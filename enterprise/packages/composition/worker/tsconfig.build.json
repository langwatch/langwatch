    },
    {
      "path": "../../../modules/managed-provider/contract/tsconfig.build.json"
    },
    {
      "path": "../../../modules/managed-provider/server/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/eventing/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/feature-flag/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/model-provider/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/observability/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/project/contract/tsconfig.build.json"
    }
  ]
}
