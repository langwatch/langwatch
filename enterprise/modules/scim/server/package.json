{
  "name": "@langwatch/enterprise-scim-server",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise SCIM token lifecycle and OpenAPI metadata.",
  "license": "SEE LICENSE IN ../../../LICENSE.md",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@langwatch/actor": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/auth-contract": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/enterprise-governance-contract": "workspace:*",
    "@langwatch/enterprise-plan-gate": "workspace:*",
    "@langwatch/enterprise-scim-contract": "workspace:*",
    "@langwatch/entitlement-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/identity-contract": "workspace:*",
    "@langwatch/identity-server": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/runtime-composition": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/user-contract": "workspace:*",
    "@trpc/server": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/enterprise-governance-server": "workspace:*",
    "@types/node": "catalog:",
    "nanoid": "^6.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
