{
  "extends": ["./tsconfig.json", "../../../../tsconfig.emit.json"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@langwatch/enterprise-sso-process": ["./src/index.ts"]
    }
  },
  "files": ["./src/index.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../../../../packages/time/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/secrets/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/process/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/ops/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/observability/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/identity/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/feature-flag/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/eventing/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../licensing/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/authz/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/audit-log/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/api/tsconfig.build.json"
    }
  ],
  // Dependencies the build does not import get no reference; tsconfig.test.json holds test-only ones (tsconfig-shape-codemod).
  "nx": {
    "sync": {
      "ignoredDependencies": [
        "@langwatch/auth-contract",
        "@langwatch/module",
        "@langwatch/test-harness",
        "@langwatch/vitest-config"
      ]
    }
  }
}
