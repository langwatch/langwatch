{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "src",
    "outDir": "dist",

    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "lib": ["es2023", "dom"],
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,

    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts"],

  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "../../../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/config/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/kernel/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/secrets/tsconfig.build.json"
    }
  ]
}
