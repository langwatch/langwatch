{
  "extends": ["./tsconfig.json", "../../../../tsconfig.emit.json"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@langwatch/enterprise-digest-process": ["./src/rules/digest-template.rules.ts"]
    }
  },
  "files": ["./src/rules/digest-template.rules.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": []
}
