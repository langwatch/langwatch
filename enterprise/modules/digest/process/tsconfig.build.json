{
  "extends": ["./tsconfig.json", "../../../../tsconfig.emit.json"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@langwatch/enterprise-digest-process": ["./src/index.ts"]
    }
  },
  "files": ["./src/index.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../../../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/authz/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/coding-agent/contract/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/entitlement/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/evaluation/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/eventing/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/mail/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/notification/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/observability/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/ops/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/organization/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/prisma-client/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/process/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/project/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/scenario/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/secrets/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/time/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/trace/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/user/contract/tsconfig.build.json"
    }
  ],
  // Dependencies the build does not import get no reference; tsconfig.test.json holds test-only ones (tsconfig-shape-codemod).
  "nx": {
    "sync": {
      "ignoredDependencies": ["@langwatch/test-harness", "@langwatch/vitest-config"]
    }
  }
}
