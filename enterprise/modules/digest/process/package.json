{
  "name": "@langwatch/enterprise-digest-process",
  "version": "0.1.0",
  "private": true,
  "description": "Weekly digest emails: folds the week's usage, picks up to five rows per person and sends one feed email through our own mailer.",
  "license": "SEE LICENSE IN ../../../LICENSE.md",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "GOMAXPROCS=2 GOMEMLIMIT=2GiB tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
