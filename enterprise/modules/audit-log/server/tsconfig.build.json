{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**"
  ],
  "references": [
    {
      "path": "../../../../modules/audit-log/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/observability/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/prisma-client/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/runtime-composition/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/system-migrations/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/time/tsconfig.build.json"
    }
  ]
}
