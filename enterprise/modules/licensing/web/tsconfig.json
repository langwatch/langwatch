{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "src",
    "outDir": "dist",

    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "paths": {
      "@langwatch/enterprise-licensing-contract": ["../contract/src/index.ts"],
      "@langwatch/authz-contract": ["../../../../modules/authz/contract/src/index.ts"]
    },

    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "../../../../dev/tsconfig.web-declarations.json"
    },
    {
      "path": "../../../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/design-system/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/authz/contract/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/plans/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/ui-host/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/time/tsconfig.build.json"
    }
  ]
}
