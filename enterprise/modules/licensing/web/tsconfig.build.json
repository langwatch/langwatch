{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "files": [
    "./src/licensing.ts",
    "./src/ui/sections/global-upgrade-modal/index.ts",
    "./src/ui/sections/license-error-interceptor/index.ts",
    "./src/ui/sections/resource-limits/index.ts",
    "./src/ui/sections/seat-types/index.ts"
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../../../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/design-system/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/plans/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/time/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/ui-host/tsconfig.build.json"
    }
  ]
}
