{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@langwatch/enterprise-governance-contract": ["../contract/src/index.ts"],
      "@langwatch/gateway-contract": ["../../../../modules/gateway/contract/src/index.ts"],
      "@langwatch/authz-contract": ["../../../../modules/authz/contract/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "../../../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/authorization/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/authz/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/browser/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/browser-host/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/design-system/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/gateway/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/handled-error/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/langy/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/model-provider/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/time/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/vitest-config/tsconfig.build.json"
    }
  ]
}
