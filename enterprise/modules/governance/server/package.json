{
  "name": "@langwatch/enterprise-governance-server",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side LangWatch Enterprise governance services.",
  "license": "SEE LICENSE IN ../../../LICENSE.md",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project enterprise/modules/governance/server/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/api-key-contract": "workspace:*",
    "@langwatch/auth-contract": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/enterprise-governance-contract": "workspace:*",
    "@langwatch/enterprise-plan-gate": "workspace:*",
    "@langwatch/entitlement-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/gateway-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/ksuid": "^2.0.2",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/organization-contract": "workspace:*",
    "@langwatch/otlp": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@langwatch/project-server": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@langwatch/trace-server": "workspace:*",
    "@opentelemetry/otlp-transformer": "0.55.0",
    "@trpc/server": "^11.18.0",
    "hono": "^4.12.27",
    "hono-openapi": "^1.3.1",
    "jsonpath-plus": "^10.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clickhouse/client": "^1.23.0",
    "@langwatch/clickhouse-client": "workspace:*",
    "@langwatch/gateway-server": "workspace:*",
    "@langwatch/test-harness": "workspace:*",
    "nanoid": "^6.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
