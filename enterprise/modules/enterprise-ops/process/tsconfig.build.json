{
  "extends": ["./tsconfig.json", "../../../../tsconfig.emit.json"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@langwatch/enterprise-ops-process": ["./src/index.ts"]
    }
  },
  "files": ["./src/index.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../../../../packages/process/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/ops/contract/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../licensing/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/audit-log/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/test-harness/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/process-stores/tsconfig.build.json"
    }
  ],
  // Workspace dependencies no source or test file imports get no reference (tsconfig-shape-codemod).
  "nx": {
    "sync": {
      "ignoredDependencies": ["@langwatch/module", "@langwatch/vitest-config"]
    }
  }
}
