{
  "extends": [
    "./tsconfig.json",
    "../../../../tsconfig.emit.json"
  ],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@langwatch/enterprise-connect-process": [
        "./src/index.ts"
      ]
    }
  },
  "files": [
    "./src/index.ts"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.json"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../../../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/authorization/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/authz/contract/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../licensing/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/gateway/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/handled-error/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/instant-eval/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../modules/instant-eval-judge/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/observability/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/plans/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/process/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/time/tsconfig.build.json"
    }
  ]
}
