{
  "extends": ["./tsconfig.json", "../../../../tsconfig.emit.json"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@langwatch/enterprise-connect-contract": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["**/__tests__/**", "**/__mocks__/**", "**/tests/**", "**/*.test.*", "**/*.spec.*"],

  "references": [
    {
      "path": "../../licensing/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/module/tsconfig.build.json"
    }
  ]
}
