{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "extends": ["./tsconfig.json", "../../../../tsconfig.emit.json"],
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**"
  ],
  "references": [
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../client/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/design-system/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/browser/tsconfig.build.json"
    },
    {
      "path": "../../../../packages/vitest-config/tsconfig.build.json"
    }
  ]
}
