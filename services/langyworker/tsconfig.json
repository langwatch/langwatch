{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "noUncheckedIndexedAccess": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/langyworker.tsbuildinfo",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "package.json"],
  "exclude": [
    // Bun-only build script (uses the `Bun` global). Compiled BY bun, never by
    // tsc; typechecked via `bun build` at the point of use (same convention as
    // sdks/typescript/scripts/build-cli-binary.ts).
    "scripts/build-binary.ts"
  ]
}
