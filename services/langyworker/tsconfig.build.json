{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    // tsc is the whole build: .ts specifiers are rewritten to .js in dist.
    "rewriteRelativeImportExtensions": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "package.json"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    {
      "path": "../../packages/vitest-config/tsconfig.build.json"
    }
  ]
}
