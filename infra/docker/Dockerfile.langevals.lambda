FROM python:3.11-slim

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /usr/src/app

RUN pip install --target . awslambdaric

# Copy workspace config and lock file
COPY services/langevals/pyproject.toml services/langevals/uv.lock ./

# Copy all workspace members (required for uv workspace resolution)
COPY services/langevals/langevals_core/ langevals_core/
COPY services/langevals/evaluators/ evaluators/
COPY services/langevals/notebooks/pyproject.toml notebooks/

ARG EVALUATOR

# Install only base + specific evaluator extra
RUN uv sync --frozen --no-dev --extra $EVALUATOR

# No outbound calls from libraries at runtime. LangEvals prices calls from
# LangWatch's own model catalog (langevals_core/model_pricing.py), so LiteLLM
# never downloads its price list; RAGAS analytics are off unless the operator
# sets RAGAS_DO_NOT_TRACK=false. Every tiktoken encoding is cached in the image,
# and LiteLLM points tiktoken at CUSTOM_TIKTOKEN_CACHE_DIR, so tokenizing
# downloads nothing either.
ENV LITELLM_LOCAL_MODEL_COST_MAP=True
ENV RAGAS_DO_NOT_TRACK=true
ENV LANGWATCH_MODEL_PRICING_DIR=/usr/src/app/model-pricing
ENV TIKTOKEN_CACHE_DIR=/usr/src/app/tiktoken
ENV CUSTOM_TIKTOKEN_CACHE_DIR=/usr/src/app/tiktoken
COPY platform/app/src/server/modelProviders/llmModels.json platform/app/src/server/modelProviders/llmModels.overlay.json model-pricing/
RUN uv run --no-sync python -c "import tiktoken; [tiktoken.get_encoding(name) for name in tiktoken.list_encoding_names()]"

COPY services/langevals/langevals/ langevals/
RUN PYTHONPATH="." uv run python langevals/server.py --preload

# Copy remaining project files
COPY services/langevals/scripts/ scripts/
COPY services/langevals/Makefile services/langevals/README.md services/langevals/LICENSE.md ./

ENTRYPOINT ["uv", "--no-cache", "run", "--no-sync", "python", "-m", "awslambdaric"]
CMD ["langevals.server.handler"]
