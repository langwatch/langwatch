# Cloud: subscriptions are seeded rows (tenancy SQL); Stripe is built lazily, so no key is set.
IS_SAAS=true
# Organisation 4 lives on a private ClickHouse and a private S3 (tenancy.ts route names); the S3 value is main's JSON account shape.
CLICKHOUSE_URL__snap__snap_hybrid_org_4=http://default:langwatch@clickhouse-private:8123/langwatch
DATAPLANE_S3__snap__snap_hybrid_org_4={"endpoint":"http://storagesim:9000","bucket":"snap-private","accessKeyId":"snapshot-test-access","secretAccessKey":"snapshot-test-secret"}
