# Cloud: subscriptions are seeded rows (tenancy SQL); Stripe is built lazily, so no key is set.
IS_SAAS=true
# Organisation 4 lives on a private ClickHouse and a private S3 (tenancy.ts route names).
CLICKHOUSE_URL__snap__snap_hybrid_org_4=http://default:langwatch@clickhouse-private:8123/langwatch
DATAPLANE_S3__snap__snap_hybrid_org_4=http://snapshot-test-access:snapshot-test-secret@storagesim:9000/snap-private
