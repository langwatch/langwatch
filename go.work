go 1.27.1

// Monorepo Go workspace. No module sits at the repository root: cmd, pkg,
// services and tools are one module each, beside the SDK and the ClickHouse
// operator. The `replace` directives in each go.mod serve Docker and other
// non-workspace builds. Example/e2e modules under sdks/go keep their own
// relative `replace => ../` and are intentionally left out of the workspace.
use (
	./cmd
	./infra/clickhouse-serverless
	./pkg
	./sdks/go
	./services
	./tools
)
