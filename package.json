{
  "name": "@langwatch/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "LangWatch repository workspace and contributor command facade.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/langwatch/langwatch.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node dev/scripts/dev-supervisor.mjs bash dev/scripts/dev-stack.sh",
    "dev:app": "pnpm --parallel --filter @langwatch/ui --filter @langwatch/platform-api dev",
    "dev:ui": "node dev/scripts/dev-supervisor.mjs pnpm --filter @langwatch/ui dev",
    "dev:api": "node dev/scripts/dev-supervisor.mjs pnpm --filter @langwatch/platform-api dev",
    "dev:worker": "node dev/scripts/dev-supervisor.mjs pnpm --filter @langwatch/worker dev",
    "dev:backend": "node dev/scripts/dev-supervisor.mjs pnpm --filter @langwatch/dev-runtime dev",
    "dev:one": "node dev/scripts/dev-supervisor.mjs pnpm --filter @langwatch/dev-runtime dev:one",
    "dev:go": "make service-watch svc=combined",
    "dev:concurrent": "pnpm --parallel --filter @langwatch/ui --filter @langwatch/platform-api --filter @langwatch/worker dev",
    "dev:cli": "pnpm --filter @langwatch/server dev",
    "start": "pnpm --filter @langwatch/platform-api start",
    "build": "pnpm run build:types && nx run-many -t build --exclude @langwatch/server,tag:go --outputStyle=static",
    "build:app": "nx run @langwatch/ui:build --outputStyle=static",
    "build:cli": "nx run @langwatch/server:build --outputStyle=static",
    "test": "pnpm -r --filter \"./packages/*\" --filter \"./modules/*/*\" --filter \"./enterprise/modules/*/*\" test",
    "test:unit": "pnpm --filter @langwatch/platform-api --filter @langwatch/worker --filter @langwatch/ui test",
    "test:component": "node -e \"console.error('No component lane outside the monolith yet: apps/{api,worker,ui} each ship one vitest.config.ts and no jsdom lane. Run pnpm test:unit, or the package suite you mean.'); process.exit(1)\"",
    "test:integration": "node -e \"console.error('No datastore lane outside the monolith yet: only @langwatch/coding-agent-process declares test:integration. Run that package directly, or pnpm test:unit.'); process.exit(1)\"",
    "test:e2e": "E2E_STACK_PORT=5600 BASE_URL=http://localhost:5600 pnpm --filter langwatch-e2e-tests test",
    "test:cli": "pnpm --filter @langwatch/server test",
    "test:sdk": "pnpm --filter langwatch test",
    "typecheck": "GOMEMLIMIT=2GiB tsc -b --builders 1",
    "sync:references": "bash dev/scripts/devscripts.sh sync-references --write",
    "test:dev-scripts": "TZ=UTC node --test dev/scripts/__tests__/*.unit.test.mjs",
    "lint": "node dev/nx/lint.mjs",
    "lint:changed": "node dev/nx/lint.mjs --changed",
    "lint:architecture": "pnpm --filter @langwatch/architecture-enforcer lint",
    "lint:oxlint": "oxlint --quiet --config .oxlintrc.jsonc .",
    "lint:oxlint:ci": "oxlint --quiet --format=github --config .oxlintrc.jsonc .",
    "lint:fix": "oxlint --fix --quiet --config .oxlintrc.jsonc .",
    "format": "oxfmt --write --disable-nested-config .",
    "format:check": "oxfmt --check --disable-nested-config .",
    "ensure:ai-gateway-secrets": "bash dev/scripts/ensure-ai-gateway-secrets.sh",
    "prepare:files": "pnpm run start:prepare:files",
    "generate:modules": "bash dev/scripts/devscripts.sh generate-modules",
    "start:prepare:files": "pnpm run ensure:ai-gateway-secrets && pnpm run generate:modules && nx run-many -t prisma:generate generate:evaluators generate:langy-skills generate:feature-map generate:setup-skill-bodies --outputStyle=static",
    "ensure:built": "bash dev/scripts/devscripts.sh ensure-built",
    "prisma:migrate": "pnpm --filter @langwatch/tasks task prisma-migrate",
    "clickhouse:migrate": "pnpm --filter @langwatch/tasks task clickhouse-migrate",
    "lwql:provision": "pnpm --filter @langwatch/tasks task lwql-provision",
    "start:prepare:db": "pnpm --filter @langwatch/tasks task prisma-migrate clickhouse-migrate lwql-provision",
    "prisma:seed": "pnpm --filter @langwatch/prisma-client db:seed",
    "pack:npm": "bash dev/scripts/pack-npm.sh",
    "release:dry-run": "bash dev/scripts/pack-npm.sh && tar -tzf langwatch-server-*.tgz | head -50",
    "build:types": "nx run workspace:build:types --outputStyle=static",
    "nx": "nx",
    "graph": "nx graph",
    "knip": "knip",
    "test:all": "nx run-many -t test --parallel=2",
    "test:affected": "nx affected -t test --parallel=2",
    "typecheck:all": "nx run-many -t typecheck",
    "typecheck:affected": "nx affected -t typecheck",
    "build:affected": "nx affected -t build",
    "lint:types:affected": "nx affected -t lint:types"
  },
  "devDependencies": {
    "@0xdeafcafe/tslsp-cli": "0.6.0",
    "@testing-library/jest-dom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "catalog:",
    "knip": "catalog:",
    "nx": "23.2.1",
    "oxfmt": "0.70.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.6.0"
}
