{
  "name": "@langwatch/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "LangWatch repository workspace and contributor command facade.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/langwatch/langwatch.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @langwatch/web dev",
    "dev:app": "pnpm --filter @langwatch/web dev:app",
    "dev:worker": "pnpm --filter @langwatch/web dev:worker",
    "dev:concurrent": "pnpm --filter @langwatch/web dev:concurrent",
    "dev:cli": "pnpm --filter @langwatch/server dev",
    "start": "pnpm --filter @langwatch/web start",
    "build": "pnpm -r --filter \"!@langwatch/server\" build",
    "build:app": "pnpm --filter @langwatch/web... build",
    "build:cli": "pnpm --filter @langwatch/server build",
    "test": "pnpm -r --filter \"./packages/*\" --filter \"./packages/features/*/*\" --filter \"./packages/enterprise/features/*/*\" --filter \"./packages/enterprise/composition/*\" test",
    "test:unit": "pnpm --filter @langwatch/web test:unit",
    "test:component": "pnpm --filter @langwatch/web test:component",
    "test:integration": "pnpm --filter @langwatch/web test:integration",
    "test:e2e": "pnpm --filter @langwatch/web test:e2e",
    "test:cli": "pnpm --filter @langwatch/server test",
    "test:sdk": "pnpm --filter langwatch test",
    "typecheck": "pnpm --filter @langwatch/web typecheck",
    "typecheck:all": "pnpm --filter @langwatch/web typecheck:all",
    "lint": "pnpm lint:architecture",
    "lint:oxlint": "oxlint --quiet --config .oxlintrc.architecture.json apps packages/features packages/enterprise packages/config packages/design-system packages/prisma-client/src packages/runtime-composition/src platform/app/src platform/app/scripts platform/app/e2e platform/app/prisma platform/app/vite",
    "lint:architecture": "pnpm lint:oxlint && pnpm --filter @langwatch/architecture-lint lint",
    "lint:architecture:declarations": "pnpm --filter @langwatch/architecture-lint lint:declarations",
    "lint:architecture:migration": "pnpm --filter @langwatch/architecture-lint lint:migration",
    "lint:fix": "oxlint --fix --quiet --config .oxlintrc.architecture.json apps packages/features packages/enterprise packages/config packages/design-system packages/prisma-client/src packages/runtime-composition/src platform/app/src platform/app/scripts platform/app/e2e platform/app/prisma platform/app/vite",
    "format": "oxfmt --write --disable-nested-config .",
    "format:check": "oxfmt --check --disable-nested-config .",
    "prepare:files": "pnpm --filter @langwatch/web start:prepare:files",
    "start:prepare:files": "pnpm --filter @langwatch/web start:prepare:files",
    "prisma:migrate": "pnpm --filter @langwatch/web prisma:migrate",
    "prisma:seed": "pnpm --filter @langwatch/web prisma:seed",
    "pack:npm": "bash dev/scripts/pack-npm.sh",
    "release:dry-run": "bash dev/scripts/pack-npm.sh && tar -tzf langwatch-server-*.tgz | head -50",
    "refactor:rename-package": "pnpm --filter @langwatch/architecture-lint rename-package --root ../.."
  },
  "devDependencies": {
    "@0xdeafcafe/tslsp-cli": "0.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260506.1",
    "oxfmt": "0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.24.0"
}
