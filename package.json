{
  "name": "@langwatch/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "LangWatch repository workspace and contributor command facade.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/langwatch/langwatch.git"
  },
  "type": "module",
  "scripts": {
    "postinstall": "node dev/scripts/install-check-shims.mjs --remove",
    "dev": "node dev/scripts/dev-supervisor.mjs bash dev/scripts/dev-stack.sh",
    "dev:app": "pnpm --parallel --filter @langwatch/ui --filter @langwatch/platform-api dev",
    "dev:ui": "node dev/scripts/dev-supervisor.mjs pnpm --filter @langwatch/ui dev",
    "dev:api": "node dev/scripts/dev-supervisor.mjs pnpm --filter @langwatch/platform-api dev",
    "dev:worker": "node dev/scripts/dev-supervisor.mjs pnpm --filter @langwatch/worker dev",
    "dev:backend": "node dev/scripts/dev-supervisor.mjs pnpm --filter @langwatch/dev-runtime dev",
    "dev:go": "make service-watch svc=combined",
    "dev:concurrent": "pnpm --parallel --filter @langwatch/ui --filter @langwatch/platform-api --filter @langwatch/worker dev",
    "dev:cli": "pnpm --filter @langwatch/server dev",
    "start": "pnpm --filter @langwatch/platform-api start",
    "build": "pnpm -r --filter \"!@langwatch/server\" build",
    "build:app": "pnpm --filter \"@langwatch/ui...\" build",
    "build:cli": "pnpm --filter @langwatch/server build",
    "test": "pnpm -r --filter \"./packages/*\" --filter \"./modules/*/*\" --filter \"./enterprise/modules/*/*\" --filter \"./enterprise/packages/composition/*\" test",
    "test:unit": "pnpm --filter @langwatch/platform-api --filter @langwatch/worker --filter @langwatch/ui test:unit",
    "test:component": "node -e \"console.error('No component lane outside the monolith yet: apps/{api,worker,ui} each ship one vitest.config.ts and no jsdom lane. Run pnpm test:unit, or the package suite you mean.'); process.exit(1)\"",
    "test:integration": "node -e \"console.error('No datastore lane outside the monolith yet: only @langwatch/coding-agent-server declares test:integration. Run that package directly, or pnpm test:unit.'); process.exit(1)\"",
    "test:e2e": "E2E_STACK_PORT=5600 BASE_URL=http://localhost:5600 pnpm --filter langwatch-e2e-tests test",
    "test:cli": "pnpm --filter @langwatch/server test",
    "test:sdk": "pnpm --filter langwatch test",
    "typecheck": "node dev/scripts/check-queue.mjs node dev/scripts/typecheck.mjs",
    "typecheck:declarations": "node dev/scripts/typecheck-declarations.mjs",
    "typecheck:fast": "node dev/scripts/check-queue.mjs node dev/scripts/typecheck.mjs --fast",
    "typecheck:one": "node dev/scripts/typecheck-one.mjs",
    "typecheck:all": "pnpm --workspace-concurrency=1 -r --filter \"!@langwatch/server\" typecheck",
    "check:ts-budget": "pnpm --filter @langwatch/architecture-lint check:ts-budget",
    "check:node-resolution": "node dev/scripts/check-node-resolution.mjs",
    "sync:references": "node dev/scripts/sync-tsconfig-references.mjs --write",
    "test:dev-scripts": "TZ=UTC node --test dev/scripts/__tests__/*.unit.test.mjs",
    "lint": "pnpm lint:architecture",
    "lint:oxlint": "oxlint --quiet --config .oxlintrc.architecture.json apps modules enterprise packages/config packages/design-system packages/handled-error/src packages/prisma-client/src packages/runtime-composition/src packages/api/src packages/eventing/src packages/observability/src packages/mail/src packages/group-queue/src packages/test-harness/src packages/architecture-lint/src sdks/typescript/src mcp/typescript/src",
    "lint:architecture": "pnpm lint:oxlint && pnpm --filter @langwatch/architecture-lint lint",
    "lint:architecture:declarations": "pnpm --filter @langwatch/architecture-lint lint:declarations",
    "lint:architecture:migration": "pnpm --filter @langwatch/architecture-lint lint:migration",
    "lint:fix": "oxlint --fix --quiet --config .oxlintrc.architecture.json apps modules enterprise packages/config packages/design-system packages/handled-error/src packages/prisma-client/src packages/runtime-composition/src packages/api/src packages/eventing/src packages/observability/src packages/mail/src packages/group-queue/src packages/test-harness/src packages/architecture-lint/src sdks/typescript/src mcp/typescript/src",
    "format": "oxfmt --write --disable-nested-config .",
    "format:check": "oxfmt --check --disable-nested-config .",
    "ensure:ai-gateway-secrets": "bash dev/scripts/ensure-ai-gateway-secrets.sh",
    "prepare:files": "pnpm run start:prepare:files",
    "generate:modules": "node dev/scripts/generate-modules.mjs",
    "start:prepare:files": "pnpm run ensure:ai-gateway-secrets && pnpm run generate:modules && cp services/langevals/ts-integration/evaluators.generated.ts modules/evaluator/contract/src/evaluators.generated.ts && pnpm --filter @langwatch/prisma-client prisma:generate && pnpm --filter @langwatch/langy-web generate:langy-skills && pnpm --filter @langwatch/langy-server generate:setup-skill-bodies",
    "ensure:built": "node dev/scripts/ensure-built.mjs",
    "prisma:migrate": "pnpm --filter @langwatch/tasks task prisma-migrate",
    "clickhouse:migrate": "pnpm --filter @langwatch/tasks task clickhouse-migrate",
    "lwql:provision": "pnpm --filter @langwatch/tasks task lwql-provision",
    "start:prepare:db": "pnpm --filter @langwatch/tasks task prisma-migrate clickhouse-migrate lwql-provision",
    "prisma:seed": "pnpm --filter @langwatch/prisma-client db:seed",
    "pack:npm": "bash dev/scripts/pack-npm.sh",
    "release:dry-run": "bash dev/scripts/pack-npm.sh && tar -tzf langwatch-server-*.tgz | head -50",
    "refactor:rename-package": "pnpm --filter @langwatch/architecture-lint rename-package --root ../.."
  },
  "devDependencies": {
    "@0xdeafcafe/tslsp-cli": "0.6.0",
    "@testing-library/jest-dom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "catalog:",
    "oxfmt": "0.63.0",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.24.0"
}
