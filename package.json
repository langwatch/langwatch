{
  "name": "@langwatch/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "LangWatch repository workspace and contributor command facade.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/langwatch/langwatch.git"
  },
  "type": "module",
  "scripts": {
    "dev": "bash dev/scripts/dev-stack.sh",
    "dev:hmr": "bash dev/scripts/dev-stack.sh --hmr",
    "dev:ui": "pnpm --filter @langwatch/ui dev",
    "dev:api": "pnpm --filter @langwatch/platform-api dev",
    "dev:worker": "pnpm --filter @langwatch/worker dev",
    "dev:backend": "pnpm --filter @langwatch/dev-runtime dev",
    "dev:go": "make service-watch svc=combined",
    "dev:cli": "pnpm --filter @langwatch/server dev",
    "start": "pnpm --filter @langwatch/platform-api start",
    "build": "pnpm run build:types && FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx run-many -t build --exclude @langwatch/server,tag:go --outputStyle=static",
    "build:app": "FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx run @langwatch/ui:build --outputStyle=static",
    "build:cli": "FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx run @langwatch/server:build --outputStyle=static",
    "build:server": "pnpm run start:prepare:files && pnpm run ensure:built && pnpm run build:types && FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx run-many -t build -p @langwatch/ui,@langwatch/scenario-child --outputStyle=static",
    "test": "FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx run-many -t test -p \"dir:packages/*\" \"dir:modules/*/*\" \"dir:enterprise/modules/*/*\"",
    "test:unit": "FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx run-many -t test -p @langwatch/platform-api @langwatch/worker @langwatch/ui",
    "test:component": "node -e \"console.error('No component lane outside the monolith yet: apps/{api,worker,ui} each ship one vitest.config.ts and no jsdom lane. Run pnpm test:unit, or the package suite you mean.'); process.exit(1)\"",
    "test:integration": "node -e \"console.error('No datastore lane outside the monolith yet: only @langwatch/coding-agent-process declares test:integration. Run that package directly, or pnpm test:unit.'); process.exit(1)\"",
    "test:e2e": "E2E_STACK_PORT=5600 BASE_URL=http://localhost:5600 pnpm --filter langwatch-e2e-tests test",
    "test:cli": "FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx run-many -t test -p @langwatch/server",
    "test:sdk": "FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx run-many -t test -p langwatch",
    "typecheck": "FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx typecheck --outputStyle=static",
    "sync:references": "bash dev/scripts/devscripts.sh sync-references --write",
    "test:dev-scripts": "TZ=UTC node --test dev/scripts/__tests__/*.unit.test.mjs dev/scripts/upgrade-rehearsal/__tests__/*.unit.test.mjs",
    "lint": "node dev/nx/lint.mjs",
    "lint:changed": "node dev/nx/lint.mjs --changed",
    "lint:architecture": "pnpm --filter @langwatch/architecture-enforcer lint",
    "lint:fix": "oxlint --fix --quiet --config .oxlintrc.jsonc .",
    "format": "oxfmt --write --disable-nested-config .",
    "format:check": "oxfmt --check --disable-nested-config .",
    "ensure:ai-gateway-secrets": "bash dev/scripts/ensure-ai-gateway-secrets.sh",
    "prepare:files": "pnpm run start:prepare:files",
    "generate:modules": "bash dev/scripts/devscripts.sh generate-modules",
    "generate:readmes": "go run ./cmd/readmegen --write",
    "check:readmes": "go run ./cmd/readmegen --check",
    "start:prepare:files": "pnpm run ensure:ai-gateway-secrets && pnpm run generate:modules && FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx run-many -t prisma:generate generate:evaluators generate:langy-skills generate:feature-map generate:setup-skill-bodies --outputStyle=static",
    "ensure:built": "FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx run-many -t build -p langwatch,@langwatch/mcp-server,@langwatch/ksuid,@langwatch/mail --outputStyle=static",
    "task": "pnpm run ensure:built && pnpm --filter @langwatch/tasks task",
    "prisma:migrate": "pnpm run ensure:built && pnpm --filter @langwatch/tasks task upgrade",
    "clickhouse:migrate": "pnpm run ensure:built && pnpm --filter @langwatch/tasks task upgrade",
    "lwql:provision": "pnpm --filter @langwatch/tasks task lwql-provision",
    "start:prepare:db": "pnpm run ensure:built && pnpm --silent --filter @langwatch/platform-api run start:prepare:db",
    "prisma:seed": "pnpm --filter @langwatch/prisma-client db:seed",
    "pack:npm": "bash dev/scripts/pack-npm.sh",
    "release:dry-run": "bash dev/scripts/pack-npm.sh && tar -tzf langwatch-server-*.tgz | head -50",
    "build:types": "FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx run workspace:build:types --outputStyle=static",
    "nx": "nx",
    "graph": "nx graph",
    "knip": "knip",
    "test:all": "FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx run-many -t test --parallel=2",
    "test:affected": "FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx affected -t test --parallel=2",
    "build:affected": "FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx affected -t build",
    "lint:types": "node dev/nx/lint.mjs --types",
    "lint:types:affected": "FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false nx affected -t lint:types"
  },
  "devDependencies": {
    "@0xdeafcafe/tslsp-cli": "0.6.0",
    "@testing-library/jest-dom": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "catalog:",
    "concurrently": "catalog:",
    "knip": "catalog:",
    "nx": "23.2.1",
    "oxfmt": "0.70.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.6.0"
}
