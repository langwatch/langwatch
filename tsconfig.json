{
  // The workspace solution: every package's check root, in one project graph.
  //
  // `pnpm typecheck` ends with `tsc -b` against this file, so the compiler walks
  // the reference graph once and checks each project exactly once (the api and
  // ui closures run first as their own processes, for memory -- ADR-100). The recursive
  // form it replaced (`pnpm -r typecheck`, serialised) spawned one `tsc -b` per
  // package, and each of those re-walked its own dependency subtree: a package
  // near the root of the graph had its up-to-date check re-run by most of the
  // other 194. That cost 110s against this file's 9s, and reported TS6305
  // errors that were only an artefact of checking a package before a sibling's
  // declarations existed.
  //
  // Nothing here changes a package's own typecheck. `pnpm --filter <pkg>
  // typecheck` still runs `tsc -b` against that package alone, which is the
  // narrow, cheap run to iterate with.
  //
  // `references` is generated -- `pnpm sync:references` writes it from the
  // workspace manifests, and the declaration-project-references rule fails a
  // build where it has drifted. Do not hand-edit the array.
  "files": [],
  "exclude": [".claude/"],
  // The mail preview studio is a project of its own inside a package, so no
  // workspace manifest names it; the rest of the array is derived.
  "langwatchExtraReferences": [{ "path": "packages/mail/preview/tsconfig.json" }],
