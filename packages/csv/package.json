{
  "name": "@langwatch/csv",
  "version": "0.0.1",
  "private": true,
  "description": "The one rule every CSV LangWatch writes has to apply: the spreadsheet formula guard, plus the browser-side CSV download writer that applies it.",
  "keywords": [
    "csv",
    "formula-injection",
    "langwatch"
  ],
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./download": {
      "types": "./dist/download-csv.d.ts",
      "default": "./src/download-csv.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "papaparse": "^5.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/papaparse": "^5.5.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
