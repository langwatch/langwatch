{
  "name": "@langwatch/platform-api-client",
  "version": "0.1.0",
  "private": true,
  "description": "The browser's one typed tRPC client for the platform API. Feature web packages import it; the process shell supplies its transport.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./feature-api": {
      "types": "./src/feature-api.ts",
      "default": "./src/feature-api.ts"
    },
    "./query-key": {
      "types": "./src/trpc-query-key.ts",
      "default": "./src/trpc-query-key.ts"
    },
    "./invalidate": {
      "types": "./src/use-invalidate-procedure.ts",
      "default": "./src/use-invalidate-procedure.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/platform-api": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  }
}
