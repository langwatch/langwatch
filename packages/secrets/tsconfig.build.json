{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@langwatch/secrets": ["./src/index.ts"]
    },
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**"],
  "references": [
    {
      "path": "../handled-error/tsconfig.build.json"
    }
  ]
}
