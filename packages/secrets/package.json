{
  "name": "@langwatch/secrets",
  "version": "0.0.1",
  "private": true,
  "description": "Secrets as pass-through values: modules declare handles by one id, the app states a lookup order (env, file, 1Password), and a value exists only inside the closure that builds its collaborator.",
  "keywords": [
    "langwatch",
    "secrets"
  ],
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./secret": {
      "types": "./dist/secret.d.ts",
      "default": "./src/secret.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/handled-error": "workspace:*"
  },
  "devDependencies": {
    "@langwatch/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
