{
  "name": "@langwatch/secrets",
  "version": "0.0.1",
  "private": true,
  "description": "Server-only secret classification and resolution: the SECRET/COMPOSITE/POINTER/CONFIG key registry, the SecretSource port, its env, 1Password, chaining and refusing adapters, and log redaction by key class",
  "keywords": [
    "configuration",
    "langwatch",
    "secrets"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./keys.json": "./keys.json"
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project packages/secrets/tsconfig.json && tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.24.0"
}
