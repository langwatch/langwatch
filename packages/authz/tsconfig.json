{
  "compilerOptions": {
    "target": "es2020",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2020"],
    // `passport.ts` and `bitset.ts` are the server-only subpaths and use
    // node:crypto and Buffer. Without this the package's own typecheck was
    // red on seven errors; browser-safety of the root entry is enforced by
    // the export barrel and the app's frontend-boundary test, not here.
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/authz.tsbuildinfo",
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  // The package ships its TypeScript sources (exports point at src/*.ts), so
  // nothing is emitted from here. Tests are checked by tsconfig.test.json,
  // which supplies the `vitest` module types this config has no need of.
  "exclude": ["src/__tests__/**"]
}
