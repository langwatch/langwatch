{
  "name": "@langwatch/authz",
  "version": "0.1.0",
  "private": true,
  "description": "The isomorphic authorization core (ADR-092): the vocabulary, the permission registry, built-in roles and the pure decide() walk. No node imports, so the frontend and the backend share it verbatim. Server-side services live in @langwatch/authz-server.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./witness": {
      "types": "./src/witness.ts",
      "default": "./src/witness.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/handled-error": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
