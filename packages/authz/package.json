{
  "name": "@langwatch/authz",
  "version": "0.1.0",
  "private": true,
  "description": "The unified authorization engine (ADR-092): the permission registry, built-in roles, the pure decide() walk, and the witness/passport primitives. Storage adapters (collector, cache, grants) live in the app.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./passport": {
      "types": "./src/passport.ts",
      "default": "./src/passport.ts"
    },
    "./witness": {
      "types": "./src/witness.ts",
      "default": "./src/witness.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/handled-error": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
