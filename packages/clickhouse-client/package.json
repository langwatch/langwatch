{
  "name": "@langwatch/clickhouse-client",
  "version": "0.1.0",
  "private": true,
  "description": "The shared ClickHouse client contract: fail-closed tenant routing and scope guarding, bounded concurrency with shedding, retries and backoff, tracing and vendor logging policy, resilience over the vendor client, and fleet-aware connection-pool sizing - composed by a client class that states its order.",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./dist/clickhouse-test-endpoints.d.ts",
      "default": "./src/clickhouse-test-endpoints.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@clickhouse/client": "catalog:",
    "@langwatch/data-retention-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/task": "workspace:*",
    "@langwatch/time": "workspace:*"
  },
  "devDependencies": {
    "@testcontainers/clickhouse": "catalog:",
    "@types/node": "catalog:",
    "nanoid": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
