{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "tsBuildInfoFile": "dist/tsconfig.test.tsbuildinfo"
  },
  // The suite, plus the sources it exercises. `vitest` resolves from the
  // package's own devDependency, so the test types are checked here and
  // nowhere else.
  "include": ["src/**/*.ts", "src/__tests__/**/*.ts"],
  "exclude": [],

  "references": [
    {
      "path": "tsconfig.build.json"
    }
  ]
}
