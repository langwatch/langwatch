{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "tsBuildInfoFile": "dist/tsconfig.test.tsbuildinfo",
    "composite": false,
    "noEmit": true
  },
  "include": [
    "src/**/__tests__/**/*.ts",
    "src/**/__mocks__/**/*.ts",
    "src/**/tests/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.test.*.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.*.ts",
    "src/styles.d.ts",
    "src/**/__tests__/**/*.tsx",
    "src/**/__mocks__/**/*.tsx",
    "src/**/tests/**/*.tsx",
    "src/**/*.test.tsx",
    "src/**/*.test.*.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.spec.*.tsx",
    "tests/**/*.ts"
  ],

  "references": [
    {
      "path": "./tsconfig.build.json"
    }
  ]
}
