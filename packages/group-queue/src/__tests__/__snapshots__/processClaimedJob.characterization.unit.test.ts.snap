        "jobDataJson": "{"id":"job-1","groupId":"project_1/g1","__jobName":"job","__attempt":1}",
        "newStagedJobId": "job-1",
        "score": "<time>",
      },
    ],
  ],
  [
    "scripts.discardClaim",
    [
      "project_1/g1",
    ],
  ],
]
`;

