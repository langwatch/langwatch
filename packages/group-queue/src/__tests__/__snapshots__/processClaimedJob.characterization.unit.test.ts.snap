exports[`given a claimed job > parks the group when the payload is oversized 1`] = `
[
  [
    "blob.decode",
    [
      {
        "groupId": "project_1/g1",
        "value": "{"id":"job-1","groupId":"project_1/g1","__jobName":"job","__attempt":1}",
