// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`given a claimed job > blocks the group when the handler fails for good 1`] = `
[
  [
    "blob.decode",
    [
      {
        "groupId": "project_1/g1",
        "value": "{"id":"job-1","groupId":"project_1/g1","__jobName":"job","__attempt":1}",
      },
    ],
  ],
  [
    "redis.get",
    [
      "{test/gq/characterize}:gq:group:project_1/g1:attempt",
    ],
  ],
  [
    "handler.process",
    [
      {
        "__jobName": "job",
        "groupId": "project_1/g1",
        "id": "job-1",
      },
    ],
  ],
  [
    "blob.encode",
    [
      {
        "groupId": "project_1/g1",
        "jobData": {
          "__jobName": "job",
          "groupId": "project_1/g1",
          "id": "job-1",
        },
      },
    ],
  ],
  [
    "scripts.restageAndBlock",
    [
      {
        "errorMessage": "never again",
        "errorStack": "<stack>",
        "groupId": "project_1/g1",
        "jobDataJson": "{"id":"job-1","groupId":"project_1/g1","__jobName":"job"}",
        "newStagedJobId": "job-1",
        "score": "<time>",
      },
    ],
  ],
  [
    "blob.releaseLease",
    [
      {
        "groupId": "project_1/g1",
        "values": [
          "{"id":"job-1","groupId":"project_1/g1","__jobName":"job","__attempt":1}",
        ],
      },
    ],
  ],
]
`;

