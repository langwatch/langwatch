{
  "name": "@langwatch/group-queue",
  "version": "0.1.0",
  "private": true,
  "description": "Typed Redis-backed queues with per-group FIFO ordering and independent producer and consumer capabilities.",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./operational": {
      "types": "./dist/operational.d.ts",
      "default": "./src/operational.ts"
    }
  },
  "scripts": {
    "typecheck": "GOMAXPROCS=2 GOMEMLIMIT=2GiB tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts && vitest run --config vitest.memory-cap.config.ts"
  },
  "dependencies": {
    "@langwatch/config": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/task": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "fastq": "^1.20.1",
    "ioredis": "catalog:",
    "msgpackr": "^2.0.4"
  },
  "devDependencies": {
    "@langwatch/test-harness": "workspace:*",
    "@langwatch/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "langwatch": {
    "group": "framework"
  }
}
