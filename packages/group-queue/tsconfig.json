{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package emits: `noEmit` from the shared base is turned back off
    // here so a `tsc -p` build still writes its declarations.
    "noEmit": false,
    "lib": ["es2022"],
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/group-queue.tsbuildinfo",
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  // Exclude Vitest tests from the source typecheck and declaration build;
  // Vitest is a test-only dependency.
  "exclude": ["src/**/*.test.ts", "src/**/__tests__/**"]
}
