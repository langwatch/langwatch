{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@langwatch/api-client-web/workflow-api": ["./src/workflow-api.ts"],
      "@langwatch/api-client-web/agent-client": ["./src/agent-client.ts"]
    },
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "files": ["./src/workflow-api.ts", "./src/agent-client.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../../modules/agent/contract/tsconfig.build.json"
    },
    {
      "path": "../api/tsconfig.build.json"
    },
    {
      "path": "../../modules/dataset/contract/tsconfig.build.json"
    },
    {
      "path": "../../modules/evaluator/contract/tsconfig.build.json"
    },
    {
      "path": "../../modules/model-provider/contract/tsconfig.build.json"
    },
    {
      "path": "../../modules/prompt/contract/tsconfig.build.json"
    },
    {
      "path": "../../modules/workflow/contract/tsconfig.build.json"
    }
  ]
}
