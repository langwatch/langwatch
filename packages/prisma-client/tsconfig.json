{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "lib": ["es2023"],
    "noUncheckedIndexedAccess": true,
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "verbatimModuleSyntax": true,

  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "../../modules/api-key/contract/tsconfig.build.json"
    },
    {
      "path": "../observability/tsconfig.build.json"
    },
    {
      "path": "../time/tsconfig.build.json"
    }
  ]
}
