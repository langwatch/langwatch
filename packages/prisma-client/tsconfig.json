{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package emits: `noEmit` from the shared base is turned back off
    // here so a `tsc -p` build still writes its declarations.
    "noEmit": false,
    "lib": ["es2022"],
    "noUncheckedIndexedAccess": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/prisma-client.tsbuildinfo",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
