{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "rootDir": ".",
    "lib": ["es2023"],
    "noUncheckedIndexedAccess": true,
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "outDir": "./dist/typecheck",
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "preview/**/*.ts"],
  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "../time/tsconfig.build.json"
    },
    {
      "path": "../vitest-config/tsconfig.build.json"
    }
  ]
}
