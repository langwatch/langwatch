{
  "extends": ["./tsconfig.json", "../../tsconfig.emit.json"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@langwatch/module": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["**/__tests__/**", "**/__mocks__/**", "**/tests/**", "**/*.test.*", "**/*.spec.*"],
  "references": [],
  // Dependencies the build does not import get no reference; tsconfig.test.json holds test-only ones (tsconfig-shape-codemod).
  "nx": {
    "sync": {
      "ignoredDependencies": ["@langwatch/vitest-config"]
    }
  }
}
