{
  "extends": ["./tsconfig.json", "../../tsconfig.emit.json"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@langwatch/error-views": ["./src/views.tsx"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**"
  ],
  "references": [
    {
      "path": "../handled-error/tsconfig.build.json"
    },
    {
      "path": "../design-system/tsconfig.build.json"
    }
  ],
  // Workspace dependencies no source or test file imports get no reference (tsconfig-shape-codemod).
  "nx": {
    "sync": {
      "ignoredDependencies": ["@langwatch/vitest-config"]
    }
  }
}
