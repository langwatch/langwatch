{
  "name": "@langwatch/upgrade",
  "version": "0.1.0",
  "private": true,
  "description": "The upgrade runner's own ledger: the runner-owned ledger tables in their own Postgres schema (<schema>_upgrade_ledger), and their first seeding from those two records. Storage-engine-free: the caller hands in the Postgres and ClickHouse connections.",
  "files": [
    "src",
    "releases"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./src/*/index.ts"
    }
  },
  "scripts": {
    "typecheck": "GOMAXPROCS=2 GOMEMLIMIT=2GiB tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@clickhouse/client": "catalog:",
    "@langwatch/clickhouse-migrations": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/ksuid": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/process-stores": "workspace:*",
    "@langwatch/redis-client": "workspace:*",
    "@langwatch/secrets": "workspace:*",
    "@langwatch/system-migrations": "workspace:*",
    "@langwatch/time": "workspace:*",
    "pg": "catalog:",
    "prisma": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/vitest-config": "workspace:*",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "langwatch": {
    "group": "framework"
  }
}
