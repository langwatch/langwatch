{
  "extends": ["./tsconfig.json", "../../tsconfig.emit.json"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@langwatch/upgrade": ["./src/index.ts"]
    }
  },
  "files": ["./src/index.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../time/tsconfig.build.json"
    },
    {
      "path": "../system-migrations/tsconfig.build.json"
    },
    {
      "path": "../secrets/tsconfig.build.json"
    },
    {
      "path": "../redis-client/tsconfig.build.json"
    },
    {
      "path": "../redaction/tsconfig.build.json"
    },
    {
      "path": "../process-stores/tsconfig.build.json"
    },
    {
      "path": "../observability/tsconfig.build.json"
    },
    {
      "path": "../ksuid/tsconfig.build.json"
    },
    {
      "path": "../handled-error/tsconfig.build.json"
    },
    {
      "path": "../eventing/tsconfig.build.json"
    },
    {
      "path": "../clickhouse-migrations/tsconfig.build.json"
    },
    {
      "path": "../vitest-config/tsconfig.build.json"
    }
  ]
}
