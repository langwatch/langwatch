{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "tsBuildInfoFile": "dist/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "src/**/__tests__/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.test.*.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.*.ts",
    "src/env.d.ts",
    "src/**/__tests__/**/*.tsx",
    "src/**/*.test.tsx",
    "src/**/*.test.*.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.spec.*.tsx",
    "vitest.config.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.build.json"
    }
  ]
}
