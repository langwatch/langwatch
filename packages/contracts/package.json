{
	"name": "@langwatch/contracts",
	"version": "0.0.0",
	"private": true,
	"description": "Wire contracts shared across LangWatch surfaces — Zod schemas and the types inferred from them, with no runtime dependencies",
	"type": "module",
	"packageManager": "pnpm@10.24.0",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./agent-onboarding": "./src/agent-onboarding/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest",
		"test:unit": "vitest run"
	},
	"keywords": [
		"langwatch",
		"contracts",
		"zod",
		"schemas"
	],
	"license": "MIT",
	"peerDependencies": {
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@types/node": "^26.0.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9",
		"zod": "^3.25.76"
	}
}
