{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@langwatch/process-server": [
        "./src/index.ts"
      ]
    },
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*"
  ],
  "references": [
    {
      "path": "../kernel/tsconfig.build.json"
    }
  ]
}
