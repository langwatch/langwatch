{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@langwatch/process-server": [
        "./src/index.ts"
      ]
    },
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ]
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*"
  ],
  "references": [
    {
      "path": "../actor/tsconfig.build.json"
    },
    {
      "path": "../api/tsconfig.build.json"
    },
    {
      "path": "../../modules/api-key/contract/tsconfig.build.json"
    },
    {
      "path": "../../modules/audit-log/contract/tsconfig.build.json"
    },
    {
      "path": "../../modules/auth/contract/tsconfig.build.json"
    },
    {
      "path": "../../modules/authz/contract/tsconfig.build.json"
    },
    {
      "path": "../config/tsconfig.build.json"
    },
    {
      "path": "../../enterprise/modules/scim/contract/tsconfig.build.json"
    },
    {
      "path": "../handled-error/tsconfig.build.json"
    },
    {
      "path": "../kernel/tsconfig.build.json"
    },
    {
      "path": "../../modules/langy/contract/tsconfig.build.json"
    },
    {
      "path": "../../modules/model-provider/contract/tsconfig.build.json"
    },
    {
      "path": "../observability/tsconfig.build.json"
    },
    {
      "path": "../../modules/organization/contract/tsconfig.build.json"
    },
    {
      "path": "../process-stores/tsconfig.build.json"
    },
    {
      "path": "../secrets/tsconfig.build.json"
    }
  ]
}
