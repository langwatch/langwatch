{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@langwatch/process-server": ["./src/index.ts"]
    },
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*"
  ],
  "references": [
    {
      "path": "../handled-error/tsconfig.build.json"
    },
    {
      "path": "../kernel/tsconfig.build.json"
    },
    {
      "path": "../observability/tsconfig.build.json"
    },
    {
      "path": "../secrets/tsconfig.build.json"
    }
  ]
}
