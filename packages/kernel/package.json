{
  "name": "@langwatch/kernel",
  "version": "0.1.0",
  "private": true,
  "description": "Ordered ownership of process resources, closed once in reverse order.",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./module-api": {
      "types": "./dist/module-api-token.d.ts",
      "default": "./src/module-api-token.ts"
    },
    "./supply": {
      "types": "./dist/process-supply.d.ts",
      "default": "./src/process-supply.ts"
    }
  },
  "scripts": {
    "typecheck": "node scripts/check-feature-names.mjs && tsc -b tsconfig.test.json tsconfig.type-tests.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:",
    "@langwatch/config": "workspace:*",
    "@langwatch/secrets": "workspace:*"
  },
  "devDependencies": {
    "@langwatch/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
