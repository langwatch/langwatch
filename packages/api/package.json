{
  "name": "@langwatch/api",
  "version": "0.0.0",
  "private": true,
  "description": "LangWatch's API framework: the transport-agnostic error, access-policy and capability vocabulary, the Hono REST service framework (./rest), and the typed tRPC root and policy spine (./trpc)",
  "keywords": [
    "api",
    "hono",
    "langwatch",
    "service-framework",
    "trpc"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./rest": "./src/rest/index.ts",
    "./trpc": "./src/trpc/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.type-tests.json",
    "test": "vitest",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/api-key-contract": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@langwatch/stored-object-contract": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@standard-schema/spec": "^1.1.0",
    "@trpc/server": "11.18.0",
    "hono": "^4.12.27",
    "hono-openapi": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.24.0"
}
