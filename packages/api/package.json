{
  "name": "@langwatch/api",
  "version": "0.0.0",
  "private": true,
  "description": "LangWatch's API framework: the transport-agnostic error, access-policy and capability vocabulary, the Hono REST service framework (./rest), and the typed tRPC root and policy spine (./trpc)",
  "keywords": [
    "api",
    "hono",
    "langwatch",
    "service-framework",
    "trpc"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./access": {
      "types": "./dist/access/index.d.ts",
      "default": "./src/access/index.ts"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./src/contract/index.ts"
    },
    "./dates": {
      "types": "./dist/dates.d.ts",
      "default": "./src/dates.ts"
    },
    "./rest": {
      "types": "./dist/rest/index.d.ts",
      "default": "./src/rest/index.ts"
    },
    "./hosting": {
      "types": "./dist/hosting/index.d.ts",
      "default": "./src/hosting/index.ts"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "default": "./src/policy/index.ts"
    },
    "./trpc": {
      "types": "./dist/trpc/index.d.ts",
      "default": "./src/trpc/index.ts"
    },
    "./composition": {
      "types": "./dist/composition.d.ts",
      "default": "./src/composition.ts"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./src/web/index.ts"
    },
    "./hosting/selection": {
      "types": "./dist/hosting/transport-selection.d.ts",
      "default": "./src/hosting/transport-selection.ts"
    },
    "./hosting/mux": {
      "types": "./dist/hosting/http-mux.d.ts",
      "default": "./src/hosting/http-mux.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json tsconfig.type-tests.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@langwatch/actor": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/kernel": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/react-query": "catalog:",
    "@trpc/client": "catalog:",
    "@trpc/react-query": "catalog:",
    "@trpc/server": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "react": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/api-fixture": "workspace:*",
    "@langwatch/vitest-config": "workspace:*",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-web": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/ws": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  },
  "packageManager": "pnpm@10.24.0"
}
