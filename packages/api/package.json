{
  "name": "@langwatch/api",
  "version": "0.0.0",
  "private": true,
  "description": "LangWatch's API framework: the transport-agnostic error, access-policy and capability vocabulary, the Hono REST service framework (./rest), and the typed tRPC root and policy spine (./trpc)",
  "keywords": [
    "api",
    "hono",
    "langwatch",
    "service-framework",
    "trpc"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./access": {
      "types": "./dist/access/index.d.ts",
      "default": "./src/access/index.ts"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./src/contract/index.ts"
    },
    "./rest": {
      "types": "./dist/rest/index.d.ts",
      "default": "./src/rest/index.ts"
    },
    "./trpc": {
      "types": "./dist/trpc/index.d.ts",
      "default": "./src/trpc/index.ts"
    },
    "./composition": {
      "types": "./dist/composition.d.ts",
      "default": "./src/composition.ts"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./src/web/index.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit && tsc -p tsconfig.type-tests.json",
    "test": "vitest",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/actor": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/runtime-composition": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "hono": "^4.12.27",
    "hono-openapi": "^1.3.1",
    "react": "^19.2.7",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.6",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-web": "2.10.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.14",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  },
  "packageManager": "pnpm@10.24.0"
}
