{
  "name": "@langwatch/api",
  "version": "0.0.0",
  "private": true,
  "description": "LangWatch's API framework: the transport-agnostic error, access-policy and capability vocabulary, the Hono REST service framework (./rest), and the typed tRPC root and policy spine (./trpc)",
  "keywords": [
    "api",
    "hono",
    "langwatch",
    "service-framework",
    "trpc"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": {
        "langwatch-declarations": "./dist/src/index.d.ts",
        "default": "./src/index.ts"
      },
      "default": "./src/index.ts"
    },
    "./rest": {
      "types": {
        "langwatch-declarations": "./dist/src/rest/index.d.ts",
        "default": "./src/rest/index.ts"
      },
      "default": "./src/rest/index.ts"
    },
    "./trpc": {
      "types": {
        "langwatch-declarations": "./dist/src/trpc/index.d.ts",
        "default": "./src/trpc/index.ts"
      },
      "default": "./src/trpc/index.ts"
    },
    "./composition": {
      "types": {
        "langwatch-declarations": "./dist/src/composition.d.ts",
        "default": "./src/composition.ts"
      },
      "default": "./src/composition.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project packages/api/tsconfig.json && tsc --noEmit && tsc -p tsconfig.type-tests.json",
    "test": "vitest",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/actor": "workspace:*",
    "@langwatch/api-key-contract": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@langwatch/stored-object-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@standard-schema/spec": "^1.1.0",
    "@trpc/server": "11.18.0",
    "hono": "^4.12.27",
    "hono-openapi": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.6",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-web": "2.10.0",
    "@types/node": "^26.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.24.0"
}
