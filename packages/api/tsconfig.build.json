{
  "extends": ["./tsconfig.json", "../../tsconfig.emit.json"],
  "compilerOptions": {
    "module": "esnext",
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@langwatch/api": ["./src/index.ts"]
    },
  },
  "files": [
    "./src/index.ts",
    "./src/contract/index.ts",
    "./src/rest/index.ts",
    "./src/trpc/index.ts",
    "./src/composition.ts",
    "./src/web/index.ts"
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../actor/tsconfig.build.json"
    },
    {
      "path": "../../modules/authz/contract/tsconfig.build.json"
    },
    {
      "path": "../handled-error/tsconfig.build.json"
    },
    {
      "path": "../kernel/tsconfig.build.json"
    },
    {
      "path": "../observability/tsconfig.build.json"
    },
    {
      "path": "../time/tsconfig.build.json"
    }
  ]
}
