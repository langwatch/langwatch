{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@langwatch/process-stores": ["./src/index.ts"]
    },
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/__tests__/**", "**/tests/**", "**/*.test.*"],
  "references": [
    {
      "path": "../clickhouse-client/tsconfig.build.json"
    },
    {
      "path": "../config/tsconfig.build.json"
    },
    {
      "path": "../eventing/tsconfig.build.json"
    },
    {
      "path": "../group-queue/tsconfig.build.json"
    },
    {
      "path": "../kernel/tsconfig.build.json"
    },
    {
      "path": "../mail/tsconfig.declarations.json"
    },
    {
      "path": "../observability/tsconfig.build.json"
    },
    {
      "path": "../prisma-client/tsconfig.build.json"
    },
    {
      "path": "../redis-client/tsconfig.build.json"
    },
    {
      "path": "../secrets/tsconfig.build.json"
    }
  ]
}
