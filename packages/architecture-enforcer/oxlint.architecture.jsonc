{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",

  // The architecture rules themselves: the langwatch/* plugin this package
  // implements, every rule it exposes, and the exemptions that are part of a
  // rule's definition rather than debt against it. The root .oxlintrc.jsonc
  // extends this file, so the rules live beside the code that enforces them.
  //
  // Debt — a path exempted because it has not been paid down yet — does NOT
  // belong here. That is dev/lint/oxlint.baseline.jsonc.
  "jsPlugins": [
    {
      "name": "langwatch",
      "specifier": "./oxlint-plugin.mjs"
    }
  ],
  "rules": {
    "langwatch/cognitive-complexity": ["error", { "max": 15 }],
    "langwatch/condition-shape": "error",
    "langwatch/legacy-monolith-path": "error",
    "langwatch/api-context-services": "error",
    "langwatch/comment-block-size": "error",
    "langwatch/comment-block-size-warning": "warn",
    "langwatch/conditional-type-depth": "error",
    "langwatch/zod-object-composition": "error",
    "langwatch/fallible-result-naming": "error",
    // Measured 2026-09-15 over apps/ui/src, modules, enterprise/modules: 224
    // reports across 122 files of shipped customer copy carrying an em dash
    // that dev/docs/best_practices/copywriting.md bans. No fixer: the right
    // replacement is a comma, a colon, a parenthetical or a rewritten
    // sentence, which is an editorial choice. The 122 files are baselined.
    "langwatch/em-dash-in-copy": "error",
    // Measured 2026-09-15: 85 files. A .unit.test file that imports a renderer
    // is an integration test by this repository's own definition.
    "langwatch/unit-test-does-not-render": "error",
    // Measured 2026-09-15: 11 reports across 8 files, gated on the Prisma seam.
    // Encodes the incident CLAUDE.md records: _count inside findMany becomes an
    // uncorrelated join the planner may re-run per listed row (2.3s per call).
    "langwatch/prisma-count-in-list-query": "error",
    // Measured 2026-09-15: 223 reports across 168 files, baselined. Reports
    // every describe whose sibling tests share a 3+ statement opening, not
    // only the 10 that hoist mechanically — hoistability decides whether a
    // fixer is worth its risk, not whether the finding is worth reading.
    "langwatch/shared-setup-is-a-hook": "error",
    // Measured 2026-09-15: 14 reports across 10 files, baselined. Reports
    // `._def` on any object; only the tRPC host is exempt, by path, because
    // the router type declares no accessor for which procedure lives at a
    // path. An earlier name-based gate admitted only `*schema` locals and so
    // missed the two shipped bugs in model-provider-credential.ts that
    // dev/docs/best_practices/zod.md was written about.
    "langwatch/zod-internals": "error",
    // Measured 2026-09-15: zero. Ships clean as a guard against a defect class
    // CLAUDE.md and react.md both name and that recurs in generated code.
    "langwatch/jsx-from-hook": "error",
    "langwatch/no-try-prefix": "error",
    "langwatch/return-await-outside-try": "error",
    // NOT enabled: `positional-parameter-list` is registered in the plugin
    // above but deliberately left out of this map. Measured 2026-09-15 over
    // apps/modules/enterprise/packages/sdks: 1513 findings / 722 files at 3+
    // parameters, 398 / 222 at 4+, 122 / 86 at 5+. The drive that built it set
    // a 150-file ceiling for landing and 4+ exceeds it. The findings sampled
    // clean, so this is real debt rather than a detection fault; raising the
    // threshold to 5+ would loosen what CLAUDE.md actually asks for, so the
    // next step is narrowing `applies` to service and public-API surfaces
    // rather than moving the number.
    "langwatch/feature-source-filename": "error",
    "langwatch/feature-source-layout": "error",
    "langwatch/feature-source-subject": "error",
    "langwatch/handled-error-outside-contract": "error",
    "langwatch/layer-class": "error",
    "langwatch/no-raw-hono-mount": "error",
    "langwatch/overload-by-literal": "error",
    "langwatch/plan-literals": "error",
    "langwatch/prisma-containment": "error",
    "langwatch/schema-outside-contract": "error",
    "langwatch/service-loads-its-own-config": "error",
    "langwatch/temporal-only": "error",
    "langwatch/typed-prisma-seam": "error",
    "langwatch/web-imports-server-shaped-value": "error",
    "langwatch/environment-boundaries": "error",
    "langwatch/secrets-through-source": "error",
    "langwatch/package-boundaries": "error",
    "langwatch/feature-module-classes": "error",
    "langwatch/service-classes": "error",
    "langwatch/service-dependencies": "error",
    "langwatch/namespace-class": "error",
    "langwatch/unbounded-loop": "error",
    "langwatch/id-generation-origin": "error",
    // Measured 2026-09-15 over the `lint:oxlint` paths: 2 reports across 2
    // files. One is fixed in the same change; the other is langy's chat
    // transport, where a fresh key per send is the product decision, and it
    // sits in the baseline rather than being rewritten.
    "langwatch/idempotency-key-is-stable": "error",
    "langwatch/no-runtime-reflection": "error",
    "langwatch/feature-side-holds-no-app": "error",
    "langwatch/transport-middleware-is-a-gate": "error",
    "langwatch/type-only-value-import": "error",
    "langwatch/no-alias-reexport": "error",
    "langwatch/no-prototype-stub": "error",
    "langwatch/no-logger-spy": "error",
    "langwatch/no-raw-error-output": "error",
    "langwatch/no-boot-hook-outside-guard": "error",
    "langwatch/banned-legacy-names": "error",
    // The word "port" is banned outright. The baseline below is every file that
    // still carries it and it may only shrink; a new one is a hard failure.
    "langwatch/no-port-vocabulary": "error",
    // Measured 2026-09-10: 70 files, 80 reports, across 20 modules, seeded
    // into the shrink-only baseline. The channel conversion (ADR-144 decision
    // 9) empties services/ of conduits and the rows go with it.
    "langwatch/refusal-is-a-handled-error": "error",
    "langwatch/channel-takes-only-its-client": "error",
    "langwatch/clickhouse-containment": "error",
    "langwatch/redis-containment": "error",
    "langwatch/repository-takes-only-its-store": "error",
    "langwatch/service-does-not-open-a-channel": "error",
    "langwatch/module-app-only-across-packages": "error",
    // Measured 2026-09-10 over the `lint:oxlint` paths: 80 reports across 30
    // files. Every one is a specifier no file answers to, left behind by an
    // in-flight move; the baseline holds them only until those lanes land.
    "langwatch/dangling-barrel-export": "error",
    // Measured 2026-09-10 over the `lint:oxlint` paths: 320 reports across
    // 216 files.
    "langwatch/empty-catch": "error",
    // Measured 2026-09-10 over the `lint:oxlint` paths: 328 reports across
    // 178 files.
    // Widened 2026-09-15 to cover test files, which it previously exempted:
    // 1894 reports across 792 test files (362 `as any`, 1532 double casts),
    // recorded in the baseline as the debt that existed at the moment of
    // widening. Those 792 rows are deliberate: the register only forgives
    // rows for a rule it has never seen, so it reads a widened rule as growth
    // rather than as newly governed ground. Tests get their own message ids —
    // a test value crossed no trust boundary, so the fix is a typed stub, not
    // a schema.
    "langwatch/stand-in-cast": "error",
    // Measured 2026-09-10 over the `lint:oxlint` paths: 9 reports across 9
    // files.
    "langwatch/transport-imports-a-repository": "error",
    // Measured 2026-09-15 over the `lint:oxlint` paths with the baseline
    // itself cleared first (the rule reads its own baseline entry to decide
    // whether to report, so measuring with old entries in place undercounts):
    // 471 reports across 95 files. Every file was already known on
    // 2026-09-10; the baseline here is that same inventory minus 5 files
    // fixed since. No new drift to fix.
    "langwatch/banned-test-model-names": "error",
    // Measured 2026-09-15 the same way: 517 reports across 170 files, most of
    // them either a dynamic import inside a test body (module load order
    // depends on mocks set up first) or a deliberate lazy `import()` for
    // code-splitting a heavy component (editor, chart, drawer). Neither can
    // be flipped to a top-level import without a behavioural or bundle-size
    // change, so the baseline holds them until each is converted
    // deliberately.
    "langwatch/no-inline-dynamic-import": "error",
    // Enabled 2026-09-15 after exempting the false-positive class: 1349
    // reports across 336 files, baselined. The nested-describe check now
    // permits the MDN-style unit nesting TESTING_PHILOSOPHY.md blesses
    // (`describe(ClassName) > describe(methodName())`) and an "and "-prefixed
    // title, which together accounted for 309 of the 1658 it used to report.
    "langwatch/test-description-is-an-action": "error",
    "langwatch/awaited-return-chain": "error",
    "langwatch/max-statements-per-line": "error",
    // Measured 2026-09-15 over the `lint:oxlint` paths: 34 reports across 12
    // service files. The rule does not read the oxlint baseline (it is a
    // whitespace `layout` rule, not a `defineRule` baseline consumer), so
    // there is nothing to seed; every report was auto-fixed with `--fix` in
    // the same change instead.
    "langwatch/service-member-spacing": "error",
    "langwatch/service-quality": "error"
  },
  "overrides": [
    {
      "files": ["packages/architecture-enforcer/src/**/*.ts"],
      "rules": {
        "langwatch/boolean-wall": "error",
        "langwatch/logical-statement-spacing": "error"
      }
    },
    {
      // The reference shape reads in paragraphs. Enabled where the shape is
      // already the annotation one; a feature turns it on as it converts
      // (the rule auto-fixes: run oxlint --fix over the feature).
      "files": [
        "packages/api/src/**/*.ts",
        "modules/annotation/**/*.ts",
        "modules/annotation/**/*.tsx",
        "apps/api/src/features/annotation/**/*.ts",
        "apps/ui/src/features/annotation/**/*.ts",
        "apps/ui/src/features/annotation/**/*.tsx"
      ],
      "rules": { "langwatch/logical-statement-spacing": "error" }
    },

    // ------------------------------------------------------------------
    // DEBT REGISTER, langwatch/boolean-wall, packages/architecture-enforcer/src
    // only. logical-statement-spacing (the sibling rule in the override
    // above) auto-fixes cleanly and carries no register.
    //
    // Measured 2026-09-06: 48 boolean walls over 9 files, mostly TS-AST
    // predicate helpers (isPropertyName, isBindingName, unwrap, and
    // similar) that return one long && / || chain directly. Splitting
    // each into named intermediate predicates is real refactoring, not a
    // rename, so the 9 files are held here rather than switched off
    // package-wide. The register can only shrink: name a predicate and
    // delete the file's line.
    // ------------------------------------------------------------------
    {
      "files": [
        "packages/architecture-enforcer/src/policies/api-transport.ts",
        "packages/architecture-enforcer/src/policies/global-app-access.ts",
        "packages/architecture-enforcer/src/policies/frontend/frontend-ui-boundaries.ts",
        "packages/architecture-enforcer/src/policies/quality/service-projection-boundaries.ts",
        "packages/architecture-enforcer/src/tools/check-feature-parity.ts",
        "packages/architecture-enforcer/src/tools/test-colocation.ts",
        "packages/architecture-enforcer/src/policies/test-quality.ts",
        "packages/architecture-enforcer/src/policies/feature-layout.ts",
        "packages/architecture-enforcer/src/policies/api-transport.ts"
      ],
      "rules": { "langwatch/boolean-wall": "off" }
    },
    // ------------------------------------------------------------------
    // COGNITIVE COMPLEXITY, CONDITION SHAPE, NESTED TERNARIES. Every function
    // is held to max 15 cognitive complexity; every condition test must stay
    // readable (see langwatch/condition-shape); no ternary may nest inside
    // another. All three rules are `langwatch/*` plugin rules, so unlike
    // max-depth/complexity above they consult
    // packages/architecture-enforcer/src/oxlint-baseline.json directly and report
    // nothing for a baselined file -- no override needed here. Existing debt
    // is recorded in that file (rule|file, with a measured date); add a file
    // there to exempt it, or fix it and delete its line.
    // ------------------------------------------------------------------
    // A component is held to 20 rather than 15, because JSX scores higher for
    // the same reading effort: every `&&` guard and ternary in a tree counts
    // as a branch, though it renders flat beside what it produces.
    //
    // Measured 2026-09-14 over 11,611 scored functions in modules, apps/ui and
    // packages/design-system. Both file kinds have a median of 4, so this is a
    // tail effect, not a shift: .ts reaches p95 at 12 and p99 at 18, while .tsx
    // reaches 14 and 24. At one shared max of 15, 1.40% of .ts functions
    // report against 1.96% of .tsx -- the same line catching half again as
    // much of the component tree. Parity lands at 19; 20 is the round number
    // beside it and leaves .tsx a hair looser, at 1.29%.
    //
    // This is a threshold, not an exemption: the 35 components still above 20
    // are genuinely complex and stay reported.
    {
      "files": ["**/*.tsx"],
      "rules": {
        "langwatch/cognitive-complexity": ["error", { "max": 20 }]
      }
    },
    // Test files are held to 40 -- a table-driven suite branches more than a
    // service method -- and the 23 that sit above it are registered below.
    // This entry follows the .tsx one on purpose: later entries win, so a
    // component test keeps 40 rather than dropping to the component limit.
    {
      "files": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "langwatch/cognitive-complexity": ["error", { "max": 40 }]
      }
    }
  ]
}
