{
  "name": "@langwatch/architecture-enforcer",
  "version": "0.1.0",
  "private": true,
  "description": "Executable package-boundary policies for the LangWatch monorepo.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "node --disable-warning=ExperimentalWarning --experimental-transform-types src/cli.ts --root ../..",
    "review:test-quality": "node --disable-warning=ExperimentalWarning --experimental-transform-types src/cli.ts --root ../.. --review-test-quality",
    "typecheck": "pnpm -w exec tsc -b packages/architecture-enforcer",
    "test": "vitest run",
    "check:feature-parity": "node --experimental-transform-types src/tools/check-feature-parity.ts",
    "docs": "node src/lint-rules-doc.mjs",
    "docs:check": "node src/lint-rules-doc.mjs --check"
  },
  "dependencies": {
    "@langwatch/oxlint-rules": "workspace:*",
    "@langwatch/time": "workspace:*",
    "typescript": "catalog:sdk-toolchain",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/dev-scripts": "workspace:*",
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "js-yaml": "catalog:",
    "oxlint": "catalog:",
    "vitest": "catalog:"
  }
}
