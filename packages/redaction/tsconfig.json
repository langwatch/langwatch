{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "ESNext",
    "lib": ["ES2023", "DOM"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": "src",
    "types": ["node"],
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",

  },
  "include": ["src/**/*"],

  "references": [
    {
      "path": "tsconfig.build.json"
    }
  ]
