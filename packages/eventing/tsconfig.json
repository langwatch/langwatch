{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "noEmit": true,
    "lib": ["es2022"],
    "noUncheckedIndexedAccess": true,
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "verbatimModuleSyntax": true,

    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**", "src/**/*.test.ts"],
  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "../group-queue/tsconfig.build.json"
    },
    {
      "path": "../handled-error/tsconfig.build.json"
    },
    {
      "path": "../observability/tsconfig.build.json"
    },
    {
      "path": "../prisma-client/tsconfig.build.json"
    },
    {
      "path": "../time/tsconfig.build.json"
    },
    {
      "path": "../test-harness/tsconfig.build.json"
    }
  ]
}
