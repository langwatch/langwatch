{
  "name": "@langwatch/eventing",
  "version": "0.1.0",
  "private": true,
  "description": "Event, aggregate, pipeline, projection, subscriber, process-manager, and replay contracts for LangWatch event-driven systems.",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./src/server/index.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@langwatch/group-queue": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/ksuid": "catalog:",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "croner": "catalog:",
    "ioredis": "catalog:",
    "langwatch": "workspace:*",
    "nanoid": "^6.0.0",
    "prom-client": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/test-harness": "workspace:*",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
