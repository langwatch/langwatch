{
  "extends": ["./tsconfig.json", "../../tsconfig.emit.json"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@langwatch/eventing": ["./src/index.ts"]
    }
  },
  "files": [
    "./src/index.ts",
    "./src/testing.ts",
    "./src/server/index.ts",
    "src/services/__tests__/testHelpers.ts"
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../../sdks/typescript"
    },
    {
      "path": "../time/tsconfig.build.json"
    },
    {
      "path": "../prisma-client/tsconfig.build.json"
    },
    {
      "path": "../observability/tsconfig.build.json"
    },
    {
      "path": "../ksuid/tsconfig.build.json"
    },
    {
      "path": "../handled-error/tsconfig.build.json"
    },
    {
      "path": "../group-queue/tsconfig.build.json"
    },
    {
      "path": "../authorization/tsconfig.build.json"
    },
    {
      "path": "../clickhouse-client/tsconfig.build.json"
    }
  ],
  // Dependencies the build does not import get no reference; tsconfig.test.json holds test-only ones (tsconfig-shape-codemod).
  "nx": {
    "sync": {
      "ignoredDependencies": ["@langwatch/test-harness", "@langwatch/vitest-config"]
    }
  }
}
