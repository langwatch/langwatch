{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "outDir": "dist",

    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/enterprise.tsbuildinfo",
    // The catalogue imports a feature id from each of the nine enterprise
    // contracts, which pulls those packages' sources into this program. They
    // declare `dom` themselves and use the web-standard globals it supplies
    // (`URL` in the SSO path gate, `AbortSignal` on the governance puller), so
    // checking them under a narrower lib than they were written against
    // reported errors their own typecheck does not have. Still no "types":
    // nothing here may reach for `node:*`.
    "lib": ["es2022", "dom"],
    "types": [],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,

    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "features/billing/contract/tsconfig.build.json"
    },
    {
      "path": "features/governance/contract/tsconfig.build.json"
    },
    {
      "path": "features/licensing/contract/tsconfig.build.json"
    },
    {
      "path": "features/managed-provider/contract/tsconfig.build.json"
    },
    {
      "path": "features/saas/contract/tsconfig.build.json"
    },
    {
      "path": "features/scim/contract/tsconfig.build.json"
    },
    {
      "path": "features/sso/contract/tsconfig.build.json"
    }
  ]
}
