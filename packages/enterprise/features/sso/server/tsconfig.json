{
  "extends": "../../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "src",
    "outDir": "dist",

    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,

    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "../../../../api/tsconfig.build.json"
    },
    {
      "path": "../../../../features/auth/contract/tsconfig.build.json"
    },
    {
      "path": "../../licensing/contract/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../../../features/entitlement/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../features/ops/contract/tsconfig.build.json"
    }
  ]
}
