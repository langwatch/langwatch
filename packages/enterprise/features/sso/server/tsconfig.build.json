{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "files": ["./src/index.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../../../../api/tsconfig.build.json"
    },
    {
      "path": "../../licensing/contract/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../../../features/entitlement/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../features/ops/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../features/audit-log/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../features/user/contract/tsconfig.build.json"
    },
    {
      "path": "../../../../runtime-composition/tsconfig.build.json"
    }
  ]
}
