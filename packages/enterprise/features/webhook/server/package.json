{
  "name": "@langwatch/enterprise-webhook-server",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side LangWatch Enterprise webhook endpoint and delivery services.",
  "license": "SEE LICENSE IN ../../../LICENSE.md",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#*": {
      "types": {
        "langwatch-declarations": "./dist/*.d.ts",
        "default": "./src/*.ts"
      },
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": {
        "langwatch-declarations": "./dist/index.d.ts",
        "default": "./src/index.ts"
      },
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1080.0",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/aws-client": "workspace:*",
    "@langwatch/egress": "workspace:*",
    "@langwatch/enterprise-webhook-contract": "workspace:*",
    "@langwatch/entitlement-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/gateway-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@trpc/server": "^11.18.0",
    "hono": "^4.12.27",
    "hono-openapi": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clickhouse/client": "^1.23.0",
    "@langwatch/test-harness": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
