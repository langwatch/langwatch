{
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/enterprise-webhook-server.tsbuildinfo",
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@langwatch/enterprise-webhook-contract": ["../contract/src/index.ts"],
      "@langwatch/handled-error": ["../../../../handled-error/src/index.ts"],
      "@langwatch/prisma-client/generated": ["../../../../prisma-client/src/generated/client.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
