{
  "name": "@langwatch/enterprise-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise worker runtime composition.",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./governance/spend-spike-anomaly.worker": {
      "types": "./dist/governance/spend-spike-anomaly.worker.d.ts",
      "default": "./src/governance/spend-spike-anomaly.worker.ts"
    },
    "./governance/ingestion-pull-host": {
      "types": "./dist/governance/governance-ingestion-pull.host.d.ts",
      "default": "./src/governance/governance-ingestion-pull.host.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project packages/enterprise/composition/worker/tsconfig.json && tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1080.0",
    "@langwatch/audit-log-contract": "workspace:*",
    "@langwatch/enterprise": "workspace:*",
    "@langwatch/enterprise-api": "workspace:*",
    "@langwatch/enterprise-audit-log-server": "workspace:*",
    "@langwatch/enterprise-governance-server": "workspace:*",
    "@langwatch/enterprise-managed-provider-contract": "workspace:*",
    "@langwatch/enterprise-managed-provider-server": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/feature-flag-contract": "workspace:*",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@langwatch/runtime-composition": "workspace:*",
    "@langwatch/time": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
