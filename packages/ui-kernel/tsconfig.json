{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "verbatimModuleSyntax": true,

    "noEmit": true,

    "rootDir": ".",

    "outDir": "dist",

    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["tests/**/*.ts", "**/__tests__/**"],

  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "../browser-host/tsconfig.build.json"
    },
    {
      "path": "../config/tsconfig.build.json"
    },
    {
      "path": "../design-system/tsconfig.build.json"
    },
    {
      "path": "../../modules/auth/browser/tsconfig.build.json"
    },
    {
      "path": "../vitest-config/tsconfig.build.json"
    }
  ]
}
