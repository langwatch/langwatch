{
  "name": "@langwatch/ui-kernel",
  "version": "0.1.0",
  "private": true,
  "description": "Compiler-checked browser module supply and boot-time configuration validation.",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./supply": {
      "types": "./dist/ui-supply.d.ts",
      "default": "./src/ui-supply.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.test.json tsconfig.type-tests.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/config": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
