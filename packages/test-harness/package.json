{
  "name": "@langwatch/test-harness",
  "version": "0.1.0",
  "private": true,
  "description": "The test harness every LangWatch process shares: which lane a test file belongs in, how a shard is weighted, the one TypeScript compiler session a static scan runs through, and the datastores an integration suite is handed.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    "./trpc-members": {
      "types": "./dist/trpc-members/index.d.ts",
      "default": "./src/trpc-members/index.ts"
    },
    "./client-doubles/clickhouse": {
      "types": "./dist/client-doubles/clickhouse.double.d.ts",
      "default": "./src/client-doubles/clickhouse.double.ts"
    },
    "./client-doubles/prisma": {
      "types": "./dist/client-doubles/prisma.double.d.ts",
      "default": "./src/client-doubles/prisma.double.ts"
    },
    "./client-doubles/redis": {
      "types": "./dist/client-doubles/redis.double.d.ts",
      "default": "./src/client-doubles/redis.double.ts"
    },
    "./client-doubles/stripe": {
      "types": "./dist/client-doubles/stripe.double.d.ts",
      "default": "./src/client-doubles/stripe.double.ts"
    },
    "./nlpgo": {
      "types": "./dist/nlpgo.d.ts",
      "default": "./src/nlpgo.ts"
    },
    "./prisma": {
      "types": "./dist/cleanup-test-rows.d.ts",
      "default": "./src/cleanup-test-rows.ts"
    },
    "./api-fixture": {
      "types": "./dist/api-fixture/index.d.ts",
      "default": "./src/api-fixture/index.ts"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@clickhouse/client": "catalog:",
    "@langwatch/api": "workspace:*",
    "@langwatch/clickhouse-client": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/vitest-config": "workspace:*",
    "ioredis": "catalog:",
    "nanoid": "catalog:",
    "picomatch": "^4.0.4",
    "pino": "catalog:",
    "stripe": "^15.12.0",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/picomatch": "^4.0.2",
    "vitest": "catalog:"
  }
}
