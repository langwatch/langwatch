{
  "name": "@langwatch/observability",
  "version": "0.0.1",
  "private": true,
  "description": "Logging, context propagation, and OpenTelemetry utilities for LangWatch services",
  "keywords": [
    "langwatch",
    "logging",
    "observability",
    "opentelemetry"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./context": "./src/context/index.ts",
    "./node": "./src/node/index.ts",
    "./request": "./src/request/requestLogging.ts",
    "./tracing": "./src/trace/traceContext.ts",
    "./metrics": "./src/metrics/index.ts",
    "./metrics/testing": "./src/metrics/testing.ts",
    "./grafana-links": "./src/trace/grafana-links.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/host-metrics": "^0.39.0",
    "@opentelemetry/otlp-exporter-base": "0.221.0",
    "@opentelemetry/otlp-transformer-telemetry": "npm:@opentelemetry/otlp-transformer@0.221.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "langwatch": "workspace:*",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^4.0.2",
    "pino-pretty": "^13.1.3",
    "superjson": "^2.2.6"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@pyroscope/nodejs": "0.6.2",
    "@types/node": "^26.0.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.24.0"
}
