{
  "name": "@langwatch/observability",
  "version": "0.0.1",
  "private": true,
  "description": "Logging, context propagation, and OpenTelemetry utilities for LangWatch services",
  "keywords": [
    "langwatch",
    "logging",
    "observability",
    "opentelemetry"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./src/constants.ts"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "default": "./src/context/index.ts"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./src/node/index.ts"
    },
    "./request": {
      "types": "./dist/request/requestLogging.d.ts",
      "default": "./src/request/requestLogging.ts"
    },
    "./tracing": {
      "types": "./dist/trace/traceContext.d.ts",
      "default": "./src/trace/traceContext.ts"
    },
    "./metrics": {
      "types": "./dist/metrics/index.d.ts",
      "default": "./src/metrics/index.ts"
    },
    "./metrics/testing": {
      "types": "./dist/metrics/testing.d.ts",
      "default": "./src/metrics/testing.ts"
    },
    "./grafana-links": {
      "types": "./dist/trace/grafana-links.d.ts",
      "default": "./src/trace/grafana-links.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/host-metrics": "^0.39.0",
    "@opentelemetry/otlp-exporter-base": "0.221.0",
    "@opentelemetry/otlp-transformer-telemetry": "npm:@opentelemetry/otlp-transformer@0.221.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "langwatch": "workspace:*",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^4.0.2",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@pyroscope/nodejs": "0.6.2",
    "@types/node": "^26.0.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.24.0"
}
