{
  "name": "@langwatch/observability",
  "version": "0.0.1",
  "private": true,
  "description": "Logging, context propagation, and OpenTelemetry utilities for LangWatch services",
  "keywords": [
    "langwatch",
    "logging",
    "observability",
    "opentelemetry"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./context": "./src/context/index.ts",
    "./request": "./src/request/requestLogging.ts",
    "./tracing": "./src/trace/traceContext.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^4.0.2",
    "pino-pretty": "^13.1.3",
    "superjson": "^2.2.6"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.24.0"
}
