{
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    // `dom` for the `URL` parser the docs-origin allowlist in
    // `read-handled-error` is built on, and `es2022` for `Object.hasOwn`, which
    // is how the presentation registry looks a code up without inheriting from
    // the prototype chain. Both are universal JavaScript rather than a browser
    // affordance; this package still imports nothing from either runtime.
    "lib": ["es2022", "dom"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/handled-error.tsbuildinfo",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  // Tests run via vitest (`pnpm test`), which provides the `vitest` module and
  // its types at runtime; the declaration build must not require them.
  "exclude": ["src/**/*.test.ts"]
}
