{
  "name": "@langwatch/handled-error",
  "version": "0.1.0",
  "private": true,
  "description": "The shared handled-error contract: HandledError base class, serialized wire shapes, the Go herr envelope adapter, the enumerated app codes and the code-keyed client presentation registry. Used by the LangWatch app, MCP server, CLI, and SDKs.",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./app-codes": {
      "types": "./dist/app-codes.d.ts",
      "default": "./src/app-codes.ts"
    },
    "./docs-url": {
      "types": "./dist/docs-url.d.ts",
      "default": "./src/docs-url.ts"
    },
    "./is-server-unreachable": {
      "types": "./dist/is-server-unreachable.d.ts",
      "default": "./src/is-server-unreachable.ts"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "default": "./src/presentation.ts"
    },
    "./read-handled-error": {
      "types": "./dist/read-handled-error.d.ts",
      "default": "./src/read-handled-error.ts"
    },
    "./views": {
      "types": "./dist/views.d.ts",
      "default": "./src/views.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
