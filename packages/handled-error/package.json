{
  "name": "@langwatch/handled-error",
  "version": "0.1.0",
  "private": true,
  "description": "The handled-error machinery: the HandledError base class, its subclasses, the serialized wire shapes and the Go herr envelope adapter, the enumerated app error codes and the code-keyed customer presentation registry.",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./langwatch-handled-error": {
      "types": "./dist/langwatch-handled-error.d.ts",
      "default": "./src/langwatch-handled-error.ts"
    },
    "./is-server-unreachable": {
      "types": "./dist/is-server-unreachable.d.ts",
      "default": "./src/is-server-unreachable.ts"
    },
    "./app-codes": {
      "types": "./dist/app-codes.d.ts",
      "default": "./src/app-codes.ts"
    },
    "./docs-url": {
      "types": "./dist/docs-url.d.ts",
      "default": "./src/docs-url.ts"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "default": "./src/presentation.ts"
    },
    "./read-handled-error": {
      "types": "./dist/read-handled-error.d.ts",
      "default": "./src/read-handled-error.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/time": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
