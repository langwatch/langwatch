{
  "name": "@langwatch/vitest-config",
  "version": "0.1.0",
  "private": true,
  "description": "The one vitest shape every LangWatch package declares: the jsdom/node builder, the real-browser lane, and the console guard a unit suite sets up. It also configures the test process's logger as its boot seam, so observability and time, beneath it, keep plain vitest configs.",
  "keywords": [
    "config",
    "langwatch",
    "vitest"
  ],
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./dist/vitest-browser-config.d.ts",
      "default": "./src/vitest-browser-config.ts"
    },
    "./console-guard": {
      "types": "./dist/console-guard.d.ts",
      "default": "./src/console-guard.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@vitest/browser-playwright": "^5.0.1",
    "playwright": "*",
    "vitest": "^5.0.1"
  },
  "peerDependenciesMeta": {
    "@vitest/browser-playwright": {
      "optional": true
    },
    "playwright": {
      "optional": true
    }
  }
}
