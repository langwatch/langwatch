{
  // The generated list, and nothing else.
  //
  // It needed a home that type-checks: nothing imported it, so a renamed export
  // in any module package would have gone unnoticed until a process failed to
  // boot. A tsconfig alone could not be that home, because every project this
  // repository checks is reached through a package's own `typecheck` script,
  // and because resolving a module package needs the dependency edges pnpm
  // links from a package.json. So this directory is the package.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": [],
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "verbatimModuleSyntax": true,
    "rootDir": "src"
  },
  "include": ["src/*.generated.ts"],
  "references": [
