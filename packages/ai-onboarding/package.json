		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@types/node": "^26.0.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9",
		"zod": "^3.25.76"
	}
