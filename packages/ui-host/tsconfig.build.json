{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "files": [
    "./src/index.ts",
    "./src/compat/next-dynamic.ts",
    "./src/slots.tsx",
    "./src/capabilities.ts",
    "./src/use-router.ts",
    "./src/toaster.ts",
    "./src/storage.ts",
    "./src/errors.ts",
    "./src/query-retry.ts",
    "./src/testing.ts",
    "./src/link.tsx",
    "./src/use-drawer.ts",
    "./src/upgrade-modal-store.ts",
    "./src/use-organization-team-project.ts",
    "./src/format-time-ago.ts"
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../enterprise/features/licensing/contract/tsconfig.build.json"
    },
    {
      "path": "../handled-error/tsconfig.build.json"
    },
    {
      "path": "../time/tsconfig.build.json"
    },
    {
      "path": "../ui-drawer/tsconfig.build.json"
    }
  ]
}
