{
  "name": "@langwatch/ui-host",
  "version": "0.1.0",
  "private": true,
  "description": "The framework-shaped adapters a feature-web package asks its composing application for, instead of reaching the router, a toast singleton or session storage directly.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./compat/next-dynamic": {
      "types": "./dist/compat/next-dynamic.d.ts",
      "default": "./src/compat/next-dynamic.ts"
    },
    "./slots": {
      "types": "./dist/slots.d.ts",
      "default": "./src/slots.tsx"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "default": "./src/capabilities.ts"
    },
    "./use-router": {
      "types": "./dist/use-router.d.ts",
      "default": "./src/use-router.ts"
    },
    "./toaster": {
      "types": "./dist/toaster.d.ts",
      "default": "./src/toaster.ts"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./src/storage.ts"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./src/errors.ts"
    },
    "./query-retry": {
      "types": "./dist/query-retry.d.ts",
      "default": "./src/query-retry.ts"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "default": "./src/link.tsx"
    },
    "./use-drawer": {
      "types": "./dist/use-drawer.d.ts",
      "default": "./src/use-drawer.ts"
    },
    "./upgrade-modal-store": {
      "types": "./dist/upgrade-modal-store.d.ts",
      "default": "./src/upgrade-modal-store.ts"
    },
    "./use-organization-team-project": {
      "types": "./dist/use-organization-team-project.d.ts",
      "default": "./src/use-organization-team-project.ts"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./src/session.ts"
    },
    "./format-time-ago": {
      "types": "./dist/format-time-ago.d.ts",
      "default": "./src/format-time-ago.ts"
    },
    "./feature-flag": {
      "types": "./dist/feature-flag.d.ts",
      "default": "./src/feature-flag.ts"
    },
    "./period-selector": {
      "types": "./dist/period-selector.d.ts",
      "default": "./src/period-selector.tsx"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "default": "./src/markdown/index.tsx"
    },
    "./isolated-error-boundary": {
      "types": "./dist/isolated-error-boundary.d.ts",
      "default": "./src/isolated-error-boundary.tsx"
    },
    "./copy-button": {
      "types": "./dist/copy-button.d.ts",
      "default": "./src/copy-button.tsx"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@chakra-ui/react": "catalog:",
    "@langwatch/api-client-web": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/enterprise-licensing-contract": "workspace:*",
    "@langwatch/feature-flag-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/ui-drawer": "workspace:*",
    "lucide-react": "catalog:",
    "react-error-boundary": "catalog:",
    "react-feather": "catalog:",
    "react-icons": "catalog:",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@emotion/react": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
