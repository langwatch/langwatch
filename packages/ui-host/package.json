{
  "name": "@langwatch/ui-host",
  "version": "0.1.0",
  "private": true,
  "description": "The framework-shaped adapters a feature-web package asks its composing application for, instead of reaching the router, a toast singleton or session storage directly.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./compat/next-dynamic": {
      "types": "./src/compat/next-dynamic.ts",
      "default": "./src/compat/next-dynamic.ts"
    },
    "./capabilities": {
      "types": "./src/capabilities.ts",
      "default": "./src/capabilities.ts"
    },
    "./use-router": {
      "types": "./src/use-router.ts",
      "default": "./src/use-router.ts"
    },
    "./toaster": {
      "types": "./src/toaster.ts",
      "default": "./src/toaster.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./link": {
      "types": "./src/link.tsx",
      "default": "./src/link.tsx"
    },
    "./use-drawer": {
      "types": "./src/use-drawer.ts",
      "default": "./src/use-drawer.ts"
    },
    "./upgrade-modal-store": {
      "types": "./src/upgrade-modal-store.ts",
      "default": "./src/upgrade-modal-store.ts"
    },
    "./use-organization-team-project": {
      "types": "./src/use-organization-team-project.ts",
      "default": "./src/use-organization-team-project.ts"
    },
    "./format-time-ago": {
      "types": "./src/format-time-ago.ts",
      "default": "./src/format-time-ago.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@langwatch/enterprise-licensing-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/ui-drawer": "workspace:*",
    "date-fns": "^4.4.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
