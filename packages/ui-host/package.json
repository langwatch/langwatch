{
  "name": "@langwatch/ui-host",
  "version": "0.1.0",
  "private": true,
  "description": "The framework-shaped adapters a feature-web package asks its composing application for, instead of reaching the router, a toast singleton or session storage directly.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./compat/next-dynamic": {
      "types": "./dist/compat/next-dynamic.d.ts",
      "default": "./src/compat/next-dynamic.ts"
    },
    "./slots": {
      "types": "./dist/slots.d.ts",
      "default": "./src/slots.tsx"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "default": "./src/capabilities.ts"
    },
    "./use-router": {
      "types": "./dist/use-router.d.ts",
      "default": "./src/use-router.ts"
    },
    "./toaster": {
      "types": "./dist/toaster.d.ts",
      "default": "./src/toaster.ts"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./src/storage.ts"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./src/errors.ts"
    },
    "./query-retry": {
      "types": "./dist/query-retry.d.ts",
      "default": "./src/query-retry.ts"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "default": "./src/link.tsx"
    },
    "./use-drawer": {
      "types": "./dist/use-drawer.d.ts",
      "default": "./src/use-drawer.ts"
    },
    "./upgrade-modal-store": {
      "types": "./dist/upgrade-modal-store.d.ts",
      "default": "./src/upgrade-modal-store.ts"
    },
    "./use-organization-team-project": {
      "types": "./dist/use-organization-team-project.d.ts",
      "default": "./src/use-organization-team-project.ts"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./src/session.ts"
    },
    "./format-time-ago": {
      "types": "./dist/format-time-ago.d.ts",
      "default": "./src/format-time-ago.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project packages/ui-host/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@langwatch/enterprise-licensing-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/ui-drawer": "workspace:*",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
