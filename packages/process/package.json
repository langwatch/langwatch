{
  "name": "@langwatch/process",
  "version": "0.1.0",
  "private": true,
  "description": "Process composition: boot, supply, transport selection and lifecycle for API, worker and tasks applications.",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./nlp-internal-secret": {
      "types": "./dist/nlp-internal-secret.d.ts",
      "default": "./src/nlp-internal-secret.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.test.json tsconfig.type-tests.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/authorization": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/module": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/ops-contract": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/process-stores": "workspace:*",
    "@langwatch/secrets": "workspace:*",
    "@trpc/server": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/time": "workspace:*",
    "@langwatch/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
