{
  "name": "@langwatch/process",
  "version": "0.1.0",
  "private": true,
  "description": "Process composition: boot, supply, transport selection and lifecycle for API, worker and tasks applications.",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    },
    "./observability-owner": {
      "types": "./dist/observability-owner.d.ts",
      "default": "./src/observability-owner.ts"
    },
    "./nlp-internal-secret": {
      "types": "./dist/nlp-internal-secret.d.ts",
      "default": "./src/nlp-internal-secret.ts"
    },
    "./backend-host": {
      "types": "./dist/lifecycle/backend-host.d.ts",
      "default": "./src/lifecycle/backend-host.ts"
    },
    "./liveness-thread": {
      "types": "./dist/lifecycle/liveness-thread.d.ts",
      "default": "./src/lifecycle/liveness-thread.ts"
    },
    "./not-handled": {
      "types": "./dist/lifecycle/not-handled.d.ts",
      "default": "./src/lifecycle/not-handled.ts"
    },
    "./process-globals": {
      "types": "./dist/process-globals.d.ts",
      "default": "./src/process-globals.ts"
    }
  },
  "scripts": {
    "typecheck": "GOMAXPROCS=2 GOMEMLIMIT=2GiB tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/authorization": "workspace:*",
    "@langwatch/clickhouse-client": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/ksuid": "workspace:*",
    "@langwatch/module": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/process-stores": "workspace:*",
    "@langwatch/secrets": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@trpc/server": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/test-harness": "workspace:*",
    "@langwatch/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "langwatch": {
    "group": "framework"
  }
}
