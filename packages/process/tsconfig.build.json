{
  "extends": ["./tsconfig.json", "../../tsconfig.emit.json"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@langwatch/process": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["**/__tests__/**", "**/__mocks__/**", "**/tests/**", "**/*.test.*", "**/*.spec.*"],
  "references": [
    {
      "path": "../secrets/tsconfig.build.json"
    },
    {
      "path": "../process-stores/tsconfig.build.json"
    },
    {
      "path": "../prisma-client/tsconfig.build.json"
    },
    {
      "path": "../observability/tsconfig.build.json"
    },
    {
      "path": "../module/tsconfig.build.json"
    },
    {
      "path": "../ksuid/tsconfig.build.json"
    },
    {
      "path": "../handled-error/tsconfig.build.json"
    },
    {
      "path": "../eventing/tsconfig.build.json"
    },
    {
      "path": "../config/tsconfig.build.json"
    },
    {
      "path": "../authorization/tsconfig.build.json"
    },
    {
      "path": "../api/tsconfig.build.json"
    },
    {
      "path": "../time/tsconfig.build.json"
    },
    {
      "path": "../test-harness/tsconfig.build.json"
    }
  ],
  // Workspace dependencies no source or test file imports get no reference (tsconfig-shape-codemod).
  "nx": {
    "sync": {
      "ignoredDependencies": ["@langwatch/vitest-config"]
    }
  }
}
