{
  "name": "@langwatch/redis-client",
  "version": "0.1.0",
  "private": true,
  "description": "The shared Redis client contract: configuration resolved from a supplied environment, standalone and cluster connection construction with TLS and database-index handling, and a readiness probe the caller owns - with no connection opened as an import side effect.",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    "./session-state": {
      "types": "./dist/session-state.d.ts",
      "default": "./src/session-state.ts"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/time": "workspace:*",
    "ioredis": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
