{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020"],
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/system-migrations.tsbuildinfo",
    // Consumers import the TypeScript sources directly (see the package's
    // `exports`), so this project only ever type-checks - nothing is built.
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  // Tests are checked by tsconfig.test.json, which adds the vitest globals
  // this project does not need.
  "exclude": ["src/__tests__/**"]
}
