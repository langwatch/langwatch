{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "tsBuildInfoFile": "dist/tsconfig.test.tsbuildinfo"
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__mocks__/**/*.ts",
    "src/**/tests/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.test.*.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.*.ts",
    "src/**/*.stories.ts",
    "src/**/*.stories.*.ts",
    "src/**/*.bench.ts",
    "src/**/*.bench.*.ts",
    "src/**/__bench__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/**/__mocks__/**/*.tsx",
    "src/**/tests/**/*.tsx",
    "src/**/*.test.tsx",
    "src/**/*.test.*.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.spec.*.tsx",
    "src/**/*.stories.tsx",
    "src/**/*.stories.*.tsx",
    "src/**/*.bench.tsx",
    "src/**/*.bench.*.tsx",
    "src/**/__bench__/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],
  "references": [
    {
      "path": "./tsconfig.build.json"
    },
    {
      "path": "../design-system-internal/tsconfig.build.json"
    }
  ]
}
