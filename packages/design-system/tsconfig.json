{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "types": ["vite/client"],
    "verbatimModuleSyntax": true,

    "rootDir": ".",

    "outDir": "dist"
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "stories/**/*.ts",
    "stories/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ],

  "references": [
    {
      "path": "tsconfig.build.json"
    }
  ]
}
