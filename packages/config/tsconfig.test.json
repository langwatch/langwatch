{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "tsBuildInfoFile": "dist/tsconfig.test.tsbuildinfo",
    "composite": false
  },
  // The suite, plus the sources it exercises. `node:fs` compiles here and
  // nowhere else: the browser-graph guard has to read its subjects off disk,
  // while the config itself must stay loadable by a browser.
  "include": ["src/**/__tests__/**/*.ts"],

  "references": [
    {
      "path": "./tsconfig.build.json"
    }
  ]
}
