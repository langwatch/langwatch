{
  "name": "@langwatch/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared runtime configuration parsing and validation conventions.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./docs-url": {
      "types": "./src/docs-url.ts",
      "default": "./src/docs-url.ts"
    },
    "./public-app-config": {
      "types": "./src/public-app-config.ts",
      "default": "./src/public-app-config.ts"
    },
    "./public-app-config/projection": {
      "types": "./src/public-app-config.projection.ts",
      "default": "./src/public-app-config.projection.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/plans": "workspace:*",
    "@langwatch/secrets": "workspace:*",
    "zod": "catalog:",
    "zod-validation-error": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
