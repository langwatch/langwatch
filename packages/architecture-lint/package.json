{
  "name": "@langwatch/architecture-lint",
  "version": "0.1.0",
  "private": true,
  "description": "Executable package-boundary policies for the LangWatch monorepo.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "tsx src/cli.ts --root ../.. --no-declarations --no-legacy-application-migration",
    "lint:declarations": "tsx src/cli.ts --root ../.. --no-legacy-application-migration",
    "lint:migration": "tsx src/cli.ts --root ../.. --no-declarations",
    "rename-package": "tsx src/rename-workspace-package.cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "oxlint": "^1.78.0",
    "tsx": "^4.22.4",
    "vitest": "^4.1.9"
  }
}
