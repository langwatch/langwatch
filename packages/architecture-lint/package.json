{
  "name": "@langwatch/architecture-lint",
  "version": "0.1.0",
  "private": true,
  "description": "Executable package-boundary policies for the LangWatch monorepo.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "node --experimental-transform-types src/cli.ts --root ../.. --no-declarations --no-legacy-application-migration",
    "lint:declarations": "node --experimental-transform-types src/cli.ts --root ../.. --no-legacy-application-migration",
    "lint:migration": "node --experimental-transform-types src/cli.ts --root ../.. --no-declarations",
    "review:comment-blocks": "node --experimental-transform-types src/cli.ts --root ../.. --no-declarations --no-legacy-application-migration --review-comment-blocks --all-comment-blocks",
    "review:test-quality": "node --experimental-transform-types src/cli.ts --root ../.. --review-test-quality",
    "rename-package": "node --experimental-transform-types src/rename-workspace-package.cli.ts",
    "rename-feature-sources": "node --experimental-transform-types src/rename-feature-sources.cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "colocate-tests": "node --experimental-transform-types src/colocate-tests.cli.ts",
    "check:ts-budget": "node --experimental-transform-types src/declaration-budget.cli.ts --root ../..",
    "check:feature-parity": "node --experimental-transform-types src/check-feature-parity.ts",
    "docs": "node src/lint-rules-doc.mjs"
  },
  "dependencies": {
    "@langwatch/lint-core": "workspace:*",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.1",
    "js-yaml": "^5.2.0",
    "oxlint": "^1.78.0",
    "vitest": "^5.0.0"
  }
}
