  "compilerOptions": {
    "noEmit": true,
    "rootDir": "src",
    "outDir": "dist",

    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "lib": ["es2022", "dom"],
    "paths": {
      "zod": ["../../../../node_modules/.pnpm/zod@4.4.3/node_modules/zod"]
