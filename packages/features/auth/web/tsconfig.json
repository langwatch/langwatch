{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",

    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    // See the same entries in `apps/ui/tsconfig.json`: the checker reads the
    // trimmed browser contract, the bundler still resolves the real package.
    "paths": {
      "better-auth/react": ["../../../../types/browser/better-auth-react.d.ts"],
      "@better-auth/passkey/client": ["../../../../types/browser/better-auth-passkey-client.d.ts"]
    },

    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "vitest.setup.ts"],
  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "../../../api/tsconfig.build.json"
    },
    {
      "path": "../../../design-system/tsconfig.build.json"
    },
    {
      "path": "../../../time/tsconfig.build.json"
    },
    {
      "path": "../../identity/contract/tsconfig.build.json"
    }
  ]
}
