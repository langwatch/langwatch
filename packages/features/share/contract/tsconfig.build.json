{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/share-contract-build.tsbuildinfo",
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**"]
}
