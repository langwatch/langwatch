{
  "name": "@langwatch/metric-server",
  "version": "0.1.0",
  "private": true,
  "description": "Metric ingestion service, event pipeline, and ClickHouse persistence.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project packages/features/metric/server/tsconfig.json && tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.0",
    "@langwatch/data-privacy-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/ksuid": "^2.0.2",
    "@langwatch/metric-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/otlp": "workspace:*",
    "@langwatch/runtime-composition": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/otlp-transformer": "0.55.0",
    "langwatch": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@langwatch/clickhouse-client": "workspace:*",
    "@langwatch/test-harness": "workspace:*",
    "@types/node": "^26.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
