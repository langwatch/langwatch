{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // No "node". The contract is loaded by the browser — the schema browser,
    // the time-window editor and the granularity picker all read the
    // vocabulary from it — so a `node:*` import or a `Buffer` reference must
    // not compile here. Tests are checked by tsconfig.test.json, which
    // supplies the node types the import-free guard needs to read its subject.
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/__tests__/**"]
}
