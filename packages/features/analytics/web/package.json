{
  "name": "@langwatch/analytics-web",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable LangWatchQL workbench, result and visualization browser surfaces.",
  "files": [
    "src",
    "tests"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./analytics-registry": {
      "types": "./src/model/analytics-registry.ts",
      "default": "./src/model/analytics-registry.ts"
    },
    "./chart": {
      "types": "./src/ui/sections/chart.ts",
      "default": "./src/ui/sections/chart.ts"
    },
    "./components/CustomGraph": {
      "types": "./src/ui/sections/custom-graph.tsx",
      "default": "./src/ui/sections/custom-graph.tsx"
    },
    "./components/PeriodSelector": {
      "types": "./src/ui/elements/period-selector.tsx",
      "default": "./src/ui/elements/period-selector.tsx"
    },
    "./components/filters/FilterSidebar": {
      "types": "./src/ui/sections/filters/filter-sidebar.tsx",
      "default": "./src/ui/sections/filters/filter-sidebar.tsx"
    },
    "./components/filters/FilterToggle": {
      "types": "./src/ui/sections/filters/filter-toggle.tsx",
      "default": "./src/ui/sections/filters/filter-toggle.tsx"
    },
    "./hooks/useFilterParams": {
      "types": "./src/ui/sections/use-filter-params.ts",
      "default": "./src/ui/sections/use-filter-params.ts"
    },
    "./screens/analytics": {
      "types": "./src/screens/analytics/index.ts",
      "default": "./src/screens/analytics/index.ts"
    },
    "./server/filters/precondition-matchers": {
      "types": "./src/model/filters/precondition-matchers.ts",
      "default": "./src/model/filters/precondition-matchers.ts"
    },
    "./server/filters/registry": {
      "types": "./src/model/filters/registry.ts",
      "default": "./src/model/filters/registry.ts"
    },
    "./server/filters/types": {
      "types": "./src/model/filters/types.ts",
      "default": "./src/model/filters/types.ts"
    },
    "./testing": {
      "types": "./src/__tests__/lwql-fixtures.ts",
      "default": "./src/__tests__/lwql-fixtures.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:browser": "vitest run -c vitest.browser.config.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@langwatch/analytics-contract": "workspace:*",
    "@langwatch/automation-contract": "workspace:*",
    "@langwatch/dashboard-contract": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/evaluator-contract": "workspace:*",
    "@langwatch/evaluator-web": "workspace:*",
    "@langwatch/platform-api-client": "workspace:*",
    "@langwatch/ui-host": "workspace:*",
    "@langwatch/workflow-web": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.5",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "ajv": "^8.20.0",
    "chakra-react-select": "^6.1.3",
    "date-fns": "^4.1.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.22.0",
    "monaco-editor": "^0.55.1",
    "numeral": "^2.0.6",
    "qs": "^6.15.3",
    "react": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "react-feather": "^2.0.10",
    "react-hook-form": "^7.80.0",
    "react-icons": "^5.7.0",
    "recharts": "^3.9.1",
    "shiki": "^4.3.0",
    "usehooks-ts": "^3.1.1",
    "vega": "6.3.1",
    "vega-embed": "7.1.0",
    "vega-lite": "6.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.0.1",
    "@types/numeral": "^2.0.5",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.9",
    "jsdom": "^30.0.1",
    "playwright": "1.61.1",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
