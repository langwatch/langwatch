{
  "name": "@langwatch/analytics-web",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable LangWatchQL workbench, result and visualization browser surfaces.",
  "files": [
    "src",
    "tests"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./visualization": {
      "types": "./src/visualization/index.ts",
      "default": "./src/visualization/index.ts"
    },
    "./validation": {
      "types": "./src/visualization/validation.ts",
      "default": "./src/visualization/validation.ts"
    },
    "./chart": {
      "types": "./src/chart.ts",
      "default": "./src/chart.ts"
    },
    "./testing": {
      "types": "./tests/lwql-fixtures.ts",
      "default": "./tests/lwql-fixtures.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@langwatch/analytics-contract": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.5",
    "ajv": "^8.20.0",
    "lucide-react": "^1.22.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "vega": "6.3.1",
    "vega-embed": "7.1.0",
    "vega-lite": "6.4.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
