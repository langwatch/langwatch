{
  "name": "@langwatch/analytics-server",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical server-side Analytics timeseries service and ClickHouse composition.",
  "files": [
    "src"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./internal": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.0",
    "@clickhouse/parser": "0.3.0",
    "@langwatch/analytics-contract": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/dashboard-contract": "workspace:*",
    "@langwatch/data-privacy-contract": "workspace:*",
    "@langwatch/evaluation-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/feature-flag-contract": "workspace:*",
    "@langwatch/feature-flag-server": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@langwatch/trace-server": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@trpc/server": "^11.18.0",
    "date-fns": "^4.4.0",
    "hono": "^4.12.27",
    "hono-openapi": "^1.3.1",
    "langwatch": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
