{
  "name": "@langwatch/annotation-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe annotation presentation and row helpers.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/annotations.ts",
  "types": "./dist/annotations.d.ts",
  "exports": {
    "./annotations": {
      "langwatch-declaration-source": "./src/annotations.ts",
      "types": "./dist/annotations.d.ts",
      "default": "./src/annotations.ts"
    },
    "./annotation-scores": {
      "langwatch-declaration-source": "./src/annotation-scores.ts",
      "types": "./dist/annotation-scores.d.ts",
      "default": "./src/annotation-scores.ts"
    },
    "./annotation-form": {
      "langwatch-declaration-source": "./src/annotation-form.ts",
      "types": "./dist/annotation-form.d.ts",
      "default": "./src/annotation-form.ts"
    },
    "./annotation-chips": {
      "langwatch-declaration-source": "./src/annotation-chips.ts",
      "types": "./dist/annotation-chips.d.ts",
      "default": "./src/annotation-chips.ts"
    },
    "./annotation-card": {
      "langwatch-declaration-source": "./src/annotation-card.ts",
      "types": "./dist/annotation-card.d.ts",
      "default": "./src/annotation-card.ts"
    },
    "./testing": {
      "langwatch-declaration-source": "./src/testing.tsx",
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.tsx"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project packages/features/annotation/web/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@langwatch/annotation-contract": "workspace:*",
    "@langwatch/csv": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/organization-web": "workspace:*",
    "@langwatch/platform-api-client": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@langwatch/ui-drawer": "workspace:*",
    "@langwatch/ui-host": "workspace:*",
    "diff": "^9.0.0",
    "lucide-react": "^1.22.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
