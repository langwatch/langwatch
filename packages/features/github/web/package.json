{
  "name": "@langwatch/github-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe GitHub integration: the Integrations settings screen and the install popup ceremony.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./screens/integrations": {
      "types": "./src/screens/integrations/index.ts",
      "default": "./src/screens/integrations/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
