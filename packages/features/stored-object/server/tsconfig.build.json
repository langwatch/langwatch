{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "files": [
    "./src/index.ts",
    "./src/transport/public-rest/stored-object.api.ts",
    "./src/testing.ts",
    "./src/repositories/clickhouse/stored-objects.repository.ts"
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../../../api/tsconfig.build.json"
    },
    {
      "path": "../../authz/contract/tsconfig.build.json"
    },
    {
      "path": "../../../aws-client/tsconfig.build.json"
    },
    {
      "path": "../../dataset/contract/tsconfig.build.json"
    },
    {
      "path": "../../../group-queue/tsconfig.build.json"
    },
    {
      "path": "../../../handled-error/tsconfig.build.json"
    },
    {
      "path": "../../../observability/tsconfig.build.json"
    },
    {
      "path": "../../../prisma-client/tsconfig.build.json"
    },
    {
      "path": "../../../redis-client/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../../system-migrations/tsconfig.build.json"
    },
    {
      "path": "../../../task/tsconfig.build.json"
    },
    {
      "path": "../../../time/tsconfig.build.json"
    }
  ]
}
