{
  "name": "@langwatch/stored-object-server",
  "version": "0.1.0",
  "private": true,
  "description": "Stored Objects service, Postgres store, API, and ClickHouse import.",
  "files": [
    "src"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./storage": {
      "types": "./src/storage.ts",
      "default": "./src/storage.ts"
    },
    "./public-api": {
      "types": "./src/api/public/stored-object.api.ts",
      "default": "./src/api/public/stored-object.api.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1080.0",
    "@azure/identity": "^4.13.1",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/aws-client": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/ksuid": "^2.0.2",
    "@langwatch/observability": "workspace:*",
    "@langwatch/stored-object-contract": "workspace:*",
    "@langwatch/system-migrations": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@trpc/server": "^11.18.0",
    "hono": "^4.12.27",
    "langwatch": "workspace:*",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
