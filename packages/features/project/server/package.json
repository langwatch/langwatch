{
  "name": "@langwatch/project-server",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical server-side project service.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project packages/features/project/server/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/api-key-contract": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/organization-contract": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@langwatch/share-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/topic-contract": "workspace:*",
    "@langwatch/runtime-composition": "workspace:*",
    "@trpc/server": "^11.18.0",
    "hono": "^4.12.27",
    "hono-openapi": "^1.3.1",
    "nanoid": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@langwatch/test-harness": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
