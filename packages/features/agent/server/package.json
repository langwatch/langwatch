{
  "name": "@langwatch/agent-server",
  "version": "0.1.0",
  "private": true,
  "description": "Agents services, private persistence, and transport-neutral API handlers.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./internal-api": {
      "types": "./src/api/internal/agent.api.ts",
      "default": "./src/api/internal/agent.api.ts"
    },
    "./legacy-rest": {
      "types": "./src/api/legacy-rest/agent.api.ts",
      "default": "./src/api/legacy-rest/agent.api.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/agent-contract": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@langwatch/workflow-contract": "workspace:*",
    "@trpc/server": "^11.18.0",
    "hono": "^4.12.27",
    "hono-openapi": "^1.3.1",
    "nanoid": "^6.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
