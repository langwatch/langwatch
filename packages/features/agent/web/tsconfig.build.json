{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "files": [
    "./src/agent-management.ts",
    "./src/connected-agents.ts",
    "./src/agent-http-editor.ts",
    "./src/agent-client.ts",
    "./src/agent-editors.ts"
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    { "path": "../../../handled-error/tsconfig.build.json" },
    { "path": "../../scenario/contract/tsconfig.build.json" },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../../api/tsconfig.build.json"
    },
    {
      "path": "../../../design-system/tsconfig.build.json"
    },
    {
      "path": "../../../time/tsconfig.build.json"
    },
    {
      "path": "../../../ui-host/tsconfig.build.json"
    }
  ]
}
