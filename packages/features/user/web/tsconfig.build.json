{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "files": ["./src/index.ts", "./src/screens/personal-workspace/index.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    { "path": "../../../../dev/tsconfig.web-declarations.json" },
    { "path": "../../authz/contract/tsconfig.build.json" },
    { "path": "../../coding-agent/contract/tsconfig.build.json" },
    { "path": "../../../../dev/tsconfig.web-declarations.json" },
    { "path": "../../../config/tsconfig.build.json" },
    { "path": "../../../design-system/tsconfig.build.json" },
    { "path": "../../gateway/web/tsconfig.build.json" },
    { "path": "../../../handled-error/tsconfig.build.json" },
    { "path": "../../identity/contract/tsconfig.build.json" },
    { "path": "../../model-provider/contract/tsconfig.build.json" },
    { "path": "../../../platform-api-client/tsconfig.build.json" },
    { "path": "../../../time/tsconfig.build.json" }
  ]
