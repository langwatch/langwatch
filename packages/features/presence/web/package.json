{
  "name": "@langwatch/presence-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe collaborative presence stores, hooks and components.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./surfaces/presence-indicators": {
      "types": "./dist/surfaces/presence-indicators.d.ts",
      "default": "./src/surfaces/presence-indicators.ts"
    },
    "./surfaces/presence-state": {
      "types": "./dist/surfaces/presence-state.d.ts",
      "default": "./src/surfaces/presence-state.ts"
    },
    "./surfaces/presence-availability": {
      "types": "./dist/presence-availability.d.ts",
      "default": "./src/presence-availability.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project packages/features/presence/web/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/presence-contract": "workspace:*",
    "react": "^19.2.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
