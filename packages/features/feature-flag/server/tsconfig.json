    "noEmit": true,
    "rootDir": "src",
    "outDir": "dist",

    "lib": ["es2022"],
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
