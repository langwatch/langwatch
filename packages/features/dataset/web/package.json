    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
