{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/automation-web.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@langwatch/authz-contract": ["../../authz/contract/src/index.ts"],
      "@langwatch/dataset-contract": ["../../dataset/contract/src/index.ts"],
      "@langwatch/monitor-contract": ["../../monitor/contract/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vitest.setup.ts"]
}
