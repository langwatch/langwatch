{
  "name": "@langwatch/evaluator-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe reusable Evaluator UI and presentation helpers.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "langwatch-declaration-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./surfaces/dynamic-zod-form": {
      "langwatch-declaration-source": "./src/ui/sections/checks/dynamic-zod-form.tsx",
      "types": "./dist/ui/sections/checks/dynamic-zod-form.d.ts",
      "default": "./src/ui/sections/checks/dynamic-zod-form.tsx"
    },
    "./surfaces/evaluator-editor-content": {
      "langwatch-declaration-source": "./src/ui/sections/evaluators/evaluator-editor-content.tsx",
      "types": "./dist/ui/sections/evaluators/evaluator-editor-content.d.ts",
      "default": "./src/ui/sections/evaluators/evaluator-editor-content.tsx"
    },
    "./surfaces/evaluator-editor-shared": {
      "langwatch-declaration-source": "./src/ui/sections/evaluators/evaluator-editor-shared.tsx",
      "types": "./dist/ui/sections/evaluators/evaluator-editor-shared.d.ts",
      "default": "./src/ui/sections/evaluators/evaluator-editor-shared.tsx"
    },
    "./surfaces/evaluator-result-chip": {
      "langwatch-declaration-source": "./src/ui/elements/shared/evaluator-result-chip.tsx",
      "types": "./dist/ui/elements/shared/evaluator-result-chip.d.ts",
      "default": "./src/ui/elements/shared/evaluator-result-chip.tsx"
    },
    "./drawers": {
      "langwatch-declaration-source": "./src/ui/sections/drawers.ts",
      "types": "./dist/ui/sections/drawers.d.ts",
      "default": "./src/ui/sections/drawers.ts"
    },
    "./editor-drawers": {
      "langwatch-declaration-source": "./src/ui/sections/editor-drawers.ts",
      "types": "./dist/ui/sections/editor-drawers.d.ts",
      "default": "./src/ui/sections/editor-drawers.ts"
    },
    "./surfaces/available-evaluators": {
      "langwatch-declaration-source": "./src/behavior/use-available-evaluators.ts",
      "types": "./dist/behavior/use-available-evaluators.d.ts",
      "default": "./src/behavior/use-available-evaluators.ts"
    },
    "./evaluation-edit": {
      "langwatch-declaration-source": "./src/evaluation-edit.ts",
      "types": "./dist/evaluation-edit.d.ts",
      "default": "./src/evaluation-edit.ts"
    },
    "./evaluators": {
      "langwatch-declaration-source": "./src/evaluators.ts",
      "types": "./dist/evaluators.d.ts",
      "default": "./src/evaluators.ts"
    },
    "./surfaces/evaluation-types": {
      "langwatch-declaration-source": "./src/model/evaluations/types.ts",
      "types": "./dist/model/evaluations/types.d.ts",
      "default": "./src/model/evaluations/types.ts"
    },
    "./surfaces/evaluation-results": {
      "langwatch-declaration-source": "./src/model/evaluation-results.ts",
      "types": "./dist/model/evaluation-results.d.ts",
      "default": "./src/model/evaluation-results.ts"
    },
    "./surfaces/evaluation-status": {
      "langwatch-declaration-source": "./src/model/evaluation-status.ts",
      "types": "./dist/model/evaluation-status.d.ts",
      "default": "./src/model/evaluation-status.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project packages/features/evaluator/web/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@langwatch/analytics-contract": "workspace:*",
    "@langwatch/analytics-web": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/dataset-contract": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/evaluation-contract": "workspace:*",
    "@langwatch/evaluator-contract": "workspace:*",
    "@langwatch/experiment-web": "workspace:*",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/model-provider-web": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prompt-web": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@langwatch/trace-web": "workspace:*",
    "@langwatch/ui-drawer": "workspace:*",
    "@langwatch/ui-host": "workspace:*",
    "@langwatch/workflow-contract": "workspace:*",
    "@langwatch/workflow-web": "workspace:*",
    "@xyflow/react": "^12.11.1",
    "langwatch": "workspace:*",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.22.0",
    "motion": "^12.42.2",
    "numeral": "^2.0.6",
    "react-feather": "^2.0.10",
    "react-hook-form": "^7.80.0",
    "react-icons": "^5.5.0",
    "safe-regex2": "^5.1.1",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash-es": "^4.17.12",
    "@types/numeral": "^2.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
