{
  "name": "@langwatch/langy-server",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical server-side Langy service.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#*": {
      "types": {
        "langwatch-declarations": "./dist/*.d.ts",
        "default": "./src/*.ts"
      },
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": {
        "langwatch-declarations": "./dist/index.d.ts",
        "default": "./src/index.ts"
      },
      "default": "./src/index.ts"
    },
    "./streaming/langy-frame-auth": {
      "types": {
        "langwatch-declarations": "./dist/ports/langy-frame-auth.port.d.ts",
        "default": "./src/ports/langy-frame-auth.port.ts"
      },
      "default": "./src/ports/langy-frame-auth.port.ts"
    },
    "./rules/langy-capability-progress": {
      "types": {
        "langwatch-declarations": "./dist/rules/langy-capability-progress.rules.d.ts",
        "default": "./src/rules/langy-capability-progress.rules.ts"
      },
      "default": "./src/rules/langy-capability-progress.rules.ts"
    },
    "./rules/langy-turn-settlement": {
      "types": {
        "langwatch-declarations": "./dist/rules/langy-turn-settlement.rules.d.ts",
        "default": "./src/rules/langy-turn-settlement.rules.ts"
      },
      "default": "./src/rules/langy-turn-settlement.rules.ts"
    },
    "./langy.ids": {
      "types": {
        "langwatch-declarations": "./dist/ports/langy-ids.port.d.ts",
        "default": "./src/ports/langy-ids.port.ts"
      },
      "default": "./src/ports/langy-ids.port.ts"
    },
    "./testing": {
      "types": {
        "langwatch-declarations": "./dist/testing.d.ts",
        "default": "./src/testing.ts"
      },
      "default": "./src/testing.ts"
    },
    "./services/langy-cli-envelope.service": {
      "types": {
        "langwatch-declarations": "./dist/services/langy-cli-envelope.service.d.ts",
        "default": "./src/services/langy-cli-envelope.service.ts"
      },
      "default": "./src/services/langy-cli-envelope.service.ts"
    },
    "./services/langy-final-parts.service": {
      "types": {
        "langwatch-declarations": "./dist/services/langy-final-parts.service.d.ts",
        "default": "./src/services/langy-final-parts.service.ts"
      },
      "default": "./src/services/langy-final-parts.service.ts"
    },
    "./services/langy-message.service": {
      "types": {
        "langwatch-declarations": "./dist/services/langy-message.service.d.ts",
        "default": "./src/services/langy-message.service.ts"
      },
      "default": "./src/services/langy-message.service.ts"
    },
    "./services/langy-turn.service": {
      "types": {
        "langwatch-declarations": "./dist/services/langy-turn.service.d.ts",
        "default": "./src/services/langy-turn.service.ts"
      },
      "default": "./src/services/langy-turn.service.ts"
    },
    "./ports/langy-turn-runtime": {
      "types": {
        "langwatch-declarations": "./dist/ports/langy-turn-runtime.port.d.ts",
        "default": "./src/ports/langy-turn-runtime.port.ts"
      },
      "default": "./src/ports/langy-turn-runtime.port.ts"
    },
    "./subscribers/langy-conversation": {
      "types": {
        "langwatch-declarations": "./dist/subscribers/langy-conversation.subscriber.d.ts",
        "default": "./src/subscribers/langy-conversation.subscriber.ts"
      },
      "default": "./src/subscribers/langy-conversation.subscriber.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "generate:setup-skill-bodies": "node --experimental-strip-types scripts/generate-setup-skill-bodies.ts"
  },
  "dependencies": {
    "@langwatch/agent-contract": "workspace:*",
    "@langwatch/agent-server": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/api-key-contract": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/feature-flag-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/ksuid": "^2.0.2",
    "@langwatch/langy-contract": "workspace:*",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@trpc/server": "^11.18.0",
    "ai": "^6.0.217",
    "hono": "^4.12.27",
    "langwatch": "workspace:*",
    "nanoid": "^5.1.5",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@langwatch/feature-flag-server": "workspace:*",
    "@langwatch/redis-client": "workspace:*",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@testcontainers/redis": "^12.0.4",
    "@types/node": "^26.0.1",
    "@types/ws": "^8.18.1",
    "ioredis": "^5.9.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
