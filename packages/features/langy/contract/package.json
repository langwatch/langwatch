{
  "name": "@langwatch/langy-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Portable Langy conversation, credential and relay contract.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./cards": {
      "types": "./dist/cards/index.d.ts",
      "default": "./src/cards/index.ts"
    },
    "./cards/handled-error": {
      "types": "./dist/cards/handled-error.d.ts",
      "default": "./src/cards/handled-error.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "pnpm -w typecheck:declarations --project packages/features/langy/contract/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/config": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
