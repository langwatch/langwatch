{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/gateway-web.tsbuildinfo",
    "verbatimModuleSyntax": true,
    "paths": {
      "@langwatch/authz-contract": ["../../authz/contract/src/index.ts"],
      "@langwatch/gateway-contract": ["../contract/src/index.ts"],
      "@langwatch/model-provider-contract": ["../../model-provider/contract/src/index.ts"],
      "@langwatch/authz-web/surfaces/scope-picker": [
        "../../authz/web/src/surfaces/scope-picker/index.ts"
      ],
      "@langwatch/enterprise-billing-web/surfaces/contact-sales": [
        "../../../enterprise/features/billing/web/src/surfaces/contact-sales/index.ts"
      ],
      "@langwatch/platform-api-client": ["../../../platform-api-client/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
