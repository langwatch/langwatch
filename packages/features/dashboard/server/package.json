{
  "name": "@langwatch/dashboard-server",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical server-side dashboard, graph, and saved workbench chart service.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project packages/features/dashboard/server/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@langwatch/analytics-contract": "workspace:*",
    "@langwatch/analytics-server": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/automation-contract": "workspace:*",
    "@langwatch/dashboard-contract": "workspace:*",
    "@langwatch/feature-flag-contract": "workspace:*",
    "@langwatch/feature-flag-server": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@trpc/server": "^11.18.0",
    "hono-openapi": "^1.3.1",
    "nanoid": "^5.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@langwatch/test-harness": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
