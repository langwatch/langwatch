{
  "name": "@langwatch/navigation-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe navigation: the application shell, the product registry, the landing redirect and the switchers the chrome renders.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./chrome": {
      "types": "./src/ui/index.ts",
      "default": "./src/ui/index.ts"
    },
    "./command-bar": {
      "types": "./src/command-bar.ts",
      "default": "./src/command-bar.ts"
    },
    "./screens/landing": {
      "types": "./src/screens/landing/index.ts",
      "default": "./src/screens/landing/index.ts"
    },
    "./testing": {
      "types": "./src/testing.tsx",
      "default": "./src/testing.tsx"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/agent-contract": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/feature-flag-contract": "workspace:*",
    "@langwatch/platform-api-client": "workspace:*",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.22.0",
    "next-themes": "^0.4.6",
    "react-error-boundary": "^6.1.2",
    "react-icons": "^5.7.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
