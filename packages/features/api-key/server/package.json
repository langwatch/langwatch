{
  "name": "@langwatch/api-key-server",
  "version": "0.1.0",
  "private": true,
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "imports": {
    "#*": {
      "types": {
        "langwatch-declarations": "./dist/*.d.ts",
        "default": "./src/*.ts"
      },
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": {
        "langwatch-declarations": "./dist/index.d.ts",
        "default": "./src/index.ts"
      },
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/api-key-contract": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/ksuid": "^2.0.2",
    "@langwatch/observability": "workspace:*",
    "@langwatch/organization-contract": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@trpc/server": "^11.18.0",
    "hono": "^4.12.27",
    "hono-openapi": "^1.3.1",
    "openapi-types": "^12.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
