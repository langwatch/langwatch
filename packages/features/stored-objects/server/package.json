{
  "name": "@langwatch/stored-objects-server",
  "version": "0.1.0",
  "private": true,
  "description": "Stored Objects service, Postgres store, API, and ClickHouse import.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./public-api": {
      "types": "./src/api/public/stored-object.api.ts",
      "default": "./src/api/public/stored-object.api.ts"
    },
    "./internal-api": {
      "types": "./src/api/internal/stored-object.api.ts",
      "default": "./src/api/internal/stored-object.api.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/stored-objects-contract": "workspace:*",
    "@langwatch/system-migrations": "workspace:*",
    "hono": "^4.12.27"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
