{
  "name": "@langwatch/evaluation-server",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical server-side Evaluation feature.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./workflow-evaluation": {
      "types": "./src/adapters/workflow-evaluation.adapter.ts",
      "default": "./src/adapters/workflow-evaluation.adapter.ts"
    },
    "./internal": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.0",
    "@langwatch/analytics-contract": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/automation-contract": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/evaluation-contract": "workspace:*",
    "@langwatch/evaluator-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/experiment-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/ksuid": "^2.0.2",
    "@langwatch/monitor-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@langwatch/workflow-contract": "workspace:*",
    "@trpc/server": "^11.18.0",
    "hono": "^4.12.27",
    "hono-openapi": "^1.3.1",
    "nanoid": "^5.1.5",
    "safe-regex2": "^5.1.1",
    "slugify": "^1.6.9",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@langwatch/test-harness": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
