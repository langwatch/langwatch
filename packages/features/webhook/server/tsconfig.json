{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "src",
    "outDir": "dist",

    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "lib": ["es2022", "dom"],
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@langwatch/webhook-contract": ["../contract/src/index.ts"],
      "@langwatch/handled-error": ["../../../handled-error/src/index.ts"],
      "@langwatch/prisma-client/generated": ["../../../prisma-client/src/generated/client.ts"]
    },

    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "../../../api/tsconfig.build.json"
    },
    {
      "path": "../../authz/contract/tsconfig.build.json"
    },
    {
      "path": "../../../aws-client/tsconfig.build.json"
    },
    {
      "path": "../../../egress/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../entitlement/contract/tsconfig.build.json"
    },
    {
      "path": "../../../eventing/tsconfig.build.json"
    },
    {
      "path": "../../gateway/contract/tsconfig.build.json"
    },
    {
      "path": "../../../handled-error/tsconfig.build.json"
    },
    {
      "path": "../../../observability/tsconfig.build.json"
    },
    {
      "path": "../../../prisma-client/tsconfig.build.json"
    },
    {
      "path": "../../../test-harness/tsconfig.build.json"
    },
    {
      "path": "../../../time/tsconfig.build.json"
    }
  ]
}
