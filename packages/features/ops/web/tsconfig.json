{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/ops-web.tsbuildinfo",
    "lib": ["es2022", "dom", "dom.iterable"],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "types": ["vitest/globals"],
    "paths": {
      "@langwatch/ops-contract": ["../contract/src/index.ts"],
      "@langwatch/feature-flag-contract": ["../../feature-flag/contract/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"]
}
