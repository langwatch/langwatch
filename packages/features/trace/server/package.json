{
  "name": "@langwatch/trace-server",
  "version": "0.1.0",
  "private": true,
  "description": "Trace read service and private persistence composition.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'"
  },
  "dependencies": {
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/dataset-contract": "workspace:*",
    "@langwatch/coding-agent-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/ksuid": "^2.0.2",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prompt-contract": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/otlp-transformer": "0.55.0",
    "@trpc/server": "^11.18.0",
    "langwatch": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clickhouse/client": "^1.23.0",
    "nanoid": "^5.1.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
