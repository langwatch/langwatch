{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "lib": ["es2022"],
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    // Consumers import the TypeScript sources directly (see the package's
    // `exports`), so this project only ever type-checks - nothing is built.
    "noEmit": true,
    "verbatimModuleSyntax": true,

    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "../../../actor/tsconfig.build.json"
    },
    {
      "path": "../../../api/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../../eventing/tsconfig.build.json"
    },
    {
      "path": "../../../handled-error/tsconfig.build.json"
    },
    {
      "path": "../../../observability/tsconfig.build.json"
    },
    {
      "path": "../../organization/contract/tsconfig.build.json"
    },
    {
      "path": "../../../prisma-client/tsconfig.build.json"
    },
    {
      "path": "../../../system-migrations/tsconfig.build.json"
    },
    {
      "path": "../../../time/tsconfig.build.json"
    },
    {
      "path": "../../../test-harness/tsconfig.build.json"
    }
  ]
}
