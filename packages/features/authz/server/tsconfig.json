{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2022"],
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/authz-server.tsbuildinfo",
    // Consumers import the TypeScript sources directly (see the package's
    // `exports`), so this project only ever type-checks - nothing is built.
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
