{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/authz-contract.tsbuildinfo",
    "lib": ["es2022"],
    // Deliberately NO "types": ["node"]. This package is isomorphic: the
    // frontend and the backend both import it, so a `node:*` import or a
    // `Buffer` reference must not compile here. That is the whole boundary —
    // enforced by the compiler rather than by a convention in a barrel.
    "types": [],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
