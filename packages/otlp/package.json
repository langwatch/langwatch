{
  "name": "@langwatch/otlp",
  "version": "0.0.1",
  "private": true,
  "description": "The OTLP wire vocabulary shared by the log, metric and trace ingestion paths: the AnyValue schema, attribute-map flattening, and identifier decoding",
  "keywords": [
    "langwatch",
    "opentelemetry",
    "otlp"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./door": {
      "types": "./dist/door.d.ts",
      "default": "./src/door.ts"
    },
    "./trace-request": {
      "types": "./dist/trace-request.d.ts",
      "default": "./src/trace-request.ts"
    }
  },
  "scripts": {
    "typecheck": "GOMAXPROCS=2 GOMEMLIMIT=2GiB tsc -b",
    "test": "vitest run --fsModuleCache"
  },
  "dependencies": {
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/module": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@opentelemetry/otlp-transformer": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.6.0",
  "langwatch": {
    "group": "telemetry"
  }
}
