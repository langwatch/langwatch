{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "lib": ["es2022"],
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "vitest/globals"],

    "noEmit": true,

    "rootDir": ".",

    "outDir": "dist/typecheck",

    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],

  "references": [
    {
      "path": "tsconfig.declarations.json"
    },
    {
      "path": "../design-system/tsconfig.build.json"
    },
    {
      "path": "../egress/tsconfig.build.json"
    },
    {
      "path": "../observability/tsconfig.build.json"
    },
    {
      "path": "../time/tsconfig.build.json"
    }
  ]
}
