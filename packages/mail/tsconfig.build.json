{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist/typecheck",
    "tsBuildInfoFile": "dist/typecheck/tsconfig.build.tsbuildinfo"
  },
  "files": ["./src/index.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../time/tsconfig.build.json"
    },
    {
      "path": "../observability/tsconfig.build.json"
    }
  ],
  // Workspace dependencies no source or test file imports get no reference (tsconfig-shape-codemod).
  "nx": {
    "sync": {
      "ignoredDependencies": [
        "@langwatch/design-system",
        "@langwatch/design-system-internal",
        "@langwatch/vitest-config"
      ]
    }
  }
}
