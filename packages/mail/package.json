{
  "name": "@langwatch/mail",
  "version": "0.1.0",
  "private": true,
  "description": "The outbound mail gateways LangWatch sends through, and the transactional messages the identity and organization surfaces send.",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/typecheck/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/typecheck/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "vite --config preview/vite.config.ts",
    "typecheck": "pnpm -w typecheck:declarations --project packages/mail/tsconfig.json && tsc --noEmit && tsc --noEmit -p preview/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1080.0",
    "@langwatch/egress": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.9",
    "@sendgrid/mail": "^8.1.6",
    "nodemailer": "^9.0.3",
    "react": "^19.2.7",
    "undici": "^8.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "@langwatch/design-system": "workspace:*",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "next-themes": "^0.4.6",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.2",
    "vitest": "^5.0.0"
  }
}
