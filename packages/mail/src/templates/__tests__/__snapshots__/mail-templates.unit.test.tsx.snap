in-right:0;margin-bottom:6px;margin-left:0">LangWatch ·<!-- --> <a class="lw-link" href="https://docs.langwatch.ai" style="color:#a83e05;text-decoration-line:none;text-decoration:underline;text-underline-offset:2px" target="_blank">Documentation</a> <!-- -->·<!-- --> <a class="lw-link" href="mailto:support@langwatch.ai" style="color:#a83e05;text-decoration-line:none;text-decoration:underline;text-underline-offset:2px" target="_blank">support@langwatch.ai</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"
`;

