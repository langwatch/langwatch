exports[`given the usage-limit email rendered from the an organization on its own terms fixture > when it is rendered > matches the stored snapshot > usage-limit — an organization on its own terms 1`] = `
"<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="en"><head><link rel="preload" as="image" href="https://app.langwatch.ai/images/logo.png"/><link rel="preload" as="image" href="https://app.langwatch.ai/images/logo-full-darktheme.svg"/><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><meta name="color-scheme" content="light dark"/><meta name="supported-color-schemes" content="light dark"/><link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=sentient@400&amp;display=swap"/><style>
@font-face {
  font-family: 'Sentient';
  src: url('https://cdn.fontshare.com/wf/RVTZPYAA57KV4AMXRX7ZIPJXSTYCRP7A/36OUS5CBIXRKI2QU7G7OUHOK7HHA53Y2/SIH66VPT4WS2HIF5PEJNDU4INNUF54LG.woff2') format('woff2'),
       url('https://cdn.fontshare.com/wf/RVTZPYAA57KV4AMXRX7ZIPJXSTYCRP7A/36OUS5CBIXRKI2QU7G7OUHOK7HHA53Y2/SIH66VPT4WS2HIF5PEJNDU4INNUF54LG.woff') format('woff');
  font-weight: 400;
  font-style: normal;
  font-display: swap;
}
:root { color-scheme: light dark; supported-color-schemes: light dark; }
.lw-dark-only { display: none !important; mso-hide: all; width: 0 !important; max-height: 0 !important; overflow: hidden !important; font-size: 0 !important; line-height: 0 !important; }
@media (prefers-color-scheme: dark) {
  .lw-body { background-color: #0a0a0c !important; }
  .lw-page { background-color: #0a0a0c !important; }
  .lw-card { background-color: #131316 !important; border-color: #26262a !important; }
  .lw-text { color: #f5f4f1 !important; }
  .lw-muted { color: #a3a29e !important; }
  .lw-subtle { color: #8a8985 !important; }
  .lw-rule { border-color: #26262a !important; }
  .lw-link { color: #ff8a3d !important; }
  .lw-eyebrow { color: #ff8a3d !important; }
  .lw-mesh { background-color: #4a3020 !important; background-image: linear-gradient(90deg, #131316 0%, #7a4520 32%, #2f3a55 70%, #131316 100%) !important; }
  .lw-action { background-color: #f5f4f1 !important; border-color: #f5f4f1 !important; color: #0a0a0c !important; }
  .lw-action-secondary { background-color: #131316 !important; border-color: #26262a !important; color: #f5f4f1 !important; }
  .lw-panel { background-color: #3c2317 !important; }
  .lw-panel-ink { color: #ff8a3d !important; }
  .lw-code { background-color: #1c1c20 !important; color: #f5f4f1 !important; }
  .lw-table-head { color: #a3a29e !important; border-color: #26262a !important; }
  .lw-table-cell { color: #f5f4f1 !important; border-color: #26262a !important; }
  .lw-table-secondary { color: #a3a29e !important; }
  .lw-tok-keyword { color: #ff8a3d !important; }
  .lw-tok-string { color: #7ee7b0 !important; }
  .lw-tok-comment { color: #8a8985 !important; }
  .lw-tok-call { color: #79c0ff !important; }
  .lw-tok-number { color: #7ee7b0 !important; }
  .lw-light-only { display: none !important; mso-hide: all; width: 0 !important; max-height: 0 !important; overflow: hidden !important; font-size: 0 !important; line-height: 0 !important; }
  .lw-dark-only { display: block !important; width: 112px !important; max-height: none !important; overflow: visible !important; font-size: 20px !important; line-height: normal !important; }
}
@media (max-width: 600px) {
