:20px;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;padding:12px 24px;background-color:#141417;border:1px solid #141417;color:#ffffff;font-size:14px;font-weight:600;border-radius:999px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Accept invitation</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><p class="lw-muted" style="font-size:13.5px;line-height:1.55;margin:0 0 16px;color:#5b5b5d;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">The team already tracks 4 projects in Acme Corp.</p><p class="lw-text" style="font-size:15px;line-height:1.6;margin:0 0 4px;color:#141417;font-weight:600;margin-top:0;margin-right:0;margin-bottom:4px;margin-left:0">See your agents</p><p class="lw-muted" style="font-size:13.5px;line-height:1.55;margin:0 0 16px;color:#5b5b5d;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Install the command line tool, sign in, and run your agent as you normally would.</p><pre class="lw-code" style="margin:12px 0 16px;padding:12px;background-color:#f6f5f4;border-radius:10px;font-family:ui-monospace, SFMono-Regular, &quot;SF Mono&quot;, Menlo, Consolas, &quot;Courier New&quot;, monospace;font-size:12px;line-height:1.5;color:#141417;white-space:pre-wrap;overflow-wrap:normal;word-break:normal"><span class="lw-tok-keyword" style="color:#a83e05">npm</span> install -g <span class="lw-tok-keyword" style="color:#a83e05">langwatch</span>
<span class="lw-tok-keyword" style="color:#a83e05">langwatch</span> login
<span class="lw-tok-keyword" style="color:#a83e05">claude</span></pre><p class="lw-muted" style="font-size:13.5px;line-height:1.55;margin:0 0 16px;color:#5b5b5d;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><a class="lw-link" href="https://docs.langwatch.ai/integration/cli" style="color:#a83e05;text-decoration-line:none;text-decoration:underline;text-underline-offset:2px" target="_blank">Read the command line guide</a> for signing in to a self-hosted instance, and for agents other than Claude Code.</p><p class="lw-text" style="font-size:15px;line-height:1.6;margin:18px 0 4px;color:#141417;font-weight:600;margin-top:18px;margin-right:0;margin-bottom:4px;margin-left:0">Or let your coding agent do it</p><p class="lw-muted" style="font-size:13.5px;line-height:1.55;margin:0 0 16px;color:#5b5b5d;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Add the LangWatch skills:</p><pre class="lw-code" style="margin:12px 0 16px;padding:12px;background-color:#f6f5f4;border-radius:10px;font-family:ui-monospace, SFMono-Regular, &quot;SF Mono&quot;, Menlo, Consolas, &quot;Courier New&quot;, monospace;font-size:12px;line-height:1.5;color:#141417;white-space:pre-wrap;overflow-wrap:normal;word-break:normal"><span class="lw-tok-keyword" style="color:#a83e05">npx</span> skills add <span class="lw-tok-keyword" style="color:#a83e05">langwatch</span>/skills</pre><p class="lw-muted" style="font-size:13.5px;line-height:1.55;margin:0 0 16px;color:#5b5b5d;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Then paste this into your agent:</p><p class="lw-code" style="font-size:14px;line-height:1.55;margin:12px 0 16px;padding:12px;background-color:#f6f5f4;border-radius:10px;color:#141417;margin-top:12px;margin-right:0;margin-bottom:16px;margin-left:0">Install the LangWatch skills with npx skills add langwatch/skills, then instrument my code with LangWatch following the tracing skill.</p><p class="lw-muted" style="font-size:13.5px;line-height:1.55;margin:0 0 16px;color:#5b5b5d;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><a class="lw-link" href="https://docs.langwatch.ai/integration/typescript/guide" style="color:#a83e05;text-decoration-line:none;text-decoration:underline;text-underline-offset:2px" target="_blank">Open the quickstart</a> to copy each step.</p><p class="lw-text" style="font-size:15px;line-height:1.6;margin:0 0 16px;color:#141417;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">If this was a mistake, you can safely ignore this email.</p><hr class="lw-rule" style="width:100%;border:none;border-top:1px solid #e3e3e4;margin:26px 0 18px"/><p class="lw-subtle" style="font-size:12px;line-height:1.6;margin:0 0 6px;color:#727274;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0">LangWatch ·<!-- --> <a class="lw-link" href="https://docs.langwatch.ai" style="color:#a83e05;text-decoration-line:none;text-decoration:underline;text-underline-offset:2px" target="_blank">Documentation</a> <!-- -->·<!-- --> <a class="lw-link" href="mailto:support@langwatch.ai" style="color:#a83e05;text-decoration-line:none;text-decoration:underline;text-underline-offset:2px" target="_blank">support@langwatch.ai</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"
`;

