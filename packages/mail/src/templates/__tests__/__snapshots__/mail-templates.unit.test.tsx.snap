-size:14px;font-weight:600;border-radius:999px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Open <!-- -->Acme Corp</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><hr class="lw-rule" style="width:100%;border:none;border-top:1px solid #e3e3e4;margin:26px 0 18px"/><p class="lw-subtle" style="font-size:12px;line-height:1.6;margin:0 0 6px;color:#727274;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0">LangWatch ·<!-- --> <a class="lw-link" href="https://docs.langwatch.ai" style="color:#a83e05;text-decoration-line:none;text-decoration:underline;text-underline-offset:2px" target="_blank">Documentation</a> <!-- -->·<!-- --> <a class="lw-link" href="mailto:support@langwatch.ai" style="color:#a83e05;text-decoration-line:none;text-decoration:underline;text-underline-offset:2px" target="_blank">support@langwatch.ai</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"
