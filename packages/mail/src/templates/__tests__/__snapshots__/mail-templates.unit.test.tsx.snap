nter" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:24px 0"><tbody><tr><td><p style="font-size:13.5px;line-height:24px;padding:10px 0;color:#141417;margin:0;font-weight:600;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">44,150,000 of 50,000,000 events</p><table style="width:100%;border-collapse:collapse;table-layout:fixed;height:8px;margin:10px 0 0"><tbody><tr><td style="width:88.3%;background-color:#f56b1a;border-radius:4px 0 0 4px;font-size:0;line-height:8px"> </td><td class="lw-code" style="width:11.700000000000003%;background-color:#f6f5f4;border-radius:0 4px 4px 0;font-size:0;line-height:8px"> </td></tr></tbody></table></td></tr></tbody></table><table class="lw-table" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="width:100%;border-collapse:collapse;margin:16px 0;table-layout:fixed"><thead><tr><th class="lw-table-head" style="width:70%;padding:0 12px 7px 0;text-align:left;font-family:&quot;JetBrains Mono&quot;, ui-monospace, SFMono-Regular, &quot;SF Mono&quot;, Menlo, Consolas, &quot;Courier New&quot;, monospace;font-size:10px;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#5b5b5d;border-bottom:1px solid #e3e3e4;white-space:nowrap">Project</th><th class="lw-table-head" style="width:30%;padding:0 12px 7px 0;text-align:right;font-family:&quot;JetBrains Mono&quot;, ui-monospace, SFMono-Regular, &quot;SF Mono&quot;, Menlo, Consolas, &quot;Courier New&quot;, monospace;font-size:10px;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:#5b5b5d;border-bottom:1px solid #e3e3e4;white-space:nowrap">events</th></tr></thead><tbody><tr><td class="lw-table-cell" style="padding:9px 12px 9px 0;text-align:left;font-size:13px;line-height:1.4;color:#141417;border-bottom:1px solid #e3e3e4;font-variant-numeric:normal;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Claims triage</td><td class="lw-table-cell" style="padding:9px 12px 9px 0;text-align:right;font-size:13px;line-height:1.4;color:#141417;border-bottom:1px solid #e3e3e4;font-variant-numeric:tabular-nums;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">31,000,000</td></tr><tr><td class="lw-table-cell" style="padding:9px 12px 9px 0;text-align:left;font-size:13px;line-height:1.4;color:#141417;border-bottom:1px solid #e3e3e4;font-variant-numeric:normal;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Broker copilot</td><td class="lw-table-cell" style="padding:9px 12px 9px 0;text-align:right;font-size:13px;line-height:1.4;color:#141417;border-bottom:1px solid #e3e3e4;font-variant-numeric:tabular-nums;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">13,150,000</td></tr></tbody></table><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:26px 0 16px"><tbody><tr><td><table border="0" cellPadding="0" cellSpacing="0" role="presentation" style="border-collapse:separate;border-spacing:0"><tbody><tr><td style="padding-right:0;vertical-align:middle"><a class="lw-action" href="https://app.langwatch.ai/settings/usage" style="line-height:20px;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;padding:12px 24px;background-color:#141417;border:1px solid #141417;color:#ffffff;font-size:14px;font-weight:600;border-radius:999px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">View usage details</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table></td></tr></tbody></table><p class="lw-muted" style="font-size:13.5px;line-height:1.55;margin:0 0 16px;color:#5b5b5d;margin-top:0;margin-right:0;margin-bottom:16