angWatch" height="27" src="https://app.langwatch.ai/images/logo.png" style="display:block;outline:none;border:none;text-decoration:none;font-family:&quot;Sentient&quot;, ui-serif, Georgia, &quot;Times New Roman&quot;, serif;font-size:20px;color:#141417" width="112"/><img class="lw-dark-only" alt="LangWatch" height="27" src="https://app.langwatch.ai/images/logo-full-darktheme.svg" style="display:none;outline:none;border:none;text-decoration:none;font-family:&quot;Sentient&quot;, ui-serif, Georgia, &quot;Times New Roman&quot;, serif;font-size:20px;color:#f5f4f1" width="112"/></td></tr></tbody></table><table width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="width:100%;border-collapse:collapse;margin:0 0 24px"><tbody><tr><td class="lw-mesh" height="3" style="height:3px;line-height:3px;font-size:0;background-color:#ffcfa8;background-image:linear-gradient(90deg, #ffffff 0%, #ffaf6e 32%, #cddcf9 70%, #ffffff 100%);border-radius:2px"> </td></tr></tbody></table><p class="lw-eyebrow" style="font-size:11px;line-height:1.4;margin:0 0 8px;font-family:&quot;JetBrains Mono&quot;, ui-monospace, SFMono-Regular, &quot;SF Mono&quot;, Menlo, Consolas, &quot;Courier New&quot;, monospace;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;color:#f56b1a;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">LICENSE</p><h1 class="lw-text" style="margin:0 0 16px;font-family:&quot;Sentient&quot;, ui-serif, Georgia, &quot;Times New Roman&quot;, serif;font-size:29px;font-weight:400;line-height:1.2;letter-spacing:-0.03em;color:#141417">Your LangWatch license</h1><p class="lw-text" style="font-size:15px;line-height:1.6;margin:0 0 16px;color:#141417;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Thank you for your license. Here is what it covers.</p><table style="width:100%;border-collapse:collapse;margin:16px 0"><tbody><tr><td class="lw-muted" style="padding:8px 16px 8px 0;font-family:&quot;JetBrains Mono&quot;, ui-monospace, SFMono-Regular, &quot;SF Mono&quot;, Menlo, Consolas, &quot;Courier New&quot;, monospace;font-size:11px;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;color:#5b5b5d;white-space:nowrap;vertical-align:top">Plan</td><td class="lw-text" style="padding:7px 0;font-size:13.5px;color:#141417;text-align:right">Partner_trial</td></tr><tr><td class="lw-muted" style="padding:8px 16px 8px 0;font-family:&quot;JetBrains Mono&quot;, ui-monospace, SFMono-Regular, &quot;SF Mono&quot;, Menlo, Consolas, &quot;Courier New&quot;, monospace;font-size:11px;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;color:#5b5b5d;white-space:nowrap;vertical-align:top">Seats</td><td class="lw-text" style="padding:7px 0;font-size:13.5px;color:#141417;text-align:right">10</td></tr><tr><td class="lw-muted" style="padding:8px 16px 8px 0;font-family:&quot;JetBrains Mono&quot;, ui-monospace, SFMono-Regular, &quot;SF Mono&quot;, Menlo, Consolas, &quot;Courier New&quot;, monospace;font-size:11px;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;color:#5b5b5d;white-space:nowrap;vertical-align:top">Expires</td><td class="lw-text" style="padding:7px 0;font-size:13.5px;color:#141417;text-align:right">January 1, 2027</td></tr></tbody></table><p class="lw-text" style="font-size:15px;line-height:1.6;margin:0 0 16px;color:#141417;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">A <code>.langwatch-license</code> file is attached. Go to Settings, then License, in your LangWatch instance and upload it — or paste the key below.</p><pre class="lw-code" style="margin:12px 0 16px;padding:12px;background-color:#f6f5f4;border-radius:10px;font-family:&quot;JetBrains Mono&quot;, ui-monospace, SFMono-Regular, &quot;SF Mono&quot;, Menlo, Consolas, &quot;Courier New&quot;, monospace;font-size:12px;line-height:1.5;color:#141417;white-space:pre-wrap;overflow-wrap:break-word;word-break:break-all">eyJhbGciOiJFZERTQSJ9.eyJvcmciOiJOb3J0aHdpbmQiLCJzZWF0cyI6MTAsImV4cCI6MTc5ODc2MTYwMH0.QnJm2Xr9tKcAb0pWq3ZsLh8YdN1eFgUiOoRtVxCw5v</pre><p class="lw-muted" style="font-size:13.5px;line-height:1.55;margin:0 0 16px;color:#5b5b5d;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">Keep this key private. Anyone holding it can activate a LangWatch instance.</p><hr class="lw-rule" style="width:100%;border:none;border-top:1px solid #e3e3e4;margin:26px 0 18px"/><p class="lw-subtle" style="font-size:12px;line-height:1.6;margin:0 0 6px;color:#727274;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0"><span style="font-family:&quot;JetBrains Mono&quot;, ui-monospace, SFMono-Regular, &quot;SF Mono&quot;, Menlo, Consolas, &quot;Courier New&quot;, monospace;font-size:11px;letter-spacing:0.08em">LANGWATCH</span> <!-- -->·<!-- --> <a class="lw-link" href="https://docs.langwatch.ai" style="color:#a83e05;text-decoration-line:none;text-decoration:underline;text-underline-offset:2px" target="_blank">Documentation</a> <!-- -->·<!-- --> <a class="lw-link" href="mailto:support@langwatch.ai" style="color:#a83e05;text-decoration-line:none;text-decoration:underline;text-underline-offset:2px" target="_blank">support@langwatch.ai</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"
`;

exports[`given the license email rendered from the a plan from the public ladder fixture > when it is rendered > matches the stored snapshot > license — a plan from the public ladder 1`] = `
