ottom:14px"><tbody><tr><td><img class="lw-light-only" alt="LangWatch" height="27" src="https://app.langwatch.ai/images/logo.png" style="display:block;outline:none;border:none;text-decoration:none;font-family:-apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;font-size:20px;color:#141417" width="112"/><img class="lw-dark-only" alt="LangWatch" height="27" src="https://app.langwatch.ai/images/logo-full-darktheme.svg" style="display:none;outline:none;border:none;text-decoration:none;font-family:-apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;font-size:20px;color:#f5f4f1" width="112"/></td></tr></tbody></table><table width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="width:100%;border-collapse:collapse;margin:0 0 24px"><tbody><tr><td class="lw-mesh" height="3" style="height:3px;line-height:3px;font-size:0;background-color:#ffcfa8;background-image:linear-gradient(90deg, #ffffff 0%, #ffaf6e 32%, #cddcf9 70%, #ffffff 100%);border-radius:2px"> </td></tr></tbody></table><h1 class="lw-text" style="margin:0 0 16px;font-family:-apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial, sans-serif;font-size:24px;font-weight:600;line-height:1.3;letter-spacing:-0.015em;color:#141417">A request to join is still waiting</h1><p class="lw-text" style="font-size:15px;line-height:1.6;margin:0 0 16px;color:#141417;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><strong>Morgan Ellis</strong> asked to join <strong>Acme Corp</strong> a week ago and nobody has answered yet.</p><p class="lw-text" style="font-size:15px;line-height:1.6;margin:0 0 16px;color:#141417;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0">It lapses in another week. This is the only reminder we send about it.</p><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin:26px 0"><tbody><tr><td><a class="lw-action" href="https://app.langwatch.ai/settings/members" style="line-height:20px;text-decoration:none;display:inline-block;max-width:100%;mso-padding-alt:0px;padding:12px 24px;background-color:#141417;border:1px solid #141417;color:#ffffff;font-size:14px;font-weight:600;border-radius:999px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px" target="_blank"><span><!--[if mso]><i style="mso-font-width:400%;mso-text-raise:18" hidden>&#8202;&#8202;&#8202;</i><![endif]--></span><span style="max-width:100%;display:inline-block;line-height:120%;mso-padding-alt:0px;mso-text-raise:9px">Open members settings</span><span><!--[if mso]><i style="mso-font-width:400%" hidden>&#8202;&#8202;&#8202;&#8203;</i><![endif]--></span></a></td></tr></tbody></table><hr class="lw-rule" style="width:100%;border:none;border-top:1px solid #e3e3e4;margin:26px 0 18px"/><p class="lw-subtle" style="font-size:12px;line-height:1.6;margin:0 0 6px;color:#727274;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0">You are receiving this because you administer this organization.</p><p class="lw-subtle" style="font-size:12px;line-height:1.6;margin:0 0 6px;color:#727274;margin-top:0;margin-right:0;margin-bottom:6px;margin-left:0">LangWatch ·<!-- --> <a class="lw-link" href="https://docs.langwatch.ai" style="color:#a83e05;text-decoration-line:none;text-decoration:underline;text-underline-offset:2px" target="_blank">Documentation</a> <!-- -->·<!-- --> <a class="lw-link" href="mailto:support@langwatch.ai" style="color:#a83e05;text-decoration-line:none;text-decoration:underline;text-underline-offset:2px" target="_blank">support@langwatch.ai</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>"
`;

