{
  "name": "@langwatch/span-normalisation",
  "version": "0.0.1",
  "private": true,
  "description": "The span canonicalisers: the per-framework rules that turn a span's or log record's raw attributes and events into LangWatch's canonical gen_ai shape, shared by trace ingestion and analytics",
  "keywords": [
    "langwatch",
    "normalisation",
    "opentelemetry",
    "spans"
  ],
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/redaction": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
