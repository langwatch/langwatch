{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "src",
    "outDir": "dist",
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/audit-log-null.tsbuildinfo",
    "lib": ["es2022"],
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "../../modules/audit-log/contract/tsconfig.build.json"
    },
    {
      "path": "../runtime-composition/tsconfig.build.json"
    }
  ]
}
