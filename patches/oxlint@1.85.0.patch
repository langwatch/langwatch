diff --git a/bin/oxlint b/bin/oxlint
index 874f6269b88f6c16718b9286209f8cb86cfcffab..e09e0a122c481f895bb8557f8aa9d580f323a72f 100755
--- a/bin/oxlint
+++ b/bin/oxlint
@@ -1,3 +1,109 @@
 #!/usr/bin/env node
+import { accessSync, constants, mkdirSync, readFileSync, rmSync, statSync, writeFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { delimiter, join } from "node:path";
+import { fileURLToPath } from "node:url";
 
-import "../dist/cli.js";
+// LangWatch: a lint run takes a `lint` slot of haven's machine budget for its whole life
+// (dev/docs/plans/haven-exec-policy.md section 4); --lsp, --init and the listing flags take
+// none. Without haven a run waits for one of LANGWATCH_LINT_SLOTS (default 2) lock folders.
+const args = process.argv.slice(2);
+const flag = (...names) => args.some((arg) => names.includes(arg));
+const exempt = flag("-V", "--version", "-h", "--help", "--lsp", "--init", "--rules", "--print-config");
+const held = process.env.RUSH_GATE_HELD || process.env.CHECK_QUEUE_HELD || process.env.LANGWATCH_LINT_SLOT;
+
+function findBin(name, override) {
+  const candidates = [override, ...(process.env.PATH ?? "").split(delimiter).filter(Boolean).map((dir) => join(dir, name))];
+  for (const candidate of candidates) {
+    try {
+      if (candidate && statSync(candidate).isFile()) {
+        accessSync(candidate, constants.X_OK);
+        return candidate;
+      }
+    } catch {}
+  }
+}
+
+// Rush's gate owns a program when its bin folder holds a shim for it (none while the gate is off).
+function rushOwns(program) {
+  const config = join(homedir(), ".config");
+  const marked = (dir) => { try { return statSync(join(dir, "config.json")).isFile(); } catch { return false; } };
+  const root = process.env.RUSH_HOME || (!marked(join(config, "rush")) && marked(join(config, "agtop")) ? join(config, "agtop") : join(config, "rush"));
+  try { return statSync(join(root, "gate", "bin", program)).isFile(); } catch { return false; }
+}
+
+if (!exempt && !held && process.platform !== "win32" && typeof process.execve === "function") {
+  const bin = fileURLToPath(import.meta.url);
+  const rush = rushOwns("oxlint") ? findBin("rush", process.env.RUSH_BIN) : undefined;
+  try {
+    if (rush) process.execve(rush, [rush, "gate", "run", "--name", "oxlint", "--dir", process.cwd(), "--", process.execPath, ...process.execArgv, bin, ...args], { ...process.env, GOMAXPROCS: process.env.GOMAXPROCS ?? "2" });
+  } catch {
+    // execve refused: haven's slot below
+  }
+  const haven = findBin("haven", process.env.HAVEN_BIN);
+  try {
+    if (haven) process.execve(haven, [haven, "machine", "slot", "run", "--class", "lint", "--label", "oxlint", "--", process.execPath, ...process.execArgv, bin, ...args]);
+  } catch {
+    // execve refused: fall back to the lock folder below
+  }
+}
+
+function ownerAlive(lock) {
+  let pid;
+  try {
+    pid = Number(readFileSync(join(lock, "pid"), "utf8"));
+  } catch {
+    return Date.now() - statSync(lock).mtimeMs < 10_000;
+  }
+  try {
+    process.kill(pid, 0);
+    return true;
+  } catch (error) {
+    return error.code === "EPERM";
+  }
+}
+
+function tryTake(lock) {
+  try {
+    mkdirSync(lock);
+    writeFileSync(join(lock, "pid"), String(process.pid));
+    return true;
+  } catch {
+    try {
+      if (!ownerAlive(lock)) rmSync(lock, { recursive: true, force: true });
+    } catch {}
+    return false;
+  }
+}
+
+function acquire(slots) {
+  const slotDir = join(homedir(), ".cache", "langwatch", "lint-slots");
+  mkdirSync(slotDir, { recursive: true });
+  const pause = new Int32Array(new SharedArrayBuffer(4));
+  let told = false;
+  for (;;) {
+    for (let index = 0; index < slots; index++) {
+      const lock = join(slotDir, `slot-${index}`);
+      if (tryTake(lock)) return lock;
+    }
+    if (!told) {
+      process.stderr.write(`oxlint: waiting for a machine-wide slot (${slots} in use; LANGWATCH_LINT_SLOTS)\n`);
+      told = true;
+    }
+    Atomics.wait(pause, 0, 0, 500);
+  }
+}
+
+const slots = Number(process.env.LANGWATCH_LINT_SLOTS ?? "2");
+if (!exempt && !held && slots > 0) {
+  const lock = acquire(slots);
+  process.env.LANGWATCH_LINT_SLOT = lock;
+  process.on("exit", () => rmSync(lock, { recursive: true, force: true }));
+}
+// The slot is two units: oxlint's own threads and tsgolint's GOMAXPROCS stay within it.
+if (!exempt && !args.some((arg) => arg === "--threads" || arg.startsWith("--threads="))) {
+  process.argv.push(`--threads=${process.env.GOMAXPROCS || "2"}`);
+}
+process.env.GOMAXPROCS ??= "2";
+
+await import("../dist/cli.js");
