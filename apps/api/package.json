{
  "name": "@langwatch/platform-api",
  "version": "0.1.0",
  "private": true,
  "description": "LangWatch interactive API process composition.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/api.runtime.ts",
      "default": "./src/api.runtime.ts"
    },
    "./app-trpc": {
      "types": "./src/app-trpc/index.ts",
      "default": "./src/app-trpc/index.ts"
    },
    "./app-rest": {
      "types": "./src/app-rest/index.ts",
      "default": "./src/app-rest/index.ts"
    }
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=../../.env src/api.entrypoint.ts",
    "dev": "tsx watch --env-file-if-exists=../../.env src/api.entrypoint.ts",
    "task:clickhouse-migrate": "tsx --env-file-if-exists=../../.env src/tasks/clickhouse-migrate/clickhouse-migrate.entrypoint.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
