{
  "name": "@langwatch/platform-api",
  "version": "0.1.0",
  "private": true,
  "description": "LangWatch interactive API process composition.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/api.runtime.ts",
      "default": "./src/api.runtime.ts"
    }
  },
  "scripts": {
    "start:prepare:db": "cd ../tasks && pnpm -s task prisma-migrate clickhouse-migrate lwql-provision",
    "start": "pnpm -s run start:prepare:db && node --experimental-transform-types $(test -f ../../.env && echo --env-file=../../.env) src/api.entrypoint.ts",
    "predev": "node ../../dev/scripts/ensure-built.mjs",
    "dev": "node ../../dev/scripts/dev-supervisor.mjs --watch -- node --experimental-transform-types $(test -f ../../.env && echo --env-file=../../.env) src/api.entrypoint.ts",
    "task": "node --experimental-transform-types $(test -f ../../.env && echo --env-file=../../.env) src/tasks/tasks.entrypoint.ts",
    "typecheck": "pnpm -w typecheck:declarations --project ./tsconfig.declarations.json && tsc --noEmit -p tsconfig.test.json",
    "typecheck:fast": "pnpm -w typecheck:declarations --project apps/api/tsconfig.declarations.json && tsc --noEmit -p tsconfig.json",
    "pretest": "node ../../dev/scripts/ensure-built.mjs @langwatch/mail",
    "test": "vitest run",
    "pretest:unit": "node ../../dev/scripts/ensure-built.mjs @langwatch/mail",
    "test:unit": "vitest run",
    "test:stress": "vitest run --exclude '**/node_modules/**' src/__tests__/collector.stress.test.ts",
    "check:gateway-control-plane": "node --experimental-transform-types scripts/check-gateway-control-plane.ts"
  },
