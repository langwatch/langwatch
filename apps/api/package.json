{
  "name": "@langwatch/platform-api",
  "version": "0.1.0",
  "private": true,
  "description": "LangWatch interactive API process composition.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/api.runtime.ts",
      "default": "./src/api.runtime.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@langwatch/agent-contract": "workspace:*",
    "@langwatch/agent-server": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/runtime-composition": "workspace:*",
    "@langwatch/secret-contract": "workspace:*",
    "@langwatch/secret-server": "workspace:*",
    "@langwatch/topic-contract": "workspace:*",
    "@langwatch/topic-server": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@langwatch/trpc": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@trpc/server": "^11.18.0",
    "hono": "^4.10.7",
    "superjson": "^2.2.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
