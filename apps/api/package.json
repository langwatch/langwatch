{
  "name": "@langwatch/platform-api",
  "version": "3.20.1",
  "private": true,
  "description": "LangWatch interactive API process composition.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/main.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "default": "./src/main.ts"
    }
  },
  "scripts": {
    "start:prepare:db": "cd ../tasks && pnpm --silent task upgrade",
    "start": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import @langwatch/observability/register $(test -f ../../.env && echo --env-file=../../.env) src/main.ts",
    "predev": "pnpm -w run ensure:built",
    "dev": "node --experimental-transform-types $(test -f ../../.env && echo --env-file=../../.env) src/main.ts",
    "typecheck": "GOMAXPROCS=2 GOMEMLIMIT=2GiB tsc -b",
    "pretest": "FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false pnpm -w exec nx run @langwatch/mail:build --outputStyle=static",
    "test": "vitest run",
    "pretest:unit": "FORCE_COLOR=0 NX_LOAD_DOT_ENV_FILES=false pnpm -w exec nx run @langwatch/mail:build --outputStyle=static",
    "openapi:generate": "node --experimental-transform-types --no-warnings src/openapi-document.ts"
  },
