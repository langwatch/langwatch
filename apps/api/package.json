{
  "name": "@langwatch/platform-api",
  "version": "0.1.0",
  "private": true,
  "description": "LangWatch interactive API process composition.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/main.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "default": "./src/main.ts"
    }
  },
  "scripts": {
    "start:prepare:db": "cd ../tasks && pnpm -s task prisma-migrate clickhouse-migrate lwql-provision system-migrations-pass",
    "start": "pnpm -s run start:prepare:db && node --experimental-transform-types $(test -f ../../.env && echo --env-file=../../.env) src/main.ts",
    "predev": "node ../../dev/scripts/ensure-built.mjs",
    "dev": "node ../../dev/scripts/dev-supervisor.mjs --watch -- node --experimental-transform-types $(test -f ../../.env && echo --env-file=../../.env) src/main.ts",
    "task": "node --experimental-transform-types $(test -f ../../.env && echo --env-file=../../.env) src/tasks/tasks.entrypoint.ts",
    "typecheck": "tsc -b tsconfig.test.json",
    "pretest": "node ../../dev/scripts/ensure-built.mjs @langwatch/mail",
    "test": "vitest run",
    "pretest:unit": "node ../../dev/scripts/ensure-built.mjs @langwatch/mail",
    "test:stress": "vitest run --exclude '**/node_modules/**' src/__tests__/collector.stress.test.ts",
    "check:gateway-control-plane": "node --experimental-transform-types scripts/check-gateway-control-plane.ts"
  },
