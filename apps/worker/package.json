{
  "name": "@langwatch/worker",
  "version": "0.1.0",
  "private": true,
  "description": "LangWatch background process composition.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/main.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "default": "./src/main.ts"
    }
  },
  "scripts": {
    "start": "node --experimental-transform-types --import @langwatch/observability/register $(test -f ../../.env && echo --env-file=../../.env) src/main.ts",
    "predev": "bash ../../dev/scripts/devscripts.sh ensure-built",
    "dev": "node --experimental-transform-types $(test -f ../../.env && echo --env-file=../../.env) src/main.ts",
    "typecheck": "tsc -b tsconfig.test.json",
    "pretest": "bash ../../dev/scripts/devscripts.sh ensure-built @langwatch/mail",
    "test": "vitest run",
    "pretest:unit": "bash ../../dev/scripts/devscripts.sh ensure-built @langwatch/mail",
    "pretest:integration": "bash ../../dev/scripts/devscripts.sh ensure-built @langwatch/mail",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
