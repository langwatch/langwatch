{
  "name": "@langwatch/worker",
  "version": "0.1.0",
  "private": true,
  "description": "LangWatch background process composition.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/platform/lifecycle/worker.runtime.ts",
      "default": "./src/platform/lifecycle/worker.runtime.ts"
    },
    "./liveness": {
      "types": "./src/platform/liveness/worker.liveness.ts",
      "default": "./src/platform/liveness/worker.liveness.ts"
    },
    "./liveness/server": {
      "types": "./src/platform/liveness/worker-metrics.server.ts",
      "default": "./src/platform/liveness/worker-metrics.server.ts"
    },
    "./standalone": {
      "types": "./src/app/worker-standalone.executable.ts",
      "default": "./src/app/worker-standalone.executable.ts"
    }
  },
  "scripts": {
    "start": "tsx $(test -f ../../.env && echo --env-file=../../.env) $(test -f ../../.env.portless && echo --env-file=../../.env.portless) src/worker.entrypoint.ts",
    "dev": "tsx watch $(test -f ../../.env && echo --env-file=../../.env) $(test -f ../../.env.portless && echo --env-file=../../.env.portless) src/worker.entrypoint.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
