{
  "name": "@langwatch/worker",
  "version": "0.1.0",
  "private": true,
  "description": "LangWatch background process composition.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/platform/lifecycle/worker.runtime.ts",
      "default": "./src/platform/lifecycle/worker.runtime.ts"
    },
    "./liveness": {
      "types": "./src/platform/liveness/worker.liveness.ts",
      "default": "./src/platform/liveness/worker.liveness.ts"
    },
    "./liveness/server": {
      "types": "./src/platform/liveness/worker-metrics.server.ts",
      "default": "./src/platform/liveness/worker-metrics.server.ts"
    },
    "./standalone": {
      "types": "./src/app/worker-standalone.executable.ts",
      "default": "./src/app/worker-standalone.executable.ts"
    }
  },
  "scripts": {
    "start": "node --experimental-transform-types $(test -f ../../.env && echo --env-file=../../.env) src/worker.entrypoint.ts",
    "predev": "node ../../dev/scripts/ensure-built.mjs",
    "dev": "node ../../dev/scripts/dev-supervisor.mjs --watch -- node --experimental-transform-types $(test -f ../../.env && echo --env-file=../../.env) src/worker.entrypoint.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build": "node scripts/build-server.mjs",
    "build:server": "node scripts/build-server.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
