{
  "name": "@langwatch/worker",
  "version": "0.1.0",
  "private": true,
  "description": "LangWatch background process composition.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/platform/lifecycle/worker.runtime.ts",
      "default": "./src/platform/lifecycle/worker.runtime.ts"
    },
    "./liveness": {
      "types": "./src/platform/liveness/worker.liveness.ts",
      "default": "./src/platform/liveness/worker.liveness.ts"
    },
    "./liveness/server": {
      "types": "./src/platform/liveness/worker-metrics.server.ts",
      "default": "./src/platform/liveness/worker-metrics.server.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1080.0",
    "@langwatch/api-key-server": "workspace:*",
    "@langwatch/authz-server": "workspace:*",
    "@langwatch/automation-contract": "workspace:*",
    "@langwatch/automation-server": "workspace:*",
    "@langwatch/aws-client": "workspace:*",
    "@langwatch/coding-agent-server": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/enterprise-billing-contract": "workspace:*",
    "@langwatch/enterprise-billing-server": "workspace:*",
    "@langwatch/enterprise-worker": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/github-server": "workspace:*",
    "@langwatch/group-queue": "workspace:*",
    "@langwatch/langy-server": "workspace:*",
    "@langwatch/log-contract": "workspace:*",
    "@langwatch/log-server": "workspace:*",
    "@langwatch/metric-contract": "workspace:*",
    "@langwatch/metric-server": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@langwatch/redis-client": "workspace:*",
    "@langwatch/runtime-composition": "workspace:*",
    "@langwatch/scenario-server": "workspace:*",
    "@langwatch/stored-object-contract": "workspace:*",
    "@langwatch/stored-object-server": "workspace:*",
    "@langwatch/suite-server": "workspace:*",
    "@langwatch/topic-server": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@langwatch/trace-server": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
