{
  "name": "@langwatch/ui",
  "version": "0.1.0",
  "private": true,
  "description": "LangWatch browser process composition.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./public-config": {
      "types": "./src/behavior/public-config.ts",
      "default": "./src/behavior/public-config.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/agent-contract": "workspace:*",
    "@langwatch/agent-web": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
