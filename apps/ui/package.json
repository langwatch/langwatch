{
  "name": "@langwatch/ui",
  "version": "0.1.0",
  "private": true,
  "description": "LangWatch browser process composition.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./public-config": {
      "types": "./src/behavior/public-config.ts",
      "default": "./src/behavior/public-config.ts"
    },
    "./public-config/projection": {
      "types": "./src/behavior/public-config.projection.ts",
      "default": "./src/behavior/public-config.projection.ts"
    },
    "./design-system": {
      "types": "./src/behavior/design-system.ts",
      "default": "./src/behavior/design-system.ts"
    },
    "./langy-theme": {
      "types": "./src/model/langy-theme.ts",
      "default": "./src/model/langy-theme.ts"
    },
    "./analytics-client": {
      "types": "./src/behavior/analytics-client.ts",
      "default": "./src/behavior/analytics-client.ts"
    },
    "./posthog-analytics": {
      "types": "./src/behavior/posthog-analytics.ts",
      "default": "./src/behavior/posthog-analytics.ts"
    },
    "./gtag-readiness": {
      "types": "./src/behavior/gtag-readiness.ts",
      "default": "./src/behavior/gtag-readiness.ts"
    },
    "./browser-tracing": {
      "types": "./src/behavior/browser-tracing.ts",
      "default": "./src/behavior/browser-tracing.ts"
    },
    "./navigation-tracing": {
      "types": "./src/behavior/navigation-tracing.ts",
      "default": "./src/behavior/navigation-tracing.ts"
    },
    "./poll-for-global": {
      "types": "./src/behavior/poll-for-global.ts",
      "default": "./src/behavior/poll-for-global.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.1",
    "@chakra-ui/react": "^3.36.0",
    "@langwatch/agent-contract": "workspace:*",
