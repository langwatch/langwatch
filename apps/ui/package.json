{
  "name": "@langwatch/ui",
  "version": "0.1.0",
  "private": true,
  "description": "LangWatch browser process composition.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./public-config": {
      "types": "./src/behavior/public-config.ts",
      "default": "./src/behavior/public-config.ts"
    }
  },
  "scripts": {
    "predev": "pnpm -w run ensure:built",
    "dev": "vite --configLoader runner",
    "build": "NODE_ENV=production sh ../../dev/scripts/with-build-slot.sh vite vite build --configLoader runner",
    "build:local": "NODE_ENV=production LANGWATCH_UI_LOCAL_BUILD=1 sh ../../dev/scripts/with-build-slot.sh vite vite build --configLoader runner --outDir dist/client.local",
    "typecheck": "GOMAXPROCS=2 GOMEMLIMIT=2GiB tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:",
