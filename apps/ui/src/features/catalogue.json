{
  "version": 0,
  "governedWebPackages": [
    "@langwatch/agent-web",
    "@langwatch/automation-web",
    "@langwatch/enterprise-governance-web",
    "@langwatch/gateway-web",
    "@langwatch/prompt-web",
    "@langwatch/user-web"
  ],
  "features": [
    {
      "id": "agent-management",
      "root": "agent",
      "uses": {
        "screens": ["@langwatch/agent-web/screens/agent-management"],
        "surfaces": ["@langwatch/agent-web/surfaces/browser-port"]
      }
    },
    {
      "id": "automations",
      "root": "automations",
      "uses": {
        "screens": ["@langwatch/automation-web/screens/automations"],
        "surfaces": []
      }
    },
    {
      "id": "gateway",
      "root": "gateway",
      "uses": {
        "screens": ["@langwatch/gateway-web/screens/gateway"],
        "surfaces": []
      }
    },
    {
      "id": "governance",
      "root": "governance",
      "uses": {
        "screens": ["@langwatch/enterprise-governance-web/screens/governance"],
        "surfaces": []
      }
    },
    {
      "id": "personal-workspace",
      "root": "personal-workspace",
      "uses": {
        "screens": ["@langwatch/user-web/screens/personal-workspace"],
        "surfaces": []
      }
    }
  ]
}
