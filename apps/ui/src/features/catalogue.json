  "governedWebPackages": [
    "@langwatch/agent-web",
    "@langwatch/enterprise-governance-web",
    "@langwatch/gateway-web",
    "@langwatch/prompt-web"
  ],
  "features": [
    {
      "id": "agent-management",
      "root": "agent",
      "uses": {
        "screens": [
          "@langwatch/agent-web/screens/agent-management"
        ],
        "surfaces": [
