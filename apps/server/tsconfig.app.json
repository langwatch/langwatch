{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["dist", "node_modules", "test"],
  "references": [
    {
      "path": "../../packages/time/tsconfig.build.json"
    },
    {
      "path": "../../packages/process/tsconfig.build.json"
    },
    {
      "path": "../../packages/observability/tsconfig.build.json"
    },
    {
      "path": "../../packages/config/tsconfig.build.json"
    }
  ],
  // Dependencies the build does not import get no reference; tsconfig.test.json holds test-only ones (tsconfig-shape-codemod).
  "nx": {
    "sync": {
      "ignoredDependencies": ["@langwatch/vitest-config"]
    }
  }
}
