{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "module": "ESNext",
    "lib": ["ES2023"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "dist",
    "rootDir": ".",
    "isolatedModules": true,
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["dist", "node_modules", "test"],
  "references": [
    {
      "path": "../../packages/config/tsconfig.build.json"
    },
    {
      "path": "../../packages/observability/tsconfig.build.json"
    },
    {
      "path": "../../packages/time/tsconfig.build.json"
    },
    {
      "path": "../../packages/vitest-config/tsconfig.build.json"
    }
  ]
}
