{
  "name": "@langwatch/tasks",
  "version": "0.1.0",
  "private": true,
  "description": "One-shot database migrations and provisioning, run in command-line order.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/main.ts",
  "types": "./src/main.ts",
  "exports": {
    ".": {
      "types": "./src/main.ts",
      "default": "./src/main.ts"
    }
  },
  "scripts": {
    "task": "node --experimental-transform-types $(test -f ../../.env && echo --env-file=../../.env) src/main.ts",
    "typecheck": "tsc -b tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/analytics-process": "workspace:*",
    "@langwatch/authz-process": "workspace:*",
    "@langwatch/clickhouse-client": "workspace:*",
    "@langwatch/clickhouse-migrations": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/group-queue": "workspace:*",
    "@langwatch/identity-contract": "workspace:*",
    "@langwatch/identity-process": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/ops-process": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/redis-client": "workspace:*",
    "@langwatch/secrets": "workspace:*",
    "@langwatch/system-migrations": "workspace:*",
    "@langwatch/time": "workspace:*",
    "prisma": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
