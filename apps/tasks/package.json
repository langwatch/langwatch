{
  "name": "@langwatch/tasks",
  "version": "0.1.0",
  "private": true,
  "description": "The fourth executable: one composition root, one CMD. Runs any registered task by name against the process's real infrastructure handles.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "task": "tsx $(test -f ../../.env && echo --env-file=../../.env) $(test -f ../../.env.portless && echo --env-file=../../.env.portless) src/tasks.entrypoint.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.0",
    "@langwatch/analytics-server": "workspace:*",
    "@langwatch/automation-server": "workspace:*",
    "@langwatch/aws-client": "workspace:*",
    "@langwatch/clickhouse-client": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/egress": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/model-provider-server": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/redis-client": "workspace:*",
    "@langwatch/stored-object-server": "workspace:*",
    "@langwatch/task": "workspace:*",
    "ioredis": "5.10.1",
    "prisma": "7.9.1",
    "tsx": "^4.20.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
