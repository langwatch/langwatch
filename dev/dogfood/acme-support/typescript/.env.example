# The model provider the agent answers with.
OPENAI_API_KEY=

# The LangWatch project the agent connects to for Agent Testing.
LANGWATCH_API_KEY=
# Only for a self-hosted or local LangWatch, for example http://localhost:5560
LANGWATCH_ENDPOINT=

# Set to 0 to run the application without the connection to LangWatch.
LANGWATCH_AGENT_CONNECT=1
