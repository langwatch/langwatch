{
  "name": "langy-connected-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Langy as a connected agent with scenario setup and teardown, the way a customer connects their own agent",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/agent.ts",
    "sync": "node --env-file-if-exists=.env sync.ts",
    "test": "vitest run",
    "typecheck": "GOMAXPROCS=2 GOMEMLIMIT=2GiB tsc --noEmit"
  },
  "dependencies": {
    "langwatch": "file:../../../sdks/typescript"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
