# Drive Langy run plans on a stack. Needs LANGWATCH_ENDPOINT, LANGWATCH_API_KEY and
# LANGWATCH_PROJECT_ID in the environment or in .env; retry also needs LANGY_AGENT_ID.

cli := "node --env-file-if-exists=.env src/runs-cli.ts"

# Start the named run plans, print each batch id, poll each to the end
run-plan +names:
    {{cli}} run-plan {{names}}

# Poll a batch until every run is final; one line per run, then "overall: N/M passed"
poll batch:
    {{cli}} poll {{batch}}

# Re-run the scenarios "E2E <group> <num>: ..." with these numbers as plan "Langy e2e retry"
retry +nums:
    {{cli}} retry {{nums}}
