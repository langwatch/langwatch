# The stack's base URL. run.sh finds it from haven.
LANGWATCH_ENDPOINT=http://127.0.0.1:5560
# A personal API key: Langy acts as a person, so a project key with no owner is refused.
LANGWATCH_API_KEY=sk-lw-...
LANGWATCH_PROJECT_ID=local-dev-project
# 1 makes setup throw, to show "Setup failed" and "Not scored" on a run.
LANGY_DOGFOOD_FAIL_SETUP=0
