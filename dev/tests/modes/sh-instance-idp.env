# Deployment mode sh-instance-idp: sh-licensed plus a deployment-wide IdP (okta
# shape, served by idpsim). The developer supplies the licence and idpsim's client.
#! requires LANGWATCH_LICENSE_KEY OKTA_CLIENT_ID OKTA_ISSUER
LANGWATCH_DEPLOYMENT_MODE=sh-instance-idp
IS_SAAS=false
LANGWATCH_CONNECT_DISABLED=true
AUTH_PROVIDER=okta
