# Deployment mode sh-connected: self-hosted, activated against a LangWatch-cloud
# stack (ADR-156). The developer supplies the activation code (LANGWATCH_LICENSE_KEY)
# and that stack's Connect endpoints; nothing licence-bearing is committed.
#! requires LANGWATCH_LICENSE_KEY LANGWATCH_CONNECT_LICENSE_ENDPOINT LANGWATCH_CONNECT_GATEWAY_ENDPOINT
LANGWATCH_DEPLOYMENT_MODE=sh-connected
IS_SAAS=false
LANGWATCH_CONNECT_DISABLED=false
