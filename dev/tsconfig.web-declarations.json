{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "strict": true,
    "jsx": "react-jsx",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node",
      "react",
      "react-dom",
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ],
    "rootDir": "..",
    "outDir": ".cache/web-declarations",
    "tsBuildInfoFile": ".cache/web-declarations/tsconfig.build.tsbuildinfo",
    "customConditions": [
      "langwatch-declaration-source"
    ],
    "noUncheckedIndexedAccess": true,
    "target": "es2023",
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  },
  "include": [
    "../modules/scenario/browser/src/**/*.ts",
    "../modules/scenario/browser/src/**/*.tsx",
    "../modules/scenario/browser/src/**/*.json",
    "../modules/trace/browser/src/**/*.ts",
    "../modules/trace/browser/src/**/*.tsx",
    "../modules/trace/browser/src/**/*.json",
    "../modules/langy/browser/src/**/*.ts",
    "../modules/langy/browser/src/**/*.tsx",
    "../modules/langy/browser/src/**/*.json",
    "../modules/project/browser/src/**/*.ts",
    "../modules/project/browser/src/**/*.tsx",
    "../modules/project/browser/src/**/*.json",
    "../modules/prompt/browser/src/**/*.ts",
    "../modules/prompt/browser/src/**/*.tsx",
    "../modules/prompt/browser/src/**/*.json",
    "../modules/model-provider/browser/src/**/*.ts",
    "../modules/model-provider/browser/src/**/*.tsx",
    "../modules/model-provider/browser/src/**/*.json",
    "../modules/workflow/browser/src/**/*.ts",
    "../modules/workflow/browser/src/**/*.tsx",
    "../modules/workflow/browser/src/**/*.json",
    "../modules/dataset/browser/src/**/*.ts",
    "../modules/dataset/browser/src/**/*.tsx",
    "../modules/dataset/browser/src/**/*.json",
    "../modules/experiment/browser/src/**/*.ts",
    "../modules/experiment/browser/src/**/*.tsx",
    "../modules/experiment/browser/src/**/*.json",
    "../modules/evaluator/browser/src/**/*.ts",
    "../modules/evaluator/browser/src/**/*.tsx",
    "../modules/evaluator/browser/src/**/*.json",
    "../modules/analytics/browser/src/**/*.ts",
    "../modules/analytics/browser/src/**/*.tsx",
    "../modules/analytics/browser/src/**/*.json",
  ],
  "files": [
    "../modules/analytics/browser/src/__tests__/lwql-fixtures.ts",
    "../modules/analytics/browser/src/testing.tsx",
    "../packages/browser-trpc/src/workflow-api.ts"
  ],
  "exclude": [
    "../modules/*/browser*/src/**/__tests__/**",
    "../modules/*/browser*/src/**/__mocks__/**",
    "../modules/*/browser*/src/**/tests/**",
    "../modules/*/browser*/src/**/*.test.*",
    "../modules/*/browser*/src/**/*.spec.*",
    "../modules/*/browser*/src/**/*.stories.*",
    "../modules/*/browser*/src/**/*.bench.*",
    "../modules/*/browser*/src/**/__bench__/**",
    "../modules/*/browser*/src/testing.ts",
    "../modules/*/browser*/src/testing.tsx"
  ],
