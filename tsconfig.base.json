{
  // tsconfig.shared.json plus the options only TypeScript 7 reads. Packages on
  // the sdk-toolchain catalog (TypeScript 6) extend tsconfig.shared.json
  // instead, since TypeScript 6 refuses an option it does not know.
  "extends": "./tsconfig.shared.json",
  "compilerOptions": {
    // One checker per project: each keeps its own type tables, so the default four
    // re-derive the same types (130M instantiations vs 73M) for ~20% more CPU and
    // ~0.2-1.7 GB more memory. See ADR-100's 2026-09-23 amendment.
    "checkers": 1,
  }
}
