{
	"$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",

	// SEVERITY IS THE TIER.
	//
	//   error — baseline is clean; blocks everywhere, for everyone.
	//   warn  — a real house rule that already has a baseline, so it cannot
	//           block the whole tree. CI runs reviewdog with
	//           `filter_mode: added` + `fail_level: warning`, which turns each
	//           of these into a BLOCKING failure on the lines a PR actually
	//           adds. New code is held to the full rule; existing code shows
	//           the warning and stops nobody.
	//
	// That is why there is no second "new code" config: the severity carries
	// the tier and reviewdog carries the scope.
	//
	// Baselines when these were switched on (biome 2.5.1 over src, ee, scripts,
	// e2e, prisma, vite, packages):
	//
	//   noExcessiveLinesPerFunction     3592
	//   noExcessiveCognitiveComplexity  2055
	//   useMaxParams                     324
	//   noEmptyBlockStatements            93
	//   noFloatingPromises                39
	//   noMisusedPromises                 19
	//   noForIn                            2
	//                                   ----
	//                                   6124 across 2807 files
	//
	// A hard error threshold was measured and rejected: the tail is long enough
	// that even maxLines 800 leaves 17 violations and complexity 75 leaves 28,
	// and functions over 1500 lines and complexity over 100 both exist. Any
	// threshold cheap enough to adopt was too loose to mean anything.
	//
	// Promote a rule to error once its baseline hits zero, and delete the
	// matching clause from /.coderabbit.yaml so it stops being reported twice.
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!src/server/modelProviders/llmModels.json",
			// Generated by `pnpm openapi:generate` (src/tasks/generateOpenAPISpec.ts),
			// never hand-edited, and past 1MB it trips Biome's maxSize into a
			// pathless "ignored file" notice that the new-violations gate then
			// counts as a regression. There is nothing to lint in it.
			"!src/app/api/openapiLangWatch.json",
			// `!!` is a HARD ignore: it applies even to files Biome pulls in
			// through the type graph rather than from the scan list. Needed
			// because this file is never scanned directly — it arrives as a
			// dependency of anything that imports the SDK.
			//
			// The published `langwatch` package inlines the whole REST API
			// schema into one .d.ts: `interface operations` alone is 11,998
			// lines, `interface paths` another 2,058, 525KB in total. Biome
			// gives up at 200,000 types and raises an INTERNAL diagnostic,
			// which it then repeats for every importing file.
			//
			// NOTE WHAT THIS DOES AND DOES NOT BUY. Biome was already unable
			// to analyse those types — it aborted on them. So the type-aware
			// rules (noFloatingPromises, noMisusedPromises) were ALREADY blind
			// wherever the SDK's types reach, and still are. This only stops
			// the crash being reported, it does not restore the coverage.
			//
			// The actual fix belongs in typescript-sdk/: its public types are
			// written as indexed lookups into the generated schema, e.g.
			// `paths["/api/evaluators"]["get"]["responses"]["200"]...`, and a
			// dts bundler cannot tree-shake an indexed access — it has to
			// inline the entire `paths` tree to keep the lookup resolvable.
			// Emitting the resolved shapes as named types instead would let it
			// ship only what is used. That is a change to a published package,
			// so it lands on an SDK release and a version bump here, not in
			// this config.
			"!!**/node_modules/langwatch/dist/*.d.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"complexity": {
				"noBannedTypes": "error",
				"noUselessThisAlias": "error",
				"noUselessTypeConstraint": "error",
				"useLiteralKeys": "error",
				"useOptionalChain": "error",
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": { "maxAllowedComplexity": 10 }
				},
				"noExcessiveLinesPerFunction": {
					"level": "warn",
					"options": {
						"maxLines": 60,
						"skipBlankLines": true,
						"skipIifes": true
					}
				},
				"useMaxParams": {
					"level": "warn",
					"options": { "max": 3 }
				}
			},
			"correctness": {
				"noNextAsyncClientComponent": "warn",
				"noPrecisionLoss": "error",
				"noUnusedImports": "error",
				"noUnusedVariables": "warn"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error"
			},
			"performance": {
				"noImgElement": "off",
				"noUnwantedPolyfillio": "warn",
				"useGoogleFontPreconnect": "warn",
				"noSyncScripts": "error"
			},
			"style": {
				"noHeadElement": "warn",
				"noInferrableTypes": "error",
				"noNamespace": "error",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"@chakra-ui/react": {
								"importNames": ["Dialog", "Drawer", "Modal"],
								"message": "Import Dialog or Drawer from ~/components/ui/dialog and ~/components/ui/drawer instead. Modal-style flows also use the Dialog wrapper (see AICreateModal, RunScenarioModal, etc.) — there is no Modal wrapper. The wrappers force a transparent backdrop (no dark grey overlay), wire focus/scroll defaults, and add an inline error boundary. Raw Chakra primitives reintroduce the dark backdrop we explicitly do not want."
							}
						}
					}
				},
				"useArrayLiterals": "error",
				"useAsConstAssertion": "error",
				"useConsistentArrayType": "off",
				"useConsistentTypeDefinitions": "off",
				"useForOf": "error",
				"useImportType": {
					"level": "warn"
				},
				"useShorthandFunctionType": "error"
			},
			"suspicious": {
				"noDocumentImportInPage": "error",
				"noEmptyBlockStatements": "error",
				"noEmptyInterface": "error",
				"noForIn": "error",
				"noExplicitAny": "off",
				"noExtraNonNullAssertion": "error",
				"noHeadImportInDocument": "error",
				"noMisleadingInstantiator": "error",
				"noNonNullAssertedOptionalChain": "error",
				"noTsIgnore": "off",
				"noUnsafeDeclarationMerging": "error",
				"useAdjacentOverloadSignatures": "error",
				"useAwait": "off",
				"useGoogleFontDisplay": "warn",
				"useNamespaceKeyword": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"indentStyle": "space",
			"indentWidth": 2,
			"bracketSameLine": false,
			"bracketSpacing": true,
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"overrides": [
		{
			"includes": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
			"linter": {
				"rules": {
					"complexity": {
						"noArguments": "error"
					},
					"correctness": {
						"noConstAssign": "off",
						"noGlobalObjectCalls": "off",
						"noInvalidConstructorSuper": "off",
						"noSetterReturn": "off",
						"noUndeclaredVariables": "off",
						"noUnreachable": "off",
						"noUnreachableSuper": "off"
					},
					"style": {
						"useConst": "error",
						"useSpreadOverApply": "error"
					},
					"suspicious": {
						"noDuplicateClassMembers": "off",
						"noDuplicateObjectKeys": "off",
						"noDuplicateParameters": "off",
						"noFunctionAssign": "off",
						"noImportAssign": "off",
						"noRedeclare": "off",
						"noUnsafeNegation": "off",
						"noVar": "error",
						"useGetterReturn": "off"
					}
				}
			}
		},
		{
			// The SCIM implementation moved from src/server/scim to ee/scim so
			// the Enterprise license covers it (#4830). Its complexity findings
			// predate the move and were already tolerated at the old path via
			// the repo-wide baseline; the relocation must not force a rewrite
			// of a working provisioning flow, so the same tolerance follows the
			// files to their licensed home. New ee/scim code still gets the
			// rules via fresh files.
			"includes": [
				"ee/scim/routes.ts",
				"ee/scim/scim-group.service.ts",
				"ee/scim/scim.service.ts",
				"ee/scim/webhooks.ts"
			],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveCognitiveComplexity": "off",
						"noExcessiveLinesPerFunction": "off"
					}
				}
			}
		},
		{
			// e2e/ and scripts/dogfood/ are throwaway operator scripts — browser
			// QA walkthroughs and seed/demo tooling — not product code. They are
			// full of best-effort `catch {}` around actions allowed to fail, and
			// fire-and-forget awaits. Same category as the test-file exemption
			// below; they ship to nobody.
			//
			// The complexity trio is off here for a different reason than the
			// promise rules above. A browser walkthrough is one long linear
			// script — navigate, click, assert, repeat — and its cognitive
			// complexity is a count of the steps in the flow, not of anything
			// tangled. Splitting `parseSetCookie` or a 4-argument `signUp(ctx,
			// email, password, name)` into smaller pieces to satisfy a limit
			// makes the flow harder to follow, not easier, so the rules would
			// only ever be silenced file by file.
			"includes": ["e2e/**", "scripts/dogfood/**", "scripts/_dogfood_*"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveCognitiveComplexity": "off",
						"noExcessiveLinesPerFunction": "off",
						"useMaxParams": "off"
					},
					"nursery": {
						"noFloatingPromises": "off",
						"noMisusedPromises": "off"
					},
					"suspicious": {
						"noEmptyBlockStatements": "off"
					}
				}
			}
		},
		{
			// A floating promise in a test is still an unhandled rejection, but
			// these are assertion chains and setup calls where the assertion
			// already owns the failure. Scoped to test files only.
			"includes": ["**/__tests__/**"],
			"linter": {
				"rules": {
					"nursery": {
						"noFloatingPromises": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/*.spec.ts",
				"**/*.spec.tsx",
				"**/__tests__/**"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noEmptyBlockStatements": "off",

						// Test-quality rules, scoped to test files on purpose:
						// unscoped, noFocusedTests matches any function called
						// `fit(...)` and fires on a production zoom hook.
						//
						// Severity by measured baseline, same doctrine as above.
						//   noFocusedTests        0  — a merged `.only` silently
						//                              disables the rest of its file
						//   noDuplicateTestHooks  0
						//   noExportsInTest       1
						//   noSkippedTests        0  — burned down from 110; every
						//                              skip was implemented, repaired
						//                              or removed. Conditional
						//                              skipIf(env) remains allowed.
						//   noMisplacedAssertion  0  — burned down from 172: aliased
						//                              its became it.runIf, assertion
						//                              helpers became projections
						//                              asserted inside the it(), and
						//                              lookup helpers throw like
						//                              testing-library get* queries
						"noFocusedTests": "error",
						"noDuplicateTestHooks": "error",
						"noExportsInTest": "warn",
						"noSkippedTests": "error",
						"noMisplacedAssertion": "error"
					},
					"nursery": {
						"useTestHooksOnTop": "error"
					},
					"complexity": {
						"noExcessiveNestedTestSuites": "error",

						// A `describe` callback is a suite declaration, not a
						// function, and its length counts the cases covered —
						// the one number a test file is meant to grow. CLAUDE.md
						// mandates the nested `describe("given …") /
						// describe("when …")` structure that makes the outer
						// callback span the whole file, so every well-formed
						// suite past ~60 lines trips this, and the only edit
						// that satisfies it splits the file on a boundary the
						// rule picked rather than the subject did.
						// `noExcessiveNestedTestSuites` above is the rule that
						// actually governs the shape of a suite.
						"noExcessiveLinesPerFunction": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.tsx"],
			"linter": {
				"rules": {
					"nursery": {
						"noMisusedPromises": "off"
					}
				}
			}
		},
		{
			"includes": [
				"src/components/ui/dialog.tsx",
				"src/components/ui/drawer.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
