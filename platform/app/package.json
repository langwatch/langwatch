{
  "name": "@langwatch/web",
  "version": "3.16.0",
  "private": true,
  "workspaces": [],
  "scripts": {
    "build:server": "node scripts/build-server.mjs",
    "generate:task-registry": "node scripts/generate-task-registry.mjs",
    "build": "pnpm run start:prepare:files && NODE_ENV=production BUILD_TIME=1 vite build && pnpm run build:server",
    "build:client": "NODE_ENV=production vite build",
    "lint": "node ../../dev/scripts/check-queue.mjs pnpm exec biome lint ./src ./ee ./scripts ./e2e ./prisma ./vite --max-diagnostics=1000",
    "lint:plugins": "node ../../dev/scripts/check-queue.mjs pnpm exec biome lint --only=plugin --max-diagnostics=none ./src ./ee",
    "lint:fix": "node ../../dev/scripts/check-queue.mjs pnpm exec biome lint --write ./src ./ee ./scripts ./e2e ./prisma ./vite --max-diagnostics=1000",
    "check:feature-parity": "tsx scripts/check-feature-parity.ts",
    "check:openapi-completeness": "tsx scripts/check-openapi-completeness.ts",
    "check:openapi-route-coverage": "tsx scripts/check-openapi-route-coverage.ts",
    "format": "node ../../dev/scripts/check-queue.mjs pnpm exec oxfmt --write --config ../../.oxfmtrc.json --disable-nested-config src ee scripts e2e prisma vite",
    "postinstall": "make -C ../.. setup-hooks 2>/dev/null || true; node ../../dev/scripts/install-check-shims.mjs || true",
    "dev": "WORKERS_IN_PROCESS=1 pnpm run dev:app",
    "dev:app": "NODE_ENV=development ./scripts/check-ports.sh && pnpm run start:prepare:files && NODE_ENV=development FORCE_COLOR=1 node ../../dev/scripts/dev-supervisor.mjs pnpm start 2>&1 | tee server.log",
    "dev:worker": "NODE_ENV=development pnpm run start:prepare:files && NODE_ENV=development FORCE_COLOR=1 node ../../dev/scripts/dev-supervisor.mjs pnpm run start:workers:dev",
    "dev:concurrent": "START_WORKERS=true pnpm run dev:app",
    "dev:vite": "vite",
    "dev:clean": "rm -rf node_modules/.vite .dev-certs && echo 'Vite cache and dev certs cleared. Restart dev server.'",
    "start": "./scripts/start.sh",
    "start:app": "node --enable-source-maps dist/server/server.cjs",
    "start:app:dev": "NODE_ENV=development tsx src/server.mts",
    "start:prepare:files": "pnpm run ensure:ai-gateway-secrets && pnpm run copy:langevals-types && pnpm run prisma:generate:typescript && pnpm run build:typescript-sdk && pnpm run build:mcp-server && pnpm run generate:langy-skills && pnpm run generate:setup-skill-bodies && pnpm run generate:task-registry",
    "ensure:ai-gateway-secrets": "bash scripts/ensure-ai-gateway-secrets.sh",
    "build:typescript-sdk": "pnpm --filter langwatch run build",
    "build:mcp-server": "./scripts/build-mcp-server.sh",
    "start:prepare:db": "pnpm run prisma:migrate && pnpm run clickhouse:migrate && pnpm run lwql:provision",
    "start:workers": "node --enable-source-maps dist/server/workers.cjs",
    "start:workers:dev": "tsx src/workers.ts",
    "typecheck": "node ../../dev/scripts/check-queue.mjs ./node_modules/.bin/tsc --noEmit --project ./tsconfig.tsgo.json",
    "typecheck:tests": "node ../../dev/scripts/check-queue.mjs ./node_modules/.bin/tsc --noEmit --project ./tsconfig.tsgo.tests.json",
    "typecheck:all": "node ../../dev/scripts/check-queue.mjs ./node_modules/.bin/tsc --noEmit --project ./tsconfig.tsgo.all.json",
    "test:unit": "NODE_ENV=test PINO_LOG_LEVEL=warn vitest",
    "test:browser": "NODE_ENV=test PINO_LOG_LEVEL=warn vitest -c vitest.browser.config.ts",
    "test:ci": "pnpm run test:unit",
    "test:component": "NODE_ENV=test PINO_LOG_LEVEL=warn vitest -c vitest.component.config.ts",
    "test:integration": "NODE_ENV=test PINO_LOG_LEVEL=warn vitest -c vitest.integration.config.ts",
    "test:pg-integration": "NODE_ENV=test PINO_LOG_LEVEL=warn vitest -c vitest.pg-integration.config.ts",
    "test:stress": "NODE_ENV=test PINO_LOG_LEVEL=warn vitest -c vitest.stress.config.ts",
    "test:stripe-integration": "NODE_ENV=test PINO_LOG_LEVEL=warn vitest -c vitest.stripe-integration.config.ts",
    "task": "./scripts/run-task.sh",
    "task:backfill-datasets-s3": "pnpm run task backfillDatasetContentToS3",
    "task:migrate-object-storage": "NODE_OPTIONS=--max-old-space-size=4096 pnpm run task migrateObjectStorage",
    "prisma:generate:typescript": "pnpm prisma generate",
    "prisma:generate:migration": "pnpm prisma migrate dev --create-only",
    "prisma:migrate": "sh -c 'if [ \"$SKIP_PRISMA_MIGRATE\" != \"true\" ]; then pnpm prisma migrate deploy; else echo \"Skipping Prisma migrations\"; fi'",
    "prisma:seed": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.portless prisma/seed.ts",
    "seed:sample-traces": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.portless scripts/seed-sample-traces.ts",
    "seed:realistic-platform": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.portless scripts/seed-realistic-platform-data.ts",
    "seed:mass": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.portless scripts/seed-mass.ts",
    "seed:retention": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.portless scripts/seed-retention.ts",
    "seed:langy-prompts": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.portless scripts/seed-langy-prompts.ts",
    "clickhouse:migrate": "sh -c 'if [ \"$SKIP_CLICKHOUSE_MIGRATE\" != \"true\" ]; then pnpm run task clickhouseMigrate; else echo \"Skipping ClickHouse migrations\"; fi'",
    "lwql:provision": "sh -c 'if [ \"$SKIP_LWQL_PROVISION\" != \"true\" ]; then pnpm run task provisionLwql; else echo \"Skipping LangWatchQL provisioning\"; fi'",
    "copy:langevals-types": "cp ../../services/langevals/ts-integration/evaluators.generated.ts src/server/evaluations/evaluators.generated.ts",
    "tsc-watch": "tsc --noEmit --watch",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:save-auth-state": "tsx e2e/save-auth-state.ts",
    "test:e2e:codegen": "playwright codegen --load-storage=./e2e/auth.json http://localhost:5560/",
    "test:e2e:langevals-staging": "bash -c 'eval \"$(aws --profile ${AWS_PROFILE:-lw-dev} configure export-credentials --format env)\" && S3_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID S3_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY S3_SESSION_TOKEN=$AWS_SESSION_TOKEN S3_BUCKET_NAME=${S3_BUCKET_NAME:-runtime-storage-dev} S3_REGION=${S3_REGION:-eu-central-1} LANGEVALS_E2E_ENABLED=1 LANGEVALS_STAGING_THRESHOLD_BYTES=200 EVAL_MAX_PAYLOAD_BYTES=20000000 TOPIC_CLUSTERING_MAX_PAYLOAD_BYTES=200000000 vitest run src/server/langevals/__tests__/stagedFetch.e2e.test.ts --reporter verbose'",
    "licenses": "pnpx license-checker --summary && pnpx license-checker --json > licenses.json && echo \"Full licenses report saved to licenses.json\"",
    "generate:langy-skills": "tsx scripts/generate-langy-skills.ts",
    "generate:setup-skill-bodies": "tsx scripts/generate-setup-skill-bodies.ts",
    "generate:vega-validator": "tsx scripts/generate-vega-lite-validator.ts"
  },
