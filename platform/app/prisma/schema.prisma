enum RetentionPolicyScopeType {
  ORGANIZATION
  TEAM
  PROJECT
}

// A data-retention override for one category at one scope. Single-scope-per-row
// (ADR-021): the row applies at exactly one scope, identified inline by
// (scopeType, scopeId), anchored to one owning organization. Resolution cascades
// PROJECT -> TEAM -> ORGANIZATION -> platform default (49 days), per category,
// so an org admin can set a retention once and have it apply to every project
// that has no closer override. The ClickHouse migration default for rows that
// predate the retention column is separate and intentionally 308 days.
// One row per (scope, category): each row holds a single category's day count,
// so categories cascade independently.
model RetentionPolicy {
  id             String                   @id @default(nanoid())
  organizationId String
  scopeType      RetentionPolicyScopeType
  scopeId        String
  category       String
  retentionDays  Int
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @default(now()) @updatedAt

  @@unique([scopeType, scopeId, category])
  @@index([organizationId])
  @@index([scopeType, scopeId])
}

enum DataPrivacyScopeType {
  ORGANIZATION
  DEPARTMENT
  TEAM
  PROJECT
}

// A data-privacy rule for one scope (ADR-021): single-scope-per-row, identified
// inline by (scopeType, scopeId, personalOnly), anchored to one owning
// organization. `config` is a DataPrivacyConfig JSON blob (see
// src/server/data-privacy/dataPrivacy.types.ts) covering content disposition per
// category (capture / restrict / drop), the restrict audience, the PII level,
// secrets redaction, and extra attribute keys to drop. Resolution cascades
// PROJECT -> DEPARTMENT -> TEAM -> ORGANIZATION per field; unset fields inherit
// and list fields (custom drop-keys, custom secret patterns) union down the
// chain. `personalOnly` narrows an ORGANIZATION or DEPARTMENT rule to personal
// (per-user) projects; for those the department is resolved through the project
// owner. With no rule anywhere, platform defaults apply (content captured and
// visible to the team, essential PII, secrets redacted).
model DataPrivacyPolicy {
  id             String               @id @default(nanoid())
  organizationId String
  scopeType      DataPrivacyScopeType
  scopeId        String
  personalOnly   Boolean              @default(false)
  config         Json
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt

  @@unique([scopeType, scopeId, personalOnly])
  @@index([organizationId])
  @@index([scopeType, scopeId])
}

