  project       Project           @relation(fields: [projectId], references: [id])
  costType      CostType
  costName      String?
  referenceType CostReferenceType
  referenceId   String
  amount        Float
  currency      String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  extraInfo     Json?

  @@index([referenceType, referenceId])
  @@index([costType])
  @@index([projectId])
  @@index([projectId, createdAt])
}

/// PROJECTION of the topic-clustering event stream (ADR-051): topics are
/// `topics_recorded` events; this table is written ONLY by
/// TopicModelFoldProjection (cursor: TopicModelProjection) and is
/// rebuildable by replay. Kept named `Topic` because it is the domain
/// entity every surface reads — the `*Projection` suffix is reserved for
/// cursor/read-model tables.
model Topic {
  id        String  @id @default(nanoid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  name      String
  parentId  String?
  parent    Topic?  @relation("Subtopics", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subtopics Topic[] @relation("Subtopics")

  embeddings_model       String
  centroid               Json
  p95Distance            Float
  automaticallyGenerated Boolean @default(true)

  /// The `topics_recorded` event that recorded this topic (its id in the
  /// event log). Null means the row predates event ownership and has not
  /// been seeded onto the stream yet; the projection sets it on every row
  /// it writes.
  lastEventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([parentId])
  @@index([projectId])
}

model Dataset {
  id               String            @id @default(nanoid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id])
  name             String
  slug             String
  columnTypes      Json
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  archivedAt       DateTime?
  datasetRecords   DatasetRecord[]
  batchEvaluations BatchEvaluation[]
  mapping          Json?
  useS3            Boolean           @default(false)
  s3RecordCount    Int?
  // ADR-032: dataset content moves to S3 as chunked JSONL.
  // `useS3` above is the legacy single-blob path, superseded by `contentLayout`
  // (still write-enabled for `useCustomS3` orgs, left untouched); the new layout
  // is marked by `contentLayout` so old pods mid-rolling-deploy don't misroute.
  contentLayout    String            @default("postgres") // postgres | s3_jsonl
  status           String            @default("ready") // uploading | processing | ready | failed
  statusError      String?
  // Server-owned staging key bound to the row at presign time, so finalize
  // never trusts a client-supplied key (ADR-032 D4 / C1).
  stagingKey       String?
  // Original upload filename, captured at presign so the normalize job can
  // detect the file format (CSV/JSONL/JSON) — the staged object carries no name.
  uploadFilename   String?
  rowCount         Int?
  sizeBytes        BigInt?
  chunkCount       Int?
  chunkOffsets     Json?

  @@unique([projectId, slug])
}

model DatasetRecord {
  id        String   @id @default(nanoid())
  datasetId String
  dataset   Dataset  @relation(fields: [datasetId], references: [id])
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  entry     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([datasetId])
  @@index([projectId])
  @@index([createdAt])
  // Serves the per-project entry counts the dataset lists render, and the
  // project-scoped record reads on the editor page, as an index-only scan.
  // Without it the planner has to combine the two single-column indexes and
  // falls back to a sequential scan once a project's rows dominate the table.
  @@index([projectId, datasetId])
}

model Dashboard {
  id        String        @id @default(nanoid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id])
  name      String
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  graphs    CustomGraph[]

  @@index([projectId])
  @@index([projectId, order])
  @@map("Dashboard")
}

model SavedView {
  id        String   @id @default(nanoid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  filters   Json     @default("{}")
  query     String?
  period    Json?
  order     Int      @default(0)
  /// Discriminator for the two storage shapes that share this table:
  ///   - "v1-traces-filter" (default) - legacy /messages page filter map saved views
  ///   - "v2-traces-lens"             - new traces v2 lens configs (columns, addons, grouping, sort, filterText) encoded inside `filters` JSON
  /// Each client filters by its own kind on read so neither sees the other's rows.
  kind      String   @default("v1-traces-filter")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([projectId])
  @@index([projectId, order])
  @@index([userId])
  @@index([projectId, kind, order])
}

model CustomGraph {
  id        String   @id @default(nanoid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  name      String
  /// The chart's definition, in the shape its `kind` names.
  graph     Json
  filters   Json?
  /// Discriminator for the two chart shapes that share this table:
  ///   - "builder" (default) - the chart builder's own `graph` payload
  ///   - "workbench_sql"     - a saved LangWatchQL workbench chart, whose
  ///     `graph` holds the versioned { sql, parameters, vegaLiteSpec }
  ///     definition (see server/analytics/saved-workbench-charts)
  /// Each reader filters by its own kind, so neither sees the other's rows and
  /// a builder chart can never be interpreted as a workbench definition.
  kind      String   @default("builder")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Report page relationship
  dashboardId String?
  dashboard   Dashboard? @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  // Grid positioning (2-column grid)
  gridColumn  Int           @default(0)
  gridRow     Int           @default(0)
  colSpan     Int           @default(1)
  rowSpan     Int           @default(1)
  trigger     Trigger?
  TriggerSent TriggerSent[]

  @@index([projectId])
  @@index([dashboardId])
  @@index([projectId, kind])
}

model BatchEvaluation {
  id           String     @id @default(nanoid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id])
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id])
  data         Json       @default("{}")
  status       String
  score        Float
  label        String?
  passed       Boolean
  details      String
  cost         Float
  datasetSlug  String
  datasetId    String
  dataset      Dataset    @relation(fields: [datasetId], references: [id])
  evaluation   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  @@unique([id])
  @@index([projectId])
  @@index([datasetId])
  @@index([experimentId])
}

enum TriggerAction {
  SEND_EMAIL
  ADD_TO_DATASET
  ADD_TO_ANNOTATION_QUEUE
  SEND_SLACK_MESSAGE
  SEND_WEBHOOK
}

// The three automation kinds, distinguished by WHAT FIRES them (ADR-042):
// AUTOMATION = an event (a trace matches filters); ALERT = a condition (a
// custom-graph metric crosses a threshold); REPORT = a schedule (a calendar
// cron). Backfilled from the legacy `customGraphId != null` heuristic.
enum TriggerKind {
  AUTOMATION
  ALERT
  REPORT
}

enum AlertType {
  CRITICAL
  WARNING
  INFO
}

model Trigger {
  id                   String                    @id @default(nanoid())
  name                 String
  projectId            String
  project              Project                   @relation(fields: [projectId], references: [id])
  action               TriggerAction
  // ADR-042: the automation kind. Backfilled AUTOMATION/ALERT from
  // customGraphId; REPORT is set by the scheduled-report upsert path.
  triggerKind          TriggerKind               @default(AUTOMATION)
  actionParams         Json
  // Legacy structured filter object (FilterField -> values). Retained for
  // back-compat; new trace-subject automations author `filterQuery` instead
  // and persist `filters` as an empty `{}`.
  filters              Json
  // ADR-043 Subject facet: the Traces-V2 liqe query string that defines which
  // traces this automation is about. NULL = legacy `filters`-driven trigger.
  // Evaluated in-memory against fold state at dispatch (never per-trace CH),
  // fail-closed on any unevaluable field.
  filterQuery          String?
  lastRunAt            Float                     @default(0)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @default(now()) @updatedAt
  active               Boolean                   @default(true)
  // Why the platform paused this automation, and when. NULL means it was not
  // paused by the platform: `active = false` alone cannot distinguish an
  // automation a customer switched off from one runaway containment stopped,
  // and resuming must clear both. Today the only value is "runaway_volume".
  pausedReason         String?
  pausedAt             DateTime?                 @db.Timestamptz(3)
  message              String?
  deleted              Boolean                   @default(false)
  alertType            AlertType?
  // Customer-authored Liquid notification templates (see ADR-036). NULL on any
  // column means "render with the framework default", so existing triggers are
  // unchanged. slackTemplateType discriminates 'string' | 'block_kit'.
  slackTemplateType    String?
  slackTemplate        String?
  emailSubjectTemplate String?
  emailBodyTemplate    String?
  // Per-trigger digest cadence (ADR-026). Ignored for persist actions.
  // Values: 'immediate' | '5min_digest' | '15min_digest' | 'hourly_digest'.
  notificationCadence  String                    @default("immediate")
  // Per-trigger trace-readiness debounce in ms (ADR-026). The column
  // applies to every action class — a persist row captured before the
  // trace settles diverges from the trace UI permanently. Today only
  // notify-class triggers actually read this (they route through the
  // outbox settle stage); persist-class triggers still dispatch inline
  // until the persist-side debounce wiring lands. The column default
  // is set so a future code change can enable persist-side debounce
  // without a schema migration.
  traceDebounceMs      Int                       @default(30000)
  TriggerSent          TriggerSent[]
  webhookDeliveries    WebhookEndpointDelivery[]
  customGraphId        String?                   @unique
  customGraph          CustomGraph?              @relation(fields: [customGraphId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum WebhookDeliveryOutcome {
  success
  retryable
  terminal
  pending
}

/// Org-anchored outbound webhook endpoint (the webhook platform, enterprise
/// only). The signing secret is AES-256-GCM encrypted at rest (shared
/// encrypt/decrypt, CREDENTIALS_SECRET) and returned in plaintext exactly
/// once, at create or roll time. `enabledEvents` holds registry event types
/// or family wildcards ("gateway.*", "*"). Failure-streak columns drive the
/// 72h auto-disable. Spec: specs/webhooks/webhook-endpoints.feature.
model WebhookEndpoint {
  id                          String                 @id
  organizationId              String
  organization                Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Where this endpoint delivers. Everything above the last hop is shared:
  /// same batching, same retry ladder, same delivery log, same signature over
  /// the same bytes.
  destinationKind             WebhookDestinationKind @default(http)
  /// The receiver URL. Present on `http` endpoints and null on the others;
  /// the per-kind shape is pinned by a CHECK constraint Prisma cannot model.
  url                         String?
  /// The Amazon SQS queue this endpoint delivers to, on `sqs` endpoints. The
  /// region and the owning account are read off it rather than configured
  /// separately, so they can never disagree with the queue.
  sqsQueueUrl                 String?
  /// The role we assume to write to the queue, and the ExternalId that proves
  /// the request came from us rather than from anyone who learned the role's
  /// name. The recommended credential mode.
  sqsRoleArn                  String?
  sqsExternalId               String?
  /// A static key pair for the queue, encrypted at rest exactly like the
  /// signing secret. Both halves are present or both are absent: a half-filled
  /// pair is what the AWS SDK reads as "we have credentials" and stops looking
  /// with, so the CHECK constraint refuses it.
  sqsAccessKeyId              String?
  sqsSecretAccessKeyEncrypted String?
  secretEncrypted             String
  /// The secret this endpoint signed with before the last roll. Deliveries
  /// carry a second `v1=` computed from it until it expires, so a receiver
  /// swaps secrets on its own schedule instead of dropping deliveries in the
  /// gap. Null once the window closes or if the secret was never rolled.
  previousSecretEncrypted     String?
  /// When the previous secret stops being signed with and accepted.
  previousSecretExpiresAt     DateTime?
  enabledEvents               String[]               @default([])
  status                      WebhookEndpointStatus  @default(ACTIVE)
  /// Why the endpoint is disabled: "auto_failures_72h" or "manual".
  disabledReason              String?
  disabledAt                  DateTime?
  /// Start of the current consecutive-failure streak; cleared on any 2xx.
  /// 72 hours of unbroken failures from this instant auto-disables.
  failingSince                DateTime?
  /// Delivery controls, each server-bounded (see webhookDeliveryControls
  /// constants): envelopes per POST, coalescing window before a partial
  /// batch ships, and concurrent POSTs to this receiver.
  maxBatchSize                Int                    @default(100)
  maxBatchDelayMs             Int                    @default(250)
  maxInFlight                 Int                    @default(4)
  lastSuccessAt               DateTime?
  lastFailureAt               DateTime?
  archivedAt                  DateTime?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @default(now()) @updatedAt

  deliveries WebhookEndpointDelivery[]

  @@index([organizationId, status])
}

/// The last hop a webhook endpoint delivers over. Lowercase because these
/// values are the wire spelling: the same strings appear in the REST DTO,
/// both SDKs and the CLI.
enum WebhookDestinationKind {
  http
  sqs
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

/// Which webhook pipeline wrote a delivery row, and therefore which columns
/// carry its tenancy: `platform` rows anchor on organizationId + endpointId,
/// `automations` rows on projectId + triggerId.
enum WebhookDeliveryChannel {
  platform
  automations
}

/// The per-ATTEMPT delivery log for BOTH webhook channels: the endpoints
/// platform's batches and the automations channel's trigger fires. One row per
/// HTTP attempt; `dispatchId` groups every attempt of one logical send (the
/// value of the X-LangWatch-Delivery-Id or X-LangWatch-Event-Id header). A slim
/// facts table: outcome, status, latency, a capped error message, and a
/// truncated copy of a failure response. Our request content (URL, headers,
/// body) is never stored. Pruned after 30 days.
///
/// The two channels used to keep separate tables with the same columns and two
/// prune implementations. They are one table with a discriminator now, so the
/// tenancy columns of the channel that did not write a row are null.
model WebhookEndpointDelivery {
  id             String                 @id @default(nanoid())
  channel        WebhookDeliveryChannel @default(platform)
  /// Platform tenancy. Null on automations rows.
  organizationId String?
  endpointId     String?
  endpoint       WebhookEndpoint?       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  /// Automations tenancy. Null on platform rows.
  projectId      String?
  project        Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  triggerId      String?
  trigger        Trigger?               @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  dispatchId     String
  /// 1-based attempt and the batch's envelope count. Both null on automations
  /// rows, which record neither: one trigger fire is one event, and the
  /// channel's sender does not thread its attempt number into the log.
  attempt        Int?
  eventCount     Int?
  responseStatus Int?
  latencyMs      Int?
  error          String?
  response       Json?
  outcome        WebhookDeliveryOutcome
  firedAt        DateTime               @default(now())
  createdAt      DateTime               @default(now())

  @@index([endpointId, firedAt])
  @@index([organizationId, firedAt])
  @@index([firedAt])
  @@index([endpointId, dispatchId])
  @@index([projectId, triggerId, firedAt])
  @@index([projectId, triggerId, dispatchId])
}

enum ExperimentType {
  DSPY
  BATCH_EVALUATION
  BATCH_EVALUATION_V2
  EVALUATIONS_V3
}

model Experiment {
  id               String            @id @default(nanoid())
  name             String?
  type             ExperimentType
  slug             String
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id])
  workflowId       String?
  workflow         Workflow?         @relation(fields: [workflowId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  archivedAt       DateTime?
  batchEvaluations BatchEvaluation[]
  workbenchState   Json?
  monitor          Monitor?

  // Monotonic counter for the workbench state. Every accepted write bumps it
  // by one, and the bump is the compare-and-set guard: a writer names the
  // version it read, and a write whose expected version no longer matches the
  // stored one is refused before anything is written. Existing rows read 0.
  workbenchVersion Int               @default(0)

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([workflowId])
  @@index([projectId, archivedAt])
}

// One snapshot of an experiment's workbench state, at one version.
//
// Ordinary typing in the workbench writes a single rolling row with
// `autoSaved = true`, updated in place so a long editing session does not
// leave one row per keystroke behind. That row is shown as "Autosave" and
// carries no number a person reads. A commit, an agent write and a restore
// each write a new `autoSaved = false` row, and those rows are numbered
// 1, 2, 3 with no gaps: the number is one higher than the highest numbered
// row of the experiment, not the counter.
//
// `state` never carries run results: those live only on the live experiment
// row, because a snapshot exists to restore a setup, not to replay an old run.
// A restore therefore writes the snapshot's setup and carries the live row's
// current results across, so bringing an old setup back never clears the
// output cells and evaluator scores of the run the experiment holds now.
model ExperimentVersion {
  id             String @id @default(nanoid())
  experimentId   String
  projectId      String
  /// The number the version is addressed and displayed by. Numbered rows hold
  /// a gap-free sequence. The rolling autosave row rides on the counter
  /// instead, which is what keeps it clear of that sequence.
  version        Int
  /// `Experiment.workbenchVersion` at the moment this row was last written.
  /// The rolling row is rewritten in place, so this is the only column that
  /// says how recent its content is, and the version list sorts and pages by
  /// it. It also joins a row to the live state: the row whose `counterVersion`
  /// equals the experiment's counter holds what the workbench shows now.
  counterVersion Int

  autoSaved     Boolean @default(false)
  commitMessage String?

  authorId String?
  /// Who wrote this version: "user", "langy" or "api".
  authorLabel String

  state Json
  /// Schema version of `state`, so a later shape change can be read forward.
  schemaVersion String @default("1")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([experimentId, version])
  @@index([projectId, experimentId, autoSaved])
  // A restore reads one version number of one experiment, and a numbered write
  // reads the highest number that experiment holds. Both name all three
  // columns, so the sort key belongs in the index rather than being applied to
  // fetched rows.
  @@index([projectId, experimentId, version])
  // The version list pages by counterVersion inside one experiment.
  @@index([projectId, experimentId, counterVersion])
  @@index([createdAt])
}

// Annotation - a reviewer's comment on a trace, or on one part of it.
//
// anchorKind/anchorId/anchorPath record which part the comment is about. All
// three null means the trace as a whole, which is what every surface that reads
// whole traces (the annotations list, the queue, the trace projections that
// feed the table and the dataset columns, the REST list endpoints) reads.
// Plain strings rather than an enum: a fourth kind of part is then a code
// change and not a schema migration, and a kind this build does not recognise
// reads as a comment about the trace rather than failing the list.
model Annotation {
  id             String   @id @default(nanoid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  traceId        String
  comment        String?
  isThumbsUp     Boolean?
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  email          String?
  scoreOptions   Json?
  expectedOutput String?
  // "span" | "field" | "message"; null = the trace as a whole
  anchorKind     String?
  // The element the comment names: a spanId for span and field anchors, the
  // turn's traceId for a message anchor
  anchorId       String?
  // What inside that element: "output", "params.temperature", or a message's
  // key; null = the whole element
  anchorPath     String?

  @@index([projectId])
  @@index([traceId])
  @@index([userId])
  @@index([projectId, traceId])
  @@index([projectId, traceId, anchorKind])
}

// ModelProvider - org-scoped, multi-scope provider configuration.
//
// Iter 110: absorbed GatewayProviderCredential entirely. The gateway
// data-plane reads its provider chain directly from ModelProvider +
// RoutingPolicy.modelProviderIds. Multi-deployment (Azure regions,
// OpenAI base-url variants) ships as N MP rows with auto-suffixed
// names (iter 109 pattern) - no `slot` discriminator column anymore.
//
// Access via ModelProviderScope only. No `projectId` legacy pointer;
// reads filter by the caller's membership set against scope rows.
//
// "Advanced (Gateway)" tab in the drawer surfaces the rate-limit /
// extraHeaders / providerConfig / fallbackPriorityGlobal / health
// fields below - same fields that lived on GatewayProviderCredential
// pre-110, just collapsed onto the provider they always 1:1-bound.
model ModelProvider {
  id                     String  @id @default(nanoid())
  // Human-readable name (iter 109): one "OpenAI" by default, auto-
  // suffixed as "OpenAI 2" / "OpenAI 3" when duplicates coexist
  // under the same organization. Model selectors use this to group
  // options when multiple instances of the same provider are in
  // scope for a project.
  name                   String
  provider               String
  // Operator-chosen slug that addresses THIS instance in a gateway model
  // string ("eu/claude-sonnet-5"). A provider family prefix names a kind, so
  // with two Anthropic rows on one key "anthropic/..." matches both and the
  // chain order decides; a handle is the name that pins one row. Lowercase
  // [a-z0-9][a-z0-9_-]*, at most 32 characters, unique per organization, and
  // never a provider family spelling. Null when the operator set none.
  routingHandle          String?
  enabled                Boolean
  customKeys             Json?
  // Provider-side custom headers - appended on every request the
  // gateway routes through this MP. (Pre-110 this lived on GPC.)
  extraHeaders           Json?
  customModels           Json?
  customEmbeddingsModels Json?
  deploymentMapping      Json?

  // Gateway rate-limits (advanced). Optional caps applied per MP.
  rateLimitRpm Int?
  rateLimitTpm Int?
  rateLimitRpd Int?

  // Per-MP credential rotation policy (gateway-only). v1 ships MANUAL
  // only; AUTO + external-secret-store integration are v1.1 scope.
  rotationPolicy GatewayProviderRotationPolicy @default(MANUAL)

  // Provider-specific routing hints (e.g. bedrock region, azure
  // deployment override). Gateway applies on top of standard config.
  providerConfig Json?

  // Fallback priority used when a VK has no RoutingPolicy. Lower =
  // tried first. Tiebreak by createdAt ASC. Deterministic across runs.
  fallbackPriorityGlobal Int?

  // Health / circuit breaker state written by the gateway.
  healthStatus      GatewayProviderHealthStatus @default(UNKNOWN)
  circuitOpenedAt   DateTime?
  lastHealthCheckAt DateTime?

  disabledAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @default(now()) @updatedAt
  scopes     ModelProviderScope[]

  // Single-organization tenancy anchor (ADR-021). Every scope of a given
  // provider resolves to the same organization, so this column is that org.
  organizationId String

  // A handle names ONE row inside the organization, so the database owns the
  // rule the gateway reads. Declared here rather than only in the migration:
  // an index Prisma cannot see in the schema is drift to it, and the next
  // `migrate dev` writes a DROP INDEX for it. Postgres treats NULLs as
  // distinct in a unique index, so every row without a handle still fits.
  @@unique([organizationId, routingHandle])
  @@index([healthStatus])
  @@index([fallbackPriorityGlobal])
  @@index([organizationId])
}

// Principal-style N-scope access (iter 109, ADR-016 follow-up): a
// single ModelProvider row can be visible to multiple organizations,
// teams, or projects. scopeType is one of "ORGANIZATION" / "TEAM" /
// "PROJECT"; scopeId is the matching id of the scoping entity.
// Writing an entry requires the caller to hold the matching manage-
// permission on that entity (organization:manage, team:manage,
// project:manage). Reads filter by the caller's membership set.
// scopeType uses its own Postgres enum following the per-table
// convention (RoleBindingScopeType / GatewayBudgetScopeType / etc).
// See dev/docs/best_practices/scoped-resources.md.
enum ModelProviderScopeType {
  ORGANIZATION
  TEAM
  PROJECT
}

model ModelProviderScope {
  id              String                 @id @default(nanoid())
  modelProviderId String
  modelProvider   ModelProvider          @relation(fields: [modelProviderId], references: [id], onDelete: Cascade)
  scopeType       ModelProviderScopeType
  scopeId         String
  createdAt       DateTime               @default(now())

  @@unique([modelProviderId, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@index([modelProviderId])
}

// ModelDefault is the source of truth for "which model does {feature, role}
// resolve to at {scope}" once the resolver lands in B3.1. A null featureKey
// is the role-level default for that scope; a populated featureKey is a
// per-feature override. See specs/model-providers/model-resolver-and-registry.feature.
//
// The two partial unique indexes encode the (NULL = role-level) semantics
// since Postgres treats NULLs as distinct in a single composite unique.
// They live in the migration alongside the table itself - Prisma can't
// express partial indexes in schema.prisma.
// scopeType uses its own Postgres enum - same per-table convention as
// ModelProviderScopeType. See dev/docs/best_practices/scoped-resources.md.
enum ModelDefaultScopeType {
  ORGANIZATION
  TEAM
  PROJECT
}

// ModelDefaultConfig is one CSS-style cascading policy. The JSON `config`
// payload maps role names (DEFAULT / FAST / EMBEDDINGS) and feature keys
// (prompt.create_default, traces.ai_search, …) to a model id. Absence of
// a key means "inherit from the next scope up" - there is no explicit
// "inherit" sentinel in storage. See
// specs/model-providers/model-default-config-cascade.feature.
//
// One config attaches to N scopes via ModelDefaultConfigScope (same n:n
// pattern as ModelProvider + ModelProviderScope from iter 109), so one
// "Production models" policy can apply to Team A + Team B + Project X
// with one row of state.
//
// On read the resolver walks PROJECT → TEAM → ORG; within a tier the
// newest createdAt config that has the key wins. Lower-tier configs
// always beat higher-tier ones even if higher tier was created later
// (CSS specificity wins over recency across tiers).
model ModelDefaultConfig {
  id        String                    @id @default(nanoid())
  config    Json
  authorId  String?
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt
  scopes    ModelDefaultConfigScope[]

  // Single-organization tenancy anchor (ADR-021). Every scope a config
  // attaches to resolves to the same organization.
  organizationId String

  @@index([organizationId])
}

// Join table binding a ModelDefaultConfig to a (scopeType, scopeId).
// One config can have many scope attachments, but a scope belongs to at
// most ONE config: every write path that attaches a scope first detaches
// it from whichever config held it, under the same per-scope advisory
// lock, and deletes any config left with zero attachments. The resolver
// still tiebreaks same-scope configs by createdAt DESC as defense for
// rows written before that invariant existed.
model ModelDefaultConfigScope {
  id        String                @id @default(nanoid())
  configId  String
  config    ModelDefaultConfig    @relation(fields: [configId], references: [id], onDelete: Cascade)
  scopeType ModelDefaultScopeType
  scopeId   String
  createdAt DateTime              @default(now())

  @@unique([configId, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@index([configId])
}

/// The organization's GitHub connection: a GitHub App installation mapped to a
/// LangWatch organization. Short-lived (1h) installation access tokens are
/// minted against these rows on demand, by Langy for writes (bot-authored pull
/// requests, scoped to the installation's repositories) and by pull-request
/// linkage for reads. No user token and no secret are stored here, the crown
/// jewel is the App private key, held only in the control-plane env.
/// Spec: specs/integrations/github-connection.feature.
///
/// installationId is globally unique (one GitHub installation, one row); a
/// single LangWatch organization may own MANY installations (different GitHub
/// accounts), so the org to installation relationship is one-to-many.
model GithubInstallation {
  id                  String       @id @default(nanoid())
  /// GitHub installation id (numeric; stored as string). Globally unique.
  installationId      String       @unique
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The GitHub account (organization or user) the App is installed on.
  accountLogin        String
  /// "Organization" or "User".
  accountType         String
  /// GitHub numeric account id (stable across renames).
  accountId           String
  /// "all" or "selected" — whether the App can see every repo on the account
  /// or only a chosen subset.
  repositorySelection String
  /// Cached repository list [{ id, fullName }] when repositorySelection =
  /// "selected". Null when "all" (the full set is resolved live at mint time).
  repositories        Json?
  /// Set when GitHub suspends the installation; cleared on unsuspend. A
  /// suspended installation cannot mint tokens.
  suspendedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt

  @@index([organizationId])
}

/// A pull request discovered through the organization's GitHub connection and
/// mapped to the branch it was opened from, so a coding-agent session that
/// knows only its branch can name the pull request it produced.
/// Spec: specs/integrations/github-connection.feature.
///
/// The stored title, state, draft and timestamp columns are SNAPSHOTS taken
/// when the mapping was last refreshed. They are fallback labels only: the
/// frontend reads live status from GitHub, so a stale row never presents
/// itself as current truth.
model GithubPullRequest {
  id                 String       @id @default(nanoid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// The GitHub host the repository lives on, e.g. "github.com".
  repositoryHost     String
  /// "owner/repo", stored LOWERCASED so a lookup matches whatever casing the
  /// session reported.
  repositoryFullName String
  /// The branch the pull request was opened from.
  headBranch         String
  prNumber           Int
  htmlUrl            String
  title              String
  /// GitHub's own state string: "open" or "closed".
  state              String
  isDraft            Boolean      @default(false)
  authorLogin        String?
  prCreatedAt        DateTime
  prClosedAt         DateTime?
  prMergedAt         DateTime?
  /// GitHub's own `updated_at` for the snapshot this row holds, and the
  /// freshness guard on every write to it: a snapshot older than the stored one
  /// is skipped. GitHub may deliver webhooks out of order, and without the
  /// guard a late `opened` lands after `closed` and reopens a merged pull
  /// request. NULL means the row predates the column, so any write is accepted.
  prUpdatedAt        DateTime?
  /// When this row was first mapped to its branch.
  mappedAt           DateTime     @default(now())
  /// When the snapshot columns were last refreshed from GitHub.
  lastCheckedAt      DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt

  @@unique([organizationId, repositoryHost, repositoryFullName, prNumber])
  @@index([organizationId, repositoryHost, repositoryFullName, headBranch])
}

/// The per-branch bookkeeping behind pull-request mapping: when a branch was
/// last looked up on GitHub, how many pull requests it resolved to, and when it
/// may be asked about again. A branch with no pull request is the common case,
/// so `notFoundAt` plus `recheckAfter` is what keeps an unmapped branch from
/// costing a GitHub call on every read.
/// Spec: specs/integrations/github-connection.feature.
model GithubBranchPullRequestCheck {
  id                 String       @id @default(nanoid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repositoryHost     String
  /// "owner/repo", stored LOWERCASED, matching GithubPullRequest.
  repositoryFullName String
  headBranch         String
  lastCheckedAt      DateTime
  prCount            Int          @default(0)
  /// Set while the branch resolves to no pull request; cleared once one is
  /// found.
  notFoundAt         DateTime?
  /// The earliest instant GitHub may be asked about this branch again.
  recheckAfter       DateTime?
  /// Consecutive lookups that found nothing, backing off the recheck.
  attempts           Int          @default(0)
  /// When a reader last asked about this branch, whether or not GitHub was
  /// called.
  lastRequestedAt    DateTime
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt

  @@unique([organizationId, repositoryHost, repositoryFullName, headBranch])
  /// The branch-recheck sweep's index, matched to the sweep's query shape:
  /// `recheckAfter <= now` bounds the scan AND supplies the ordering,
  /// `lastRequestedAt` cuts the activity horizon in the index, and
  /// `notFoundAt IS NOT NULL` is checked there too rather than by fetching the
  /// heap row. Leading with organizationId cannot serve it, because the sweep
  /// is the one read in this feature with no organization to name.
  @@index([recheckAfter, lastRequestedAt, notFoundAt])
}

/// Rebuildable operational state folded from Langy's canonical event stream.
/// The source of truth remains the ClickHouse event log.
model LangyConversationProjection {
  id        String @id @default(nanoid())
  projectId String

  ConversationId       String                     @map("conversationId")
  /// Owner; first-writer-wins from the first message's userId.
  UserId               String                     @map("userId")
  Title                String?                    @map("title")
  /// derived | auto | user — governs auto-title precedence (user is sticky).
  TitleSource          LangyProjectionTitleSource @map("titleSource")
  Status               String                     @map("status")
  IsShared             Boolean                    @default(false) @map("isShared")
  SharedAt             Float?                     @map("sharedAt")
  SharedById           String?                    @map("sharedById")
  MessageCount         Int                        @default(0) @map("messageCount")
  LastActivityAt       Float?                     @map("lastActivityAt")
  /// The turn in flight, or null when idle (busy guard reads this).
  CurrentTurnId        String?                    @map("currentTurnId")
  LastError            String?                    @map("lastError")
  /// The model the latest accepted turn ran on; reopening seeds the picker from it.
  LastModel            String?                    @map("lastModel")
  /// ADR-048 shutdown-handoff resume token (opaque, worker-authored).
  PendingHandoffToken  String?                    @map("pendingHandoffToken")
  PendingHandoffTurnId String?                    @map("pendingHandoffTurnId")
  /// Per-conversation HMAC key for worker stream frames; server-side only.
  RunToken             String?                    @map("runToken")
  ArchivedAt           Float?                     @map("archivedAt")
  CreatedAt            Float                      @map("createdAt")
  UpdatedAt            Float                      @map("updatedAt")
  /// Business time of the latest applied event.
  OccurredAt           Float                      @map("occurredAt")
  /// Event-log acceptance time. Together with lastEventId this is the cursor.
  AcceptedAt           Float                      @map("acceptedAt")
  LastEventId          String                     @map("lastEventId")
  ProjectionVersion    String                     @map("projectionVersion")

  @@unique([projectId, ConversationId])
  @@index([projectId, UserId, ConversationId])
  @@index([projectId, UserId, LastActivityAt])
}

