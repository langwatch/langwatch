// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  // The connection URL lives in prisma.config.ts (Prisma 7); the runtime
  // client connects through the pg driver adapter in src/server/db.ts.
  relationMode = "prisma"
}

// BetterAuth-compatible Account. Column names preserved; BetterAuth's field
// mapping in src/server/better-auth/index.ts points its expected names at
// these columns. `password` is new - credential passwords moved here from
// `User.password` in the better_auth_cutover migration.
model Account {
  id                String    @id @default(nanoid())
  userId            String
  type              String    @default("oauth")
  provider          String
  /// WHO asserted `providerAccountId` — the other half of better-auth 1.7's
  /// account key, which it looks up as `(issuer, accountId)`. Nullable only
  /// so the column could be added to a populated table; every write path
  /// supplies it and the migration backfilled every existing row.
  issuer            String?
  providerAccountId String
  refresh_token     String?   @db.Text
  access_token      String?   @db.Text
  expires_at        DateTime?
  ext_expires_in    Int?
  token_type        String?
  scope             String?
  id_token          String?   @db.Text
  session_state     String?
  password          String?   @db.Text
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  // The pair better-auth 1.7 looks a row up by. NOT unique, on purpose: the
  // uniqueness that matters is already enforced above, and every issuer here
  // is derived from `provider`, so this pair is unique exactly when that one
  // is. See migration 20260825030000.
  @@index([issuer, providerAccountId])
}

// The credential half of the old `Account` row (ADR-116 §1). Row-truth
// permanently: ADR-101's payload rule bars secrets from the event log, and
// OAuth refresh rewrites these on a cadence no event log should carry. The
// LINKAGE half - who holds which sign-in method - is `Identifier`, built by
// the fold.
//
// `id` IS the pinned account id: the KSUID an attach pins, which
// `Identifier.accountId` carries and which doubles as the `Account` row's id
// while the bridge table exists. Nothing is re-keyed, and better-auth's
// account id keeps its meaning after `Account` is dropped.
//
// Column names are better-auth's own canonical field names rather than
// `Account`'s NextAuth-era snake_case, so the identity branch needs no field
// mapping of its own. `provider` is a denormalized copy of the identifier's
// and is read-side only: it answers "whose row is this?" without a second
// read.
//
// `userId` relates to `User` and CASCADES, exactly as `Account` does. The
// identity branch deletes these rows itself on unlink (ADR-116 §8), but a
// user deleted outside it - by an unlatched path, an operator, a test - must
// not leave their password hash and provider tokens behind with nothing left
// to reap them. Under `relationMode = "prisma"` the cascade is the client's,
// not the database's, so it needs no FK in the migration.
// Spec: specs/identity/identity-storage-adapter.feature.
model AccountCredential {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              String
  password              String?   @db.Text
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@index([userId])
}

model Session {
  id            String   @id @default(nanoid())
  sessionToken  String   @unique
  userId        String
  expires       DateTime
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonating Json?
  ipAddress     String?
  userAgent     String?  @db.Text
  /// Which of the user's sign-in methods minted this session (D06). NULL on
  /// every session that predates the column and on any mint we could not
  /// attribute - an ordinary value, not an error. Nothing reads it to decide
  /// whether the session is valid, so no session was ended to add it.
  identifierId  String?
  /// What the sign-in that minted this session PROVED, as RFC 8176 method
  /// references (D06). Empty on every session minted before the column, and
  /// on any ordinary password sign-in. An organization that requires a second
  /// factor reads this when a member reaches its data; it is never read at
  /// mint and never ends a session.
  amr           String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([userId])
}

model User {
  id                            String                   @id @default(nanoid())
  name                          String?
  email                         String?                  @unique
  emailVerified                 Boolean                  @default(false)
  image                         String?                  @db.Text
  pendingSsoSetup               Boolean                  @default(false)
  // Per-user HMAC key for identity event payload hashes (ADR-101 §4): minted
  // at user creation, shredded on erasure - after which every identifierHash
  // in the user's event history is unlinkable noise. Row-truth; never in an
  // event.
  userHashKey                   String?
  /// Owned by the two-factor plugin (D06), which is why it is a plain
  /// boolean rather than a state: the plugin flips it when a setup is
  /// confirmed and when it is turned off, and challenges every sign-in while
  /// it is true. The lifecycle - and the history - lives on MfaEnrollment.
  twoFactorEnabled              Boolean                  @default(false)
  accounts                      Account[]
  accountCredentials            AccountCredential[]
  sessions                      Session[]
  twoFactors                    TwoFactor[]
  passkeys                      Passkey[]
  teamMemberships               TeamUser[]
  orgMemberships                OrganizationUser[]
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @default(now()) @updatedAt
  lastLoginAt                   DateTime?
  deactivatedAt                 DateTime?
  // User-level pin for the persona-resolver redirect target. NULL = use
  // auto-detection. When set, wins over auto-detected persona destination.
  // Spec: specs/ai-gateway/governance/persona-home-content.feature
  lastHomePath                  String?
  // User-level dismissal for automatic Traces Explorer tours. A single
  // dismissal applies across projects, browsers, and devices.
  // Spec: specs/traces-v2/tour-visibility-and-persistence.feature
  tracesExplorerTourDismissedAt DateTime?
  /// When this person last said "not now" to being offered a passkey
  /// (ADR-120). On the account rather than in browser storage for two
  /// reasons: a per-browser record forgets on a new device, which is exactly
  /// where the offer should be MORE eager, and an interval nobody can enforce
  /// is not an interval. NULL means never asked.
  passkeyNudgeDismissedAt       DateTime?
  Annotation                    Annotation[]
  shareLinks                    ShareLink[]
  Workflow                      Workflow[]
  WorkflowVersion               WorkflowVersion[]
  annotationQueues              AnnotationQueueMembers[]
  assignedQueueItems            AnnotationQueueItem[]    @relation("AssignedTo")
  createdQueueItems             AnnotationQueueItem[]    @relation("CreatedBy")
  llmPromptConfigVersions       LlmPromptConfigVersion[]
  scenarios                     Scenario[]
  inviteRequests                OrganizationInvite[]
  secretsCreated                ProjectSecret[]          @relation("secretCreatedBy")
  secretsUpdated                ProjectSecret[]          @relation("secretUpdatedBy")
  savedViews                    SavedView[]
  versionTagsCreated            PromptTagAssignment[]    @relation("versionTagCreatedBy")
  versionTagsUpdated            PromptTagAssignment[]    @relation("versionTagUpdatedBy")
  promptTagsCreated             PromptTag[]              @relation("promptTagCreatedBy")
  promptTagsUpdated             PromptTag[]              @relation("promptTagUpdatedBy")
  groupMemberships              GroupMembership[]
  roleBindings                  RoleBinding[]
  scimExternalIds               ScimExternalId[]
  apiKeys                       ApiKey[]
  gatewayBudgetsCreated         GatewayBudget[]          @relation("GatewayBudgetCreatedBy")
  principalVirtualKeys          VirtualKey[]             @relation("PrincipalScopedVirtualKeys")
  personalTeams                 Team[]                   @relation("PersonalTeamOwner")
  personalProjects              Project[]                @relation("PersonalProjectOwner")
  routingPoliciesCreated        RoutingPolicy[]          @relation("RoutingPolicyCreatedBy")
  routingPoliciesUpdated        RoutingPolicy[]          @relation("RoutingPolicyUpdatedBy")
  gatewayGuardrailsCreated      GatewayGuardrail[]       @relation("GatewayGuardrailCreatedBy")
  gatewayGuardrailsUpdated      GatewayGuardrail[]       @relation("GatewayGuardrailUpdatedBy")
  ingestionSourcesCreated       IngestionSource[]        @relation("IngestionSourceCreatedBy")
  anomalyRulesCreated           AnomalyRule[]            @relation("AnomalyRuleCreatedBy")
  pinnedTraces                  PinnedTrace[]
  traceEditOverlaysCreated      TraceEditOverlay[]       @relation("TraceEditOverlayCreatedBy")
  traceEditOverlaysUpdated      TraceEditOverlay[]       @relation("TraceEditOverlayUpdatedBy")
}

model VerificationToken {
  id         String   @id @default(nanoid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([identifier, token])
}

// Pure event-truth projection of the identity pipeline (ADR-101, D01): one row
// per sign-in method a user holds, fold-written from `lw.identity.*` events,
// rebuilt whole-row by replay (ADR-022/015 apply unamended - no column here is
// handler-written). Deliberately no foreign keys and no unique constraint on
// the natural key: DETACHED rows are tombstones that persist forever, so
// uniqueness of verified values is a command-time guard, not a database
// constraint. `value` and `identifierHash` are wiped by erasure (R11); the row
// itself remains as the tombstone replay reproduces.
// Spec: specs/identity/identifier-model.feature.
model Identifier {
  id                String    @id
  userId            String
  provider          String
  value             String?
  domain            String?
  identifierHash    String?
  accountId         String?
  // better-auth's own provider id, verbatim (ADR-116). `provider` above is
  // the folded identifier vocabulary - auth0/okta/custom OIDC all collapse
  // into `oidc`, microsoft into `azure-ad` - so it cannot answer a callback
  // that asks for `auth0`. `Account` is a projection of the same log, and
  // this is the column its uniqueness is keyed by. Null for an identifier no
  // protocol row backs.
  providerId        String?
  // WHO asserted the subject below - the other half of better-auth 1.7's
  // account key, and event truth rather than a derivation. A subject is
  // unique only WITHIN an issuer, so `providerId` has only ever stood in for
  // this while there is exactly one connection per configured provider. Null
  // exactly when `providerId` is.
  issuer            String?
  // The provider's own subject (ADR-116). What an IdP callback arrives
  // holding, so the projection can answer "who is this?" without the legacy
  // Account row.
  providerAccountId String?
  state             String
  connectionId      String?
  verifiedAt        DateTime?
  attachedAt        DateTime
  detachedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@index([identifierHash])
  @@index([value])
  @@index([domain])
  @@index([provider, providerAccountId])
  @@index([issuer, providerAccountId])
  @@index([accountId])
  // A PARTIAL UNIQUE INDEX on (providerId, providerAccountId), over the live
  // states only, is added by migration 20260824120004 - Prisma cannot express
  // a partial index, so it is raw SQL there and this comment is its home in
  // the model.
  //
  // Unique where `value` is not, and the difference is what the columns mean.
  // One user legitimately holds several proven identifiers carrying the same
  // ADDRESS, so address uniqueness is not a row-level rule. A provider
  // SUBJECT is different: it names exactly one account at exactly one IdP, so
  // two live identifiers sharing it are always either a duplicate or a
  // takeover. `Account` has enforced exactly this globally all along; the
  // identity branch dropped the guarantee until this index restored it.
  //
  // FORWARD CONSTRAINT, and it is load-bearing: the real invariant is that a
  // subject is unique PER CONNECTION. `providerId` stands in for the
  // connection today only because there is exactly one connection per
  // configured provider (auth0, okta, cognito, onelogin, oidc). When
  // connections become data (D04, and the Auth0 exit is what brings it), every
  // connection MUST get its own distinct provider id, or this index MUST be
  // extended to include `connectionId`. Many customer connections sharing one
  // provider id - `oidc` being the one to watch - re-opens a cross-tenant
  // sign-in, because subjects are then customer-chosen and collide.
  //
  // Deliberately no unique constraint on `value`: ONE user legitimately holds
  // several proven identifiers carrying the same address (a credential
  // sign-in and a Google sign-in are two rows with one email, both VERIFIED),
  // so "one USER per proven address" is not a row-level rule. It lives in
  // `IdentifierReservation`, claimed before any fact is stated.
}

// The address lock (ADR-116 §6). ROW-TRUTH, and deliberately not a projection:
// it is a lock, not a record of who holds what. `Identifier` answers that.
//
// One user may hold a proven address, and "check the projection, then state
// the fact" cannot decide two concurrent claims - both reads pass before
// either write lands. So a claim is taken here first, atomically, BEFORE the
// verification proof is consumed and BEFORE any fact is appended: the loser is
// refused synchronously with `identity_email_in_use`, and the event log never
// records a verification that did not hold.
//
// The primary key IS the constraint. A claim is released by the fold when the
// identifier stops holding the value (detached, dead-ended, erased), and a
// claim whose append never landed is reaped by the identity sweep.
// Spec: specs/identity/identity-storage-adapter.feature.
model IdentifierReservation {
  normalizedValue String   @id
  userId          String
  identifierId    String
  // The command that claimed it. A retry of the SAME command is not a
  // collision - it is the same claim arriving twice, which the staged re-run
  // of every ceremony guarantees will happen.
  commandId       String
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([identifierId])
}

// One row per user: the identity fold's event cursor (the AuthzProjectionCursor
// pattern, re-tenanted to users). Advanced by the projection writer itself;
// its (acceptedAt, lastEventId) compare is what makes re-applies no-ops.
model IdentityProjectionCursor {
  userId            String   @id
  lastEventId       String
  acceptedAt        DateTime
  occurredAt        DateTime
  projectionVersion String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
}

/// The two-factor plugin's own table (D06). Protocol state, and row-truth for
/// good (ADR-101 R12): the shared secret and the backup codes live here and
/// in no event, ever. Nothing in this repo reads or writes these columns -
/// the plugin owns them end to end, including the lockout counters, which is
/// why `failedVerificationCount` and `lockedUntil` are here rather than
/// rebuilt on the projection.
///
/// `backupCodes` holds an ENCRYPTED blob, not hashes. A backup code has to be
/// compared against what somebody types, and the plugin decrypts and compares;
/// hashing them would leave it unable to verify its own codes.
model TwoFactor {
  id                      String    @id @default(nanoid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt

  @@index([userId])
  @@index([secret])
}

/// The passkey plugin's own table (D07). Protocol state, like TwoFactor: the
/// public key and the signature counter are the plugin's to read and write.
/// A passkey also becomes an `Identifier` row with provider `passkey`, which
/// is what makes it a sign-in method like any other - this table is the
/// credential, that one is the identity.
///
/// `aaguid` names the authenticator MODEL, never a device or a person, and is
/// only present at registration. Privacy-preserving platforms report all
/// zeroes, so a label derived from it is best-effort by construction.
model Passkey {
  id           String   @id @default(nanoid())
  name         String?
  publicKey    String   @db.Text
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int      @default(0)
  deviceType   String
  backedUp     Boolean  @default(false)
  transports   String?
  aaguid       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([credentialID])
}

/// The two-step verification pipeline's projection (D06 - see
/// specs/identity/mfa-and-session-shape.feature). One row per PERSON, because
/// one person has one setup however many organizations they belong to.
///
/// A pure event-truth head like `SsoConnection`: every column is fold-written,
/// rows are never deleted (DISABLED is a tombstone, so history survives being
/// turned off), and a replay rebuilds it whole-row from the event log. The
/// cursor columns are inline because the fold produces exactly one row per
/// aggregate - the `Identifier` fan-out needed its own cursor table, this
/// does not.
///
/// Every column here is a lifecycle fact. There is deliberately nowhere in
/// this model a secret or a backup code could be put: `consumedBackupCodeIndexes`
/// holds POSITIONS, which is what lets "how many are left" be answered
/// without the projection ever knowing a code.
model MfaEnrollment {
  /// The user. Also the aggregate id and the tenant - one identity history
  /// per person (ADR-029 §4).
  userId                    String    @id
  /// The current enrollment, or NULL for somebody who never started one.
  enrollmentId              String?
  /// totp. Never sms.
  method                    String?
  /// NONE | PENDING | ENABLED | EXPIRED | DISABLED
  state                     String
  enrolledAt                DateTime?
  confirmedAt               DateTime?
  expiredAt                 DateTime?
  disabledAt                DateTime?
  /// password+totp | org-admin - who ended it, and on whose authority.
  disabledVia               String?
  backupCodeCount           Int       @default(0)
  /// Positions already spent, ascending. Never codes.
  consumedBackupCodeIndexes Int[]     @default([])
  failedCount               Int       @default(0)
  occurredAt                DateTime
  lastEventId               String
  acceptedAt                DateTime
  projectionVersion         String
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @default(now()) @updatedAt

  @@index([state])
}

/// The SSO connection pipeline's projection (ADR-117 §5, D04 - see
/// specs/identity/sso-connection-lifecycle.feature). A pure event-truth head
/// like `Identifier`: every column is fold-written, rows are never deleted
/// (TORN_DOWN is a tombstone), and a replay rebuilds it whole-row from the
/// event log.
///
/// The fold cursor lives on the row rather than in a sibling table, because
/// one row IS one aggregate here - a connection - so there is nothing for a
/// separate cursor table to key on that this row does not already key on.
///
/// No relation to Organization on purpose, matching `Identifier`: a
/// projection is rebuilt from events, and a foreign key would make a replay
/// depend on relational state the log does not carry. `idpMetadata` holds
/// endpoints and credential REFERENCES; no secret is ever stored here or in
/// any event.
model SsoConnection {
  id                  String    @id
  organizationId      String
  /// oidc | saml
  type                String
  /// DRAFT | CLAIMED | APPROVED | REJECTED | DISCARDED |
  /// VERIFICATION_PENDING | VERIFIED | ACTIVE | SUSPENDED |
  /// TEARDOWN_PENDING | TORN_DOWN
  state               String
  claimedDomains      String[]
  approvedDomains     String[]
  /// The only domains that ever route, and only while state is ACTIVE.
  verifiedDomains     String[]
  /// [{ domain, method, actorId, verifiedAtMs }] - what proved each verified
  /// domain, and who. Kept on the row rather than only in the log so that an
  /// operator-attested domain can never be read as one the customer proved.
  domainVerifications Json      @default("[]")
  /// { domain, method, tokenHash } while a ceremony is in flight.
  pendingVerification Json?
  idpMetadata         Json
  allowsJit           Boolean   @default(false)
  /// self-serve | legacy-grandfathered
  source              String
  testLoginAccountId  String?
  /// { domain, note } - the last ops rejection, read back on a re-claim.
  rejection           Json?
  createdBy           String?
  /// While TEARDOWN_PENDING: when the process manager's wake completes it.
  tearDownAfter       DateTime?
  occurredAt          DateTime
  lastEventId         String
  acceptedAt          DateTime
  projectionVersion   String
  /// Event-derived, not database-managed: `@default(now())` / `@updatedAt`
  /// would make a replayed row differ from the row it rebuilds, which is
  /// exactly the parity this projection has to keep.
  createdAt           DateTime
  updatedAt           DateTime

  @@index([organizationId])
  @@index([state])
  @@index([verifiedDomains], type: Gin)
}

/// The join-request pipeline's projection (ADR-117, D12 - see
/// specs/identity/join-requests.feature). A pure event-truth head like
/// `Identifier` and `SsoConnection`: every column is fold-written, rows are
/// never deleted (a terminal state is a tombstone the admin panel stops
/// listing, not an absence), and a replay rebuilds it whole-row from the
/// event log.
///
/// The fold cursor lives on the row rather than in a sibling table, because
/// one row IS one aggregate here - a request.
///
/// No relation to Organization or User on purpose, matching the two heads
/// above: a projection is rebuilt from events, and a foreign key would make a
/// replay depend on relational state the log does not carry.
///
/// Membership is NOT here. An approval dispatches an attach on the grants
/// ledger, exactly as accepting an invitation does, and that ledger fact
/// carries `source: "join-request"` as its provenance - which is what puts a
/// join approval on the customer's audit page beside every other membership
/// change rather than in a history of its own.
///
/// The requester's address is not here either: the DOMAIN is the fact, and it
/// is the only part of an address a join decision may depend on.
model JoinRequest {
  id                String    @id
  userId            String
  organizationId    String
  /// The normalized domain the match was made on.
  domain            String
  /// PENDING | APPROVED | REJECTED | EXPIRED | WITHDRAWN
  state             String
  /// How the domain was matched; `verified-identifier-domain` today.
  matchedVia        String
  /// While PENDING: when the day-14 wake lapses it. Null once resolved.
  expiresAt         DateTime?
  resolvedAt        DateTime?
  /// user | policy | invite - who ended it. `policy` is domain auto-join's
  /// own principal, deliberately not the one SSO auto-join uses.
  resolvedByType    String?
  /// The admin's user id, `domain-auto`, or the invitation id.
  resolvedById      String?
  /// user | invite-accepted, on a withdrawal.
  withdrawalCause   String?
  occurredAt        DateTime
  lastEventId       String
  acceptedAt        DateTime
  projectionVersion String
  /// Event-derived, not database-managed: `@default(now())` / `@updatedAt`
  /// would make a replayed row differ from the row it rebuilds, which is
  /// exactly the parity this projection has to keep.
  createdAt         DateTime
  updatedAt         DateTime

  @@index([organizationId, state])
  @@index([userId, state])
  @@index([userId, organizationId])
  @@index([domain])
}

enum TeamUserRole {
  ADMIN
  MEMBER
  VIEWER
  CUSTOM
}

// Scoped RBAC - scope levels for RoleBinding
enum RoleBindingScopeType {
  ORGANIZATION
  TEAM
  PROJECT
}

// The grants ledger (ADR-092 §13) - scope levels for Grant. Five tiers:
// the three RoleBinding knows, plus RESOURCE (share-link heritage) and
// PLATFORM (operator access, minted from ADMIN_EMAILS at cutover).
enum GrantScopeType {
  ORGANIZATION
  TEAM
  PROJECT
  RESOURCE
  PLATFORM
}

// WHO can hold a grant. Collectives (team, organization) are principals -
// membership is expanded at check time, never copied per member. project
// and anyone are valid at the resource tier only.
enum GrantPrincipalType {
  USER
  API_KEY
  GROUP
  TEAM
  ORGANIZATION
  PROJECT
  ANYONE
}

enum OrganizationUserRole {
  ADMIN
  MEMBER
  EXTERNAL
}

model TeamUser {
  userId         String
  teamId         String
  role           TeamUserRole
  assignedRoleId String?
  assignedRole   CustomRole?  @relation(fields: [assignedRoleId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  team           Team         @relation(fields: [teamId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@id([userId, teamId])
  @@index([teamId])
  @@index([userId])
  @@index([assignedRoleId])
}

model OrganizationUser {
  userId         String
  organizationId String
  role           OrganizationUserRole
  user           User                 @relation(fields: [userId], references: [id])
  organization   Organization         @relation(fields: [organizationId], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt

  /// Department assignment for spend attribution (the people lens).
  /// Single-valued, org-scoped, accounting-only (never gates access).
  /// Plain column ref (relationMode="prisma"); the service validates the
  /// id belongs to this org. See departments.feature.
  departmentId String?

  /// Set when an admin disables this membership to stay within the licensed
  /// seat count. The person loses access to this organization only, keeps
  /// their role, department and everything they did, and frees their seat.
  /// Reversible: re-enabling restores access if a seat is available.
  /// Seat counting excludes disabled memberships. See
  /// seat-reconciliation.feature.
  disabledAt DateTime?

  @@id([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([departmentId])
}

model Team {
  id             String       @id @default(nanoid())
  name           String
  slug           String       @unique
  members        TeamUser[]
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projects       Project[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  archivedAt     DateTime?

  // Personal workspace per (org, user). Created on user's first
  // visit to an org. UI hides isPersonal=true teams from team
  // pickers; they surface under "My Workspace" instead.
  isPersonal  Boolean @default(false)
  ownerUserId String? @db.VarChar(255)
  ownerUser   User?   @relation("PersonalTeamOwner", fields: [ownerUserId], references: [id])

  ingestionSources IngestionSource[]
  aiToolEntryTeams AiToolEntryTeam[]

  /// Department assignment inherited as the default for members and
  /// projects that have none of their own. Accounting-only.
  departmentId String?

  @@index([organizationId])
  @@index([isPersonal])
  @@index([departmentId])
}

model Organization {
  id                     String               @id @default(nanoid())
  name                   String
  phoneNumber            String?
  slug                   String               @unique
  members                OrganizationUser[]
  teams                  Team[]
  webhookEndpoints       WebhookEndpoint[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @default(now()) @updatedAt
  OrganizationInvite     OrganizationInvite[]
  usageSpendingMaxLimit  Int?
  /// Phase 8 - admin-configurable max lifetime for CLI device-flow
  /// sessions, in days. 0 = unbounded (default, mirrors GitHub CLI /
  /// gh-style flows). Companies that need finite session lifetime
  /// (eg. SOC 2 / ISO 27001 customers with mandated session
  /// expiration) can set a positive value. The /api/auth/cli/refresh
  /// endpoint rejects refresh attempts where now - issued_at exceeds
  /// this value, regardless of the underlying refresh-token TTL.
  /// Spec: specs/ai-governance/sessions/session-ttl.feature.
  maxSessionDurationDays Int                  @default(0)
  /// Every member of this organization can prove a second factor (D06). A
  /// MEMBERSHIP CONDITION, not a session policy: it is asked when a member
  /// reaches this organization's data, it holds the ones who cannot prove
  /// one at an enrollment gate for THIS organization alone, and it ends no
  /// session, ever. Turning it on signs nobody out.
  /// Spec: specs/identity/mfa-and-session-shape.feature.
  mfaRequired            Boolean              @default(false)
  signupData             Json?
  signedDPA              Boolean              @default(false)
  elasticsearchNodeUrl   String?
  elasticsearchApiKey    String?
  useCustomElasticsearch Boolean              @default(false)
  s3Endpoint             String?
  s3AccessKeyId          String?
  s3SecretAccessKey      String?
  s3Bucket               String?
  useCustomS3            Boolean              @default(false)
  sentPlanLimitAlert     DateTime?
  ssoDomain              String?              @unique
  ssoProvider            String?
  /// How colleagues on a matching domain get in (D12, ADR-117):
  /// `off` (invisible to them entirely) | `request` (they ask, an admin
  /// approves) | `auto` (a verified colleague walks straight in).
  ///
  /// `request` is the default for a self-serve organization; `auto` is never
  /// a default and never inferred - an administrator turns it on, names the
  /// domain in `joinDomains` while doing it, and the licence gate holds that
  /// value while letting `request` through.
  domainJoin             String               @default("request")
  /// The domains an administrator NAMED when turning automatic joining on.
  /// Empty means automatic joining admits nobody whatever `domainJoin` says -
  /// which is what keeps a setting left on from admitting a domain nobody
  /// ever agreed to.
  joinDomains            String[]
  presenceEnabled        Boolean              @default(true)
  /// Org-level trace-sharing kill switch. Off = trace share links cannot be
  /// created in ANY project of this org, and existing links stop resolving —
  /// the org toggle is the global switch, the per-project
  /// `Project.traceSharingEnabled` scopes the kill to a single project (mirrors
  /// `presenceEnabled`). Effective sharing = org AND project. ADR-039.
  traceSharingEnabled    Boolean              @default(true)
  /// Org-configurable contact surfaced to users in CLI "contact your
  /// admin" messages and the in-app budget-exceeded banner. Free text:
  /// accepts an email, a URL (internal ticketing system), or any other
  /// instruction. When null, callers fall back to the first ADMIN
  /// member's email (`resolveSupportContact` helper).
  supportContact         String?
  /// Signup intent, editable later as the org "Primary use" setting.
  /// AGENT_GOVERNANCE lands "/" on /me, LLM_OPS on the project home.
  /// NULL means intent unset (every pre-fork org and any org created
  /// outside onboarding) — the home resolver keeps legacy behavior.
  /// ADR-038.
  primaryIntent          OrganizationIntent?

  promoCode              String?
  stripeCustomerId       String?                        @unique
  currency               Currency                       @default(EUR)
  pricingModel           PricingModel                   @default(TIERED)
  CustomRoles            CustomRole[]
  notifications          Notification[]
  subscriptions          Subscription[]
  scimTokens             ScimToken[]
  promptTags             PromptTag[]
  groups                 Group[]
  roleBindings           RoleBinding[]
  apiKeys                ApiKey[]
  // License enforcement fields (COSS-0226)
  license                String?                        @db.Text
  licenseExpiresAt       DateTime?
  licenseLastValidatedAt DateTime?
  gatewayChangeEvents    GatewayChangeEvent[]
  routingPolicies        RoutingPolicy[]
  ingestionSources       IngestionSource[]
  anomalyRules           AnomalyRule[]
  anomalyAlerts          AnomalyAlert[]
  aiToolEntries          AiToolEntry[]
  ingestionTemplates     IngestionTemplate[]
  githubInstallations    GithubInstallation[]
  githubPullRequests     GithubPullRequest[]
  githubBranchPrChecks   GithubBranchPullRequestCheck[]

  @@index([ssoProvider])
}

model ScimToken {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// D08: the SSO connection this token was issued for, and its ENTIRE write
  /// authority — a token minted for one connection can never touch another
  /// connection's people. No relation, matching `SsoConnection` itself: that
  /// projection carries no foreign keys, so neither may a row pointing at it.
  ///
  /// Nullable only for the tokens that predate the column. They were minted
  /// when "which organization" was the whole answer, so they keep the
  /// organization-wide authority they were sold with; the backfill points
  /// each at its organization's first connection where there is one. Minting
  /// a NEW token without a connection is refused (`scim_connection_required`).
  connectionId   String?
  hashedToken    String
  description    String?
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?

  @@index([organizationId])
  @@index([hashedToken])
  @@index([connectionId])
}

/// D08 — who the directory means, per connection.
///
/// The identity provider's own identifier for a person, which is what
/// survives their email changing: an address is not identity, people change
/// theirs, and the same person carries different identifiers on two different
/// connections. So the PAIR is the key and `externalId` alone never is.
///
/// No relation to `SsoConnection` (that projection carries no foreign keys);
/// the `User` relation is real, so a deleted user takes their directory
/// identities with them rather than stranding a mapping that resolves to
/// nobody.
model ScimExternalId {
  id           String   @id @default(nanoid())
  connectionId String
  externalId   String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([connectionId, externalId])
  @@index([userId])
  @@index([connectionId])
}

/// D08 — one connection's directory sync, as the `scim-sync` pipeline's fold
/// writes it.
///
/// Pure event truth: every column is fold-written, rows are never deleted,
/// and REVOKED is a tombstone rather than an absence — a dead letter that
/// vanished when a connection was torn down would be a removal nobody could
/// check afterwards.
///
/// No relation to Organization or SsoConnection, matching `SsoConnection`
/// itself: a projection is rebuilt from events, and a foreign key would make
/// a replay depend on relational state the log does not carry.
model ScimSyncState {
  /// The aggregate: the connection's id, which IS its sync's id.
  id                String    @id
  connectionId      String
  organizationId    String
  /// TOKEN_ISSUED | SYNCING | ERROR | REVOKED
  state             String
  lastPushedAt      DateTime?
  /// The failure standing right now: { op, errorCode, attempts, retiredAtMs,
  /// userId, occurredAtMs }. A reason CODE and ids — never a token, never a
  /// secret, never an internal hostname.
  lastFailure       Json?
  /// Every failure retired without ever being applied, newest last. The dead
  /// letters an administrator has to see; retiring never drops one.
  deadLetters       Json      @default("[]")
  /// revoke | teardown, once the sync has ended.
  revokedCause      String?
  occurredAt        DateTime
  lastEventId       String
  acceptedAt        DateTime
  projectionVersion String
  /// Event-derived, not database-managed: `@default(now())` / `@updatedAt`
  /// would make a replayed row differ from the row it rebuilds, which is
  /// exactly the parity this projection has to keep.
  createdAt         DateTime
  updatedAt         DateTime

  @@index([organizationId])
  @@index([state])
  @@index([connectionId])
}

