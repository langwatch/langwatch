// ============================================================================
// Scoped RBAC - Groups, GroupMembership, RoleBinding
// ============================================================================

model Group {
  id               String            @id @default(nanoid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  slug             String
  // SCIM provenance - null for manually created groups
  externalId       String? // IdP-side group ID (SCIM externalId)
  scimSource       String? // e.g. "azure-ad", "okta"
  /// D08: which SSO connection provisioned this group. Null for manually
  /// created groups and for the SCIM groups that predate connection scoping.
  scimConnectionId String?
  members          GroupMembership[]
  roleBindings     RoleBinding[]     @relation("GroupBindings")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt

  @@unique([organizationId, slug])
  @@unique([organizationId, externalId])
  /// D08: a directory's identifier for a group is its CONNECTION's, so two
  /// connections in one organization each carry their own "engineering". The
  /// organization-scoped uniqueness above stays as the legacy safety net for
  /// the rows that carry no connection.
  @@unique([scimConnectionId, externalId])
  @@index([organizationId])
  @@index([scimConnectionId])
}

model GroupMembership {
  userId    String
  groupId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

model RoleBinding {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Principal - exactly one must be set
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId  String?
  group    Group?  @relation("GroupBindings", fields: [groupId], references: [id], onDelete: Cascade)
  apiKeyId String?
  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)

  // Role - built-in named role or custom
  role         TeamUserRole
  customRoleId String?
  customRole   CustomRole?  @relation(fields: [customRoleId], references: [id])

  // Scope - scopeType + scopeId identify the resource
  scopeType RoleBindingScopeType
  scopeId   String // orgId, teamId, or projectId depending on scopeType

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Uniqueness is enforced by six partial unique indexes defined in migrations:
  //   • user + group (built-in and custom) - 20260410120000_fix_role_binding_unique_custom_role
  //   • apiKey (built-in and custom) - 20260414222341_add_personal_access_tokens
  // Prisma does not support partial indexes natively, so there is no @@unique here.
  @@index([organizationId])
  @@index([userId])
  @@index([groupId])
  @@index([apiKeyId])
  @@index([scopeType, scopeId])
}

// The grants ledger's operational projection (ADR-092 §13). One row per
// access fact, fed exclusively by the authz_grants fold - application code
// never writes here, with ONE named exception: revocation enforcement
// deletes rows on the calling path ahead of the fold (deny-early only; the
// fold's later apply of the same event is a no-op). Ids are deterministic
// KSUIDs derived from event content, which is what makes every upsert
// idempotent. Principal and scope are plain columns, not foreign keys: rows
// are facts derived from the ledger, and five scope types point at five
// different kinds of thing.
model Grant {
  id             String @id
  organizationId String // plain column, never a relation: projection rows are
  // facts derived from the ledger and must not presume any other row exists
  // mid-replay or mid-migration

  principalType GrantPrincipalType
  principalId   String? // null only for ANYONE (resource tier)

  roleKey    String? // admin | member | viewer | lite-member | custom:<id>; null on RESOURCE rows
  // The `role` column an IMPORTED binding carried alongside a custom:<id>
  // roleKey, which cannot express it. The legacy resolver still reads it (a
  // custom role with an empty permission list falls back to the row's own
  // role), so the compat head has to reproduce it - and this column is what
  // lets a projection reloaded from these rows reconstruct the fact rather
  // than a lossy copy. Null on everything ledger-born; retired at cutover.
  legacyRole String? // ADMIN | MEMBER | VIEWER | CUSTOM
  source     String // which writer emitted the fact: grants-service | scim | invite | join-request | read-through-mint | migration (the vocabulary is GRANT_EVENT_SOURCES in @langwatch/authz-server; ADR-110 folded backfill-b, genesis-import and cutover-import into `migration`)

  scopeType GrantScopeType
  scopeId   String

  // Resource-tier FACT columns (ShareLink heritage, ADR-057 possession
  // intact; null on every other tier). All of them are set by the mint event
  // and owned by the fold like every other column here. View-consumption
  // accounting (viewCount) deliberately does NOT live on this table - it
  // has a different writer (ShareService) and lives in GrantUsage below.
  //
  // scopeId is the shared resource's id alone, so the row carries the rest
  // of that resource's identity itself: resourceKind says what the id names
  // (TRACE | THREAD, ShareLink's own spelling) and projectId says where it
  // lives. createdByUserId is whoever minted the link.
  // Unique GLOBALLY, revoked or not: a reissued token is an old share link
  // that works again, which is the one thing revoking it was for.
  token           String?   @unique
  permission      String?
  resourceKind    String?
  projectId       String?
  createdByUserId String?
  expiresAt       DateTime?
  maxViews        Int?

  occurredAt DateTime // business time of the fact (backfills carry the legacy row's createdAt)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  // A revoke MARKS the row rather than deleting it. Deleting made the
  // projection order-dependent - a redelivered `attached` after a `revoked`
  // had no row left to lose to - and it threw away the answer to when a
  // grant ended and why. Every read of live access fences on this being null.
  revokedAt     DateTime?
  revokedReason String?

  // The collector's principal scan is served by
  // "Grant_organizationId_principalType_principalId_idx", a PARTIAL index
  // (`WHERE "scopeType" <> 'RESOURCE'`) defined in migration
  // 20260817160000_grants_ledger_projections. Prisma has no partial indexes,
  // so - exactly as RoleBinding's six partial uniques do - it is NOT declared
  // here: an `@@index` for it would make the next `prisma migrate dev` drop
  // the partiality and rebuild it over every share-link row, which is the one
  // thing the WHERE clause exists to avoid.
  //
  // "Grant_resource_terms_check" is an all-or-nothing CHECK over the tier's
  // four identity columns (token, permission, resourceKind, projectId), tied
  // to scopeType = 'RESOURCE'. Added over two columns in
  // 20260817160000_grants_ledger_projections and widened to four in
  // 20260818120001_grant_resource_facts, which is where the other two arrive.
  // Prisma cannot express it either.
  @@index([organizationId, scopeType, scopeId])
  // The resource tier's own access shape: the compat/share write paths and
  // the token-possession reads both fence on (project, kind, resource).
  @@index([projectId, resourceKind, scopeId])
}

// ShareService-owned view accounting for resource grants (delivery-plan
// decision 22). Split from Grant because it has a different writer: the fold
// owns the fact columns, ShareService increments this row once per view. The
// fold NEVER writes here - a projection pass that touched viewCount would
// reset every share link's view budget.
model GrantUsage {
  grantId        String @id // the Grant row's id; deterministic, so this row is addressable before the view happens
  organizationId String
  projectId      String

  viewCount    Int       @default(0)
  lastViewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([organizationId])
  // The share write path fences its conditional consume on (grant,
  // organization, project) and the cutover seeds a whole project's budgets at
  // once; without this the project-scoped reads fall back to the
  // organization index and filter.
  @@index([projectId])
}

// The grants ledger's role projection - CustomRole's successor, fed by the
// same fold. Imported roles keep their CustomRole id, so custom:<id>
// roleKeys stay stable across the cutover.
model Role {
  id             String    @id
  organizationId String // plain column, never a relation (see Grant)
  name           String
  description    String?
  permissions    Json // registry permission strings only; empty grants nothing
  kind           String    @default("custom") // "custom" | "system_api_key"
  occurredAt     DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  // A delete marks the row. The name stays taken: identity is the id, and
  // reusing a deleted role's name would make two different roles read as one
  // in every audit trail that recorded the name.
  deletedAt      DateTime?

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ApiKey {
  id              String        @id @default(nanoid())
  name            String
  description     String?
  lookupId        String        @unique
  hashedSecret    String
  permissionMode  String        @default("all") // "all" | "readonly" | "restricted"
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdByUserId String? // null = self-created; set when admin creates for another user
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roleBindings    RoleBinding[]
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  revokedAt       DateTime?

  /// Non-null marks this key as an "ingestion key": a project-scoped,
  /// ingest-only ApiKey the unified `langwatch <tool>` CLI (and template
  /// installs) mint for OTLP Path B. The slug (claude_code / codex / gemini /
  /// opencode / claude_cowork) is stamped as `langwatch.source` provenance on
  /// every span the key authorizes. NULL for normal API / service keys.
  ingestSourceType String?

  /// Set only for ingestion keys derived from an admin IngestionTemplate
  /// (e.g. claude_cowork). Drives receiver OTTL application + the
  /// `langwatch.template.id` provenance stamp. NULL for unified-CLI tools
  /// (which have no template) and for normal keys. Column ref only (no FK,
  /// per the app-layer-integrity convention); resolved by the ingest-key service.
  ingestionTemplateId String?

  /// Human label of the CLI device session that minted this ingestion key
  /// (e.g. "Rogerio's MacBook Pro"), snapshotted at mint time from the device
  /// flow's `client_info`. Denormalized so the org-wide API-keys settings page
  /// can show which device a key came from without resolving another user's
  /// Redis-stored sessions. NULL for non-ingestion keys and for keys minted by
  /// a CLI old enough to predate device metadata.
  createdByDeviceLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  // DELIBERATELY UNINDEXED: the Langy session-key reaper sweeps on
  // (name = <reserved> AND revokedAt IS NULL AND expiresAt <= now), which no
  // index above serves, so the hourly tick is a sequential scan.
  //
  // An index for it was written and then withdrawn. Prisma runs migrations
  // inside a transaction and this repo has no non-transactional setup, so it
  // could not be built CONCURRENTLY — and a plain CREATE INDEX takes a SHARE
  // lock that blocks WRITES on this table for the whole build. ApiKey is on
  // the authorization hot path (`ApiKeyService.markUsed` fires a
  // fire-and-forget `update({ lastUsedAt })` after every authorized request,
  // including trace ingest, and `create` runs on every Langy session-key
  // mint), so that lock is a deploy-time stall on customer traffic. Paying it
  // to speed up an HOURLY background sweep is the wrong trade, and telling
  // each operator to pre-build the index by hand is not an upgrade-safe
  // mitigation.
  //
  // When the table grows enough to warrant it, add it OUT OF BAND — online,
  // outside a migration:
  //   CREATE INDEX CONCURRENTLY "ApiKey_name_expiresAt_unrevoked_idx"
  //     ON "ApiKey"("name", "expiresAt") WHERE "revokedAt" IS NULL;
  // Keep it undeclared here even then: Prisma cannot express the predicate,
  // and the predicate is the point — session keys are minted per chat turn and
  // never deleted, so the un-revoked working set stays small while the table
  // grows without bound. Declaring an `@@index` would make every migrate diff
  // want to recreate it as a non-partial index.

  @@index([userId])
  @@index([organizationId])
  @@index([lookupId])
  @@index([ingestSourceType])
  @@index([ingestionTemplateId])
}

model BillingMeterCheckpoint {
  id                   String   @id @default(cuid())
  organizationId       String
  billingMonth         String // "2026-02"
  lastReportedTotal    Int      @default(0)
  pendingReportedTotal Int? // non-null = in-flight Stripe call
  consecutiveFailures  Int      @default(0)
  updatedAt            DateTime @updatedAt

  @@unique([organizationId, billingMonth])
}

// ============================================================================
// AI Gateway
//
// Wire-shape aligned with specs/ai-gateway/_shared/contract.md (v0.1).
//
// - VirtualKey: project-scoped LangWatch-issued credential consumed by the
//   Go gateway. Secret is argon2id-hashed; only the display prefix is kept.
// - GatewayProviderCredential: a thin binding over an existing ModelProvider
//   row, carrying gateway-only settings (rate limits, rotation policy,
//   gateway-only extra headers). Never duplicates the raw API key.
// - VirtualKeyProviderCredential: the ordered fallback chain linking a VK
//   to N provider-credential bindings.
// - GatewayBudget: hierarchical budgets (org / team / project / vk /
//   principal) with calendar resets and block|warn semantics.
// - GatewayBudgetLedger: idempotent spend ledger keyed by
//   gateway_request_id (outbox pattern - writes from the Go gateway).
// - GatewayChangeEvent: monotonically-increasing revision feed consumed by
//   the gateway's long-poll `/internal/gateway/changes?since=N` endpoint.
// - AuditLog (top of file): unified actor/action/before/after audit for
//   every gateway-surface mutation alongside platform mutations.
// ============================================================================

enum VirtualKeyStatus {
  ACTIVE
  // Reversibly stopped: requests are rejected with a distinct error, but
  // the key material, scopes, budgets, and any rotation-grace state stay
  // intact so enable restores service without re-provisioning. REVOKED
  // stays terminal.
  DISABLED
  REVOKED
}

// Why this key exists. USER = explicitly created via the gateway UI / API.
// LANGY = auto-provisioned by the Langy in-product assistant; UI surfaces it
// as a managed row and forbids edit/revoke. Filtering by `purpose` replaces
// the legacy `name == "Langy" && principalUserId IS NULL` heuristic.
enum VirtualKeyPurpose {
  USER
  LANGY
}

// Rotation policy for gateway provider credentials.
// v1 ships MANUAL only - operators rotate via the Rotate button in
// the UI or by calling POST /providers/:id/rotate. Scheduled rotation
// (AUTO) and external-secret-store integration (Vault / AWS Secrets
// Manager / GCP Secret Manager) are v1.1 scope; the enum will grow
// back when those are implemented. Shipping stubbed options here
// would mislead operators into thinking they're configuring a feature
// that silently does nothing. See iter 56 dogfood feedback.
enum GatewayProviderRotationPolicy {
  MANUAL
}

enum GatewayProviderHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  CIRCUIT_OPEN
}

// GROUP is a per-member tier: one GROUP budget materialises one
// enforcement bucket per (budget, member), so "everyone in Engineering
// gets $50/month" is one row, not one row per person. The bucket rides
// the PRINCIPAL cascade machinery: the ledger stamps the member's user
// id and the bucket key is `<groupId>:<userId>`. There is no aggregate
// flavour: a shared pot across a department is a TEAM/PROJECT budget.
enum GatewayBudgetScopeType {
  ORGANIZATION
  TEAM
  PROJECT
  VIRTUAL_KEY
  PRINCIPAL
  GROUP
  // A TEMPLATE scope: scopeId is the ANCHOR (a virtual key or project id),
  // and the budget applies to each distinct external end-user id seen on
  // that anchor ("every end user: $limit per window"). Spend accrues into
  // lazy buckets keyed "<anchorId>:<endUserId>"; the bundle carries the one
  // template entry, never per-user rows (cardinality is unbounded).
  ATTRIBUTED_USER
}

enum GatewayBudgetWindow {
  MINUTE
  HOUR
  DAY
  WEEK
  MONTH
  TOTAL
  // Accrues until an explicit reset moves the period boundary; the period
  // is owned by the customer's billing cycle, not our calendar. Debit rows
  // bucket under the epoch sentinel (like TOTAL); reads bound by the
  // budget's currentPeriodStartedAt instead of a calendar period start.
  MANUAL
}

enum GatewayBudgetBreachAction {
  BLOCK
  WARN
}

enum GatewayBudgetLedgerStatus {
  SUCCESS
  PROVIDER_ERROR
  BLOCKED_BY_GUARDRAIL
  CANCELLED
}

enum GatewayChangeEventKind {
  VK_CREATED
  VK_CONFIG_UPDATED
  VK_REVOKED
  VK_ROTATED
  VK_DISABLED
  VK_ENABLED
  BUDGET_CREATED
  BUDGET_UPDATED
  BUDGET_DELETED
  MODEL_PROVIDER_UPDATED
  CACHE_RULE_CREATED
  CACHE_RULE_UPDATED
  CACHE_RULE_DELETED
  ROUTING_POLICY_UPDATED
  ROUTING_POLICY_DELETED
}

// Gateway audit action codes - kept as a TypeScript const union in
// platform/app/src/server/gateway/auditLog.repository.ts (no Prisma enum
// because gateway rows now write to the shared `AuditLog` table whose
// `action` column is a free-form String).
//
// enum GatewayAuditAction { ... } - removed in migration
// 20260425000000_consolidate_gateway_audit_into_audit_log.

enum GatewayCacheRuleMode {
  RESPECT
  FORCE
  DISABLE
}

// VirtualKey - org-scoped, multi-scope routing key for the AI Gateway.
//
// Iter 110 refactor: collapsed VirtualKey -> GatewayProviderCredential
// binding entirely (per rchaves). Provider-routing knobs (rpm/tpm/headers/
// providerConfig/etc) moved onto ModelProvider's "Advanced (Gateway)" tab.
// Per-VK chain ordering moved onto RoutingPolicy.modelProviderIds. Per-VK
// header overrides removed (use a sibling ModelProvider row for that 1%).
//
// Scoping mirrors ModelProviderScope (iter 109): a single VirtualKey row
// is reachable from multiple scopes (org / team / project) via
// VirtualKeyScope rows. No `projectId` column - multitenant key is
// `organizationId` (mandatory, matches the new dbMultiTenancyProtection
// invariant).
//
// `principalUserId` stays orthogonal to scopes: it marks "who owns this
// personal VK" for trace attribution + admin-view filtering, not "where
// can this route". A personal VK is a VK with `principalUserId` set; its
// scopes (typically ORGANIZATION) determine the routing reach.
//
// No DB-level FK constraints (codebase convention) - string columns +
// indexes; integrity enforced at service layer.
model VirtualKey {
  id             String @id @default(nanoid())
  organizationId String

  name        String
  description String?
  status      VirtualKeyStatus  @default(ACTIVE)
  purpose     VirtualKeyPurpose @default(USER)

  // The id the customer's own system knows this key by, unique per
  // organization so a provisioning run can address a key it created without
  // storing our id. Stored NULL rather than "" when absent: Postgres treats
  // NULLs as distinct in a unique index, which is what lets any number of
  // keys carry no external id at all.
  externalId String?

  // Customer-owned key/value map, echoed back verbatim on every read and
  // REPLACED wholesale on patch. Never read by the gateway, never used for
  // routing or authorization: it exists so a caller can carry its own
  // bookkeeping on our row.
  metadata Json @default("{}")

  // Set while status is DISABLED; cleared on enable. Revoke does not touch
  // these: DISABLED and REVOKED are independent lifecycle exits.
  disabledAt     DateTime?
  disabledReason String?

  // The moment the key stops serving, or null for a key that never
  // expires. Read at resolve time and compared with now, the same way
  // ApiKey.expiresAt is: the status column stays ACTIVE, so extending the
  // date is an ordinary edit and no sweeper has to run for the key to
  // stop. Unindexed on purpose: the check rides a lookup by secret hash
  // that already resolves one row.
  expiresAt DateTime?

  // Credential material. Full secret format:
  //   vk-lw-<26-char-crockford-ulid>  (32 chars total)
  // Only the hashed form and a short display prefix are kept after
  // creation. The full secret is shown exactly once.
  hashedSecret  String // argon2id(secret + server pepper)
  displayPrefix String // e.g. "vk-lw-01HZX9"

  // Principal user the VK is attributed to for trace ownership + audit.
  // Set for personal VKs minted via `langwatch login --device`; null for
  // org-/team-/project-owned VKs minted by an admin.
  principalUserId String?
  principalUser   User?   @relation("PrincipalScopedVirtualKeys", fields: [principalUserId], references: [id], onDelete: SetNull)

  // Where this key's traces and costs land. Decided once, when the key is
  // written, and stored: it used to be derived on every read by trying this
  // column, then the key's single project scope, then the organization's
  // governance project, which is three lookups that each had to remember
  // that a deleted project is not a destination.
  //
  // Deliberately NOT a VirtualKeyScope row: scope rows grant access and
  // visibility, and the trace destination must grant neither. Editing the
  // scopes therefore does not move it.
  //
  // Nullable at the database level, and the invariant that every key
  // written carries a destination is enforced in the app. A NOT NULL would
  // fail a self-hosted migration on an organization whose data predates
  // governance projects, where there is genuinely nothing to write; those
  // keys read as null, the gateway skips span export rather than failing,
  // and the next edit of the key is refused until it is given a home.
  traceProjectId String?

  // Slim config blob - per-key state only. The "gateway-config bundle"
  // that the gateway reads via /internal/gateway/config/:vk_id is now
  // materialised on-read from the scope graph (eligible ModelProviders
  // resolved by VirtualKeyScope + the linked RoutingPolicy ordering),
  // not pre-baked into this field. Allowed keys: `model_aliases`,
  // `models_allowed`. Everything else (rate_limits, fallback, cache,
  // guardrails) moved to ModelProvider (Advanced tab) or RoutingPolicy.
  config Json @default("{}")

  // Revision - every mutation bumps this; gateway uses it to skip config
  // fetches that would be no-ops.
  revision BigInt @default(0)

  // Rotation bookkeeping. When rotated in place, the previous secret stays
  // valid for 24h via `previousHashedSecret` + `previousSecretValidUntil`.
  previousHashedSecret     String?
  previousSecretValidUntil DateTime?

  revokedAt   DateTime?
  revokedById String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  createdById String
  lastUsedAt  DateTime?

  scopes        VirtualKeyScope[]
  ledgerEntries GatewayBudgetLedger[]

  // Optional RoutingPolicy reference. When set, gateway pulls
  // ordered ModelProvider chain from the policy + the policy's
  // modelAliases + policyRules. When null, the materialiser falls
  // back to ordering eligible ModelProviders by
  // `fallbackPriorityGlobal` (asc) then `createdAt` (asc) -
  // deterministic across runs and Go-side parsers.
  routingPolicyId String?
  routingPolicy   RoutingPolicy? @relation("VirtualKeyRoutingPolicy", fields: [routingPolicyId], references: [id], onDelete: SetNull)

  // Explicit routing behaviour. Split out of "routingPolicyId is null"
  // so "no fallback" is representable at all: the old implicit default
  // was fallback-across-everything-eligible, which quietly re-routes a
  // request (and its data) to another vendor. POLICY requires
  // routingPolicyId; NONE / FALLBACK_ALL require it to be null.
  routingMode VirtualKeyRoutingMode @default(NONE)

  @@unique([hashedSecret])
  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([displayPrefix])
  @@index([status])
  @@index([principalUserId])
  @@index([revision])
  @@index([routingPolicyId])
  @@index([organizationId, purpose])
}

// How a key behaves when the provider serving the requested model fails.
//
//   NONE          - no failover. The chain is exactly the provider that
//                   serves the requested model; a provider outage surfaces
//                   as an error instead of silently re-routing spend and
//                   data to a different vendor. Default for new keys.
//   FALLBACK_ALL  - try every eligible provider in priority order. This is
//                   what a null routingPolicyId used to mean implicitly,
//                   so existing keys migrate onto it and behave exactly as
//                   before.
//   POLICY        - ordering + rules come from the linked RoutingPolicy.
enum VirtualKeyRoutingMode {
  NONE
  FALLBACK_ALL
  POLICY
}

// VirtualKeyScope - N-scope access for VirtualKey, mirrors
// ModelProviderScope exactly. A single VK row is reachable from any
// scope it has a matching entry for. Writing requires the caller to
// hold the matching `virtualKeys:manage` permission at that scope.
//
// Scope-cascade resolution (read-time): a VK at PROJECT:P sees
// ModelProviders scoped at PROJECT:P, TEAM:P.team, or
// ORGANIZATION:vk.organizationId. A VK at ORGANIZATION sees only
// ORGANIZATION-scoped MPs (no leakage down). Same upward-walking
// intersection rule used by ModelDefaultConfig.
enum VirtualKeyScopeType {
  ORGANIZATION
  TEAM
  PROJECT
}

model VirtualKeyScope {
  id           String              @id @default(nanoid())
  virtualKeyId String
  virtualKey   VirtualKey          @relation(fields: [virtualKeyId], references: [id], onDelete: Cascade)
  scopeType    VirtualKeyScopeType
  scopeId      String
  createdAt    DateTime            @default(now())

  @@unique([virtualKeyId, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@index([virtualKeyId])
}

// ---------------------------------------------------------------------------
// RoutingPolicy - admin-defined routing template referenced by VirtualKey.
//
// A policy answers two gateway questions in one place:
//   1. Which provider credentials are eligible for a given request?
//   2. In what order / by what strategy do we pick among eligible providers?
//
// Decoupling these from the VK itself lets the admin publish (e.g.)
// `developer-default` once and have every personal VK in the org inherit
// the same routing semantics - no per-key configuration needed.
//
// Scoping mirrors GatewayBudget: an org-scoped policy applies to any VK
// in the org; a team-scoped policy applies to VKs whose project lives in
// that team; a project-scoped policy applies only to VKs in that project.
// `isDefault=true` (one per scope tier) makes the policy auto-apply when
// `virtualKey.issuePersonal` is called without an explicit policyId.
// ---------------------------------------------------------------------------
// RoutingPolicyScopeType - normalised from the legacy String 'scope'
// column to a proper Postgres enum, matching the per-table convention
// used by ModelProviderScopeType / GatewayBudgetScopeType / etc.
enum RoutingPolicyScopeType {
  ORGANIZATION
  TEAM
  PROJECT
}

model RoutingPolicy {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?

  // Ordered list of ModelProvider.id values (post-iter-110: GPC merged
  // into MP, the chain refers to MPs directly). JSON for shape
  // flexibility; gateway materialises into provider chain at request
  // time. Order = the order the gateway tries them in.
  modelProviderIds Json @default("[]")

  // Model name rewrites applied before dispatch. Shape:
  //   { "gpt-4o": "gpt-4o-mini", "claude": "anthropic/claude-haiku-4-5" }
  // Hoisted from per-VK config (iter 110) onto the RoutingPolicy so a
  // single policy edit updates every VK linked to it. Empty object = no
  // rewrites.
  //
  // The reserved tier names (complex / reasoning / fast, see
  // src/utils/modelTierPresets.ts) live in here as ordinary entries. The
  // gateway needs no knowledge of them: it looks a tier up the same way it
  // looks up any other name.
  modelAliases Json @default("{}")

  // The model a reserved tier name resolves to when this policy names no
  // target for it. Applies to the tier names ONLY, never as a catch-all for
  // an unrecognized model: a catch-all would serve a caller a model they
  // never named, turn every typo into a billed call, and make an allowlist
  // unenforceable because nothing would reach the rejection.
  //
  // Stores a concrete, provider-qualified model id. A moving name such as
  // "openai/latest" would make the gateway dispatch a model literally called
  // "latest".
  defaultModel String?

  // Provider-agnostic policy rules - deny/allow lists per dimension.
  // Shape: { tools: { deny: string[]; allow: string[] | null }, mcp: {...}, urls: {...}, models: {...} }
  // Hoisted from per-VK config (iter 110). Enforced pre-provider-dispatch.
  policyRules Json @default("{}")

  isDefault Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  createdBy   User?    @relation("RoutingPolicyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?    @relation("RoutingPolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // VKs that reference this policy. relationMode="prisma" so no SQL FK
  // is emitted; this exists purely to let the materialiser hydrate the
  // policy via `include: { routingPolicy: ... }` on the VK query.
  virtualKeys VirtualKey[] @relation("VirtualKeyRoutingPolicy")

  // Multi-scope assignments. A policy is selectable from any scope row
  // (union semantics). RoutingPolicyScope is the only source of truth
  // for which scopes a policy is reachable from.
  scopes RoutingPolicyScope[]

  @@index([organizationId])
}

// RoutingPolicyScope - N-scope access for RoutingPolicy. Mirrors
// VirtualKeyScope + ModelProviderScope exactly. A single RP row is
// reachable from any scope it has a matching entry for.
model RoutingPolicyScope {
  id              String                 @id @default(nanoid())
  routingPolicyId String
  routingPolicy   RoutingPolicy          @relation(fields: [routingPolicyId], references: [id], onDelete: Cascade)
  scopeType       RoutingPolicyScopeType
  scopeId         String
  createdAt       DateTime               @default(now())

  @@unique([routingPolicyId, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@index([routingPolicyId])
}

// ---------------------------------------------------------------------------
// GatewayGuardrail - project-scoped Evaluator binding the gateway enforces
// on inbound + outbound traffic per VK opt-in.
//
// Lifted from per-VK config (iter 110: vk.config.guardrails) so a project
// admin can author one guardrail and attach it to N VKs by reference,
// instead of duplicating the evaluator binding + failure mode on every VK.
// VKs opt in via vk.config.guardrailAttachments[] of
//   { direction, guardrailIds[] }
// tuples; cross-project attach is rejected at write time.
//
// Project-scoped only (for now) per rchaves: a single non-null projectId
// column, NO scope join table. Widening to team / org guardrails later
// drops the column to nullable + adds a GatewayGuardrailScope join in a
// separate migration. The single-column shape is intentional - keeps the
// current constraint enforced at schema level, not at resolver level.
//
// Spec: specs/ai-gateway/governance/guardrails-project-scope.feature
// ---------------------------------------------------------------------------
enum GatewayGuardrailDirection {
  PRE
  POST
  STREAM_CHUNK
}

enum GatewayGuardrailFailureMode {
  FAIL_OPEN
  FAIL_CLOSED
}

model GatewayGuardrail {
  id          String                      @id @default(nanoid())
  projectId   String
  project     Project                     @relation("ProjectGatewayGuardrails", fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  evaluatorId String
  evaluator   Evaluator                   @relation("EvaluatorGatewayGuardrails", fields: [evaluatorId], references: [id], onDelete: Restrict)
  direction   GatewayGuardrailDirection
  failureMode GatewayGuardrailFailureMode @default(FAIL_CLOSED)

  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  createdById String?
  createdBy   User?     @relation("GatewayGuardrailCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?     @relation("GatewayGuardrailUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([evaluatorId])
  @@index([projectId, archivedAt])
}

/// Per-platform fleet configuration that connects a closed SaaS
/// product's audit / OTel / S3 stream to LangWatch's Activity
/// Monitor (cf. specs/ai-gateway/governance/activity-monitor.feature
/// + ingestion-sources.feature, docs/ai-gateway/governance/architecture.md).
///
/// One IngestionSource = one upstream fleet (e.g. "Miro Cowork",
/// "Acme Workato production"). The runtime ingests events on whatever
/// cadence the source supports - push for OTel/webhook/S3 (Tier C/D),
/// pull for poll-based admin APIs (Tier C). Per-source-type adapters
/// normalise platform-specific shapes into OCSF + AOS before they
/// land in trace_summaries with SourceType + SourceId tags.
model IngestionSource {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Optional team-scope. null = org-wide.
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  /// 'otel_generic' | 'claude_cowork' | 'workato' | 'copilot_studio' |
  /// 'openai_compliance' | 'claude_compliance' | 's3_custom' (extensible).
  /// String not enum so adapters can be added without migrations - the
  /// supported set lives in code (activity-monitor adapter registry).
  sourceType String

  /// Human-friendly label for the admin UI. Unique per-org so two
  /// "Cowork" sources can coexist with different names.
  name        String
  description String?

  /// HMAC bearer token the upstream operator pastes into the platform
  /// (or LangWatch sends in pull mode). Stored encrypted at rest via
  /// the same pepper-derived KEK as VirtualKey secrets. Auto-generated
  /// on create, rotatable via the admin UI with a 24h grace window.
  ingestSecretHash String

  /// Per-source-type configuration. Shape is platform-specific:
  ///   - otel_generic: { allowedSourceTypeLabel?: string }
  ///   - claude_cowork: { workspaceId: string }
  ///   - workato: { sharedSecretLastFour: string }
  ///   - copilot_studio: { tenantId, clientId, clientSecretHash, pollEverySec }
  ///   - openai_compliance: { bucket, prefix, roleArn, pollEverySec }
  ///   - claude_compliance: { workspaceApiKeyHash, pollEverySec }
  ///   - s3_custom: { bucket, prefix, roleArn, parserDsl, pollEverySec }
  parserConfig Json @default("{}")

  /// For pull-based sources, persisted between polls so the next poll
  /// resumes where the last left off (timestamp / cursor / file marker).
  pollerCursor Json?

  /// Phase 10 - number of consecutive errors observed by the puller
  /// worker. Reset to 0 on a successful run. Drives admin-UI banners
  /// ("Microsoft authentication failed - re-authorize") + back-off
  /// scheduling when the source has been broken for a while.
  /// Spec: specs/ai-governance/puller-framework/puller-adapter-contract.feature
  errorCount Int @default(0)

  /// Phase 10 - cron schedule for pull-mode sources. Validated by the
  /// adapter's pullConfig schema; mirrored here for fast worker
  /// dispatch. Null for push-mode sources.
  pullSchedule String?

  /// Status flag. 'active' (default), 'disabled' (admin paused), or
  /// 'awaiting_first_event' (created but never received).
  status String @default("awaiting_first_event")

  /// ADR-088 v7: optional trace DESTINATION for conversation-bearing pulls
  /// (Databricks Genie). Null = don't route. Same shape as
  /// VirtualKey.traceProjectId: a destination is NOT a scope row and grants
  /// no access to the source; it only decides where routed conversation
  /// traces land. Must be a project of this org (validated at write time).
  /// Freely editable; already-routed history stays where it landed.
  /// NOT the deferred cost-attribution projectId (ADR-088 Decision 4).
  traceProjectId String?

  /// Last event timestamp observed (any direction). Surfaces in the
  /// admin UI as "last event 2 minutes ago".
  lastEventAt DateTime?

  archivedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  createdBy   User?    @relation("IngestionSourceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([teamId])
  @@index([sourceType])
}

/// Admin-defined anomaly detection rule. Evaluated server-side at
/// ingest time (Option C - not in this slice yet) against
/// gateway_activity_events. When triggered, an alert is dispatched
/// to the destinations configured on the rule (Slack / SIEM / webhook
/// / PagerDuty / email).
///
/// This is a configuration entity - the actual rule evaluation +
/// alert state lives in a future ClickHouse table
/// (gateway_anomaly_alerts) and a server-side worker. Spec:
/// specs/ai-gateway/governance/anomaly-rules.feature
/// (Alexis lane B C-UI; mocked-v0 today, real persistence is THIS slice).
model AnomalyRule {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// 'organization' | 'team' | 'project' | 'source_type' | 'source'.
  /// String not enum so new scopes ship without migrations.
  scope   String
  /// Org id / team id / project id / source-type string / source id
  /// - narrows what the rule applies to.
  scopeId String

  name        String
  description String?

  /// 'critical' | 'warning' | 'info'. Drives default destination
  /// routing (e.g. critical → PagerDuty, warning → Slack only).
  severity String

  /// Extensible rule taxonomy: 'spend_spike' | 'rate_limit' |
  /// 'tool_mismatch' | 'after_hours' | 'unusual_model' | 'pii_leak'
  /// | 'custom'. New types ship without migrations - evaluator
  /// picks a per-type implementation from a code registry.
  ruleType String

  /// Per-rule-type threshold shape. Examples:
  ///   spend_spike: { windowSec, ratioVsBaseline, minBaselineUsd }
  ///   rate_limit: { windowSec, requestsThreshold }
  ///   after_hours: { startHour, endHour, timezone, requestsThreshold }
  thresholdConfig Json @default("{}")

  /// Alert routing per destination. Shape:
  ///   { slack?: { channelId }, siem?: { endpointUrl, authHeader },
  ///     webhook?: { url, authHeader }, pagerduty?: { routingKey },
  ///     email?: { to: string[] } }
  /// Empty map = use org defaults (when defaults exist; today no-op).
  destinationConfig Json @default("{}")

  /// 'active' (default - evaluator picks it up) | 'disabled' (admin
  /// paused; rule rows kept for audit). 'archived' uses archivedAt
  /// timestamp instead so we can filter `archivedAt IS NULL` cheaply.
  status String @default("active")

  archivedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  createdBy   User?    @relation("AnomalyRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  alerts AnomalyAlert[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([scope, scopeId])
  @@index([ruleType])
  @@index([status])
}

/// Persisted anomaly detection. Inserted by the anomaly-detection
/// reactor (event-sourcing pipeline; modeled on PR #3351's
/// alertTrigger pattern) when a rule's threshold trips while
/// processing a freshly-arrived ActivityEventReceived event.
/// Read by api.activityMonitor.recentAnomalies for the admin dashboard.
///
/// Dedup: (ruleId, triggerWindowStart) - re-evaluating the same
/// window updates the existing row rather than creating a duplicate.
/// Acknowledgement / resolution are admin actions on the row.
///
/// Spec: specs/ai-gateway/governance/anomaly-detection.feature
model AnomalyAlert {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ruleId         String
  rule           AnomalyRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  /// Denormalised from rule for fast WHERE filtering on the
  /// dashboard query (no join needed for the common path).
  severity String
  ruleName String
  ruleType String

  /// Window the trigger refers to (UTC).
  triggerWindowStart DateTime
  triggerWindowEnd   DateTime

  /// Numeric trigger context. Per-rule-type detail in `detail` JSONB.
  triggerSpendUsd   Decimal? @db.Decimal(18, 6)
  triggerEventCount Int?

  /// Per-rule-type extra context: {topActors: [...], baseline: ...,
  /// observed: ..., timezone: ..., etc}.
  detail Json @default("{}")

  /// 'open' | 'acknowledged' | 'resolved'.
  state String @default("open")

  /// Per-destination dispatch outcome:
  ///   { webhook: { lastAttemptIso, lastError?, attemptCount, statusCode? },
  ///     slack: ..., pagerduty: ..., siem: ..., email: ... }
  destinationStatus Json @default("{}")

  detectedAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  @@unique([ruleId, triggerWindowStart])
  @@index([organizationId, detectedAt])
  @@index([ruleId])
  @@index([state])
}

/// Org-scoped catalog of AI tools surfaced on the personal home portal
/// (/me) and managed by org admins at /governance/tool-catalog.
///
/// Three first-class tile types via `type` discriminator:
///   - "coding_assistant" - click expands to setup helper (e.g. `langwatch claude`)
///   - "model_provider"   - click expands to inline personal-VK creation
///   - "external_tool"    - click expands to admin-attached markdown + external link
///
/// Scoping: organization-default entries can be OVERRIDDEN at the team
/// tier (same `slug` + `scope=team` + matching `scopeId`) so admins can
/// hide or re-skin a globally-listed tool for a specific team. The
/// user-facing `list` endpoint resolves this hierarchy at read time.
///
/// `config` is a discriminated JSON union per `type`:
///   coding_assistant: { setupCommand, setupDocsUrl, helperText? }
///   model_provider:   { providerKey, suggestedRoutingPolicyId?, defaultLabel?, projectSuggestionText? }
///   external_tool:    { descriptionMarkdown, linkUrl, ctaLabel? }
///
/// Spec: specs/ai-governance/personal-portal/tool-catalog-*.feature
model AiToolEntry {
  id             String       @id @default(nanoid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// "organization" | "team". String not enum so new scopes ship
  /// without migrations.
  scope   String
  /// organizationId or teamId, narrowing what scope this entry applies
  /// to. Always equals organizationId when scope=organization.
  scopeId String

  /// "coding_assistant" | "model_provider" | "external_tool".
  /// Discriminator drives the per-tile UX shape and validates
  /// the `config` JSON column at the app layer.
  type String

  displayName String

  /// Stable slug for team-overrides-org resolution (a team-scoped
  /// entry with the same slug as an org-scoped one hides the org
  /// default for users in that team). Server-owned: generated from
  /// displayName + nanoid(6) on create, immutable on update.
  slug String

  /// @deprecated Use `iconAsset` instead. Kept for back-compat with
  /// pre-refactor rows; new writes should populate iconAsset.
  iconKey String?

  /// Icon source - single column, prefix-discriminated:
  ///   "preset:claude_code" / "preset:codex" / ...   (built-in)
  ///   "data:image/svg+xml;base64,..."               (admin-uploaded)
  ///   null                                          → fall back to
  ///                                                   type-default in UI
  iconAsset String? @db.Text

  /// Admin-curated sort within the user-facing portal grid.
  order Int @default(0)

  /// When false the entry is hidden from the user-facing list but
  /// remains in the admin list (so admins can re-enable without
  /// losing per-entry config). Disabled is "soft-hide", archived is
  /// "soft-delete" (preserves audit trail + scope binding history).
  enabled Boolean @default(true)

  /// Per-type config JSON. Validated via zod discriminated union
  /// at the service layer (see AiToolEntryService).
  config Json @default("{}")

  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  createdById String?
  updatedById String?

  /// @deprecated Multi-team scope. Superseded by `departments` - the
  /// "Visible to" model is now WHOLE ORGANIZATION or a set of
  /// DEPARTMENTS. Rows are no longer written here (the table is kept
  /// for now to avoid a destructive drop); readers prefer `departments`.
  teams AiToolEntryTeam[]

  /// Department scope. Empty = org-wide (visible to every member).
  /// Non-empty = visible only to members whose `departmentId` is in
  /// this set. Mirrored onto the legacy scope/scopeId pair for
  /// back-compat reads (scope='organization' when empty,
  /// scope='department' otherwise).
  departments AiToolEntryDepartment[]

  @@index([organizationId, scope, scopeId])
  @@index([organizationId, enabled, archivedAt])
  @@index([organizationId, type])
}

/// @deprecated Per-team scope binding for AiToolEntry. Superseded by
/// AiToolEntryDepartment; kept so the rename migration is non-destructive.
/// No new rows are written here.
model AiToolEntryTeam {
  id      String      @id @default(nanoid())
  entryId String
  teamId  String
  entry   AiToolEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  team    Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([entryId, teamId])
  @@index([teamId])
}

/// Per-department scope binding for AiToolEntry. Empty set = org-wide.
/// Non-empty = entry visible only to members of those departments (an
/// OrganizationUser whose `departmentId` is in the set). Mirrors
/// AiToolEntryTeam's shape. `departmentId` is a plain column ref
/// (relationMode="prisma"), matching how Department is referenced
/// elsewhere; the service validates the id belongs to the org.
model AiToolEntryDepartment {
  id           String      @id @default(nanoid())
  entryId      String
  departmentId String
  entry        AiToolEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, departmentId])
  @@index([departmentId])
}

/// Admin/platform-curated catalog row for upstream OTLP normalization.
/// Owns the OTTL transform that reshapes a specific upstream tool's
/// span shape into canonical gen_ai conventions. Users connect via an
/// ingestion key (an ingest-only ApiKey carrying ingestionTemplateId) to
/// land traces in their personal project.
///
/// `organizationId` NULL = platform-published default (always-visible
/// across every org). NOT NULL = org-authored (visible only within
/// that org). v1 ships only platform-published; org-authored authoring
/// UI lands v2 (the column ships now to avoid a future migration).
///
/// Spec: specs/ai-gateway/governance/ingestion-templates-catalog.feature
model IngestionTemplate {
  id             String        @id @default(nanoid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Stable slug - unique within (organizationId, slug) scope. Generated
  /// from displayName + nanoid(6) on create for org-authored; canonical
  /// values for platform-published (`claude_code` / `cursor` /
  /// `claude_cowork` / `raw_otlp_advanced`).
  slug String

  /// Mirrors the slug for v1 platform-published rows. Kept as a separate
  /// column so a future v2 may publish two templates that share an
  /// upstream sourceType (e.g. claude_code-personal vs claude_code-team)
  /// without a migration. String not enum - extensibility.
  sourceType String

  displayName String
  description String? @db.Text

  /// Icon source - single column, prefix-discriminated, mirrors
  /// AiToolEntry.iconAsset:
  ///   `preset:<kind>`                 (built-in slot)
  ///   `data:image/svg+xml;base64,…`   (admin-uploaded for org-authored)
  ///   null                            → fall back to slug-default in UI
  iconAsset String? @db.Text

  /// Discriminator for what (if any) extra credential metadata the
  /// install drawer captures from the user:
  ///   null              → otlp_token-only (drawer auto-issues the
  ///                       ingestion key, no input form)
  ///   `static_api_key`  → drawer captures the user's upstream tool API key
  ///   `agent_id`        → drawer captures an agent identifier (e.g.
  ///                       Cursor agentId)
  /// String not enum so v2 shapes (oauth_redirect / s3_bucket) ship
  /// without a migration.
  credentialSchema String?

  /// Admin/platform-authored OTTL statements. Applied at receive time
  /// AFTER the receiver re-stamps the binding's authoritative principal
  /// + provenance keys (see `protectedTemplateAttributeKeys` 19-key
  /// closed list). Templates write canonical OTTL outputs (gen_ai.*,
  /// cost.usd, response.model) - they CANNOT write attribution or
  /// provenance keys; the receiver guard restores those post-OTTL.
  ottlRules String @default("") @db.Text

  /// True for the v1 platform-published default templates
  /// (organizationId IS NULL). Future org-authored rows write false.
  /// Drives the admin UI "READ-ONLY view + Request a custom template"
  /// surface - admins consume + opt-out only in v1.
  platformPublished Boolean @default(false)

  /// Admin/platform enable. False = hidden from /me catalog. Existing
  /// ingestion keys continue to land traces; new installs are blocked.
  enabled Boolean @default(true)

  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  createdById String?
  updatedById String?

  @@unique([organizationId, slug])
  @@index([organizationId, archivedAt])
  @@index([sourceType])
}

// GatewayProviderCredential + VirtualKeyProviderCredential were both
// dropped in iter 110 (collapse-VK-binding refactor). Provider-routing
// knobs (rateLimitRpm/Tpm/Rpd, extraHeaders, providerConfig,
// fallbackPriorityGlobal, rotationPolicy, health-status / circuit
// state) live on `ModelProvider` directly; the order-of-providers
// ("which to try first") lives on `RoutingPolicy.modelProviderIds`.

model GatewayBudget {
  id             String                 @id @default(nanoid())
  organizationId String
  // Single source of truth for the target (ADR-021): inline (scopeType,
  // scopeId) within one organization. scopeId is a team / project / virtual
  // key / user id depending on scopeType; the query layer reads it directly.
  // No typed FK columns - scope-entity deletion cleanup is a service-layer
  // concern, consistent with the no-foreign-key-constraints convention.
  scopeType      GatewayBudgetScopeType
  scopeId        String

  // Provider filter, orthogonal to the target: null = every provider the
  // key can reach; set = the budget only counts and only constrains spend
  // dispatched to that provider. This is what makes the targeting matrix
  // n x n ("$50/month on OpenAI for the platform team") without adding a
  // scope type per provider. Holds a `ModelProvider.id` (the row id, not
  // the provider type key): it survives renames and is the same identity
  // the gateway keys credentials on, so chain filtering is an id compare.
  providerKey String?

  name        String
  description String?
  window      GatewayBudgetWindow
  limitUsd    Decimal                   @db.Decimal(18, 6)
  onBreach    GatewayBudgetBreachAction @default(BLOCK)
  timezone    String? // org-level default if null

  // See the matching fields on VirtualKey: the customer's own id for this
  // budget, unique per organization and stored NULL when absent, plus a
  // customer-owned map this platform only ever echoes back.
  externalId String?
  metadata   Json    @default("{}")

  // Mutated by the ledger, read by the gateway as part of the config payload.
  spentUsd               Decimal   @default(0) @db.Decimal(18, 6)
  currentPeriodStartedAt DateTime  @default(now())
  resetsAt               DateTime
  lastResetAt            DateTime?

  // The phase of a cyclic window. NULL keeps the window calendar aligned
  // (a MONTH budget rolls on the 1st); set, the window rolls from this
  // instant instead, so a budget anchored on the 17th at 09:00 UTC starts a
  // fresh month every 17th at 09:00 UTC. Immutable once written: moving it
  // would redraw every period the budget has already reported and enforced
  // on. Only ever set on a cyclic window; TOTAL and MANUAL do not cycle.
  cycleAnchorAt DateTime?

  archivedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String
  createdBy   User     @relation("GatewayBudgetCreatedBy", fields: [createdById], references: [id])

  ledgerEntries    GatewayBudgetLedger[]
  bucketBoundaries GatewayBudgetBucketBoundary[]

  // Set when this budget row is the one the virtual-key drawer's budget
  // field manages (created with the key or through its edit drawer).
  // Clearing the drawer field archives ONLY this row; budgets created
  // independently on the Budgets page keep their own lifecycle and their
  // own delete permission.
  managedByVirtualKeyId String?

  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([scopeType, scopeId, providerKey])
  @@index([managedByVirtualKeyId])
  @@index([resetsAt])
}

// Per-bucket period boundary for ATTRIBUTED_USER template budgets. The
// template's own currentPeriodStartedAt is the anchor-wide boundary; a
// single end-user bucket reset (POST budgets/:id/reset?end_user_id=) writes
// a row here instead of moving the whole template. Spend reads for a bucket
// bound by max(template boundary, bucket boundary). Rows are boundaries,
// not counters: recorded spend is never mutated.
model GatewayBudgetBucketBoundary {
  id             String        @id @default(nanoid())
  organizationId String
  budgetId       String
  budget         GatewayBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  // The ledger bucket key: "<anchorId>:<endUserId>".
  bucketScopeId  String

  periodStartedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([budgetId, bucketScopeId])
  @@index([organizationId])
}

model GatewayBudgetLedger {
  id       String        @id @default(nanoid())
  budgetId String
  budget   GatewayBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  virtualKeyId    String
  virtualKey      VirtualKey @relation(fields: [virtualKeyId], references: [id], onDelete: Cascade)
  // Post-iter-110 GPC merged into ModelProvider; ledger entries point
  // at the MP directly. Column kept nullable for ledger rows whose
  // resolving provider has since been deleted (audit-only state).
  modelProviderId String?

  // The provider the request was actually dispatched to, stamped on every
  // debit so a provider-filtered budget accumulates only its own spend.
  // Same identity as GatewayBudget.providerKey (a ModelProvider row id).
  // Null when the dispatching gateway did not report one.
  providerKey String?

  // Idempotency key - ULID produced by the gateway per request. Dedup for 24h.
  gatewayRequestId String
  amountUsd        Decimal                   @db.Decimal(18, 6)
  tokensInput      Int                       @default(0)
  tokensOutput     Int                       @default(0)
  tokensCacheRead  Int                       @default(0)
  tokensCacheWrite Int                       @default(0)
  model            String
  durationMs       Int?
  status           GatewayBudgetLedgerStatus @default(SUCCESS)
  occurredAt       DateTime                  @default(now())

  @@unique([budgetId, gatewayRequestId])
  @@index([virtualKeyId])
  @@index([gatewayRequestId])
  @@index([occurredAt])
}

model GatewayChangeEvent {
  // Monotonically-increasing revision the gateway long-polls on.
  revision        BigInt                 @id @default(autoincrement())
  organizationId  String
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind            GatewayChangeEventKind
  virtualKeyId    String?
  budgetId        String?
  // Post-collapse: events pointing at a provider point at the
  // ModelProvider directly (no separate binding row).
  modelProviderId String?
  projectId       String?
  project         Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  payload         Json?
  createdAt       DateTime               @default(now())

  @@index([organizationId, revision])
  @@index([projectId, revision])
  @@index([virtualKeyId])
  @@index([budgetId])
}

// model GatewayAuditLog removed - gateway services now write to the
// shared `AuditLog` model (top of file). See migration
// 20260425000000_consolidate_gateway_audit_into_audit_log.

// AI Gateway cache-control rules - operator-defined overrides without
// client code changes. Org-scoped; compiled into the VK bundle at
// /changes-refresh time so the hot path stays at ~700 ns. Matchers +
// action live as JSON so the wire schema can evolve without migrations.
// See specs/ai-gateway/cache-control-rules.feature for the contract and
// docs/ai-gateway/cache-control.mdx for the rules-engine narrative.
model GatewayCacheRule {
  id             String @id @default(nanoid())
  // organizationId is the multitenancy boundary; no FK is enforced at the
  // DB level (org-scoped table, distribution-friendly). The service layer
  // guards orphan-org refs at write time.
  organizationId String

  name        String
  description String?
  priority    Int     @default(100)
  enabled     Boolean @default(true)

  // Matchers are ANDed. Null / empty means "no constraint on this field".
  // Shape (validated in the service layer, JSON on the wire):
  //   {
  //     vk_id?: string,
  //     vk_tags?: string[],
  //     vk_prefix?: string,
  //     principal_id?: string,
  //     model?: string,
  //     request_metadata?: Record<string, string>
  //   }
  matchers Json

  // Action applied when the rule matches.
  //   { mode: "respect"|"force"|"disable", ttl?: number, salt?: string }
  // `mode` is also captured in `modeEnum` so we can index by it; the
  // JSON column keeps the full action for forward compatibility with
  // ttl / salt etc.
  action   Json
  modeEnum GatewayCacheRuleMode

  archivedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  // createdById is a user reference; no FK enforced (distribution policy).
  // The service layer enforces "rule is created by an active user".
  createdById String

  @@index([organizationId, archivedAt, priority])
  @@index([organizationId, enabled, priority])
}

// FeatureFlag stores the postgres-backed value for one registered
// flag, used to keep system-scoped kill switches and pipeline toggles
// off PostHog (see specs/ops/internal-feature-flags.feature). The
// in-code registry holds metadata (scope, description, default); this
// table just holds the current operator-set value. Absence of a row
// means "use the registry default".
//
// One row per flag key. No per-tenant overrides: system kill switches
// flip cluster-wide; PostHog still owns user/A-B targeting for product
// flags via the PRODUCT scope path in featureFlagService.
model FeatureFlag {
  key          String   @id
  enabled      Boolean
  // Optional list of targeting rules evaluated before the `enabled`
  // fallback. Each rule is `{ match: { projectId?, organizationId? },
  // enabled: boolean }` - first match wins. Shape lives in
  // `src/server/featureFlag/rules.ts` so it can grow over time
  // (percentage rollouts, email-domain matches, etc.) without a
  // migration. Storing as JSON keeps the surface flexible while
  // postgres handles the row-level cache invalidation.
  rules        Json?
  // Last operator to flip the value. Free-form string (user id), no FK
  // because the same table serves SaaS and self-hosted installs where
  // the User table is not guaranteed to share lifecycle with this row.
  lastEditedBy String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

/// Durable state for a long-running event-sourced process.
model ProcessManagerInstance {
  id          String    @id @default(nanoid())
  processName String
  projectId   String
  processKey  String
  tenantId    String
  userId      String?
  state       Json
  revision    Int
  nextWakeAt  DateTime? @db.Timestamptz(3)
  updatedAt   DateTime  @db.Timestamptz(3)

  @@unique([processName, projectId, processKey])
  @@index([nextWakeAt])
}

/// Idempotency marker for a source event consumed by a process definition.
model ProcessManagerInbox {
  id             String   @id @default(nanoid())
  processName    String
  projectId      String
  processKey     String
  tenantId       String
  /// The raw source event id, kept UNINDEXED for diagnostics. A caller composes
  /// this and its length is that domain's business, so it must never carry a
  /// btree constraint — see `sourceEventKey`.
  sourceEventId  String
  /// The fixed-width digest of `sourceEventId` the uniqueness is enforced on,
  /// derived by the store (`stores/inboxKey.ts`). Postgres cannot index a btree
  /// row past ~2704 bytes; keying on a digest makes the constraint the same
  /// width no matter what any pipeline concatenates into an idempotency key.
  ///
  /// Nullable ONLY for the rolling deploy that introduces it — pods running the
  /// previous build write rows without it, and a NOT NULL would fail their
  /// commits outright. The store always supplies it.
  ///
  /// The trade, stated plainly: a NULL is not constrained by the unique index
  /// (btree treats NULLs as distinct), so while an old writer is serving, the
  /// one case that loses its guard is the same source event reaching two
  /// different process keys at once — the store's own read-check plus its
  /// per-processKey advisory lock cover everything else. A follow-up migration
  /// adds NOT NULL once the fleet has cycled and closes it.
  sourceEventKey String?
  consumedAt     DateTime @db.Timestamptz(3)
  // Do not add an index on `consumedAt` here. The retention sweep can use one,
  // but a deploy-time CREATE INDEX holds a SHARE lock that blocks INSERT on
  // this table, the highest-volume write path in the system. The index is
  // ops-managed instead: built with CREATE INDEX CONCURRENTLY, see
  // dev/docs/runbooks/process-manager-table-purge.md. The sweep works without
  // it on the bounded table it maintains.

  @@unique([processName, projectId, sourceEventKey])
  @@index([processName, projectId, processKey, consumedAt])
}

enum ProcessManagerOutboxStatus {
  pending
  dispatched
  dead
  /// An operator marked this dead message as never-to-be-sent
  /// (specs/ops/dead-letter-recovery.feature). A mark, not a delete: the row
  /// is retained as its own audit trail and the dispatcher never leases it.
  discarded
}

enum ProcessManagerOutboxAttemptOutcome {
  retry_scheduled
  dead
}

/// Transactional intents emitted by a durable process transition.
model ProcessManagerOutbox {
  id            String                     @id @default(nanoid())
  processName   String
  projectId     String
  processKey    String
  tenantId      String
  userId        String?
  messageKey    String
  intentType    String
  payload       Json
  traceCarrier  Json
  sourceEventId String?
  status        ProcessManagerOutboxStatus @default(pending)
  attempts      Int                        @default(0)
  nextAttemptAt DateTime                   @db.Timestamptz(3)
  leasedUntil   DateTime?                  @db.Timestamptz(3)
  leaseToken    String?                    @unique
  dispatchedAt  DateTime?                  @db.Timestamptz(3)
  createdAt     DateTime                   @db.Timestamptz(3)
  updatedAt     DateTime                   @db.Timestamptz(3)
  // Do not add an index on `dispatchedAt` here. The retention sweep can use a
  // partial one (WHERE status = 'dispatched'), but Prisma cannot express a
  // partial index and a deploy-time CREATE INDEX holds a SHARE lock that
  // blocks INSERT on this table, the highest-volume write path in the system.
  // The index is ops-managed instead: built with CREATE INDEX CONCURRENTLY,
  // see dev/docs/runbooks/process-manager-table-purge.md. The sweep works
  // without it on the bounded table it maintains.

  attemptLog ProcessManagerOutboxAttempt[]

  @@unique([processName, projectId, messageKey])
  @@index([processName, projectId, processKey, createdAt])
  @@index([status, nextAttemptAt, leasedUntil])
}

/// Why an outbox delivery failed, one row per FAILED attempt
/// (specs/ops/dead-letter-recovery.feature). Successes write nothing, so the
/// table grows with trouble, not with traffic. Rows die with their message:
/// the cascade delete is the retention story, riding the existing sweep.
model ProcessManagerOutboxAttempt {
  id           String                             @id @default(nanoid())
  outboxId     String
  projectId    String
  /// 1-based attempt number, as the dispatcher counts it.
  attempt      Int
  occurredAt   DateTime                           @db.Timestamptz(3)
  outcome      ProcessManagerOutboxAttemptOutcome
  errorType    String
  /// The safe failure diagnostic the dispatcher already computes for its
  /// span — never a raw provider body.
  errorMessage String
  retryAfterMs Int?

  outbox ProcessManagerOutbox @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  // Also what makes the cascade delete affordable: Postgres does not index
  // the referencing side of a foreign key on its own.
  @@index([outboxId, attempt])
}

/// Per-project topic clustering run status (ADR-051): the rebuildable
/// operational read model behind the settings page. One row per project;
/// folded from run_completed/run_failed events, never written directly.
model TopicClusteringRunProjection {
  /// KSUID (`topicrun_…`), generated by the repository on first upsert.
  id        String @id
  projectId String

  LastRequestedAt            Float?  @map("lastRequestedAt")
  LastRequestTrigger         String? @map("lastRequestTrigger")
  LastRunAt                  Float?  @map("lastRunAt")
  /// completed | skipped | failed
  LastRunOutcome             String? @map("lastRunOutcome")
  LastRunMode                String? @map("lastRunMode")
  LastRunSkippedReason       String? @map("lastRunSkippedReason")
  LastRunError               String? @map("lastRunError")
  LastRunErrorCode           String? @map("lastRunErrorCode")
  /// True when the customer can resolve the failure (credentials, quota).
  LastRunErrorUserActionable Boolean @default(false) @map("lastRunErrorUserActionable")
  LastRunTracesProcessed     Int     @default(0) @map("lastRunTracesProcessed")
  LastRunTopicsCount         Int     @default(0) @map("lastRunTopicsCount")
  LastRunSubtopicsCount      Int     @default(0) @map("lastRunSubtopicsCount")
  LastRunPages               Int     @default(0) @map("lastRunPages")
  InProgressRunId            String? @map("inProgressRunId")
  InProgressTraces           Int     @default(0) @map("inProgressTraces")
  InProgressPages            Int     @default(0) @map("inProgressPages")
  /// Business time the in-progress run opened; bounds how long the read
  /// model may report it as running (mirrors the process's stale-run guard).
  InProgressStartedAt        Float?  @map("inProgressStartedAt")

  CreatedAt         Float  @map("createdAt")
  UpdatedAt         Float  @map("updatedAt")
  /// Business time of the latest applied event.
  OccurredAt        Float  @map("occurredAt")
  /// Event-log acceptance time. Together with lastEventId this is the cursor.
  AcceptedAt        Float  @map("acceptedAt")
  LastEventId       String @map("lastEventId")
  ProjectionVersion String @map("projectionVersion")

  @@unique([projectId])
}

/// Cursor row for the topic-model projection (ADR-051). The model itself is
/// the `Topic` table, written through by the projection; this row only
/// records how far the fold has applied the event log.
model TopicModelProjection {
  /// KSUID (`topicmodel_…`), generated by the repository on first upsert.
  id        String @id
  projectId String

  CreatedAt         Float  @map("createdAt")
  UpdatedAt         Float  @map("updatedAt")
  /// Business time of the latest applied event.
  OccurredAt        Float  @map("occurredAt")
  /// Event-log acceptance time. Together with lastEventId this is the cursor.
  AcceptedAt        Float  @map("acceptedAt")
  LastEventId       String @map("lastEventId")
  ProjectionVersion String @map("projectionVersion")

  @@unique([projectId])
}

/// Per-project topic clustering run history (audit read model, ADR-051).
/// One row per project; `runs` is the bounded newest-first entry list.
/// Rebuildable by replaying the event log.
model TopicClusteringRunHistoryProjection {
  /// KSUID (`topicrunhist_…`), generated by the repository on first upsert.
  id        String @id
  projectId String

  Runs Json @map("runs")

  CreatedAt         Float  @map("createdAt")
  UpdatedAt         Float  @map("updatedAt")
  /// Business time of the latest applied event.
  OccurredAt        Float  @map("occurredAt")
  /// Event-log acceptance time. Together with lastEventId this is the cursor.
  AcceptedAt        Float  @map("acceptedAt")
  LastEventId       String @map("lastEventId")
  ProjectionVersion String @map("projectionVersion")

  @@unique([projectId])
}

/// Rebuildable per-source pull checkpoint and operator-facing run status.
model IngestionPullRunProjection {
  id        String @id
  sourceId  String @unique
  projectId String

  Enabled           Boolean @default(false) @map("enabled")
  Cron              String? @map("cron")
  Cursor            String? @map("cursor")
  LastRunAt         Float?  @map("lastRunAt")
  LastRunOutcome    String? @map("lastRunOutcome")
  LastRunEventCount Int     @default(0) @map("lastRunEventCount")
  LastRunError      String? @map("lastRunError")
  LastRunErrorCode  String? @map("lastRunErrorCode")
  ConsecutiveErrors Int     @default(0) @map("consecutiveErrors")

  /// Identity of the run whose outcome this row reflects. Outcomes from a
  /// superseded run arrive with a smaller value and are ignored, so a late
  /// completion cannot regress Cursor or the status fields.
  LastRunScheduledFor Float? @map("lastRunScheduledFor")

  CreatedAt         Float  @map("createdAt")
  UpdatedAt         Float  @map("updatedAt")
  OccurredAt        Float  @map("occurredAt")
  AcceptedAt        Float  @map("acceptedAt")
  LastEventId       String @map("lastEventId")
  ProjectionVersion String @map("projectionVersion")

  @@index([projectId])
}

// ============================================================================
// Langy assistant
// ============================================================================
// The Langy conversation SPINE moved off Postgres onto the event-sourcing
// framework (ADR-046). The conversation is now a projection of an event stream:
// its spine lives in the ClickHouse `langy_conversations` fold table and its
// messages in `langy_messages`. The old `LangyConversation` Postgres model was
// deleted; see migration `..._drop_langy_conversation`.

// ADR-042 Phase 1: the generic calendar-scheduling primitive. One row per
// scheduled thing, `targetType`/`targetId` keep it consumer-agnostic (a
// scheduled report writes `("reportTrigger", trigger.id)`; a future weekly
// rollup writes its own type). The durable Postgres row is the SOURCE OF
// TRUTH AND the only coordination layer — NO Redis. The in-process
// SchedulerService loop (worker-only) reads `nextRunAt` to sleep until the
// soonest due job, scans due rows, and atomically CLAIMS each via a
// conditional `UPDATE ... WHERE id = <id> AND nextRunAt = <expected>` before
// firing its registered handler. That conditional claim is the SOLE
// exactly-once mechanism: exactly one of N racing workers wins each slot, so
// every worker can run the loop and share firing load (no leader-lock). See
// src/server/app-layer/scheduler/ and dev/docs/adr/044-scheduled-reports-automation-kind.md.
model ScheduledJob {
  id          String    @id @default(nanoid())
  projectId   String // multitenancy + per-tenant fairness
  targetType  String // the consumer key, e.g. "reportTrigger"
  targetId    String // what to fire, e.g. the Trigger.id
  cron        String // e.g. "0 9 * * 1"
  timezone    String // IANA, e.g. "America/New_York"
  // Forward marker: the resolved UTC instant of the next fire. Indexed so
  // the loop's due-scan and MIN(nextRunAt) sleep target are cheap.
  nextRunAt   DateTime
  // Last calendar instant fired (the "slot"). NULL until the first fire.
  // Only advanced once a fire is DELIVERED, so a failed slot is retried, not
  // silently skipped.
  lastSlot    DateTime?
  // The calendar instant of the slot currently in flight (claimed, retrying,
  // or crash-recovering). Stamped by the FIRST claim of a slot and preserved
  // across retry/lease re-claims, because `nextRunAt` mutates into a backoff
  // or lease instant the moment a slot is worked — without this column a
  // retried daily report would compute its window from the backoff instant
  // (minutes) instead of the cron slot (a day). NULL when no slot is in
  // flight (delivered / abandoned / released).
  currentSlot DateTime?
  // Retry bookkeeping. On claim the loop leases the slot by pushing
  // `nextRunAt` a lease-window into the future without advancing to the next
  // cron slot; a handler failure re-arms `nextRunAt` at a bounded backoff and
  // bumps `attempts`, so the slot is retried instead of lost. Once `attempts`
  // reaches the cap the slot is abandoned to the next cron instant with
  // `lastError` kept for the operator. Reset to (0, NULL) on a delivered fire.
  attempts    Int       @default(0)
  lastError   String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  // One schedule per target — makes upsertForTarget / claim a clean
  // conditional update keyed on the target identity.
  @@unique([targetType, targetId])
  // The due-scan: `WHERE active AND nextRunAt <= now` and MIN(nextRunAt).
  @@index([active, nextRunAt])
  // Per-project lookup.
  @@index([projectId])
}

// Issue reports sent by customers' coding agents through `langwatch report`
// (CLI) or the MCP report tool. A global support inbox, read only from the
// admin backoffice: no tenancy column on purpose. `linkedProjectId` is
// informational (resolved from an optional API key at intake, kept without an
// FK so reports outlive project deletion).
model BugReport {
  id               String   @id @default(nanoid())
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  source           String
  kind             String
  title            String
  summary          String?
  sessionData      String?
  sessionTruncated Boolean  @default(false)
  agent            String?
  contactEmail     String?
  cliVersion       String?
  linkedProjectId  String?
  metadata         Json?

  @@index([createdAt])
}

// The stored outcome of a request that carried an `Idempotency-Key`, so that
// retrying a create returns the original answer instead of creating a second
// row. See `~/server/api/idempotency` for the semantics.
//
// `scopeId` is the tenancy the key is unique within: the project on the
// gateway platform's creates, the organization on the webhook platform's,
// matching each family's auth scope. A key is private to the tenant that used
// it, so two tenants can pick the same string without colliding.
//
// A NULL `responseStatus` is the pending marker, written before the handler
// runs and filled in once it succeeds. Only successful outcomes are ever
// stored, so a row with a status is always a 2xx worth replaying.
//
// `responseBody` holds the exact bytes of the original response, AES-256-GCM
// encrypted under CREDENTIALS_SECRET. Encrypted because two of the four creates
// answer with a show-once secret that is kept nowhere else in readable form, so
// replaying them means the secret transits this row. Stored as the serialised
// bytes rather than as a document because that is what makes a replay
// byte-identical: a string round trip leaves nothing in a position to reorder
// or renormalise it.
//
// Expired rows are dropped lazily, when their key is next presented, as are
// rows that no longer decrypt because the secret was rotated under them. The
// `expiresAt` index is there so an operator can also prune in bulk, since keys
// that are never retried are never revisited.
model IdempotencyReceipt {
  id                 String   @id @default(nanoid())
  scopeId            String
  key                String
  claimId            String
  requestFingerprint String
  responseStatus     Int?
  responseBody       String?  @db.Text
  createdAt          DateTime @default(now())
  heartbeatAt        DateTime
  expiresAt          DateTime

  @@unique([scopeId, key])
  @@index([expiresAt])
}

// The status of a brokered realtime voice session (ADR-097).
enum GatewayRealtimeSessionStatus {
  // The credential was minted and the call may be running. Only OPEN rows
  // count against the key's cap.
  OPEN
  // The vendor reported the call, or the client posted its usage.
  CLOSED
  // The mint never produced a credential, so no call exists.
  FAILED
  // The row outlived the longest call the vendor allows with no report.
  // Its spend record settles as cost-unknown; a late report supersedes it.
  EXPIRED
}

// One brokered realtime voice session.
//
// The gateway holds no session state: a voice session outlives the request
// that minted it, its vendor report lands on whichever replica answers next,
// and the per-key open-session cap has to be counted somewhere every replica
// sees. This row is that place.
//
// `id` IS the gateway request id, so the session and its spend record are one
// aggregate seen from two sides. Nothing here carries conversation content:
// the media socket runs client to vendor and never reaches this platform.
model GatewayRealtimeSession {
  id             String @id
  projectId      String
  organizationId String
  virtualKeyId   String

  // The credential row the mint used. The vendor's webhook is verified
  // against this row's own secret, which is what keeps the HMAC check a
  // single computation instead of a walk over every configured provider.
  modelProviderId String

  // "openai" or "elevenlabs". Not an enum: a vendor added later must not
  // need a migration on the hot path of a mint.
  vendor  String
  agentId String?

  // The catalog id this session bills under.
  model String

  // The model id the caller asked for, which is what the mint's own span
  // records. It differs from `model` whenever the request named a
  // provider-prefixed alias, so the settlement span has to use this one or
  // one call shows up as two models: the mint at no cost, and the cost under
  // a name the trace never mentions.
  requestedModel String?

  // The vendor's own id for the conversation. Unique per vendor so a
  // redelivered post-call report resolves to exactly one session, and NULL
  // until the mint reports one, since Postgres treats NULLs as distinct.
  vendorConversationId String?

  status GatewayRealtimeSessionStatus @default(OPEN)

  mintedAt    DateTime  @default(now())
  closedAt    DateTime?
  // Why the session left OPEN, for the rows that did not close normally.
  closeReason String?

  // The customer-facing trace the mint was recorded under.
  //
  // A brokered call runs client to vendor, so the only span the gateway emits
  // for it is the mint itself, and that span is written before the call has
  // cost anything. Keeping the trace id here lets the settlement write its
  // cost back into the same trace, so one session stays one trace instead of
  // becoming a zero-cost mint next to an orphaned cost.
  traceId String?

  // The vendor's own cost payload, kept verbatim for reconciliation only.
  // Money is rated from the quantities like every other request; this is
  // what the two are compared against when they disagree.
  vendorCostRaw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // The webhook lookup. Unique per vendor across the whole table, not per
  // tenant: a vendor's conversation id is unique in the vendor's own system,
  // so two tenants presenting the same one is a bug rather than a collision
  // to tolerate. Tenant isolation on the read path is matchRealtimeSession's
  // organizationId filter, not this key.
  @@unique([vendor, vendorConversationId])
  // The cap count: open sessions for one key inside the window.
  @@index([virtualKeyId, status, mintedAt])
  // The fallback match, and the expiry sweep.
  @@index([projectId, status, mintedAt])
}

// One record per (migration, tenant) for the in-place system migrations
// runner (@langwatch/system-migrations): one-time data migrations the
// system performs on itself at worker boot, organization by organization.
// "Pending" is the absence of a record. `status` is the package's
// TenantMigrationStatus ("migrated" | "finalized" | "parked"); "finalized"
// is a one-way latch hot paths read through an in-process cache (a tenant
// may only leave its legacy path once its record says finalized). `report`
// carries the migration's own evidence: parity diffs for a held tenant,
// the error for a parked one, counts for a finalized one. `tenantId` is an
// Organization id as a plain column ref (no FK) - the runner is generic
// over tenants and survives organization deletion trivially. First rider:
// the ADR-092 stage-B TeamUser backfill (@langwatch/authz-server). Spec:
// specs/migration/authz-grants-rollout.feature.
model SystemMigrationTenantState {
  migrationName String
  tenantId      String
  status        String
  report        Json?
  // BUSINESS time of the transition this row holds - stamped by whoever
  // wrote it, never by the database. `updatedAt` is wall-clock and moves for
  // reasons that are not transitions, so it cannot order a transition against
  // a replayed one: a row created by a replay carries `updatedAt = now` and
  // would then reject every LATER fact in the same replay. The grants-ledger
  // projection guards its writes on this column instead
  // (authz-grants-projection.prisma.repository.ts).
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@id([migrationName, tenantId])
  @@index([migrationName, status])
}

model SystemMigrationEnrollment {
  organizationId   String
  // The stable name of one registered migration (e.g.
  // "authz-team-user-backfill"). A plain string column validated in code
  // against the registered migrations, like the status column above - each
  // migration is enrolled separately, so the rollout paces per
  // (organization, migration).
  migrationName    String
  enrolledByUserId String
  createdAt        DateTime @default(now())

  @@id([organizationId, migrationName])
  @@index([migrationName])
}
