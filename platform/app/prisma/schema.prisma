  ACCELERATE_ANNUAL
}

enum PricingModel {
  TIERED
  SEAT_EVENT
}

/// Organization signup intent (ADR-038): which product the org came for.
enum OrganizationIntent {
  AGENT_GOVERNANCE
  LLM_OPS
}

enum SubscriptionStatus {
