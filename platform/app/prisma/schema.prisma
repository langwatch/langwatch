model TriggerSent {
  id              String       @id @default(nanoid())
  triggerId       String
  traceId         String? // Set for trace-based triggers, null for custom graph alerts
  customGraphId   String? // Set for custom graph alerts, null for trace-based triggers
  customGraph     CustomGraph? @relation(fields: [customGraphId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id])
  trigger         Trigger      @relation(fields: [triggerId], references: [id])
  resolvedAt      DateTime? // For custom graph alerts: null = still firing, set = resolved
  // Identity of the open incident this row represents, set while firing and
  // cleared (NULL) on resolve. A single-column unique on it means at most one
  // OPEN incident can exist per identity — Postgres treats NULLs as distinct,
  // so any number of resolved rows coexist. This is the atomic claim for a
  // graph alert: `@@unique([triggerId, traceId])` can't guard it because
  // `traceId` is NULL for graph alerts, so without this two evaluators could
  // both open an incident and both dispatch.
  openIncidentKey String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  @@unique([triggerId, traceId])
  @@index([triggerId])
  @@index([projectId])
  @@index([customGraphId])
  @@index([resolvedAt])
}

// ADR-031: recipient unsubscribe / suppression list for trigger emails. A row
// suppresses delivery of trigger email to `email` within `projectId`. A null
// `triggerId` suppresses every trigger in the project; a set `triggerId`
// suppresses only that one. `reason` leaves room for future "bounce" rows.
model EmailSuppression {
  id        String   @id @default(nanoid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  email     String
  triggerId String? // null = suppressed for every trigger in the project
  reason    String   @default("unsubscribe")
  createdAt DateTime @default(now())

  // Prisma cannot express partial indexes. The migration replaces this with two
  // partial unique indexes (triggerId IS NULL / IS NOT NULL) so that project-wide
  // suppression rows (null triggerId) are deduped despite Postgres treating NULLs
  // as distinct. Keep this @@unique for per-trigger uniqueness intent.
  @@unique([projectId, email, triggerId])
  @@index([projectId])
}

