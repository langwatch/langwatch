// AuditLog is the unified governance ledger. Both gateway-driven mutations
// (VK/budget/provider-binding/cache-rule via the 4 gateway services) and
// platform-driven actions (tRPC mutations via auditLogMutations middleware)
// write here. There is no separate GatewayAuditLog table - see migration
// 20260425000000_consolidate_gateway_audit_into_audit_log.
//
// Two write shapes coexist on the same table:
//   * Platform shape  - `args` + `metadata` + `error` carry the call-site
//     context. `targetKind`, `targetId`, `before`, `after` stay null.
//   * Gateway shape   - `targetKind`, `targetId`, `before`, `after` carry
//     resource identity + diff. `args` / `metadata` / `error` stay null.
// The /settings/audit-log page renders both via a `source` field computed
// from the presence of `targetKind` (gateway = purple badge, platform = grey).
model AuditLog {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  userId         String?
  projectId      String?
  organizationId String?
  action         String
  args           Json?
  error          String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?

  // Gateway-shape governance fields (see model docstring above).
  targetKind String?
  targetId   String?
  before     Json?
  after      Json?

  @@index([createdAt])
  @@index([userId])
  @@index([projectId])
  @@index([action])
  @@index([ipAddress])
  @@index([organizationId, createdAt])
  @@index([targetKind, targetId])
}

enum PromptScope {
  ORGANIZATION
  PROJECT
}

model LlmPromptConfig {
  id             String      @id @default(nanoid())
  handle         String? // Globally unique identifier in format team/sample-prompt
  name           String
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @default(now()) @updatedAt
  deletedAt      DateTime?
  organizationId String
  scope          PromptScope @default(PROJECT)

  // Copy tracking
  copiedFromPromptId String?
  copiedFrom         LlmPromptConfig?  @relation("PromptCopies", fields: [copiedFromPromptId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  copiedPrompts      LlmPromptConfig[] @relation("PromptCopies")

  // Relation to all versions - latest is determined by query
  versions LlmPromptConfigVersion[] @relation("Versions")

  // Relation to labels (e.g., "production", "staging")
  versionTags PromptTagAssignment[] @relation("VersionTags")

  @@unique([handle], map: "LlmPromptConfig_handle_key")
  @@index([projectId])
  // Listing queries filter on (organizationId, scope) together. On a plain
  // organizationId index one large organization matches almost every row and
  // the planner falls back to scanning the table; scope in the index keeps
  // the lookup selective. The composite also serves organizationId-only
  // filters as its prefix, so a separate single-column index is not needed.
  @@index([organizationId, scope])
  @@index([copiedFromPromptId])
}

model LlmPromptConfigVersion {
  id            String          @id @default(nanoid())
  version       Int // The version number of the config
  commitMessage String? // Optional: Describe changes in this version
  authorId      String? // Optional: User who created this version
  author        User?           @relation(fields: [authorId], references: [id])
  configId      String // Foreign key to the parent LlmPromptConfig
  config        LlmPromptConfig @relation("Versions", fields: [configId], references: [id], onDelete: Cascade) // Cascade delete versions if parent is deleted

  // Version specific data
  configData    Json   @map("config") // The actual config JSON for this version
  schemaVersion String // Schema version for this specific configData

  runtimeParameters Json @default("{}")

  createdAt DateTime @default(now()) // Used to determine the latest version

  // Required for multi-tenancy
  projectId String

  // Tags pointing to this version
  versionTags PromptTagAssignment[]

  @@unique([configId, version]) // Each version number must be unique per config
  @@index([configId])
  @@index([authorId])
  @@index([createdAt]) // Index important for finding the latest efficiently
}

model PromptTagAssignment {
