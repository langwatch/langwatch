  PROJECT
}

// A custom model-cost override. Single-scope-per-row (ADR-021): the row
// applies at exactly one scope, identified inline by (scopeType, scopeId),
// and is anchored to one owning organization. Resolution cascades
// PROJECT -> TEAM -> ORGANIZATION -> the static llmModels.json default, so
// an org admin can set a cost once and have it apply to every project that
