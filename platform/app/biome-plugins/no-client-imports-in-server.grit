language js

// Backend code must not value-import browser-only packages or the client
// source trees.
//
// The leak this exists for was one hop and invisible in review:
// `routes/evaluations-legacy.ts` imported a single display-name constant from a
// React component, and that one import pulled Chakra UI, Ark UI, Emotion,
// react-dom and react-router — ~1,320 modules, 212MB RSS — into the API, worker
// and ingestion processes alike.
//
// This plugin is the author-time half of the guard. It runs in the editor and
// in `pnpm lint`, so the import is refused as it is typed. Its companion is
// `src/server/__tests__/frontend-boundary.unit.test.ts`, which walks the real
// import graph.
//
// THE TWO ARE NOT REDUNDANT, and the split is the whole point:
//
//  - the plugin sees ONE FILE AT A TIME. It catches the direct hop the moment
//    it is written, and it is the only one of the two that can say so in the
//    editor. It cannot see past the specifier it is looking at;
//  - the test is TRANSITIVE. A server file importing a framework-free helper
//    that later grows a Chakra import is invisible here and caught there. That
//    is the exact shape of the original leak, so the test is the authority on
//    what may ship and the plugin is the nudge.
//
// Widen one and check whether the other needs it too. The banned specifiers
// below and the test's BROWSER_ONLY list are the same list written twice; they
// are kept in sync by `__tests__/clientBoundaryLintParity.unit.test.ts`, which
// fails when they drift.
//
// See CLAUDE.md ("Importing a component into server code…") and
// specs/setup/memory-footprint.feature.

// Which files are backend. Deliberately the same set as BACKEND_TREES and
// BACKEND_ENTRYPOINTS in frontend-boundary.unit.test.ts, so the two guards
// disagree about violations and never about scope.
//
// `ee/` is NOT a backend root, and the tempting reading that it is cost a
// revision here: the tree is licensed, not architecturally separate, and it is
// mixed. `ee/scim` and `ee/billing` are services, but `ee/governance/dashboard`
// and `ee/admin/backoffice` are React pages that import Chakra perfectly
// legitimately — 54 of them, which is what scoping `ee/` wholesale flagged.
// Its server half is still covered, transitively, by the companion test: it is
// reachable from `src/server`, so the walk enters it and keeps going.
//
// Anchored on a leading separator so a directory merely ENDING in `...server`
// cannot opt a whole tree into this by accident.
pattern in_backend_code() {
	r"[\s\S]*/src/(?:server/|mcp/|tasks/|app/api/|pages/api/|server\.mts|start\.ts|workers\.ts)[\s\S]*"
}

// Test files are exempt, matching `isSource` in the companion test, which skips
// `*.test.*`, `*.spec.*`, `__tests__/` and `__mocks__/`.
//
// The rule protects the RESIDENT MEMORY of running backend processes. A test
// file is never in one. A server integration test that reaches for a client
// helper to build a fixture is loading that helper into vitest, where React is
// already present and costs nothing.
pattern is_test_file() {
	r"[\s\S]*(?:/__tests__/|/__mocks__/|\.test\.|\.spec\.)[\s\S]*"
}

// Server-rendered email templates are React by design — react-email renders
// them to HTML at send time — so React is legitimate there and nowhere else.
// The same exemption the transitive test grants via ALLOWED_PREFIXES.
pattern is_mail_template() {
	r"[\s\S]*/src/server/mailer/[\s\S]*"
}

// Packages that only make sense in a browser.
//
// BOTH QUOTES ARE PART OF THE MATCH, and that is load-bearing rather than
// tidy: an unanchored `react` also matches `reactflow` (the optimization-studio
// canvas) and `@react-email/components` (which the mail templates above import
// legitimately). Anchoring on the closing quote — with an optional subpath —
// bans `react` and `react/jsx-runtime` while leaving both of those alone.
//
// The @opentelemetry entries are deliberately narrow. Most of that scope is
// isomorphic and the server legitimately depends on it (api, core, resources,
// sdk-trace-base, semantic-conventions, the OTLP exporters); only these three
// are browser-bound. Banning the scope wholesale would make the rule unusable.
pattern browser_only_package() {
	r"[\"'](?:react|react-dom|react-router|react-feather|lucide-react|framer-motion|@chakra-ui/[^\"']+|@ark-ui/[^\"']+|@emotion/[^\"']+|@zag-js/[^\"']+|@opentelemetry/sdk-trace-web|@opentelemetry/instrumentation-document-load|@opentelemetry/instrumentation-fetch)(?:/[^\"']*)?[\"']"
}

// The client source trees, in both the `~/` alias spelling and the relative one.
//
// A `components/` or `hooks/` segment is matched AT ANY DEPTH, not just at the
// root. Anchoring it at the root looked sufficient and missed the real thing:
// `langyTurnRelay.ts` imports `~/features/langy/components/capabilities/…`, and
// `data-prefetcher.ts` imports `~/optimization_studio/components/properties/…`.
// Both are feature-local component trees, and both are exactly what CLAUDE.md
// means by "don't value-import a `**/components/**` file at all".
//
// The trailing slash on `components/` is what keeps `~/utils/componentsHelper`
// out of it — the segment has to be a directory, not a filename starting with
// the word.
//
// `hooks` and `stores` are matched ONLY as TOP-LEVEL trees, never at depth, and
// the asymmetry with `components` is not an oversight — it is measured. Giving
// `hooks/` the same any-depth treatment flagged 11 files, and every one was a
// false positive: `ee/billing/nurturing/hooks/` holds server-side LIFECYCLE
// hooks (`fireSignupNurturingCalls`, `ensureUserSyncedToCio`), which have
// nothing to do with React. "hooks" is an overloaded word and `components` is
// not, so only `components` can be trusted at arbitrary depth.
//
// `stores` additionally drops the relative spelling entirely. `src/stores/` is
// the client's zustand state, but `../stores/` from inside
// `src/server/event-sourcing/` resolves to that pipeline's own event stores —
// 30-odd legitimate imports a relative pattern would read as client code. The
// alias form cannot collide, so `stores` is alias-only.
//
// `(?:\.\./)+hooks/` is safe for the same reason in reverse: with no
// intermediate segment it can only resolve to `src/hooks/`. It is the nested
// spelling (`…/nurturing/hooks/`) that is ambiguous, and it is not matched.
pattern client_source_tree() {
	or {
		r"[\"']~/(?:[^\"']*/)?components/[^\"']*[\"']",
		r"[\"'](?:\.\./)+(?:[^\"']*/)?components/[^\"']*[\"']",
		r"[\"']~/hooks/[^\"']*[\"']",
		r"[\"'](?:\.\./)+hooks/[^\"']*[\"']",
		r"[\"']~/stores/[^\"']*[\"']"
	}
}

pattern banned_client_source() {
	or {
		browser_only_package(),
		client_source_tree()
	}
}

pattern report_import($node) {
	$node where {
		register_diagnostic(span=$node, message="Backend code must not value-import browser-only packages or the client trees (components/, hooks/, stores/). One such import pulled ~1,320 modules and 212MB RSS into every backend process. `import type` is fine — types are erased — so if you only need the shape, write `import type`. If you need the value, move it into a framework-free module both sides can import. See CLAUDE.md and src/server/__tests__/frontend-boundary.unit.test.ts.", severity="error")
	}
}

// A guard shared by every arm below. Kept in one place because the arms differ
// only in the SHAPE of statement they match, never in who they apply to, and
// eight copies drifting apart is how a rule quietly stops covering a tree.
pattern in_scope() {
	$file where {
		$file <: in_backend_code(),
		! $file <: is_mail_template(),
		! $file <: is_test_file()
	}
}

// `import type { X } from "…"` is EXEMPT, and that exemption is the only reason
// this rule is adoptable: a type-only import is erased at compile time and
// cannot pull a module at runtime, so a server file may freely name a
// component's types — src/server/filters and src/server/traces already do, and
// flagging them would have made this unshippable.
//
// It is also exactly what Biome's built-in `noRestrictedImports` cannot express.
// That rule matches the specifier and nothing else, so it flags `import type
// { FilterParam } from "~/hooks/useFilterParams"` every bit as loudly as a value
// import — measured on this tree, 3 of its 5 hits were type-only. That is why
// this is a plugin and not four lines of config.
//
// The negation matches the STATEMENT text rather than a clause node, because the
// `type` keyword is not part of the binding `$clause` captures. Rust's regex
// engine has no lookahead, so it cannot be folded into the positive pattern as
// `import\s+(?!type)` and has to stay a separate negation.
//
// WHY THERE ARE EIGHT ARMS RATHER THAN ONE. Biome's GritQL matches code SHAPES,
// and `import $clause from $source` — the obvious single pattern — binds far
// less than it appears to. Measured against a fixture covering every spelling,
// it matches a default and a plain named import and silently misses BOTH
// `import * as React from "react"` and every inline-type spelling
// (`import { type FC, useEffect }`). Each arm below is one shape that pattern
// cannot reach, and each exists because a fixture proved the gap.
//
// KNOWN RESIDUAL GAPS, stated because a rule that hides them is worse than one
// that does not: an inline type specifier surrounded on BOTH sides by others in
// a list of four or more, and `{ type A, type B, c }`, are not matched. Both are
// pathological spellings of an import a developer would more naturally write as
// two statements. The transitive companion test catches what slips past here —
// this list is the nudge, not the authority.
or {
	// Default and plain named imports: the common case.
	`import $clause from $source` as $stmt where {
		$source <: banned_client_source(),
		! $stmt <: r"import\s+type[\s\S]*",
		$filename <: in_scope(),
		$stmt <: report_import($stmt)
	},
	// `import * as React from "react"`. Not reached by `$clause` above, and the
	// most likely spelling to be reached for as a workaround once the common
	// case starts failing the build.
	`import * as $ns from $source` as $stmt where {
		$source <: banned_client_source(),
		$filename <: in_scope(),
		$stmt <: report_import($stmt)
	},
	// `import { type FC, useEffect } from "react"` — inline type first.
	//
	// The `$rest` guard is not decoration. Without it `import { type A, type B }`
	// is flagged, and that statement is entirely erased: every specifier is a
	// type, so it costs nothing at runtime and the diagnostic would be a false
	// positive on the very spelling this rule tells people to write instead.
	`import { type $t, $rest } from $source` as $stmt where {
		$source <: banned_client_source(),
		! $rest <: r"type\s[\s\S]*",
		$filename <: in_scope(),
		$stmt <: report_import($stmt)
	},
	// `import { useMemo, type ReactNode } from "react"` — inline type last.
	`import { $rest, type $t } from $source` as $stmt where {
		$source <: banned_client_source(),
		! $rest <: r"[\s\S]*type\s[\s\S]*",
		$filename <: in_scope(),
		$stmt <: report_import($stmt)
	},
	// `import { useRef, type Ref, useId } from "react"` — inline type in the
	// middle, reachable only by naming the shape on both sides.
	`import { $a, type $t, $b } from $source` as $stmt where {
		$source <: banned_client_source(),
		$filename <: in_scope(),
		$stmt <: report_import($stmt)
	},
	// A side-effect import has no clause at all, so no arm above sees it, and
	// `import "@chakra-ui/react"` costs the same resident memory as a bound one.
	// It can never be a type import, so there is nothing to exempt.
	`import $source` as $stmt where {
		$source <: banned_client_source(),
		$filename <: in_scope(),
		$stmt <: report_import($stmt)
	},
	// `export { CustomGraph } from "~/components/…"` pulls the module exactly as
	// hard as an import while reading as an export — the easiest arm to forget.
	`export { $specs } from $source` as $stmt where {
		$source <: banned_client_source(),
		! $stmt <: r"export\s+type[\s\S]*",
		$filename <: in_scope(),
		$stmt <: report_import($stmt)
	},
	// `export * from "~/components/…"`: a barrel re-export, which pulls the whole
	// module and everything it imports along with it.
	`export * from $source` as $stmt where {
		$source <: banned_client_source(),
		! $stmt <: r"export\s+type[\s\S]*",
		$filename <: in_scope(),
		$stmt <: report_import($stmt)
	}
}
