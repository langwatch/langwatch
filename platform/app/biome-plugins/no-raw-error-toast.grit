language js

// Error toasts must not render an error's own message.
//
// Since #5984 the wire message for a handled error IS its code, so
// `description: error.message` shows the customer `validation_error`; for an
// unhandled error the message can carry internals (Prisma models, SQL,
// hostnames). `showErrorToast` from `~/features/errors` reads the handled
// payload and renders the code-keyed copy instead.
//
// This plugin is the author-time nudge: it runs in the editor and in
// `pnpm lint`, and it matches the common spellings by name. Its companion is
// `src/features/errors/logic/__tests__/noRawErrorToasts.unit.test.ts`, a
// source scanner that tracks renamed catch bindings, hoisted locals and
// enclosing calls.
//
// The two guards OVERLAP; neither subsumes the other. Known divergences:
//
//  - the plugin catches leaks the scanner misses when the copy object is built
//    somewhere other than the toast call's own argument list —
//    `toaster.create(buildToast({ description: error.message }))`. The scanner
//    attributes that slot to `buildToast`, which is not a toast call, so it
//    stays quiet;
//  - the scanner catches leaks the plugin cannot see at all, because a
//    name-matching pattern has no notion of dataflow: a renamed catch binding
//    (`catch (problem)`), a hoisted local (`const message = e.message`), a
//    destructure (`const { message } = error`), or a suffixed name
//    (`apiError.message`);
//  - the plugin flags wherever Biome is pointed; the scanner walks `src/` and
//    `ee/` only;
//  - suppression differs — see `marked_ok` below. The scanner's is per line;
//    the plugin's is per flagged call or element.
//
// Neither is redundant. Widen one and check whether the other needs it too.
//
// See dev/docs/best_practices/error-handling.md and ADR-045.

// `contains` rather than a literal value match: the leak is almost never
// written flat. It hides inside a ternary (`err instanceof Error ? err.message
// : "…"`), behind a cast (`(error as Error).message`), or inside a template
// literal — three shapes an equality match misses and a customer still reads.
pattern error_ish() {
	or {
		`error`,
		`err`,
		`e`,
		`exception`,
		`cause`,
		`(error as $_)`,
		`(err as $_)`,
		`(e as $_)`
	}
}

// Every way we have actually seen an error turned into copy. `String(…)` was
// the only stringifier the first version knew, so `JSON.stringify(err)`,
// `err.toString()` and `String(err.cause)` shipped a raw error to a customer
// while both guards reported a clean tree.
pattern leaks_an_error() {
	or {
		contains bubble `$errish.message` where { $errish <: error_ish() },
		contains bubble `$errish?.message` where { $errish <: error_ish() },
		contains bubble `String($errish)` where { $errish <: error_ish() },
		contains bubble `JSON.stringify($errish)` where { $errish <: error_ish() },
		contains bubble `$errish.toString()` where { $errish <: error_ish() }
	}
}

// The per-line opt-out documented in dev/docs/best_practices/error-handling.md,
// as far as GritQL can see it.
//
// Without this, a line the author correctly marked `// no-raw-error-toast-ok`
// still hard-failed the `Enforce analyzer plugins` CI step with no way out:
// the scanner honoured the marker, the plugin had never heard of it.
//
// A node's text in GritQL runs from its first token to its last, so it carries
// comments written *between* those tokens and nothing outside them. That
// covers the marker where it is actually written — inside the toast call or
// the element — which is why this is applied to the whole flagged construct
// rather than to the offending value. It cannot see a comment trailing the
// statement's closing `)`. For that spelling, or to silence the plugin without
// silencing the scanner, write `// biome-ignore lint: <reason>` on the line
// above; Biome rejects `plugin` and `plugin/<name>` as suppression categories.
//
// Coarser than the scanner's per-line check, deliberately: the plugin is the
// nudge, the scanner is the authority on what may ship.
pattern marked_ok() {
	r"[\s\S]*no-raw-error-toast-ok[\s\S]*"
}

pattern report($node) {
	$node where {
		register_diagnostic(span=$node, message="Don't render an error's raw message in a toast — for a handled error this is the code slug (the customer reads `validation_error`), and for an unhandled one it can leak internals. Use showErrorToast({ error, fallbackTitle }) from ~/features/errors instead. See dev/docs/best_practices/error-handling.md.", severity="error")
	}
}

// `fallbackTitle={error.message}` — the JSX spelling. A pattern anchored on
// `key: value` never sees it, which is how `HandledErrorAlert` came to sit in
// the guard's file prefilter while having no coverage at all.
pattern leaky_copy_attribute() {
	jsx_attribute() as $attr where {
		$attr <: r"(?:title|description|fallbackTitle)=[\s\S]*",
		$attr <: leaks_an_error(),
		$attr <: report($attr)
	}
}

// Elements that put an error in front of a customer.
//
// `Toast.Description` and `Alert.Description` are here because the copy does
// not have to arrive as a prop: Chakra's compositional spelling puts it in the
// children, and `<Alert.Description>{error.message}</Alert.Description>` reads
// the same slug to the same customer that `description: error.message` does.
pattern error_copy_component() {
	r"(?:HandledErrorAlert|ErrorAlert|ErrorCard|(?:Toast|Alert)\.(?:Title|Description))"
}

or {
	// `toaster` re-spreads `createToaster(...)` in `components/ui/toaster.tsx`,
	// so the status shorthands are first-class and already used at six sites.
	// A rule that knows only `.create` is one autocomplete away from bypassed.
	`$call($props)` as $toast where {
		$call <: or {
			`toaster.create`,
			`toaster.error`,
			`toaster.warning`,
			`toaster.info`,
			`toaster.success`,
			`toaster.loading`,
			`toaster.promise`,
			`toaster.update`,
			`showErrorToast`
		},
		! $toast <: marked_ok(),
		$props <: contains bubble `$key: $value` where {
			$key <: or {
				`title`,
				`description`,
				`fallbackTitle`
			},
			$value <: leaks_an_error(),
			$value <: report($value)
		}
	},
	// `FormServerError` renders `errors.root.serverError.message` verbatim, so
	// a hand-written `form.setError(FORM_SERVER_ERROR, { message: … })`
	// bypasses `applyHandledErrorToForm` and puts the slug on screen with
	// nothing in the way.
	`$form.setError($_, $props)` as $setter where {
		! $setter <: marked_ok(),
		$props <: contains bubble `message: $value` where {
			$value <: leaks_an_error(),
			$value <: report($value)
		}
	},
	jsx_self_closing_element(name=$component, attributes=$attrs) as $element where {
		$component <: error_copy_component(),
		! $element <: marked_ok(),
		$attrs <: contains bubble leaky_copy_attribute()
	},
	jsx_opening_element(name=$component, attributes=$attrs) as $element where {
		$component <: error_copy_component(),
		! $element <: marked_ok(),
		$attrs <: contains bubble leaky_copy_attribute()
	},
	// `<Toast.Description>{error.message}</Toast.Description>` — the children,
	// not the attributes. Every pattern above walks past this, which is exactly
	// how the same leak survives a rewrite from the prop spelling to the
	// compositional one.
	jsx_element() as $element where {
		$element <: r"<\s*(?:HandledErrorAlert|ErrorAlert|ErrorCard|(?:Toast|Alert)\.(?:Title|Description))\b[\s\S]*",
		! $element <: marked_ok(),
		$element <: contains bubble jsx_expression() as $child where {
			$child <: leaks_an_error(),
			$child <: report($child)
		}
	}
}
