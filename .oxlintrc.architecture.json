{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    {
      "name": "langwatch",
      "specifier": "./packages/architecture-lint/oxlint-plugin.mjs"
    }
  ],
  "rules": {
    "langwatch/api-context-services": "error",
    "langwatch/environment-boundaries": "error",
    "langwatch/package-boundaries": "error",
    "langwatch/feature-module-classes": "error",
    "langwatch/service-classes": "error",
    "langwatch/service-dependencies": "error"
  }
}
