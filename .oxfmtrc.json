{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",

  "sortImports": true,
  "sortPackageJson": true,

  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/generated/**",
    "modules/analytics/contract/src/visualization/vega-lite-schema-validator.generated.js",
    "modules/analytics/contract/src/visualization/vega-lite-schema-validator.generated.d.ts",
    "**/*.generated.*",
    "modules/langy/process/src/rules/setup-skill-bodies.rules.ts",
    "packages/prisma-client/src/table-catalogue.ts",
    "**/CHANGELOG.md",
    "docs/api-reference/openapiLangWatch.json",
    "specs/api-reference/openapi-document.json",
    "skills/_compiled/**",
    "services/langyagent/internal/assets/skills/**",
    "plugins/langwatch/scripts/session-context.mjs",
    "plugins/langwatch/scripts/session-guidance.mjs",
    "specs/webhooks/signature-vectors.json",
    "**/*.min.*",
    "**/testdata/**",
    "**/fixtures/**",
    "**/__fixtures__/**",
    "charts/**/templates/**",
    "docs/docs.json",
    "**/*.mdx",
    "services/langyagent/internal/assets/AGENTS.md",
    "dev/docs/lint-rules.md",
    "dev/docs/plans/claudemd-lint-extraction.md",
    "dev/docs/adr/151-nx-tags.md",
    "specs/langy/langy-keys-plan.md",
    "specs/langy/langy-pr4-plan.md",
    "**/vendor/**",
    "tools/apidiff/scenarios/**",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "package-lock.json",
    "yarn.lock"
  ]
}
