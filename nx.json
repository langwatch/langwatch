{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "origin/main",
  "namedInputs": {
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.shared.json",
      "{workspaceRoot}/pnpm-workspace.yaml"
    ],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.test.tsx",
      "!{projectRoot}/**/*.test.mts",
      "!{projectRoot}/vitest.config.*",
      "!{projectRoot}/vitest.integration.config.*"
    ],
    "lintGlobals": [
      "sharedGlobals",
      "{workspaceRoot}/.oxlintrc.jsonc",
      "{workspaceRoot}/packages/oxlint-rules/**/*",
      "{workspaceRoot}/packages/architecture-enforcer/oxlint*",
      "{workspaceRoot}/modules/catalogue.json",
      "{workspaceRoot}/modules/*/*/package.json",
      "{workspaceRoot}/enterprise/modules/*/*/package.json",
      "{workspaceRoot}/docs/api-reference/openapiLangWatch.json"
    ],
    "jsBuild": [
      {
        "runtime": "node --version"
      },
      "npmDeps"
    ],
    "go": [
      "{workspaceRoot}/**/*.go",
      "{workspaceRoot}/**/go.mod",
      "{workspaceRoot}/**/go.sum",
      "{workspaceRoot}/go.work",
      "{workspaceRoot}/go.work.sum",
      "{workspaceRoot}/cmd/**/*",
      "{workspaceRoot}/pkg/**/*",
      "{workspaceRoot}/services/**/*",
      "{workspaceRoot}/tools/**/*",
      "{workspaceRoot}/infra/clickhouse-serverless/**/*",
      "{workspaceRoot}/sdks/go/**/*",
      {
        "runtime": "go version"
      },
      {
        "env": "GOFLAGS"
      },
      {
        "env": "GOOS"
      },
      {
        "env": "GOARCH"
      },
      {
        "env": "CGO_ENABLED"
      },
      {
        "env": "GOEXPERIMENT"
      },
      {
        "externalDependencies": []
      }
    ],
    "npmDeps": [
      {
        "externalDependencies": []
      }
    ]
  },
  "plugins": [
    "./dev/nx/lint-plugin.mjs",
    "./dev/nx/go-plugin.mjs",
    "./dev/nx/npm-deps-plugin.mjs",
    "./dev/nx/helm-plugin.mjs",
    "./dev/nx/workspace-plugin.mjs"
  ],
  "targetDefaults": {
    "typecheck": [
      {
        "cache": true,
        "inputs": [
          "default",
          "^production",
          "npmDeps",
          {
            "externalDependencies": ["typescript"]
          }
        ],
        "outputs": [
          "{projectRoot}/dist/**/*.d.ts",
          "{projectRoot}/dist/**/*.d.ts.map",
          "{projectRoot}/dist/**/*.tsbuildinfo",
          "{projectRoot}/dist/**/*.json"
        ]
      },
      {
        "filter": {
          "projects": [
            "@langwatch/ui",
            "@langwatch/server",
            "@langwatch/scenario-child",
            "@langwatch/langyworker"
          ]
        },
        "outputs": [
          "{projectRoot}/dist/tsconfig.typecheck.tsbuildinfo",
          "{projectRoot}/dist/tsconfig.test.tsbuildinfo"
        ]
      },
      {
        "filter": {
          "projects": ["@langwatch/mail"]
        },
        "outputs": [
          "{projectRoot}/dist/typecheck",
          "{projectRoot}/dist/tsconfig.typecheck.tsbuildinfo",
          "{projectRoot}/dist/tsconfig.preview.tsbuildinfo"
        ]
      },
      {
        "filter": {
          "projects": ["langwatch"]
        },
        "outputs": [
          "{projectRoot}/dist/src",
          "{projectRoot}/dist/__tests__",
          "{projectRoot}/dist/*.config.*",
          "{projectRoot}/dist/test-setup.*",
          "{projectRoot}/dist/package.json",
          "{projectRoot}/dist/tsconfig.typecheck.tsbuildinfo"
        ]
      }
    ],
    "build": [
      {
        "cache": true,
        "dependsOn": ["^build"],
        "inputs": ["production", "^production", "jsBuild"],
        "outputs": [
          "{projectRoot}/dist",
          "!{projectRoot}/dist/typecheck",
          "!{projectRoot}/dist/tsconfig.{typecheck,test,preview}.tsbuildinfo"
        ]
      },
      {
        "filter": {
          "projects": ["langwatch"]
        },
        "cache": true,
        "dependsOn": ["^build"],
        "inputs": [
          "production",
          "!{projectRoot}/src/internal/generated/**/*",
          "^production",
          "{workspaceRoot}/feature-map.json",
          "{workspaceRoot}/skills/**/*",
          "{workspaceRoot}/specs/api-reference/openapi-document.json",
          "{workspaceRoot}/services/langevals/ts-integration/evaluators.generated.ts",
          "{workspaceRoot}/modules/evaluator/contract/src/evaluators.native.ts",
          "{workspaceRoot}/modules/model-provider/contract/src/catalog/model-catalog.json",
          "{workspaceRoot}/modules/scenario/contract/src/evaluator-attachments.ts",
          "{workspaceRoot}/modules/scenario/contract/src/suite-fields.ts",
          "{workspaceRoot}/modules/trace/contract/src/trace-format.schemas.ts",
          "{workspaceRoot}/packages/redaction/src/**/*",
          "jsBuild"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "!{projectRoot}/dist/src",
          "!{projectRoot}/dist/__tests__",
          "!{projectRoot}/dist/*.config.*",
          "!{projectRoot}/dist/test-setup.*",
          "!{projectRoot}/dist/package.json",
          "!{projectRoot}/dist/tsconfig.typecheck.tsbuildinfo",
          "{projectRoot}/src/internal/generated"
        ]
      },
      {
        "filter": {
          "projects": ["@langwatch/ksuid"]
        },
        "outputs": [
          "{projectRoot}/dist",
          "!{projectRoot}/dist/**/*.d.ts.map",
          "!{projectRoot}/dist/*.tsbuildinfo"
        ]
      },
      {
        "filter": {
          "projects": ["@langwatch/scenario-child"]
        },
        "cache": true,
        "dependsOn": ["^build"],
        "inputs": [
          "production",
          "^production",
          "jsBuild",
          {
            "env": "EMIT_META"
          }
        ],
        "outputs": [
          "{projectRoot}/dist",
          "!{projectRoot}/dist/typecheck",
          "!{projectRoot}/dist/tsconfig.{typecheck,test,preview}.tsbuildinfo"
        ]
      },
      {
        "filter": {
          "projects": ["@langwatch/haven-web"]
        },
        "cache": true,
        "dependsOn": ["^build"],
        "inputs": ["production", "^production", "jsBuild"],
        "outputs": ["{workspaceRoot}/tools/thuishaven/adapters/dashboard/web/dist"]
      },
      {
        "filter": {
          "projects": ["@langwatch/idpsim-web"]
        },
        "cache": true,
        "dependsOn": ["^build"],
        "inputs": ["production", "^production", "jsBuild"],
        "outputs": ["{workspaceRoot}/services/idpsim/web/dist"]
      },
      {
        "filter": {
          "projects": ["@langwatch/mailsim-web"]
        },
        "cache": true,
        "dependsOn": ["^build"],
        "inputs": ["production", "^production", "jsBuild"],
        "outputs": ["{workspaceRoot}/services/mailsim/web/dist"]
      },
      {
        "filter": {
          "plugin": "./dev/nx/go-plugin.mjs"
        },
        "cache": true,
        "dependsOn": ["^build"],
        "inputs": [
          "go",
          "!{workspaceRoot}/**/*_test.go",
          {
            "dependentTasksOutputFiles": "**/*"
          }
        ],
        "outputs": ["{workspaceRoot}/.bin/{projectName}/{projectName}"]
      }
    ],
    "prisma:generate": {
      "cache": true,
      "inputs": [
        "{projectRoot}/prisma/schema.prisma",
        "{projectRoot}/prisma.config.ts",
        "{projectRoot}/scripts/generate-table-catalogue.mjs",
        "{projectRoot}/package.json",
        "sharedGlobals",
        "npmDeps"
      ],
      "outputs": ["{projectRoot}/src/generated", "{projectRoot}/src/table-catalogue.ts"]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "npmDeps",
        {
          "externalDependencies": ["vitest"]
        }
      ],
      "outputs": []
    },
    "test:unit": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "npmDeps",
        {
          "externalDependencies": ["vitest"]
        }
      ],
      "outputs": []
    },
    "lint": [
      {
        "cache": true,
        "inputs": [
          "default",
          "^production",
          "lintGlobals",
          {
            "externalDependencies": ["oxlint"]
          },
          "npmDeps"
        ],
        "outputs": []
      },
      {
        "filter": {
          "projects": ["@langwatch/architecture-enforcer"]
        },
        "cache": false
      }
    ],
    "lint:types": {
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "lintGlobals",
        "npmDeps",
        {
          "externalDependencies": ["oxlint", "oxlint-tsgolint"]
        }
      ],
      "outputs": []
    },
    "lint:go": {
      "cache": true,
      "inputs": ["go", "{workspaceRoot}/.golangci.yml", "{workspaceRoot}/Makefile"],
      "outputs": []
    },
    "test:go": {
      "cache": false
    },
    "generate:langy-skills": {
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/**/*",
        "{workspaceRoot}/infra/docker/Dockerfile.langyagent",
        "{workspaceRoot}/skills/_lib/frontmatter.ts",
        "{workspaceRoot}/skills/_compiled/native/**/*",
        {
          "runtime": "node --version"
        },
        "npmDeps"
      ],
      "outputs": ["{projectRoot}/src/model/shared/langy/langySkills.generated.json"]
    },
    "generate:feature-map": {
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/**/*",
        "{workspaceRoot}/feature-map.json",
        {
          "runtime": "node --version"
        }
      ],
      "outputs": ["{projectRoot}/src/model/shared/langy/feature-map.generated.json"]
    },
    "generate:setup-skill-bodies": {
      "cache": true,
      "inputs": [
        "{projectRoot}/scripts/**/*",
        "{workspaceRoot}/skills/_compiled/native/**/*",
        "^production",
        {
          "runtime": "node --version"
        },
        "npmDeps"
      ],
      "outputs": ["{projectRoot}/src/rules/setup-skill-bodies.rules.ts"]
    },
    "generate:evaluators": {
      "cache": true,
      "inputs": [
        "{workspaceRoot}/services/langevals/ts-integration/evaluators.generated.ts",
        "{projectRoot}/package.json"
      ],
      "outputs": ["{projectRoot}/src/evaluators.generated.ts"]
    },
    "generate": {
      "cache": true,
      "inputs": [
        "{projectRoot}/copy-types.sh",
        "{projectRoot}/scripts/**/*",
        "{projectRoot}/package.json",
        "{workspaceRoot}/feature-map.json",
        "{workspaceRoot}/skills/**/*",
        "{workspaceRoot}/specs/api-reference/openapi-document.json",
        "{workspaceRoot}/services/langevals/ts-integration/evaluators.generated.ts",
        "{workspaceRoot}/modules/evaluator/contract/src/evaluators.native.ts",
        "{workspaceRoot}/modules/model-provider/contract/src/catalog/model-catalog.json",
        "{workspaceRoot}/modules/scenario/contract/src/evaluator-attachments.ts",
        "{workspaceRoot}/modules/scenario/contract/src/suite-fields.ts",
        "{workspaceRoot}/modules/trace/contract/src/trace-format.schemas.ts",
        "{workspaceRoot}/packages/redaction/src/**/*",
        {
          "runtime": "node --version"
        },
        "npmDeps"
      ],
      "outputs": ["{projectRoot}/src/internal/generated"]
    },
    "herrgen": {
      "cache": true,
      "inputs": [
        "go",
        "{workspaceRoot}/packages/error-presentation/src/**/*",
        "{workspaceRoot}/packages/handled-error/src/**/*"
      ],
      "outputs": ["{workspaceRoot}/packages/error-presentation/src/codes.generated.ts"]
    }
  },
  "parallel": 4,
  "maxCacheSize": "10GB",
  "analytics": false,
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": false,
      "projectsAffectedByDependencyUpdates": "auto"
    }
  }
}
