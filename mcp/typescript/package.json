{
  "name": "@langwatch/mcp-server",
  "version": "2.0.0",
  "description": "An MCP server for Langwatch.",
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/langwatch/langwatch.git",
    "directory": "mcp-server"
  },
  "bin": {
    "langwatch-mcp-server": "./dist/index.js"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./create-mcp-server": {
      "types": "./src/create-mcp-server.d.ts",
      "import": "./dist/create-mcp-server.js",
      "require": "./dist/create-mcp-server.js",
      "default": "./dist/create-mcp-server.js"
    },
    "./config": {
      "types": "./src/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.js",
      "default": "./dist/config.js"
    }
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsup && node build.js",
    "prepublish": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "catalog:",
    "@anthropic-ai/claude-code": "2.1.228",
    "@eslint/js": "^10.0.1",
    "@langwatch/egress": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/redaction": "workspace:*",
    "@langwatch/scenario": "^0.4.6",
    "@opentelemetry/context-async-hooks": "^2.1.0",
    "@opentelemetry/sdk-node": "catalog:",
    "@types/debug": "catalog:",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/yargs": "^17.0.33",
    "ai": "catalog:",
    "chalk": "catalog:",
    "dotenv": "catalog:",
    "esbuild": "catalog:",
    "eslint": "^10.2.1",
    "express": "^5.2.1",
    "node-pty": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:sdk-toolchain",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "yargs": "^18.0.0",
    "zod-validation-error": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
