{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "tsBuildInfoFile": "dist/tsconfig.test.tsbuildinfo",
    "composite": false
  },
  // The suite, plus the sources it exercises. `vitest` resolves from the
  // package's own devDependency, so the test types are checked here and
  // nowhere else.
  "include": [
    "src/**/__tests__/**/*.ts",
    "src/**/__mocks__/**/*.ts",
    "src/**/tests/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.test.*.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.*.ts",
    "src/**/*.stories.ts",
    "src/**/*.stories.*.ts",
    "src/**/*.bench.ts",
    "src/**/*.bench.*.ts",
    "src/**/__bench__/**/*.ts",
    "src/__tests__/**/*.ts"
  ],

  "references": [
    {
      "path": "./tsconfig.build.json"
    }
  ]
}
