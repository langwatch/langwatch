{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "lib": ["es2022"],
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    // Consumers import the TypeScript sources directly (see the package's
    // `exports`), so this project only ever type-checks - nothing is built.
    "noEmit": true,
    "verbatimModuleSyntax": true,

    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts"],
  // Tests are checked by tsconfig.test.json, which adds the vitest globals
  // this project does not need. Any `__tests__` directory, at any depth: a
  // test colocated with the module it covers is still a test.
  "exclude": ["src/**/__tests__/**"],
  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "../../../packages/actor/tsconfig.build.json"
    },
    {
      "path": "../../authz/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/eventing/tsconfig.build.json"
    },
    {
      "path": "../../../packages/handled-error/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/observability/tsconfig.build.json"
    },
    {
      "path": "../../ops/server/tsconfig.build.json"
    },
    {
      "path": "../../../packages/prisma-client/tsconfig.build.json"
    },
    {
      "path": "../../../packages/system-migrations/tsconfig.build.json"
    },
    {
      "path": "../../../packages/time/tsconfig.build.json"
    },
    {
      "path": "../../../packages/test-harness/tsconfig.build.json"
    }
  ]
}
