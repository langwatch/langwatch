{
  "name": "@langwatch/identity-process",
  "version": "0.1.0",
  "private": true,
  "description": "The server-side runtime of the identity platform (ADR-101, ADR-115, ADR-116, ADR-117): IdentityGuardsService, IdentityService, the verification ceremony, the backfill pass, the better-auth ceremonies, and the folded-in event-sourcing layer - the envelope, the command handlers, the folds, the two process managers and the four pipeline definitions the worker registers, behind postgres.*.adapter seams.",
  "license": "MIT",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./adapters/better-auth-identity-birth": {
      "types": "./dist/services/better-auth-identity-birth.service.d.ts",
      "default": "./src/services/better-auth-identity-birth.service.ts"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    },
    "./composition/sso-connection-backoffice": {
      "types": "./dist/repositories/prisma/prisma.sso-connection-backoffice.repository.d.ts",
      "default": "./src/repositories/prisma/prisma.sso-connection-backoffice.repository.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/actor": "workspace:*",
    "@langwatch/audit-log-contract": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/identity-contract": "workspace:*",
    "@langwatch/kernel": "workspace:*",
    "@langwatch/ksuid": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/process-stores": "workspace:*",
    "@langwatch/system-migrations": "workspace:*",
    "@langwatch/time": "workspace:*",
    "nanoid": "^6.0.0",
    "prom-client": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/api-fixture": "workspace:*",
    "@langwatch/test-harness": "workspace:*",
    "@langwatch/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "better-auth": "^1.7.1"
  }
}
