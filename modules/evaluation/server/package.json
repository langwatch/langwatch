{
  "name": "@langwatch/evaluation-server",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical server-side Evaluation feature.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./workflow-evaluation": {
      "types": "./dist/adapters/workflow-evaluation.adapter.d.ts",
      "default": "./src/adapters/workflow-evaluation.adapter.ts"
    },
    "./composition/evaluation-cost": {
      "types": "./dist/repositories/prisma/prisma.evaluation-cost.repository.d.ts",
      "default": "./src/repositories/prisma/prisma.evaluation-cost.repository.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@clickhouse/client": "catalog:",
    "@langwatch/analytics-contract": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/automation-contract": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/dataset-contract": "workspace:*",
    "@langwatch/evaluation-contract": "workspace:*",
    "@langwatch/evaluator-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/experiment-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/ksuid": "catalog:",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/monitor-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/runtime-composition": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@langwatch/workflow-contract": "workspace:*",
    "@trpc/server": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "nanoid": "catalog:",
    "safe-regex2": "catalog:",
    "slugify": "catalog:",
    "zod": "catalog:",
    "zod-to-json-schema": "^3.25.2",
    "zod-validation-error": "catalog:"
  },
  "devDependencies": {
    "@langwatch/test-harness": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
