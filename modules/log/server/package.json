{
  "name": "@langwatch/log-server",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical Log service and private persistence adapters.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project modules/log/server/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.0",
    "@langwatch/data-privacy-contract": "workspace:*",
