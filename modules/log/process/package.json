{
  "name": "@langwatch/log-process",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical Log service and private persistence adapters.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "GOMAXPROCS=2 GOMEMLIMIT=2GiB tsc -b",
    "test": "vitest run --fsModuleCache --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@clickhouse/client": "catalog:",
    "@langwatch/api": "workspace:*",
    "@langwatch/clickhouse-client": "workspace:*",
    "@langwatch/data-privacy-contract": "workspace:*",
    "@langwatch/data-retention-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/log-contract": "workspace:*",
    "@langwatch/module": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/otlp": "workspace:*",
    "@langwatch/plans": "workspace:*",
    "@langwatch/process": "workspace:*",
    "@langwatch/span-normalisation": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/otlp-transformer": "catalog:",
    "hono": "catalog:",
    "langwatch": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/clickhouse-migrations": "workspace:*",
    "@langwatch/process-stores": "workspace:*",
    "@langwatch/test-harness": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
