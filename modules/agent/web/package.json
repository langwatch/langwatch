{
  "name": "@langwatch/agent-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe Agents UI and client contracts.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./agent-editors": {
      "langwatch-declaration-source": "./src/agent-editors.ts",
      "types": "./dist/agent-editors.d.ts",
      "default": "./src/agent-editors.ts"
    },
    "./agent-management": {
      "langwatch-declaration-source": "./src/agent-management.ts",
      "types": "./dist/agent-management.d.ts",
      "default": "./src/agent-management.ts"
    },
    "./connected-agents": {
      "langwatch-declaration-source": "./src/connected-agents.ts",
      "types": "./dist/connected-agents.d.ts",
      "default": "./src/connected-agents.ts"
    },
    "./agent-http-editor": {
      "langwatch-declaration-source": "./src/agent-http-editor.ts",
      "types": "./dist/agent-http-editor.d.ts",
      "default": "./src/agent-http-editor.ts"
    },
    "./agent-client": {
      "langwatch-declaration-source": "./src/agent-client.ts",
      "types": "./dist/agent-client.d.ts",
      "default": "./src/agent-client.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/agent-contract": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/scenario-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/ui-host": "workspace:*",
    "lucide-react": "^1.22.0",
    "react-hook-form": "^7.80.0"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
