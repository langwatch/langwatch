{
  "name": "@langwatch/agent-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Portable Agents domain values, schemas, commands, queries, and capabilities.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./code-config": {
