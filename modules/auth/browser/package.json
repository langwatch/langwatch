{
  "name": "@langwatch/auth-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe front-door screens: sign in, sign up, password recovery, email verification, the invitation landing and the sign-in error page.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./src/session.ts"
    },
    "./declaration": {
      "langwatch-declaration-source": "./src/auth.web.ts",
      "types": "./dist/auth.web.d.ts",
      "default": "./src/auth.web.ts"
    },
    "./auth": {
      "langwatch-declaration-source": "./src/auth.ts",
      "types": "./dist/auth.d.ts",
      "default": "./src/auth.ts"
    },
    "./session-capability": {
      "types": "./dist/behavior/ui-session.d.ts",
      "default": "./src/behavior/ui-session.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@langwatch/api": "workspace:*",
    "@langwatch/auth-contract": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/browser-host": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/identity-contract": "workspace:*",
    "@langwatch/organization-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/ui-kernel": "workspace:*",
    "@paper-design/shaders-react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "better-auth": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react-feather": "catalog:",
    "react-hook-form": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@langwatch/error-presentation": "workspace:*",
    "@langwatch/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
