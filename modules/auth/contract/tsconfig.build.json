{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["**/__tests__/**", "**/__mocks__/**", "**/tests/**", "**/*.test.*", "**/*.spec.*"],
  "references": [
    {
      "path": "../../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../../../packages/config/tsconfig.build.json"
    },
    {
      "path": "../../identity/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/runtime-composition/tsconfig.build.json"
    }
  ]
}
