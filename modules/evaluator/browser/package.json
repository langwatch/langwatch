{
  "name": "@langwatch/evaluator-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe reusable Evaluator UI and presentation helpers.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./declaration": {
      "langwatch-declaration-source": "./src/evaluator.web.ts",
      "types": "./dist/evaluator.web.d.ts",
      "default": "./src/evaluator.web.ts"
    },
    "./dynamic-zod-form": {
      "langwatch-declaration-source": "./src/dynamic-zod-form.ts",
      "types": "./dist/dynamic-zod-form.d.ts",
      "default": "./src/dynamic-zod-form.ts"
    },
    "./evaluator-editor-content": {
      "langwatch-declaration-source": "./src/evaluator-editor-content.ts",
      "types": "./dist/evaluator-editor-content.d.ts",
      "default": "./src/evaluator-editor-content.ts"
    },
    "./surfaces/evaluator-editor-shared": {
      "langwatch-declaration-source": "./src/ui/sections/evaluators/evaluator-editor-shared.tsx",
      "types": "./dist/ui/sections/evaluators/evaluator-editor-shared.d.ts",
      "default": "./src/ui/sections/evaluators/evaluator-editor-shared.tsx"
    },
    "./available-evaluators": {
      "langwatch-declaration-source": "./src/available-evaluators.ts",
      "types": "./dist/available-evaluators.d.ts",
      "default": "./src/available-evaluators.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
