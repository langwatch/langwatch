{
  "extends": ["./tsconfig.json", "../../../tsconfig.emit.json"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@langwatch/workflow-process": ["./src/index.ts"]
    }
  },
  "files": ["./src/index.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/upgrade/tsconfig.build.json"
    },
    {
      "path": "../../../packages/time/tsconfig.build.json"
    },
    {
      "path": "../../../packages/secrets/tsconfig.build.json"
    },
    {
      "path": "../../secret/contract/tsconfig.build.json"
    },
    {
      "path": "../../scenario/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/redis-client/tsconfig.build.json"
    },
    {
      "path": "../../../packages/process-stores/tsconfig.build.json"
    },
    {
      "path": "../../../packages/process/tsconfig.build.json"
    },
    {
      "path": "../../../packages/plans/tsconfig.build.json"
    },
    {
      "path": "../../../packages/observability/tsconfig.build.json"
    },
    {
      "path": "../../../packages/module/tsconfig.build.json"
    },
    {
      "path": "../../model-provider/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/ksuid/tsconfig.build.json"
    },
    {
      "path": "../../../packages/handled-error/tsconfig.build.json"
    },
    {
      "path": "../../../packages/eventing/tsconfig.build.json"
    },
    {
      "path": "../../dataset/contract/tsconfig.build.json"
    },
    {
      "path": "../../authz/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/authorization/tsconfig.build.json"
    },
    {
      "path": "../../api-key/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../../agent/contract/tsconfig.build.json"
    }
  ],
  // Dependencies the build does not import get no reference; tsconfig.test.json holds test-only ones (tsconfig-shape-codemod).
  "nx": {
    "sync": {
      "ignoredDependencies": [
        "@langwatch/prisma-client",
        "@langwatch/project-contract",
        "@langwatch/task",
        "@langwatch/test-harness"
      ]
    }
  }
}
