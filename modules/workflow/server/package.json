{
  "name": "@langwatch/workflow-server",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical server-side Workflow feature.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "catalog:",
    "@aws-sdk/client-lambda": "catalog:",
    "@langwatch/agent-contract": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/dataset-contract": "workspace:*",
    "@langwatch/evaluator-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/runtime-composition": "workspace:*",
    "@langwatch/scenario-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/workflow-contract": "workspace:*",
    "@trpc/server": "catalog:",
    "ai": "catalog:",
    "diff": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "monacopilot": "catalog:",
    "nanoid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/test-harness": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
