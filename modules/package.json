{
  "name": "@langwatch/installed-modules",
  "version": "0.1.0",
  "private": true,
  "description": "What this build installs: the generated server and web module lists, and the members each module declared.",
  "license": "MIT",
  "files": [
    "*.generated.ts"
  ],
  "type": "module",
  "main": "./server-modules.generated.ts",
  "exports": {
    "./server": "./server-modules.generated.ts",
    "./web": "./web-modules.generated.ts",
    "./members": "./server-module-members.generated.ts"
  },
  "scripts": {
    "generate": "node ../dev/scripts/generate-modules.mjs",
    "typecheck": "tsc --noEmit"
  },
