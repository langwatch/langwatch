{
  "name": "@langwatch/experiment-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Portable batch evaluation result presentation and comparison behaviour.",
  "files": [
    "src",
    "tests"
  ],
  "type": "module",
  "exports": {
    "./declaration": {
      "langwatch-declaration-source": "./src/experiment.web.ts",
      "types": "./dist/experiment.web.d.ts",
      "default": "./src/experiment.web.ts"
    },
    "./batch-evaluation-state": {
      "langwatch-declaration-source": "./src/batch-evaluation-state.ts",
      "types": "./dist/batch-evaluation-state.d.ts",
      "default": "./src/batch-evaluation-state.ts"
    },
    "./comparison-config-form": {
      "langwatch-declaration-source": "./src/comparison-config-form.ts",
      "types": "./dist/comparison-config-form.d.ts",
      "default": "./src/comparison-config-form.ts"
    },
    "./evaluation-mappings": {
      "langwatch-declaration-source": "./src/evaluation-mappings.ts",
      "types": "./dist/evaluation-mappings.d.ts",
      "default": "./src/evaluation-mappings.ts"
    },
    "./evaluator-editor-callbacks": {
      "langwatch-declaration-source": "./src/evaluator-editor-callbacks.ts",
      "types": "./dist/evaluator-editor-callbacks.d.ts",
      "default": "./src/evaluator-editor-callbacks.ts"
    },
    "./batch-results": {
      "langwatch-declaration-source": "./src/batch-results.ts",
      "types": "./dist/batch-results.d.ts",
      "default": "./src/batch-results.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:browser": "playwright install --with-deps chromium && vitest run --config vitest.browser.config.ts"
