{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "extends": ["./tsconfig.json", "../../../tsconfig.emit.json"],
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**"
  ],
  "references": [
    {
      "path": "../../slack/contract/tsconfig.build.json"
    },
    {
      "path": "../../langy/contract/tsconfig.build.json"
    },
    {
      "path": "../../langy/client/tsconfig.build.json"
    },
    {
      "path": "../../feature-flag/contract/tsconfig.build.json"
    },
    {
      "path": "../../github/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/design-system/tsconfig.build.json"
    },
    {
      "path": "../../../packages/browser-host/tsconfig.build.json"
    },
    {
      "path": "../../../packages/browser/tsconfig.build.json"
    },
    {
      "path": "../../../packages/api/tsconfig.build.json"
    }
  ],
  // Dependencies the build does not import get no reference; tsconfig.test.json holds test-only ones (tsconfig-shape-codemod).
  "nx": {
    "sync": {
      "ignoredDependencies": ["@langwatch/vitest-config"]
    }
  }
}
