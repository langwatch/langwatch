{
  "extends": ["./tsconfig.json", "../../../tsconfig.emit.json"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@langwatch/audit-log-process": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**"
  ],
  "references": [
    {
      "path": "../../../packages/time/tsconfig.build.json"
    },
    {
      "path": "../../../packages/process/tsconfig.build.json"
    },
    {
      "path": "../../../packages/prisma-client/tsconfig.build.json"
    },
    {
      "path": "../../organization/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/module/tsconfig.build.json"
    },
    {
      "path": "../../../packages/ksuid/tsconfig.build.json"
    },
    {
      "path": "../../../packages/eventing/tsconfig.build.json"
    },
    {
      "path": "../../../enterprise/modules/billing/contract/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../../../packages/test-harness/tsconfig.build.json"
    },
    {
      "path": "../../../packages/process-stores/tsconfig.build.json"
    }
  ],
  // Workspace dependencies no source or test file imports get no reference (tsconfig-shape-codemod).
  "nx": {
    "sync": {
      "ignoredDependencies": ["@langwatch/vitest-config"]
    }
  }
}
