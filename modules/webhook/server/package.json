{
  "name": "@langwatch/webhook-server",
  "version": "0.1.0",
  "private": true,
  "description": "Server-side LangWatch webhook endpoint and delivery services.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1080.0",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/aws-client": "workspace:*",
    "@langwatch/egress": "workspace:*",
    "@langwatch/webhook-contract": "workspace:*",
    "@langwatch/entitlement-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/gateway-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/runtime-composition": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@trpc/server": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clickhouse/client": "catalog:",
    "@langwatch/test-harness": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
