{
  "name": "@langwatch/secret-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe project Secrets settings screen, presentation and client contracts.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./declaration": {
      "langwatch-declaration-source": "./src/secret.web.ts",
