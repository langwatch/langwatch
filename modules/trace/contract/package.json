{
  "name": "@langwatch/trace-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Portable trace read contracts and viewer-safe DTOs.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "pnpm -w typecheck:declarations --project modules/trace/contract/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/config": "workspace:*",
    "@langwatch/data-privacy-contract": "workspace:*",
    "@langwatch/evaluation-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/runtime-composition": "workspace:*",
    "liqe": "^3.8.7",
    "ohm-js": "^17.5.0",
    "ts-pattern": "^5.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
