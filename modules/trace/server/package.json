{
  "name": "@langwatch/trace-server",
  "version": "0.1.0",
  "private": true,
  "description": "Trace read service and private persistence composition.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    },
    "./composition/trace-edit-overlay": {
      "types": "./dist/repositories/prisma/prisma.trace-edit-overlay.repository.d.ts",
      "default": "./src/repositories/prisma/prisma.trace-edit-overlay.repository.ts"
    },
    "./composition/trace-processing-producer": {
      "types": "./dist/adapters/trace-processing-producer.adapter.d.ts",
      "default": "./src/adapters/trace-processing-producer.adapter.ts"
    },
    "./api-trpc/trace-read-mappers": {
      "types": "./dist/transport/api-trpc/trace-read-mappers.api.d.ts",
      "default": "./src/transport/api-trpc/trace-read-mappers.api.ts"
    },
    "./api-trpc/traces-v2": {
      "types": "./dist/transport/api-trpc/traces-v2.api.d.ts",
      "default": "./src/transport/api-trpc/traces-v2.api.ts"
    },
    "./api-trpc/shared-trace": {
      "types": "./dist/transport/api-trpc/shared-trace.api.d.ts",
      "default": "./src/transport/api-trpc/shared-trace.api.ts"
    },
    "./api-trpc/trace-view-gates": {
      "types": "./dist/transport/api-trpc/trace-view-gates.api.d.ts",
      "default": "./src/transport/api-trpc/trace-view-gates.api.ts"
    },
    "./api-rest/otlp-ingest": {
      "types": "./dist/transport/otlp-ingest.rest.d.ts",
      "default": "./src/transport/otlp-ingest.rest.ts"
    },
    "./api-rest/otlp-path-alias": {
      "types": "./dist/transport/otlp-path-alias.rest.d.ts",
      "default": "./src/transport/otlp-path-alias.rest.ts"
    },
    "./api-rest/traces": {
      "types": "./dist/transport/api-rest/traces.api.d.ts",
      "default": "./src/transport/api-rest/traces.api.ts"
    },
    "./api-rest/trace-legacy": {
      "types": "./dist/transport/api-rest/trace-legacy.api.d.ts",
      "default": "./src/transport/api-rest/trace-legacy.api.ts"
    },
    "./api-rest/collector": {
      "types": "./dist/transport/api-rest/collector.api.d.ts",
      "default": "./src/transport/api-rest/collector.api.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@langwatch/runtime-composition": "workspace:*",
    "@aws-sdk/client-s3": "catalog:",
    "@langwatch/annotation-contract": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/clickhouse-client": "workspace:*",
    "@langwatch/coding-agent-contract": "workspace:*",
    "@langwatch/csv": "workspace:*",
    "@langwatch/data-privacy-contract": "workspace:*",
    "@langwatch/data-retention-contract": "workspace:*",
    "@langwatch/data-retention-server": "workspace:*",
    "@langwatch/dataset-contract": "workspace:*",
    "@langwatch/entitlement-contract": "workspace:*",
    "@langwatch/evaluation-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/experiment-contract": "workspace:*",
    "@langwatch/feature-flag-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/ksuid": "catalog:",
    "@langwatch/log-contract": "workspace:*",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/monitor-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/otlp": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@langwatch/prompt-contract": "workspace:*",
    "@langwatch/scenario": "catalog:",
    "@langwatch/scenario-contract": "workspace:*",
    "@langwatch/share-contract": "workspace:*",
    "@langwatch/stored-object-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/topic-contract": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/core": "catalog:",
    "@opentelemetry/otlp-transformer": "catalog:",
    "@opentelemetry/otlp-transformer-next": "npm:@opentelemetry/otlp-transformer@0.219.0",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@trpc/server": "catalog:",
    "ai": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "langwatch": "workspace:*",
    "papaparse": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:",
    "zod-validation-error": "catalog:"
  },
  "devDependencies": {
    "@clickhouse/client": "catalog:",
    "@langwatch/data-privacy-server": "workspace:*",
    "@langwatch/test-harness": "workspace:*",
    "@types/papaparse": "catalog:",
    "nanoid": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
