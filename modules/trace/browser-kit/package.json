{
  "name": "@langwatch/trace-browser-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Peer-importable browser helpers owned by the Trace module.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./trace-drawer-chip": {
      "langwatch-declaration-source": "./src/trace-drawer-chip.tsx",
      "types": "./dist/trace-drawer-chip.d.ts",
      "default": "./src/trace-drawer-chip.tsx"
    },
    "./page-visibility": {
      "langwatch-declaration-source": "./src/page-visibility.ts",
      "types": "./dist/page-visibility.d.ts",
      "default": "./src/page-visibility.ts"
    },
    "./trace-query-config": {
      "langwatch-declaration-source": "./src/trace-query-config.ts",
      "types": "./dist/trace-query-config.d.ts",
      "default": "./src/trace-query-config.ts"
    },
    "./sse-subscription": {
      "langwatch-declaration-source": "./src/sse-subscription.ts",
      "types": "./dist/sse-subscription.d.ts",
      "default": "./src/sse-subscription.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@chakra-ui/react": "catalog:",
    "@langwatch/design-system": "workspace:*",
    "react-icons": "catalog:",
    "@langwatch/observability": "workspace:*"
  },
  "devDependencies": {
    "@langwatch/test-harness": "workspace:*",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.7"
  }
}
