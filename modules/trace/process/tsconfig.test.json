{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "tsBuildInfoFile": "dist/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "src/**/__tests__/**/*.ts",
    "src/**/__mocks__/**/*.ts",
    "src/**/tests/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.test.*.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.*.ts",
    "src/**/*.stories.ts",
    "src/**/*.stories.*.ts",
    "src/**/*.bench.ts",
    "src/**/*.bench.*.ts",
