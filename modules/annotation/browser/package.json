{
  "name": "@langwatch/annotation-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe annotation presentation and row helpers.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/annotations.ts",
  "types": "./dist/annotations.d.ts",
  "exports": {
    "./declaration": {
      "langwatch-declaration-source": "./src/annotation.web.ts",
      "types": "./dist/annotation.web.d.ts",
      "default": "./src/annotation.web.ts"
    },
    "./annotation-form": {
      "langwatch-declaration-source": "./src/annotation-form.ts",
      "types": "./dist/annotation-form.d.ts",
      "default": "./src/annotation-form.ts"
    },
    "./annotation-card": {
      "langwatch-declaration-source": "./src/annotation-card.ts",
      "types": "./dist/annotation-card.d.ts",
      "default": "./src/annotation-card.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@chakra-ui/react": "catalog:",
    "@langwatch/annotation-contract": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/browser-host": "workspace:*",
    "@langwatch/csv": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/error-presentation": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/organization-browser": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-browser-kit": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@langwatch/ui-kernel": "workspace:*",
    "diff": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-hook-form": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
