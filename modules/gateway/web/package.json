{
  "name": "@langwatch/gateway-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe AI Gateway presentation helpers and surfaces.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./drawers": {
      "types": "./dist/drawers.d.ts",
      "default": "./src/drawers.ts"
    },
    "./surfaces/budget-overview": {
      "types": "./dist/ui/sections/budget-overview/index.d.ts",
      "default": "./src/ui/sections/budget-overview/index.ts"
    },
    "./gateway": {
      "langwatch-declaration-source": "./src/gateway.ts",
      "types": "./dist/gateway.d.ts",
      "default": "./src/gateway.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/authz-web": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/csv": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/gateway-contract": "workspace:*",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@langwatch/ui-host": "workspace:*",
    "lucide-react": "catalog:",
    "papaparse": "catalog:",
    "react-hook-form": "catalog:",
    "recharts": "catalog:",
    "shiki": "^3.15.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@langwatch/trace-server": "workspace:*",
    "@langwatch/trace-web": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/papaparse": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
