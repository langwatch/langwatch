{
  "name": "@langwatch/gateway-process",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical server-side Gateway service.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./dist/__tests__/testing.d.ts",
      "default": "./src/__tests__/testing.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@langwatch/analytics-contract": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/api-key-contract": "workspace:*",
    "@langwatch/authorization": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/egress": "workspace:*",
    "@langwatch/evaluation-contract": "workspace:*",
    "@langwatch/evaluator-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/feature-flag-contract": "workspace:*",
    "@langwatch/gateway-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/ksuid": "workspace:*",
    "@langwatch/langy-contract": "workspace:*",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/module": "workspace:*",
    "@langwatch/monitor-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/organization-contract": "workspace:*",
    "@langwatch/plans": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/process": "workspace:*",
    "@langwatch/process-stores": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@langwatch/redis-client": "workspace:*",
    "@langwatch/secret-contract": "workspace:*",
    "@langwatch/secrets": "workspace:*",
    "@langwatch/task": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@langwatch/webhook-contract": "workspace:*",
    "@trpc/server": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "ioredis": "catalog:",
    "jsonwebtoken": "catalog:",
    "nanoid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clickhouse/client": "catalog:",
    "@langwatch/clickhouse-client": "workspace:*",
    "@langwatch/clickhouse-migrations": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/test-harness": "workspace:*",
    "@types/jsonwebtoken": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
