{
  "name": "@langwatch/gateway-server",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical server-side Gateway service.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    },
    "./realtime-session-reconciliation": {
      "types": "./dist/services/gateway-realtime-session-reconciliation.service.d.ts",
      "default": "./src/services/gateway-realtime-session-reconciliation.service.ts"
    },
    "./composition/gateway-change-events": {
      "types": "./dist/repositories/prisma/prisma.gateway-change-event.repository.d.ts",
      "default": "./src/repositories/prisma/prisma.gateway-change-event.repository.ts"
    },
    "./composition/gateway-audit": {
      "types": "./dist/repositories/prisma/prisma.gateway-audit.repository.d.ts",
      "default": "./src/repositories/prisma/prisma.gateway-audit.repository.ts"
    },
    "./composition/gateway-virtual-keys": {
      "types": "./dist/repositories/prisma/prisma.virtual-key.repository.d.ts",
      "default": "./src/repositories/prisma/prisma.virtual-key.repository.ts"
    },
    "./composition/gateway-elevenlabs-credentials": {
      "types": "./dist/repositories/prisma/prisma.gateway-elevenlabs-credential.repository.d.ts",
      "default": "./src/repositories/prisma/prisma.gateway-elevenlabs-credential.repository.ts"
    },
    "./composition/gateway-guardrails": {
      "types": "./dist/repositories/prisma/prisma.gateway-guardrail.repository.d.ts",
      "default": "./src/repositories/prisma/prisma.gateway-guardrail.repository.ts"
    },
    "./composition/gateway-scope-resolution": {
      "types": "./dist/repositories/prisma/prisma.gateway-scope-resolution.repository.d.ts",
      "default": "./src/repositories/prisma/prisma.gateway-scope-resolution.repository.ts"
    },
    "./composition/gateway-key-budgets": {
      "types": "./dist/repositories/prisma/prisma.gateway-key-budget.repository.d.ts",
      "default": "./src/repositories/prisma/prisma.gateway-key-budget.repository.ts"
    },
    "./composition/gateway-transactions": {
      "types": "./dist/adapters/postgres.gateway-transaction.adapter.d.ts",
      "default": "./src/adapters/postgres.gateway-transaction.adapter.ts"
    },
    "./composition/gateway-virtual-key-direct-budgets": {
      "types": "./dist/repositories/prisma/prisma.gateway-virtual-key-direct-budget.repository.d.ts",
      "default": "./src/repositories/prisma/prisma.gateway-virtual-key-direct-budget.repository.ts"
    },
    "./composition/gateway-realtime-sessions": {
      "types": "./dist/repositories/prisma/prisma.gateway-realtime-session.repository.d.ts",
      "default": "./src/repositories/prisma/prisma.gateway-realtime-session.repository.ts"
    },
    "./composition/gateway-virtual-key-authorization": {
      "types": "./dist/repositories/prisma/prisma.virtual-key-authorization.repository.d.ts",
      "default": "./src/repositories/prisma/prisma.virtual-key-authorization.repository.ts"
    },
    "./composition/gateway-provider-labels": {
      "types": "./dist/repositories/prisma/prisma.gateway-provider-label.repository.d.ts",
      "default": "./src/repositories/prisma/prisma.gateway-provider-label.repository.ts"
    },
    "./composition/gateway-spend-fold": {
      "types": "./dist/projections/gateway-spend.projection.d.ts",
      "default": "./src/projections/gateway-spend.projection.ts"
    },
    "./api-trpc/gateway-spend-event": {
      "types": "./dist/transport/api-trpc/gateway-spend-event.api.d.ts",
      "default": "./src/transport/api-trpc/gateway-spend-event.api.ts"
    },
    "./api-trpc/gateway-usage": {
      "types": "./dist/transport/api-trpc/gateway-usage.api.d.ts",
      "default": "./src/transport/api-trpc/gateway-usage.api.ts"
    },
    "./api-trpc/virtual-key": {
      "types": "./dist/transport/api-trpc/virtual-key.api.d.ts",
      "default": "./src/transport/api-trpc/virtual-key.api.ts"
    },
    "./api-rest/gateway-platform": {
      "types": "./dist/transport/api-rest/gateway-platform.api.d.ts",
      "default": "./src/transport/api-rest/gateway-platform.api.ts"
    },
    "./api-rest/gateway-internal": {
      "types": "./dist/transport/api-rest/gateway-internal.api.d.ts",
      "default": "./src/transport/api-rest/gateway-internal.api.ts"
    },
    "./api-rest/gateway-spend": {
      "types": "./dist/transport/api-rest/gateway-spend.api.d.ts",
      "default": "./src/transport/api-rest/gateway-spend.api.ts"
    },
    "./api-rest/elevenlabs-webhook": {
      "types": "./dist/transport/api-rest/elevenlabs-webhook.api.d.ts",
      "default": "./src/transport/api-rest/elevenlabs-webhook.api.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@langwatch/runtime-composition": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/api-key-contract": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/evaluator-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/feature-flag-contract": "workspace:*",
    "@langwatch/gateway-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/langy-contract": "workspace:*",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/monitor-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/organization-contract": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@langwatch/task": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@trpc/server": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "ioredis": "catalog:",
    "jsonwebtoken": "catalog:",
    "nanoid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clickhouse/client": "catalog:",
    "@langwatch/clickhouse-client": "workspace:*",
    "@langwatch/test-harness": "workspace:*",
    "@types/jsonwebtoken": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
