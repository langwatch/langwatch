      "path": "../../trace/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/time/tsconfig.build.json"
    },
    {
      "path": "../../project/contract/tsconfig.build.json"
    },
    {
      "path": "../../onboarding/contract/tsconfig.build.json"
    },
    {
      "path": "../../onboarding/client/tsconfig.build.json"
    },
    {
      "path": "../../model-provider/contract/tsconfig.build.json"
    },
    {
