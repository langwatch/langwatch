    },
    {
      "path": "../../feature-flag/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/error-views/tsconfig.build.json"
    },
    {
      "path": "../../../enterprise/modules/enterprise-gateway/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/design-system/tsconfig.build.json"
    },
    {
      "path": "../../../packages/csv/tsconfig.build.json"
    },
    {
      "path": "../../../packages/browser-host/tsconfig.build.json"
    },
    {
      "path": "../../../packages/browser/tsconfig.build.json"
    },
    {
      "path": "../../../packages/api/tsconfig.build.json"
    }
  ],
  // Dependencies the build does not import get no reference; tsconfig.test.json holds test-only ones (tsconfig-shape-codemod).
  "nx": {
    "sync": {
      "ignoredDependencies": [
        "@langwatch/authorization",
        "@langwatch/config",
        "@langwatch/enterprise-billing-client",
