{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",

    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@langwatch/authz-contract": ["../../authz/contract/src/index.ts"],
      "@langwatch/gateway-contract": ["../contract/src/index.ts"],
      "@langwatch/model-provider-contract": ["../../model-provider/contract/src/index.ts"],
      "@langwatch/enterprise-billing-browser/surfaces/contact-sales": [
        "../../../enterprise/modules/billing/browser/src/ui/sections/contact-sales/index.ts"
      ]
    },
    "composite": true,
    "noEmit": false
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.build.json"
    },
    {
      "path": "./tsconfig.test.json"
    }
  ]
}
