{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom"],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    // `node` is for `scripts/` (Node generators) and the tests that read the
    // repo from disk, not for `src/` — `process.env` in browser source is
    // refused by `langwatch/environment-boundaries`, not by this list.
    "types": ["node"],
    "resolveJsonModule": true,

    "rootDir": ".",

    "outDir": "dist",
    "composite": true,
    "noEmit": false
  },
  "files": [],
  "include": [],

  "references": [
    {
      "path": "./tsconfig.build.json"
    },
    {
      "path": "./tsconfig.test.json"
    }
  ]
}
