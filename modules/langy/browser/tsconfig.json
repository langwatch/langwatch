{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom"],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    // `node` is for `scripts/` (Node generators) and the tests that read the
    // repo from disk, not for `src/` — `process.env` in browser source is
    // refused by `langwatch/environment-boundaries`, not by this list.
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "resolveJsonModule": true,


    "rootDir": ".",

    "outDir": "dist",

  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "scripts/**/*.ts"],

  "references": [
    {
      "path": "../../../dev/tsconfig.web-declarations.json"
    },
    {
