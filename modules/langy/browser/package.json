{
  "name": "@langwatch/langy-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe Langy behaviour and reusable presentation.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    "./declaration": {
      "langwatch-declaration-source": "./src/langy.web.ts",
      "types": "./dist/langy.web.d.ts",
      "default": "./src/langy.web.ts"
    },
    "./langy-page-registration": {
      "langwatch-declaration-source": "./src/langy-page-registration.ts",
      "types": "./dist/langy-page-registration.d.ts",
      "default": "./src/langy-page-registration.ts"
    },
    "./langy-ui-actions": {
      "langwatch-declaration-source": "./src/langy-ui-actions.ts",
      "types": "./dist/langy-ui-actions.d.ts",
      "default": "./src/langy-ui-actions.ts"
    },
    "./surfaces/asaplangy": {
      "langwatch-declaration-source": "./src/asaplangy.ts",
      "types": "./dist/asaplangy.d.ts",
      "default": "./src/asaplangy.ts"
    },
    "./surfaces/langy-theme.css": "./src/ui/elements/langy-theme.css"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "generate:langy-skills": "node --experimental-transform-types scripts/generate-langy-skills.ts",
    "generate:feature-map": "node --experimental-transform-types scripts/generate-feature-map.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.219",
    "@chakra-ui/charts": "^3.36.0",
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@langwatch/api": "workspace:*",
    "@langwatch/browser-host": "workspace:*",
    "@langwatch/browser-trpc": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/error-presentation": "workspace:*",
    "@langwatch/feature-flag-contract": "workspace:*",
    "@langwatch/github-browser": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/langy-browser-kit": "workspace:*",
    "@langwatch/langy-contract": "workspace:*",
    "@langwatch/model-provider-browser": "workspace:*",
    "@langwatch/model-provider-browser-kit": "workspace:*",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-browser-kit": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@langwatch/ui-kernel": "workspace:*",
    "@tanstack/react-virtual": "catalog:",
    "ai": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "catalog:",
    "react-feather": "catalog:",
    "react-router": "catalog:",
    "recharts": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@langwatch/skills": "workspace:*",
    "@langwatch/vitest-config": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@trpc/client": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
