{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "files": [
    "./src/index.ts",
    "./src/ports/langy-frame-auth.port.ts",
    "./src/rules/langy-capability-progress.rules.ts",
    "./src/rules/langy-turn-settlement.rules.ts",
    "./src/ports/langy-ids.port.ts",
    "./src/testing.ts",
    "./src/services/langy-cli-envelope.service.ts",
    "./src/services/langy-final-parts.service.ts",
    "./src/services/langy-message.service.ts",
    "./src/services/langy-turn.service.ts",
    "./src/ports/langy-turn-runtime.port.ts",
    "./src/subscribers/langy-conversation.subscriber.ts"
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../../agent/contract/tsconfig.build.json"
    },
    {
      "path": "../../agent/server/tsconfig.build.json"
    },
    {
      "path": "../../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../../api-key/contract/tsconfig.build.json"
    },
    {
      "path": "../../authz/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/eventing/tsconfig.build.json"
    },
    {
      "path": "../../feature-flag/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/handled-error/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../model-provider/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/observability/tsconfig.build.json"
    },
    {
      "path": "../../../packages/prisma-client/tsconfig.build.json"
    },
    {
      "path": "../../../packages/runtime-composition/tsconfig.build.json"
    },
    {
      "path": "../../../packages/time/tsconfig.build.json"
    }
  ]
}
