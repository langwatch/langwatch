{
  "name": "@langwatch/langy-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe Langy behaviour and reusable presentation.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "langwatch-declaration-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./surfaces/asaplangy": {
      "langwatch-declaration-source": "./src/surfaces/asaplangy/index.ts",
      "types": "./dist/surfaces/asaplangy/index.d.ts",
      "default": "./src/surfaces/asaplangy/index.ts"
    },
    "./surfaces/langy-page-registration": {
      "langwatch-declaration-source": "./src/surfaces/langy-page-registration/index.ts",
      "types": "./dist/surfaces/langy-page-registration/index.d.ts",
      "default": "./src/surfaces/langy-page-registration/index.ts"
    },
    "./surfaces/langy-theme.css": "./src/ui/elements/langy-theme.css",
    "./screens/langy": {
      "langwatch-declaration-source": "./src/screens/langy/index.ts",
      "types": "./dist/screens/langy/index.d.ts",
      "default": "./src/screens/langy/index.ts"
    },
    "./surfaces/langy-store": {
      "langwatch-declaration-source": "./src/surfaces/langy-store/index.ts",
      "types": "./dist/surfaces/langy-store/index.d.ts",
      "default": "./src/surfaces/langy-store/index.ts"
    },
    "./surfaces/langy-context": {
      "langwatch-declaration-source": "./src/surfaces/langy-context/index.ts",
      "types": "./dist/surfaces/langy-context/index.d.ts",
      "default": "./src/surfaces/langy-context/index.ts"
    },
    "./surfaces/langy-mark": {
      "langwatch-declaration-source": "./src/surfaces/langy-mark/index.ts",
      "types": "./dist/surfaces/langy-mark/index.d.ts",
      "default": "./src/surfaces/langy-mark/index.ts"
    },
    "./surfaces/langy-panel-layout": {
      "langwatch-declaration-source": "./src/surfaces/langy-panel-layout/index.ts",
      "types": "./dist/surfaces/langy-panel-layout/index.d.ts",
      "default": "./src/surfaces/langy-panel-layout/index.ts"
    },
    "./surfaces/langy-ui-actions": {
      "langwatch-declaration-source": "./src/surfaces/langy-ui-actions/index.ts",
      "types": "./dist/surfaces/langy-ui-actions/index.d.ts",
      "default": "./src/surfaces/langy-ui-actions/index.ts"
    },
    "./surfaces/langy-code-access-preference": {
      "langwatch-declaration-source": "./src/ui/sections/langy-code-access-preference.tsx",
      "types": "./dist/ui/sections/langy-code-access-preference.d.ts",
      "default": "./src/ui/sections/langy-code-access-preference.tsx"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project modules/langy/web/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "generate:langy-skills": "node --experimental-transform-types scripts/generate-langy-skills.ts",
    "generate:feature-map": "node --experimental-transform-types scripts/generate-feature-map.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.219",
    "@chakra-ui/charts": "^3.36.0",
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "@langwatch/api": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/feature-flag-contract": "workspace:*",
    "@langwatch/github-web": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/langy-contract": "workspace:*",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/model-provider-web": "workspace:*",
    "@langwatch/ops-web": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@langwatch/trace-web": "workspace:*",
    "@langwatch/ui-drawer": "workspace:*",
    "@langwatch/ui-host": "workspace:*",
    "@langwatch/workflow-web": "workspace:*",
    "@tanstack/react-virtual": "^3.14.5",
    "ai": "^6.0.217",
    "lucide-react": "^1.22.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "react-feather": "^2.0.10",
    "react-router": "^8.0.1",
    "recharts": "^3.9.1",
    "zod": "^4.4.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@langwatch/skills": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@trpc/client": "11.18.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
