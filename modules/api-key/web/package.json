{
  "name": "@langwatch/api-key-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe API Keys settings screen, the CLI device-flow authorize screen and the two handoff consent screens, presentation and client contracts.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./api-keys": {
      "langwatch-declaration-source": "./src/api-keys.ts",
      "types": "./dist/api-keys.d.ts",
      "default": "./src/api-keys.ts"
    },
    "./authorize": {
      "langwatch-declaration-source": "./src/authorize.ts",
      "types": "./dist/authorize.d.ts",
      "default": "./src/authorize.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/api-key-contract": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/authz-web-kit": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/browser-host": "workspace:*",
    "lucide-react": "catalog:",
    "motion": "catalog:"
  },
  "devDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@langwatch/test-harness": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
