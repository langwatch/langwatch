{
  "name": "@langwatch/api-key-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe API Keys settings screen, the CLI device-flow authorize screen and the two handoff consent screens, presentation and client contracts.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./declaration": {
      "langwatch-declaration-source": "./src/api-key.web.ts",
      "types": "./dist/api-key.web.d.ts",
      "default": "./src/api-key.web.ts"
    }
  },
  "scripts": {
    "typecheck": "GOMAXPROCS=2 GOMEMLIMIT=2GiB tsc -b",
    "test": "vitest run",
    "test:browser": "playwright install --with-deps chromium && vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/api-key-client": "workspace:*",
    "@langwatch/api-key-contract": "workspace:*",
    "@langwatch/authorization": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/browser": "workspace:*",
    "@langwatch/browser-host": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/organization-client": "workspace:*",
    "@langwatch/project-client": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-client": "workspace:*",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@langwatch/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
