{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "tsBuildInfoFile": "dist/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "src/**/__tests__/**/*.ts",
    "src/**/__mocks__/**/*.ts",
    "src/**/tests/**/*.ts",
    "src/**/*.test.ts",
    "src/**/*.test.*.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.*.ts",
    "src/**/*.stories.ts",
    "src/**/*.stories.*.ts",
    "src/**/*.bench.ts",
    "src/**/*.bench.*.ts",
    "src/**/__bench__/**/*.ts",
    "src/**/testing.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.build.json"
    },
    {
      "path": "../../../packages/authorization/tsconfig.build.json"
    },
    {
      "path": "../../../packages/group-queue/tsconfig.build.json"
    },
    {
      "path": "../../../packages/process-stores/tsconfig.build.json"
    }
  ],
  "exclude": ["src/__tests__/testing.ts", "src/__tests__/fixtures/graph-activity.fixture.ts"]
}
