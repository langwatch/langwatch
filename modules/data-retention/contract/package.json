{
  "name": "@langwatch/data-retention-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Portable data-retention contracts and Zod 4 schemas.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./retention-tables": {
      "types": "./dist/retention-tables.d.ts",
      "default": "./src/retention-tables.ts"
    },
    "./event-log-retention-policy": {
      "types": "./dist/event-log-retention-policy.d.ts",
      "default": "./src/event-log-retention-policy.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/kernel": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
