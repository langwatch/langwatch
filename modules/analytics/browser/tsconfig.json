{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node", "react", "react-dom"],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,


    "rootDir": ".",

    "outDir": "dist",

  },
  // `tests/` holds the real-browser lane. Vite's oxc transform reads the
  // tsconfig that covers a file, so one outside `include` fails to transform
  // at all — "Tsconfig not found", before a single assertion runs.
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx"],

  "references": [
    {
      "path": "../../../dev/tsconfig.web-declarations.json"
    },
    {
      "path": "../browser-kit/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../../../packages/browser-host/tsconfig.build.json"
    },
    {
      "path": "../../../packages/browser-trpc/tsconfig.build.json"
    },
    {
      "path": "../../dashboard/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/design-system/tsconfig.build.json"
    },
    {
      "path": "../../../packages/error-presentation/tsconfig.build.json"
    },
    {
      "path": "../../evaluator/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/handled-error/tsconfig.build.json"
    },
    {
      "path": "../../prompt/browser-kit/tsconfig.build.json"
    },
    {
      "path": "../../../packages/time/tsconfig.build.json"
    },
    {
      "path": "../../trace/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/ui-kernel/tsconfig.build.json"
    },
    {
      "path": "../../../packages/vitest-config/tsconfig.build.json"
    }
  ]
}
