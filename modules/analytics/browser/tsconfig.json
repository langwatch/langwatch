{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node", "react", "react-dom"],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,

    "rootDir": ".",

    "outDir": "dist",
    "composite": true,
    "noEmit": false
  },
  "files": [],
  // `tests/` holds the real-browser lane. Vite's oxc transform reads the
  // tsconfig that covers a file, so one outside `include` fails to transform
  // at all — "Tsconfig not found", before a single assertion runs.
  "include": [],

  "references": [
    {
      "path": "./tsconfig.build.json"
    },
    {
      "path": "./tsconfig.test.json"
    }
  ]
}
