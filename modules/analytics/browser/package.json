    "@langwatch/browser-trpc": "workspace:*",
    "@langwatch/dashboard-contract": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/error-presentation": "workspace:*",
    "@langwatch/evaluator-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/prompt-browser-kit": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@langwatch/ui-kernel": "workspace:*",
    "@monaco-editor/react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@trpc/client": "catalog:",
