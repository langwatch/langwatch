    "recharts": "catalog:",
    "usehooks-ts": "catalog:",
    "vega": "catalog:",
    "vega-embed": "7.1.0",
    "vega-lite": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/lodash-es": "catalog:",
