{
  "name": "@langwatch/analytics-catalogue",
  "version": "0.1.0",
  "private": true,
  "description": "Portable, framework-free dashboards catalogue: every widget, every template and the From LangWatch boards.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "GOMAXPROCS=2 GOMEMLIMIT=2GiB tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@langwatch/analytics-contract": "workspace:*"
  },
  "devDependencies": {
    "@langwatch/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
