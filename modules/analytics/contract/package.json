{
  "name": "@langwatch/analytics-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Portable Analytics timeseries contracts and Zod 4 schemas.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./visualization": {
      "types": "./dist/visualization/index.d.ts",
      "default": "./src/visualization/index.ts"
    },
    "./visualization/validation": {
      "types": "./dist/visualization/validation.d.ts",
      "default": "./src/visualization/validation.ts"
    },
    "./testing": {
      "types": "./dist/visualization/__tests__/fixtures/index.d.ts",
      "default": "./src/visualization/__tests__/fixtures/index.ts"
    },
    "./chart-frame-document": {
      "types": "./dist/features/chart-frame/chart-frame-document.d.ts",
      "default": "./src/features/chart-frame/chart-frame-document.ts"
    },
    "./chart-frame-import-map": {
      "types": "./dist/features/chart-frame/chart-frame-import-map.d.ts",
      "default": "./src/features/chart-frame/chart-frame-import-map.ts"
    },
    "./chart-frame-protocol": {
      "types": "./dist/features/chart-frame/chart-frame-protocol.d.ts",
      "default": "./src/features/chart-frame/chart-frame-protocol.ts"
    },
    "./chart-grid": {
      "types": "./dist/features/dashboard-widget/chart-grid.d.ts",
      "default": "./src/features/dashboard-widget/chart-grid.ts"
    },
    "./dashboard-widget-definition": {
      "types": "./dist/features/dashboard-widget/dashboard-widget-definition.d.ts",
      "default": "./src/features/dashboard-widget/dashboard-widget-definition.ts"
    },
    "./langwatch-ql-limits": {
      "types": "./dist/features/lwql/langwatch-ql-limits.d.ts",
      "default": "./src/features/lwql/langwatch-ql-limits.ts"
    }
  },
  "scripts": {
    "generate:vega-validator": "node --experimental-transform-types scripts/generate-vega-lite-validator.ts",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/authorization": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/module": "workspace:*",
    "@langwatch/time": "workspace:*",
    "ajv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vega": "catalog:",
    "vega-lite": "catalog:",
    "vitest": "catalog:"
  }
}
