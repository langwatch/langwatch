{
  "name": "@langwatch/stored-object-server",
  "version": "0.1.0",
  "private": true,
  "description": "Stored Objects service, Postgres store, API, and ClickHouse import.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./composition/stored-objects": {
      "types": "./dist/repositories/clickhouse/stored-objects.repository.d.ts",
      "default": "./src/repositories/clickhouse/stored-objects.repository.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project modules/stored-object/server/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.826.0",
    "@aws-sdk/s3-request-presigner": "^3.826.0",
    "@azure/identity": "^4.13.1",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/aws-client": "workspace:*",
    "@langwatch/dataset-contract": "workspace:*",
    "@langwatch/group-queue": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/ksuid": "^2.0.2",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/redis-client": "workspace:*",
    "@langwatch/runtime-composition": "workspace:*",
    "@langwatch/stored-object-contract": "workspace:*",
    "@langwatch/system-migrations": "workspace:*",
    "@langwatch/task": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@trpc/server": "^11.18.0",
    "hono": "^4.12.27",
    "ioredis": "5.10.1",
    "langwatch": "workspace:*",
    "prom-client": "^15.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
