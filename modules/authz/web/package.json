{
  "name": "@langwatch/authz-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe LangWatch authorization screens, scope presentation and client contracts.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./authz": {
      "langwatch-declaration-source": "./src/authz.ts",
      "types": "./dist/authz.d.ts",
      "default": "./src/authz.ts"
    },
    "./surfaces/scope-picker": {
      "types": "./dist/surfaces/scope-picker/index.d.ts",
      "default": "./src/surfaces/scope-picker/index.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/role-contract": "workspace:*",
    "@langwatch/ui-host": "workspace:*",
    "lucide-react": "catalog:",
    "react-feather": "catalog:",
    "react-hook-form": "catalog:"
  },
  "devDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
