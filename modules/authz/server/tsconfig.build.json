{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@langwatch/authz-server": ["./src/index.ts"]
    },
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "files": ["./src/index.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../../../packages/actor/tsconfig.build.json"
    },
    {
      "path": "../../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/eventing/tsconfig.build.json"
    },
    {
      "path": "../../../packages/handled-error/tsconfig.build.json"
    },
    {
      "path": "../../../packages/kernel/tsconfig.build.json"
    },
    {
      "path": "../../../packages/ksuid/tsconfig.build.json"
    },
    {
      "path": "../../../packages/observability/tsconfig.build.json"
    },
    {
      "path": "../../organization/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/prisma-client/tsconfig.build.json"
    },
    {
      "path": "../../../packages/process-stores/tsconfig.build.json"
    },
    {
      "path": "../../../packages/system-migrations/tsconfig.build.json"
    },
    {
      "path": "../../../packages/time/tsconfig.build.json"
    }
  ]
}
