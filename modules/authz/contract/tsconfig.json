{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",

    "lib": ["es2022"],
    // Deliberately NO "types": ["node"]. This package is isomorphic: the
    // frontend and the backend both import it, so a `node:*` import or a
    // `Buffer` reference must not compile here. That is the whole boundary —
    // enforced by the compiler rather than by a convention in a barrel.
    "types": [],
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,

    "rewriteRelativeImportExtensions": false
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "../../../packages/actor/tsconfig.build.json"
    },
    {
      "path": "../../../packages/config/tsconfig.build.json"
    },
    {
      "path": "../../../packages/handled-error/tsconfig.build.json"
    },
    {
      "path": "../../../packages/time/tsconfig.build.json"
    }
  ]
}
