{
  "name": "@langwatch/github-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe GitHub integration: the Integrations settings screen and the install popup ceremony.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    "./surfaces/github-connect-popup": {
      "types": "./dist/behavior/github-connect-popup.d.ts",
      "default": "./src/behavior/github-connect-popup.ts"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./screens/integrations": {
      "types": "./dist/screens/integrations/index.d.ts",
      "default": "./src/screens/integrations/index.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project modules/github/web/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/github-contract": "workspace:*",
    "@langwatch/ui-host": "workspace:*",
    "react": "^19.2.7",
    "react-feather": "^2.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
