{
  "name": "@langwatch/github-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe GitHub integration: the Integrations settings screen and the install popup ceremony.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    "./surfaces/github-connect-popup": {
      "types": "./dist/behavior/github-connect-popup.d.ts",
      "default": "./src/behavior/github-connect-popup.ts"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./integrations": {
      "langwatch-declaration-source": "./src/integrations.ts",
      "types": "./dist/integrations.d.ts",
      "default": "./src/integrations.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/github-contract": "workspace:*",
    "@langwatch/ui-host": "workspace:*",
    "react": "catalog:",
    "react-feather": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
