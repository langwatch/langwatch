{
  "extends": ["./tsconfig.json", "../../../tsconfig.emit.json"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo"
  },
  "files": ["./src/behavior/github-connect-popup.ts", "./src/github.web.ts"],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.stories.*",
    "**/*.bench.*",
    "**/__bench__/**",
    "**/testing.ts",
    "**/testing.tsx"
  ],
  "references": [
    {
      "path": "../../../packages/browser/tsconfig.build.json"
    }
  ]
}
