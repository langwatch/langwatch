{
  "name": "@langwatch/coding-agent-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Portable coding-agent session read contract.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {
    "typecheck": "GOMAXPROCS=2 GOMEMLIMIT=2GiB tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/authorization": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/module": "workspace:*",
    "@langwatch/span-normalisation": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/time": "workspace:*",
    "@langwatch/vitest-config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
