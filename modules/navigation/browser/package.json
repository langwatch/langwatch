{
  "name": "@langwatch/navigation-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe navigation: the application shell, the product registry, the landing redirect and the switchers the chrome renders.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./declaration": {
      "langwatch-declaration-source": "./src/navigation.web.ts",
      "types": "./dist/navigation.web.d.ts",
      "default": "./src/navigation.web.ts"
    },
    "./chrome": {
      "types": "./dist/ui/index.d.ts",
      "default": "./src/ui/index.ts"
    },
    "./surfaces/command-bar": {
      "types": "./dist/command-bar.d.ts",
      "default": "./src/command-bar.ts"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "default": "./src/navigation.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/agent-contract": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/browser-host": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/feature-flag-contract": "workspace:*",
    "@langwatch/identity-contract": "workspace:*",
    "@langwatch/langy-contract": "workspace:*",
    "@langwatch/ops-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/ui-kernel": "workspace:*",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react-error-boundary": "catalog:",
    "react-icons": "catalog:",
    "usehooks-ts": "catalog:",
    "zod": "catalog:",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@langwatch/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
