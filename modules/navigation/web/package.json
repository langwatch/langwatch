{
  "name": "@langwatch/navigation-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe navigation: the application shell, the product registry, the landing redirect and the switchers the chrome renders.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./chrome": {
      "types": "./dist/ui/index.d.ts",
      "default": "./src/ui/index.ts"
    },
    "./surfaces/command-bar": {
      "types": "./dist/surfaces/command-bar/index.d.ts",
      "default": "./src/surfaces/command-bar/index.ts"
    },
    "./screens/navigation": {
      "types": "./dist/screens/navigation/index.d.ts",
      "default": "./src/screens/navigation/index.ts"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.tsx"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/agent-contract": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/feature-flag-contract": "workspace:*",
    "@langwatch/langy-contract": "workspace:*",
    "@langwatch/ops-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/ui-host": "workspace:*",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react-error-boundary": "catalog:",
    "react-icons": "catalog:",
    "usehooks-ts": "catalog:",
    "zod": "catalog:",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
