{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",

    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node", "react", "react-dom"],
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@langwatch/authz-contract": ["../../authz/contract/src/index.ts"],
      "@langwatch/coding-agent-contract": ["../../coding-agent/contract/src/index.ts"],
      "@langwatch/coding-agent-browser": ["../../coding-agent/browser/src/index.ts"],
      "@langwatch/coding-agent-browser/surfaces/activity": [
        "../../coding-agent/browser/src/activity.ts"
      ],
      "@langwatch/enterprise-governance-contract": [
        "../../../enterprise/modules/governance/contract/src/index.ts"
      ],
      "@langwatch/gateway-contract": ["../../gateway/contract/src/index.ts"],
      "@langwatch/model-provider-contract": ["../../model-provider/contract/src/index.ts"],
      "@langwatch/user-contract": ["../contract/src/index.ts"]
    },

  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vitest.setup.ts"],
  "references": [
    {
      "path": "tsconfig.build.json"
    },
    {
      "path": "../../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../../../packages/browser-host/tsconfig.build.json"
    },
    {
      "path": "../../coding-agent/browser/tsconfig.build.json"
    },
    {
      "path": "../../coding-agent/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/config/tsconfig.build.json"
    },
    {
      "path": "../../../packages/design-system/tsconfig.build.json"
    },
    {
      "path": "../../../packages/error-presentation/tsconfig.build.json"
    },
    {
      "path": "../../gateway/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/handled-error/tsconfig.build.json"
    },
    {
      "path": "../../identity/contract/tsconfig.build.json"
    },
    {
      "path": "../../model-provider/browser-kit/tsconfig.build.json"
    },
    {
      "path": "../../model-provider/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/time/tsconfig.build.json"
    },
    {
      "path": "../../../packages/ui-kernel/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../authz/contract/tsconfig.build.json"
    },
    {
      "path": "../../../packages/vitest-config/tsconfig.build.json"
    }
  ]
}
