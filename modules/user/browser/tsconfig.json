{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.typecheck.tsbuildinfo",

    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node", "react", "react-dom"],
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@langwatch/auth-contract": ["../../auth/contract/src/index.ts"],
      "@langwatch/authz-contract": ["../../authz/contract/src/index.ts"],
      "@langwatch/coding-agent-contract": ["../../coding-agent/contract/src/index.ts"],
      "@langwatch/enterprise-governance-contract": [
        "../../../enterprise/modules/governance/contract/src/index.ts"
      ],
      "@langwatch/gateway-contract": ["../../gateway/contract/src/index.ts"],
      "@langwatch/langy-contract": ["../../langy/contract/src/index.ts"],
      "@langwatch/model-provider-contract": ["../../model-provider/contract/src/index.ts"],
      "@langwatch/user-contract": ["../contract/src/index.ts"]
    },
    "composite": true,
    "noEmit": false
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.build.json"
    },
    {
      "path": "./tsconfig.test.json"
    }
  ]
}
