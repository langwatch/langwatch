{
  "name": "@langwatch/user-web",
  "version": "0.1.0",
  "private": true,
  "description": "The personal workspace a person opens on themselves: their AI tools, their usage, their credentials and their coding-agent activity.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./personal-workspace": {
      "langwatch-declaration-source": "./src/personal-workspace.ts",
      "types": "./dist/personal-workspace.d.ts",
      "default": "./src/personal-workspace.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/coding-agent-contract": "workspace:*",
    "@langwatch/coding-agent-web": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/gateway-web": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/identity-contract": "workspace:*",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@paper-design/shaders-react": "catalog:",
    "lucide-react": "catalog:",
    "numeral": "catalog:",
    "react-icons": "catalog:",
    "react-markdown": "catalog:",
    "remark-gfm": "catalog:"
  },
  "devDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@langwatch/authz-contract": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/numeral": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
