{
  "name": "@langwatch/notification-server",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical server-side notification record service, private persistence, and the process-owned outbound mail delivery capability.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "catalog:",
    "@langwatch/ksuid": "catalog:",
    "@langwatch/notification-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/runtime-composition": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@sendgrid/mail": "catalog:",
    "nodemailer": "catalog:",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@types/nodemailer": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
