{
  "name": "@langwatch/organization-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe organization settings screens: the audit trail an admin or compliance reviewer reads.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./declaration": {
      "langwatch-declaration-source": "./src/organization.web.ts",
      "types": "./dist/organization.web.d.ts",
      "default": "./src/organization.web.ts"
    },
    "./surfaces/personal-workspace-features": {
      "types": "./dist/behavior/personal-workspace-features-api.d.ts",
      "default": "./src/behavior/personal-workspace-features-api.ts"
    },
    "./surfaces/department-picker": {
      "types": "./dist/department-picker.d.ts",
      "default": "./src/department-picker.ts"
    },
    "./surfaces/organization-facts": {
      "types": "./dist/behavior/ui-organization-facts.d.ts",
      "default": "./src/behavior/ui-organization-facts.ts"
    },
    "./surfaces/scope-capability": {
      "types": "./dist/behavior/scope-capability.d.ts",
      "default": "./src/behavior/scope-capability.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/auth-contract": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/browser-host": "workspace:*",
    "@langwatch/config": "workspace:*",
    "@langwatch/csv": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/enterprise-licensing-browser": "workspace:*",
    "@langwatch/entitlement-contract": "workspace:*",
    "@langwatch/identity-contract": "workspace:*",
    "@langwatch/organization-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/ui-kernel": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "lodash-es": "catalog:",
    "lucide-react": "catalog:",
    "papaparse": "catalog:",
    "react-hook-form": "catalog:",
    "react-router": "catalog:",
    "use-debounce": "catalog:"
  },
  "devDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@langwatch/vitest-config": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/papaparse": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
