{
  "name": "@langwatch/organization-process",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical server-side organization service.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./composition/organization-invites": {
      "types": "./dist/repositories/prisma/prisma.organization-invite.repository.d.ts",
      "default": "./src/repositories/prisma/prisma.organization-invite.repository.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@langwatch/actor": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/api-key-contract": "workspace:*",
    "@langwatch/authorization": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/clickhouse-client": "workspace:*",
    "@langwatch/enterprise-billing-contract": "workspace:*",
    "@langwatch/enterprise-licensing-contract": "workspace:*",
    "@langwatch/entitlement-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/identity-contract": "workspace:*",
    "@langwatch/internal-slack": "workspace:*",
    "@langwatch/kernel": "workspace:*",
    "@langwatch/ksuid": "workspace:*",
    "@langwatch/mail": "workspace:*",
    "@langwatch/module": "workspace:*",
    "@langwatch/notification-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/onboarding-contract": "workspace:*",
    "@langwatch/organization-contract": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/process-stores": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@langwatch/redis-client": "workspace:*",
    "@langwatch/role-contract": "workspace:*",
    "@langwatch/secrets": "workspace:*",
    "@langwatch/share-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/user-contract": "workspace:*",
    "@slack/webhook": "catalog:",
    "@trpc/server": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "nanoid": "^6.0.0",
    "slugify": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/api-fixture": "workspace:*",
    "@langwatch/test-harness": "workspace:*",
    "@langwatch/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
