{
  "name": "@langwatch/organization-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe organization settings screens: the audit trail an admin or compliance reviewer reads.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./organization-client": {
      "langwatch-declaration-source": "./src/organization-client.ts",
      "types": "./dist/organization-client.d.ts",
      "default": "./src/organization-client.ts"
    },
    "./personal-workspace-features": {
      "types": "./dist/behavior/personal-workspace-features-api.d.ts",
      "default": "./src/behavior/personal-workspace-features-api.ts"
    },
    "./surfaces/department-picker": {
      "types": "./dist/surfaces/department-picker/index.d.ts",
      "default": "./src/surfaces/department-picker/index.ts"
    },
    "./drawers": {
      "types": "./dist/screens/drawers.d.ts",
      "default": "./src/screens/drawers.ts"
    },
    "./drawers/project": {
      "types": "./dist/ui/sections/project-drawers.d.ts",
      "default": "./src/ui/sections/project-drawers.ts"
    },
    "./screens/organization": {
      "types": "./dist/screens/organization/index.d.ts",
      "default": "./src/screens/organization/index.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/csv": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/enterprise-licensing-web": "workspace:*",
    "@langwatch/entitlement-contract": "workspace:*",
    "@langwatch/identity-contract": "workspace:*",
    "@langwatch/organization-contract": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/ui-host": "workspace:*",
    "lodash-es": "catalog:",
    "lucide-react": "catalog:",
    "papaparse": "catalog:",
    "react-contextual-analytics": "catalog:",
    "react-hook-form": "catalog:",
    "use-debounce": "catalog:"
  },
  "devDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/papaparse": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
