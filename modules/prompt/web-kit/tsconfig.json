    },
    {
      "path": "../../model-provider/web-kit/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    },
    {
      "path": "../../workflow/contract/tsconfig.build.json"
    },
    {
      "path": "../../workflow/web-kit/tsconfig.build.json"
    },
    {
      "path": "../../../packages/api-client-web/tsconfig.build.json"
    },
    {
      "path": "../../../packages/test-harness/tsconfig.build.json"
    }
  ]
}
