    "@langwatch/workflow-browser-kit": "workspace:*",
    "@langwatch/workflow-contract": "workspace:*",
    "lucide-react": "catalog:",
    "react-hook-form": "catalog:",
    "rich-textarea": "^0.27.0",
    "usehooks-ts": "catalog:"
  },
  "devDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@langwatch/browser-trpc": "workspace:*",
    "@langwatch/test-harness": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
