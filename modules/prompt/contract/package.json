{
  "name": "@langwatch/prompt-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Portable Prompt feature contracts and Zod 4 schemas.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./llm-config-constants": {
      "types": "./dist/llm-config-constants.d.ts",
      "default": "./src/llm-config-constants.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/dataset-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/plans": "workspace:*",
    "@langwatch/runtime-composition": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
