{
  "name": "@langwatch/project-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe project screens: the project home a member lands on, and the organization and project settings they configure.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./declaration": {
      "langwatch-declaration-source": "./src/project.web.ts",
      "types": "./dist/project.web.d.ts",
      "default": "./src/project.web.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:browser": "playwright install --with-deps chromium && vitest run --config vitest.browser.config.ts"
  },
