{
  "name": "@langwatch/project-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe project screens: the project home a member lands on, and the organization and project settings they configure.",
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    "./screens/home": {
      "langwatch-declaration-source": "./src/screens/home/index.ts",
      "types": "./dist/screens/home/index.d.ts",
      "default": "./src/screens/home/index.ts"
    },
    "./screens/project-settings": {
      "langwatch-declaration-source": "./src/screens/project-settings/index.ts",
      "types": "./dist/screens/project-settings/index.d.ts",
      "default": "./src/screens/project-settings/index.ts"
    },
    "./surfaces/tech-stack": {
      "langwatch-declaration-source": "./src/ui/blocks/tech-stack.tsx",
      "types": "./dist/ui/blocks/tech-stack.d.ts",
      "default": "./src/ui/blocks/tech-stack.tsx"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@langwatch/analytics-contract": "workspace:*",
    "@langwatch/analytics-web": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/feature-flag-contract": "workspace:*",
    "@langwatch/langy-web": "workspace:*",
    "@langwatch/navigation-web": "workspace:*",
    "@langwatch/organization-web": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-web": "workspace:*",
    "@langwatch/ui-host": "workspace:*",
    "@paper-design/shaders-react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "lodash-es": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "numeral": "catalog:",
    "posthog-js": "catalog:",
    "react-contextual-analytics": "catalog:",
    "react-hook-form": "catalog:",
    "react-icons": "catalog:"
  },
  "devDependencies": {
    "@chakra-ui/react": "catalog:",
    "@emotion/react": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/numeral": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
