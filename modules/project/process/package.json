{
  "name": "@langwatch/project-process",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical server-side project service.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@langwatch/api": "workspace:*",
    "@langwatch/audit-log-contract": "workspace:*",
    "@langwatch/authorization": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/data-privacy-contract": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/ksuid": "workspace:*",
    "@langwatch/module": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/onboarding-contract": "workspace:*",
    "@langwatch/organization-contract": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/process": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@langwatch/task": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/upgrade": "workspace:*",
    "@trpc/server": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "nanoid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/instant-eval-judge-process": "workspace:*",
    "@langwatch/process-stores": "workspace:*",
    "@langwatch/secrets": "workspace:*",
    "@langwatch/test-harness": "workspace:*",
    "@langwatch/vitest-config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
