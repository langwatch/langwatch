{
  "name": "@langwatch/suite-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe Suite run presentation primitives.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/run-formatters.ts",
  "types": "./dist/run-formatters.d.ts",
  "exports": {
    "./testing": {
      "types": "./dist/__tests__/test-helpers.d.ts",
      "default": "./src/__tests__/test-helpers.ts"
    },
    "./run-cards": {
      "langwatch-declaration-source": "./src/run-cards.ts",
      "types": "./dist/run-cards.d.ts",
      "default": "./src/run-cards.ts"
    },
    "./run-dialogs": {
      "langwatch-declaration-source": "./src/run-dialogs.ts",
      "types": "./dist/run-dialogs.d.ts",
      "default": "./src/run-dialogs.ts"
    },
    "./run-formatters": {
      "langwatch-declaration-source": "./src/run-formatters.ts",
      "types": "./dist/run-formatters.d.ts",
      "default": "./src/run-formatters.ts"
    },
    "./run-history-store": {
      "langwatch-declaration-source": "./src/run-history-store.ts",
      "types": "./dist/run-history-store.d.ts",
      "default": "./src/run-history-store.ts"
    },
    "./suite-form": {
      "langwatch-declaration-source": "./src/suite-form.ts",
      "types": "./dist/suite-form.d.ts",
      "default": "./src/suite-form.ts"
    },
    "./suite-pickers": {
      "langwatch-declaration-source": "./src/suite-pickers.ts",
      "types": "./dist/suite-pickers.d.ts",
      "default": "./src/suite-pickers.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@chakra-ui/react": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/scenario-contract": "workspace:*",
    "@langwatch/suite-contract": "workspace:*",
    "@langwatch/ui-host": "workspace:*",
    "@tanstack/react-virtual": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-feather": "catalog:",
    "react-hook-form": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
