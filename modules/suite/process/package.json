{
  "name": "@langwatch/suite-process",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical server-side Suite feature.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
