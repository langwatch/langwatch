{
  "name": "@langwatch/hosted-mcp-contract",
  "version": "0.1.0",
  "private": true,
  "description": "Portable Hosted MCP feature contract.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "pnpm -w typecheck:declarations --project modules/hosted-mcp/contract/tsconfig.json && tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@langwatch/runtime-composition": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
