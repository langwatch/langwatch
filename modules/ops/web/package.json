{
  "name": "@langwatch/ops-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe platform operations and backoffice UI.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./surfaces/impersonation": {
      "types": "./dist/surfaces/impersonation/index.d.ts",
      "default": "./src/surfaces/impersonation/index.ts"
    },
    "./screens/ops": {
      "types": "./dist/screens/ops/index.d.ts",
      "default": "./src/screens/ops/index.ts"
    },
    "./drawers": {
      "types": "./dist/screens/drawers.d.ts",
      "default": "./src/screens/drawers.ts"
    },
    "./surfaces/keyboard-key": {
      "types": "./dist/surfaces/keyboard-key/index.d.ts",
      "default": "./src/surfaces/keyboard-key/index.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
