{
  "name": "@langwatch/scenario-server",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical server-side Scenario service and private persistence.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    },
    "./composition/scenario-failure-handler": {
      "types": "./dist/services/scenario-failure-handler.service.d.ts",
      "default": "./src/services/scenario-failure-handler.service.ts"
    },
    "./composition/simulation-clickhouse": {
      "types": "./dist/adapters/simulation.clickhouse.adapter.d.ts",
      "default": "./src/adapters/simulation.clickhouse.adapter.ts"
    },
    "./composition/simulation-eventing": {
      "types": "./dist/adapters/simulation-eventing.adapter.d.ts",
      "default": "./src/adapters/simulation-eventing.adapter.ts"
    },
    "./composition/simulation-execution-port": {
      "types": "./dist/ports/simulation-execution.port.d.ts",
      "default": "./src/ports/simulation-execution.port.ts"
    },
    "./composition/simulation-processing-producer": {
      "types": "./dist/adapters/simulation-processing-producer.adapter.d.ts",
      "default": "./src/adapters/simulation-processing-producer.adapter.ts"
    },
    "./composition/stalled-runs-backfill": {
      "types": "./dist/tasks/stalled-runs-backfill.task.d.ts",
      "default": "./src/tasks/stalled-runs-backfill.task.ts"
    },
    "./api-trpc/scenario": {
      "types": "./dist/transport/api-trpc/scenario.api.d.ts",
      "default": "./src/transport/api-trpc/scenario.api.ts"
    },
    "./api-trpc/scenario-events": {
      "types": "./dist/transport/api-trpc/scenario-events.api.d.ts",
      "default": "./src/transport/api-trpc/scenario-events.api.ts"
    },
    "./api-trpc/simulation-runner": {
      "types": "./dist/transport/api-trpc/simulation-runner.api.d.ts",
      "default": "./src/transport/api-trpc/simulation-runner.api.ts"
    },
    "./api-rest/scenario-event": {
      "types": "./dist/transport/api-rest/scenario-event.api.d.ts",
      "default": "./src/transport/api-rest/scenario-event.api.ts"
    },
    "./api-rest/scenario-run-export": {
      "types": "./dist/transport/api-rest/scenario-run-export.api.d.ts",
      "default": "./src/transport/api-rest/scenario-run-export.api.ts"
    },
    "./api-rest/scenario": {
      "types": "./dist/transport/api-rest/scenario.api.d.ts",
      "default": "./src/transport/api-rest/scenario.api.ts"
    },
    "./api-rest/simulation-run": {
      "types": "./dist/transport/api-rest/simulation-run.api.d.ts",
      "default": "./src/transport/api-rest/simulation-run.api.ts"
    },
    "./api-rest/scenario-generate": {
      "types": "./dist/transport/api-rest/scenario-generate.api.d.ts",
      "default": "./src/transport/api-rest/scenario-generate.api.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project . && tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "catalog:",
    "@ai-sdk/provider": "^3.0.13",
    "@clickhouse/client": "catalog:",
    "@langwatch/agent-contract": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/automation-contract": "workspace:*",
    "@langwatch/csv": "workspace:*",
    "@langwatch/eventing": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prisma-client": "workspace:*",
    "@langwatch/project-contract": "workspace:*",
    "@langwatch/prompt-contract": "workspace:*",
    "@langwatch/scenario": "catalog:",
    "@langwatch/scenario-contract": "workspace:*",
    "@langwatch/secret-contract": "workspace:*",
    "@langwatch/suite-contract": "workspace:*",
    "@langwatch/task": "workspace:*",
    "@langwatch/trace-contract": "workspace:*",
    "@langwatch/user-contract": "workspace:*",
    "@langwatch/workflow-contract": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@trpc/server": "catalog:",
    "@xyflow/react": "catalog:",
    "ai": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "jsonpath-plus": "catalog:",
    "langwatch": "workspace:*",
    "liquidjs": "catalog:",
    "nanoid": "catalog:",
    "papaparse": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@langwatch/model-provider-server": "workspace:*",
    "@langwatch/organization-contract": "workspace:*",
    "@langwatch/redis-client": "workspace:*",
    "@langwatch/suite-server": "workspace:*",
    "@langwatch/test-harness": "workspace:*",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@types/papaparse": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
