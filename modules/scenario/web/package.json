{
  "name": "@langwatch/scenario-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe Scenario library and target-selection UI.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    "./scenario-mappings": {
      "langwatch-declaration-source": "./src/scenario-mappings.ts",
      "types": "./dist/scenario-mappings.d.ts",
      "default": "./src/scenario-mappings.ts"
    },
    "./surfaces/media-part": {
      "langwatch-declaration-source": "./src/ui/sections/media-part.tsx",
      "types": "./dist/ui/sections/media-part.d.ts",
      "default": "./src/ui/sections/media-part.tsx"
    },
    ".": {
      "langwatch-declaration-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./surfaces/simulations-preference": {
      "langwatch-declaration-source": "./src/surfaces/simulations-preference/index.ts",
      "types": "./dist/surfaces/simulations-preference/index.d.ts",
      "default": "./src/surfaces/simulations-preference/index.ts"
    },
    "./screens/simulations": {
      "langwatch-declaration-source": "./src/screens/simulations/index.ts",
      "types": "./dist/screens/simulations/index.d.ts",
      "default": "./src/screens/simulations/index.ts"
    },
    "./drawers": {
      "langwatch-declaration-source": "./src/screens/drawers.ts",
      "types": "./dist/screens/drawers.d.ts",
      "default": "./src/screens/drawers.ts"
    }
  },
  "scripts": {
    "typecheck": "pnpm -w typecheck:declarations --project modules/scenario/web/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "@hookform/resolvers": "^5.4.0",
    "@langwatch/agent-contract": "workspace:*",
    "@langwatch/agent-web": "workspace:*",
    "@langwatch/analytics-web": "workspace:*",
    "@langwatch/api": "workspace:*",
    "@langwatch/authz-contract": "workspace:*",
    "@langwatch/design-system": "workspace:*",
    "@langwatch/experiment-contract": "workspace:*",
    "@langwatch/feature-flag-contract": "workspace:*",
    "@langwatch/handled-error": "workspace:*",
    "@langwatch/ksuid": "^2.0.2",
    "@langwatch/langy-web": "workspace:*",
    "@langwatch/model-provider-contract": "workspace:*",
    "@langwatch/model-provider-web": "workspace:*",
    "@langwatch/observability": "workspace:*",
    "@langwatch/prompt-web": "workspace:*",
    "@langwatch/scenario-contract": "workspace:*",
    "@langwatch/suite-contract": "workspace:*",
    "@langwatch/suite-web": "workspace:*",
    "@langwatch/time": "workspace:*",
    "@langwatch/trace-web": "workspace:*",
    "@langwatch/ui-drawer": "workspace:*",
    "@langwatch/ui-host": "workspace:*",
    "@langwatch/workflow-contract": "workspace:*",
    "@langwatch/workflow-web": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.5",
    "lucide-react": "^1.22.0",
    "posthog-js": "^1.396.9",
    "react": "^19.2.7",
    "react-feather": "^2.0.10",
    "react-hook-form": "^7.80.0",
    "react-icons": "^5.7.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.4.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.101.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^30.0.1",
    "react-dom": "^19.2.7",
    "react-router": "^8.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
