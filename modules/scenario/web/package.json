    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.36.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
