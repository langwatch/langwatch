{
  "name": "@langwatch/scenario-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-safe Scenario library and target-selection UI.",
  "files": [
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    "./declaration": {
      "langwatch-declaration-source": "./src/scenario.web.ts",
      "types": "./dist/scenario.web.d.ts",
      "default": "./src/scenario.web.ts"
    },
    "./scenario-mappings": {
      "langwatch-declaration-source": "./src/scenario-mappings.ts",
      "types": "./dist/scenario-mappings.d.ts",
      "default": "./src/scenario-mappings.ts"
    },
    "./surfaces/media-part": {
      "langwatch-declaration-source": "./src/ui/sections/media-part.tsx",
      "types": "./dist/ui/sections/media-part.d.ts",
      "default": "./src/ui/sections/media-part.tsx"
    },
    ".": {
      "langwatch-declaration-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./surfaces/simulations-preference": {
      "langwatch-declaration-source": "./src/simulations-preference.ts",
      "types": "./dist/simulations-preference.d.ts",
      "default": "./src/simulations-preference.ts"
    },
    "./simulations": {
      "langwatch-declaration-source": "./src/simulations.ts",
      "types": "./dist/simulations.d.ts",
      "default": "./src/simulations.ts"
    },
    "./drawers": {
      "langwatch-declaration-source": "./src/drawers.ts",
      "types": "./dist/drawers.d.ts",
      "default": "./src/drawers.ts"
    },
    "./surfaces/parameter-line-field": {
      "types": "./dist/ui/sections/agent-testing/run/parameter-line-field.d.ts",
      "default": "./src/ui/sections/agent-testing/run/parameter-line-field.tsx"
    },
    "./surfaces/dialog-fields": {
      "types": "./dist/ui/elements/agent-testing/shared/dialog-fields.d.ts",
      "default": "./src/ui/elements/agent-testing/shared/dialog-fields.tsx"
    },
    "./surfaces/parameter-line": {
      "types": "./dist/model/agent-testing/run/parameter-line.d.ts",
      "default": "./src/model/agent-testing/run/parameter-line.ts"
    },
    "./surfaces/parameter-suggestions": {
      "types": "./dist/ui/sections/agent-testing/run/parameter-suggestions.d.ts",
      "default": "./src/ui/sections/agent-testing/run/parameter-suggestions.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
