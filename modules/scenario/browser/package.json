    "@langwatch/ui-kernel": "workspace:*",
    "@langwatch/workflow-browser": "workspace:*",
    "@langwatch/workflow-contract": "workspace:*",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "lucide-react": "catalog:",
