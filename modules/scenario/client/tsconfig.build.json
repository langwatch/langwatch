{
  "extends": ["./tsconfig.json", "../../../tsconfig.emit.json"],
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "paths": {
      "@langwatch/scenario-client": ["./src/index.ts"]
    }
  },
  "files": ["./src/index.ts"],
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": ["**/__tests__/**", "**/__mocks__/**", "**/tests/**", "**/*.test.*", "**/*.spec.*"],
  "references": [
    {
      "path": "../../../packages/api/tsconfig.build.json"
    },
    {
      "path": "../contract/tsconfig.build.json"
    }
  ]
}
